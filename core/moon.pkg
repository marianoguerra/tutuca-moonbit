// `x/time` and `x/codec/base64` are here for ONE arm each of `Value`:
// `Instant` needs a calendar to print an RFC 3339 timestamp, and `Bin` needs
// base64 to survive JSON. Both are pure, both are already module dependencies,
// and the alternative is a second hand-kept spelling of each — which is two
// answers to a question that has one.
import {
  "moonbitlang/core/string",
  "moonbitlang/core/json",
  "moonbitlang/x/time",
  "moonbitlang/x/codec/base64",
}

import {
  "moonbitlang/quickcheck" @qc,
  "moonbitlang/quickcheck/gen",
  "moonbitlang/core/json",
  // assert_same_object: the copy-on-write contract is about IDENTITY, so the
  // tests that pin it need the identity assertion, not Eq.
  "moonbitlang/core/test",
} for "test"
