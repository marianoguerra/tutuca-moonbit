// Type aliases

// Traits
pub(open) trait ComponentSource {
  fn describe(Self, String?, String) -> SchemaInfo? = _
  fn build(Self, String?, String, Map[String, Value], at~ : String) -> Value?
}

pub(open) trait Ctx {
  fn path(Self) -> DispatchPath = _
  fn target_path(Self) -> DispatchPath = _
  fn name(Self) -> String? = _
  fn origin(Self) -> Origin = _
  fn send(Self, String, Array[Value]) -> Unit = _
  fn send_at_path(Self, DispatchPath, String, Array[Value]) -> Unit = _
  fn set_member_at_path(Self, DispatchPath, String, Value) -> Unit = _
  fn set_property_at_path(Self, DispatchPath, String, Value) -> Unit = _
  fn intent(Self, String, Array[Value], IntentOpts) -> Unit = _
  fn intent_at_path(Self, DispatchPath, String, Array[Value], IntentOpts) -> Unit = _
  fn forward(Self, Array[Value]?, IntentOpts?) -> Unit = _
  fn reply(Self, Value) -> Unit = _
  fn send_reply(Self, String, Array[Value]) -> Unit = _
  fn lookup(Self, String, LookupOpts) -> Value = _
  fn make(Self, String, Map[String, Value], LookupOpts) -> Value? = _
  fn fail(Self, Value) -> Unit = _
  fn stop_propagation(Self) -> Unit = _
  fn at(Self) -> PathChanges = _
  fn walk_path(Self, (Int32, Value) -> Bool) -> Unit = _
}

pub(open) trait Fields {
  fn schema() -> SchemaInfo
  fn encode(Self) -> Map[String, Value]
  fn decode(Map[String, Value]) -> Self?
}

pub(open) trait Obj {
  fn component_id(Self) -> Int32? = _
  fn field(Self, String) -> Value? = _
  fn with_field(Self, String, Value) -> Value? = _
  fn property(Self, String) -> Value? = _
  fn set_property(Self, String, Value) -> Outcome = _
  fn member_at(Self, String, &Stack) -> Value? = _
  fn set_member(Self, String, Value) -> Outcome = _
  fn mutate_member(Self, String, String, Array[Value]) -> Outcome = _
  fn item(Self, PathKey) -> Value? = _
  fn with_item(Self, PathKey, Value) -> Value? = _
  fn seq_entries(Self) -> Array[(PathKey, Value)]? = _
  fn trigger(Self, String) -> Value? = _
  fn method_at(Self, String, &Stack) -> Value? = _
  fn trigger_at(Self, String, &Stack) -> Value? = _
  fn handler(Self, HandlerBucket, String) -> Handler? = _
  fn schema(Self) -> SchemaInfo? = _
  fn size(Self) -> Int32? = _
  fn identity(Self) -> ObjId? = _
  fn eq(Self, &Obj) -> Bool = _
  fn debug(Self) -> String = _
  fn persist_id(Self) -> String? = _
}

pub(open) trait Stack {
  fn lookup_bare(Self, String) -> Value = _
  fn lookup_event_path(Self, Array[String]) -> Value = _
  fn lookup_bind(Self, String) -> Value = _
  fn lookup_dynamic(Self, String) -> Value = _
  fn lookup_storage(Self, String) -> Value = _
  fn lookup_member(Self, String) -> Value = _
  fn lookup_method(Self, String) -> Value = _
  fn lookup_trigger(Self, String) -> Value = _
}
