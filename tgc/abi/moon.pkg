// The frozen `tgc/2` preamble: the canonical wasm-GC type section every module
// carries, plus the op codes, export names, import names and the runtime
// function vocabulary that go with it.
//
// ONE table, ONE rendering. The preamble is wap source and the WAT is DERIVED
// from it by lowering and printing, because two hand-kept spellings of a
// structural type are two types — which is the thing this package exists to
// prevent. `wap` is therefore a real dependency here rather than a test-only
// one: a caller asking for `preamble_wat` is asking for the answer a compiler
// gave, not for a string that looks like one.
import {
  "marianoguerra/wap",
  "marianoguerra/wap/ast" @wast,
  "marianoguerra/wax/compile",
  "moonbitlang/core/debug",
}

import {
  "marianoguerra/wax/message",
  "marianoguerra/error-report",
} for "test"
