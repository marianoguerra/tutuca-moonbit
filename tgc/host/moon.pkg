// Host side of the component format (tgc/SPEC.md): wraps a foreign module's
// instance in a DynObj (&Obj implementer) and synthesizes real compiled
// components from the module's own manifest, so render/dispatch/transactor
// treat them exactly like local ones.
//
// Backend-agnostic on purpose: &Guest is the seam, the browser implements it
// over the instantiated module's exports, and tests implement it with an
// in-process fake — so the whole host runs with no wasm at all.
// Check: moon check tgc/host
import {
  "marianoguerra/tutuca/core" @tutuca,
  // A field's `constraint` is part of the DESCRIPTION rather than of the
  // runtime, so it lives with the thing that projects descriptions. The parser
  // fills one in; the registry and both layers read it.
  // What this host will ACCEPT from a module. The decisions live there and the
  // mechanics live here, so "what can a dropped module do" has one answer.
  "marianoguerra/tutuca/tgc/policy",
  // Where an instance GOES when it has to outlive the page. Another leaf: a
  // snapshot is a value worth having without a module in hand.
  "marianoguerra/tutuca/tgc/persist",
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/lint",
  "moonbitlang/core/json",
}

import {
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/testing/harness",
  "marianoguerra/tutuca/vdom/memdom",
  "moonbitlang/core/debug",
  // the FakeGuest persists as text of its own, which is what proves the host
  // never looks inside a guest's bytes
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
} for "test"
