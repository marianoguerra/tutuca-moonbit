// Card -> `tgc` module.
//
// The THIRD backend over `tscript`'s one AST, and the one meant to outlive the
// other two: `tscript/emit_mbt` writes MoonBit ahead of time and
// This replaces a Component Model backend; see `tgc/SPEC.md`.
// A language with three implementations and no shared table has three
// semantics, so this is held to `tscript/conformance` exactly as they are.
//
// It builds a wap AST. The backend before this one emitted Wax SOURCE, for a
// reason worth recording: the generated text was an artifact a card author
// could read, which is what the playground's panel is for. What that cost was
// an expression emitter that answered a String while writing statements into a
// shared buffer as a side effect, indentation maintained by hand at eleven
// sites, its own string escaping, and diagnostics whose line numbers had the
// preamble's length subtracted from them.
//
// The artifact is the thing to keep, and it is now an outline rather than the
// source — see `describe_wap`. When wap grows a printer, or this package grows
// one, it goes back to being the whole module.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/statedef",
  "marianoguerra/tutuca/tscript",
  "marianoguerra/tutuca/tscript/check",
  "marianoguerra/tutuca/viewfile",
  "marianoguerra/error-report" @report,
  // The VIEW checker, and the surface it answers: `check_component_views` does
  // both, which is why a card's templates are checked at all.
  "marianoguerra/tutuca/viewgen",
  "marianoguerra/tutuca/tgc/abi",
  "marianoguerra/tutuca/tgc/rt",
  "marianoguerra/wap",
  "marianoguerra/wap/ast" @wast,
  "marianoguerra/wap/resolve",
  "marianoguerra/wap/parse",
  "marianoguerra/wap/lower" @waplower,
  "marianoguerra/wax/compile",
  "marianoguerra/error-report" @report,
  "marianoguerra/wax/message",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/set",
}
