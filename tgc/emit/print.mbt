// The generated module, as wap source.
//
// `Compiled::wap` is the discovery path: a card author who wants to know what a
// handler became reads it, and an author writing an escape copies its idioms.
// The backend before this one emitted source and handed back the text it had
// written; this one builds a tree, so the text has to be printed back — and
// printing it is what keeps the artifact rather than trading it for the tree.
//
// It prints WAP, not Wax and not WAT. A reader who wants the wasm has
// `wasm-tools print` and a reader who wants the cost model has the wap README;
// what nobody else can produce is the notation this backend actually emitted.
//
// Only the constructs `tgc/emit` builds are handled with care. The rest print
// as `<expr>` rather than being guessed at, because a printer that invents a
// spelling for something it does not emit is a second grammar nobody checks.

///|
/// One module, as wap source.
fn print_module(m : @wast.Module) -> String {
  let out = StringBuilder()
  out.write_string("// Generated by `tgc/emit` from a card. Do not edit.\n")
  out.write_string("//\n")
  out.write_string(
    "// The frozen preamble is IMPORTED, not carried: the types below are the\n",
  )
  out.write_string("// format's and nothing here spells them.\n\n")
  for d in m.decls {
    print_decl(out, d)
  }
  out.to_string()
}

///|
fn print_decl(out : StringBuilder, d : @wast.Decl) -> Unit {
  match d {
    ModuleName(name) => out.write_string("module \{name}\n\n")
    Import(path) => out.write_string("import \{path.join(".")}\n\n")
    ImportHost(module_~, funcs~, ..) => {
      out.write_string("import \"\{module_}\":\n")
      for f in funcs {
        // The import NAME is spelled out even when it matches, because without
        // it wap prefixes the wasm import field with the module and the link
        // fails. Printing it keeps this text something a reader can paste.
        match f.import_name {
          Some(n) => out.write_string("  import \"\{n}\" ")
          None => out.write_string("  ")
        }
        out.write_string("fn \{f.name}\{print_sig(f)}\n")
      }
      out.write_string("\n")
    }
    TypeD(name~, def~, ..) => {
      match def {
        Record(fields~, ..) => {
          let parts = []
          for f in fields {
            parts.push("\{f.name} :: \{print_type(f.typ)}")
          }
          out.write_string("type \{name} = { " + parts.join(", ") + " }\n")
        }
        Alias(t) => out.write_string("type \{name} = \{print_type(t)}\n")
        _ => out.write_string("type \{name} = ...\n")
      }
      out.write_string("\n")
    }
    Fn(f) => {
      match f.export_name {
        Some(e) => out.write_string("export \"\{e}\" ")
        None => ()
      }
      out.write_string("fn \{f.name}\{print_sig(f)}:\n")
      match f.body {
        Some(body) =>
          for n in body {
            print_node(out, n, 1)
          }
        None => out.write_string("  // no body\n")
      }
      out.write_string("\n")
    }
    _ => ()
  }
}

///|
fn print_sig(f : @wast.FnDecl) -> String {
  let ps = []
  for p in f.params {
    ps.push("\{p.name} :: \{print_type(p.typ)}")
  }
  let head = "(" + ps.join(", ") + ")"
  match f.results {
    [] => head
    [one] => head + " -> " + print_type(one)
    many => {
      let rs = []
      for r in many {
        rs.push(print_type(r))
      }
      head + " -> (" + rs.join(", ") + ")"
    }
  }
}

///|
fn print_type(t : @wast.Type) -> String {
  match t {
    I32 => "i32"
    I64 => "i64"
    U32 => "u32"
    U64 => "u64"
    F32 => "f32"
    F64 => "f64"
    Bool => "bool"
    Named(n) => n
    Nullable(inner) => print_type(inner) + "?"
    ArrayOf(inner) => "[" + print_type(inner) + "]"
    Eq => "eq"
    Any => "any"
    _ => "?"
  }
}

///|
fn indent(out : StringBuilder, depth : Int) -> Unit {
  for _ in 0..<depth {
    out.write_string("  ")
  }
}

///|
/// One node, as a line or a block of them.
fn print_node(out : StringBuilder, n : @wast.Node, depth : Int) -> Unit {
  match n.it {
    Bind(binders~, value~, mutable~) => {
      indent(out, depth)
      let kw = if mutable { "var" } else { "let" }
      let names = []
      for bd in binders {
        names.push(
          match bd.typ {
            Some(t) => "\{bd.name} :: \{print_type(t)}"
            None => bd.name
          },
        )
      }
      let target = if names.length() == 1 {
        names[0]
      } else {
        "(" + names.join(", ") + ")"
      }
      match value {
        Some(v) => out.write_string("\{kw} \{target} = \{print_expr(v)}\n")
        None => out.write_string("\{kw} \{target}\n")
      }
    }
    Assign(targets~, value~, ..) => {
      indent(out, depth)
      let ts = []
      for t in targets {
        ts.push(print_expr(t))
      }
      out.write_string(ts.join(", ") + " = " + print_expr(value) + "\n")
    }
    If(arms~, ..) =>
      for i, arm in arms {
        let (cond, body) = arm
        indent(out, depth)
        match cond {
          Some(c) =>
            out.write_string(
              (if i == 0 { "if " } else { "| " }) + print_expr(c) + ":\n",
            )
          None => out.write_string("| else:\n")
        }
        for inner in body {
          print_node(out, inner, depth + 1)
        }
      }
    ForRange(var_~, from~, to~, body~, ..) => {
      indent(out, depth)
      out.write_string(
        "for \{var_} in \{print_expr(from)} ..< \{print_expr(to)}:\n",
      )
      for inner in body {
        print_node(out, inner, depth + 1)
      }
    }
    Return(v) => {
      indent(out, depth)
      match v {
        Some(x) => out.write_string("return " + print_expr(x) + "\n")
        None => out.write_string("return\n")
      }
    }
    Block(items) =>
      for inner in items {
        print_node(out, inner, depth)
      }
    _ => {
      indent(out, depth)
      out.write_string(print_expr(n) + "\n")
    }
  }
}

///|
/// One expression, on one line.
fn print_expr(n : @wast.Node) -> String {
  match n.it {
    Int(s) => s
    Float(s) => s
    BoolLit(v) => if v { "true" } else { "false" }
    StrLit(s) => "\"" + escape(s) + "\""
    Null => "null"
    Var(name) => name
    Field(base, name) => print_expr(base) + "." + name
    Index(base, key) => print_expr(base) + "[" + print_expr(key) + "]"
    Call(callee, args) => {
      let parts = []
      for a in args {
        parts.push(print_expr(a))
      }
      print_expr(callee) + "(" + parts.join(", ") + ")"
    }
    Bin(op, l, r) => print_expr(l) + " " + print_bin(op) + " " + print_expr(r)
    Un(op, v) =>
      (match op {
        Not => "!"
        Neg => "-"
      }) +
      print_expr(v)
    NonNull(v) => print_expr(v) + "!"
    Cast(v, t) => "(" + print_expr(v) + " as " + print_type(t) + ")"
    Test(v, t) => "(" + print_expr(v) + " is " + print_type(t) + ")"
    ArrayLit(typ~, items~) => {
      let parts = []
      for i in items {
        parts.push(print_expr(i))
      }
      (match typ {
        Some(t) => t
        None => ""
      }) +
      "[" +
      parts.join(", ") +
      "]"
    }
    ArrayRepeat(typ~, value~, count~) =>
      (match typ {
        Some(t) => t
        None => ""
      }) +
      "[" +
      print_expr(value) +
      " ** " +
      print_expr(count) +
      "]"
    RecordLit(typ~, fields~) => {
      let parts = []
      for f in fields {
        let (name, v) = f
        parts.push(
          match v {
            Some(x) => name + ": " + print_expr(x)
            None => name
          },
        )
      }
      (match typ {
        Some(t) => t
        None => ""
      }) +
      "{ " +
      parts.join(", ") +
      " }"
    }
    // A block or a branch in a value position. The emitters hoist those into
    // statements, so reaching here means a shape this printer has not learned
    // rather than one it chose not to spell.
    _ => "<expr>"
  }
}

///|
fn print_bin(op : @wast.BinOp) -> String {
  match op {
    Add => "+"
    Sub => "-"
    Mul => "*"
    Div => "/"
    Rem => "%"
    Shl => "<<"
    Shr => ">>"
    BitAnd => "&"
    BitOr => "||"
    BitXor => "^"
    Eq => "=="
    Ne => "!="
    Lt => "<"
    Gt => ">"
    Le => "<="
    Ge => ">="
  }
}

///|
/// A wap string literal's escapes.
///
/// The EMITTER needs none of this — `StrLit` carries the string and the encoder
/// writes the bytes, which is one of the things the tree bought. It is needed
/// here, printing back out, and that is the right place for it: a bug in this
/// escaping makes the artifact wrong, not the module.
fn escape(s : String) -> String {
  let out = StringBuilder()
  for c in s {
    match c {
      '"' => out.write_string("\\\"")
      '\\' => out.write_string("\\\\")
      '\n' => out.write_string("\\n")
      '\r' => out.write_string("\\r")
      '\t' => out.write_string("\\t")
      _ => out.write_char(c)
    }
  }
  out.to_string()
}
