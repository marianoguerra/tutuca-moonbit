// The browser half of `files`: a real download, and a real read of a file the
// viewer picked or dropped.
//
// Separate package because it is the only part that cannot run anywhere else —
// `files` is backend-agnostic and tested on a Map, and this is two imports and
// one export that make the same trait talk to a page. A gallery that never
// names this carries no download code and declares no extra wasm import, which
// is why the seam is where it is.
// Check: moon check --target wasm-gc files/wasm
import {
  "marianoguerra/tutuca/files",
}

supported_targets = "wasm-gc"

// Warning 73 (`unnecessary_annotation`) is off HERE and nowhere else, for one
// line: an EMPTY struct literal has exactly one spelling, `T::{ }`, because a
// bare `{ }` reads as an empty Map — and moonc flags the `T::` on it as
// unnecessary anyway. `T::{  }`, `({  } : T)` and `{ .. }` were all tried; only
// the flagged one compiles. Remove this when moonc stops reporting it.

warnings = "-73"
