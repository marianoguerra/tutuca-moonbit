{
  "manifestVersion": 3,
  "apiVersion": 10,
  "moduleName": "dice",
  "doc": "A die you roll. It asks the host for the number, because it cannot make one.",
  "version": "0.1.0",
  "homepage": "",
  "authors": [],
  "stringEncoding": "utf16",
  "components": [
    {
      "name": "Dice",
      "doc": "A die you roll. It asks the host for the number, because it has no way to make one.",
      "keywords": [
        "dice",
        "die",
        "random",
        "roll",
        "game",
        "chance"
      ],
      "category": "input",
      "messageDocs": [
        {
          "name": "roll",
          "doc": "Ask the host for a number and show it."
        },
        {
          "name": "clear",
          "doc": "Forget every roll."
        },
        {
          "name": "rolled",
          "doc": "The host answered with a face."
        },
        {
          "name": "rollFailed",
          "doc": "The host would not roll."
        },
        {
          "name": "caption",
          "doc": "The die and its face as one sentence."
        },
        {
          "name": "isMax",
          "doc": "Was this roll the highest face?"
        }
      ],
      "views": [
        {
          "name": "main",
          "src": "views/Dice.main.html"
        }
      ],
      "types": [
        {
          "kind": "ty-float",
          "elem": null,
          "items": [],
          "name": "",
          "members": []
        },
        {
          "kind": "ty-list",
          "elem": 0,
          "items": [],
          "name": "",
          "members": []
        }
      ],
      "fields": [
        {
          "name": "faces",
          "ty": 0,
          "doc": "How many faces. Six unless you say otherwise.",
          "required": false,
          "constraint": {
            "min": 2,
            "max": 100
          }
        },
        {
          "name": "last",
          "ty": 0,
          "doc": "The face showing, or 0 before the first roll.",
          "required": false,
          "constraint": null
        },
        {
          "name": "rolls",
          "ty": 1,
          "doc": "Every face this die has shown, oldest first.",
          "required": false,
          "constraint": null
