# macOS
.DS_Store

# MoonBit build output and fetched dependencies
# `target/` is the Rust guest's (guests/rust-tempconv); the directory form is
# deliberate — a bare `target` would also ignore any FILE with that name.
_build/
target/
.mooncakes/
.moonagent/

# npm (happy-dom for js-target tests; fetched playground compiler)
node_modules/

# Assembled distributables (regenerate with `cmd/dev -- dist`)
dist/

# Vendored MoonBit web compiler for the playground — fetched on build,
# never committed (5+ MB, version-coupled; see playground/build/assemble.mjs)
playground/vendor/moonc-web.cjs

# Playwright-MCP browser session dumps
.playwright-mcp/

# Per-machine agent settings. Not `.claude/` wholesale: a project may want to
# check in shared skills or settings, and only this file is personal.
.claude/settings.local.json

# Throwaway scaffold used by scripts/check-playground-examples.mjs
playground/_examples_check/

# The only .wit in the tree is the hand-written dyncomp boundary contract.
# `gen-views` no longer emits any: nothing consumed the documents it wrote.
*.wit
!dyncomp/wit/*.wit
# ...and the copy `tutuca new-guest` writes into a scaffolded guest, which is a
# source file there rather than generated output: without this, a guest under
# examples/ builds here and nowhere else, because a fresh clone would have no
# contract to embed.
!examples/**/wit/*.wit
