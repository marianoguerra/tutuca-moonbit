// The seam between building a vdom tree and diffing it against the last one.
//
// A filter runs after `render_root` has finished evaluating anode and before
// `@vdom.render` touches the DOM, which is the only point where an attribute's
// VALUE is concrete and nothing has been written yet. Absent is the trusted
// case and costs one `if` per render.
//
// Over `vdom` and nothing else: a filter rewrites a tree, and knows about no
// policy, no bundle and no renderer. See docs/sanitizer.md.
import {
  "marianoguerra/tutuca/vdom",
  // The CSS value validator, for `CssFilter`. A leaf over a tokenizer, with no
  // dependency on `anode` or on `anode/sanitize` — which is what lets this
  // package take it without taking the config model it deliberately does not
  // have.
  "marianoguerra/tutuca/anode/sanitize/css" @safecss,
  // `SinkHints` — which of these rules an element's attribute NAMES could
  // concern, decided by `render` off the view tree and passed to
  // `filter_elem_hinted`. A leaf with no imports, which is what lets this
  // package take it: naming the type in `anode`, where the tree is, would put
  // a template compiler behind every render (see `handler.mbt`).
  "marianoguerra/tutuca/sinks",
  "moonbitlang/core/set",
}

import {
  "marianoguerra/tutuca/anode/sanitize/css" @safecss,
  "moonbitlang/core/debug",
  "moonbitlang/core/test",
} for "test"
