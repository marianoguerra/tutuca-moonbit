// The MoonBit backend, held to the conformance corpus.
//
// The corpus is DATA and the interpreter reads it directly. This backend
// cannot: its answers only exist once `moonc` has compiled them. So the corpus
// is projected into corpus.html by `cmd/dev -- gen-conformance`, compiled by
// `gen-views` like any other view file, and driven case by case here.
//
// A whitebox test, because what it drives is `corpus_inline_update` — a
// package-private function the generated wrapper composes, and the thing that
// actually has to agree with the interpreter.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/tscript/conformance",
  "moonbitlang/core/debug",
}

// Warning 73 (`unnecessary_annotation`) is off here because this package holds
// GENERATED modules, and `gen` writes `@anode.`/`@tutuca.` qualifiers on
// purpose: the same emitter writes into a CONSUMER's package, whose imports it
// does not control, and a bare name there is one collision away from not
// compiling. The qualifier is redundant in this repo and load-bearing outside
// it, so the lint is the thing that gives way.

warnings = "-73"
