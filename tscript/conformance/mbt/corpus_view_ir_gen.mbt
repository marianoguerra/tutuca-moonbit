    name~,
    views~,
    initial~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match corpus_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
