///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn corpus_views() -> Map[String, @anode.View] {
  { "main": corpus_main_view_ir() }
}

///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn corpus_inline_update(
  s : CorpusState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[CorpusState] {
  match msg {
    Input("case0", _args) => {
      let s = { ..s, count: 5 }
      Next(s)
    }
    Input("case1", args) => {
      guard args.get(0) is Some(Num(d)) else { return Unchanged }
      let s = { ..s, count: (s.count.to_double() + d).to_int() }
      Next(s)
    }
    Input("case2", args) => {
      guard args.get(0) is Some(Str(_)) else { return Unchanged }
      guard args.get(1) is Some(Str(b)) else { return Unchanged }
      let s = { ..s, name: b }
      Next(s)
    }
    Input("case4", _args) => {
      let s = { ..s, count: 1 }
      let s = { ..s, count: (s.count.to_double() + 1.0).to_int() }
      let s = { ..s, count: (s.count.to_double() + 1.0).to_int() }
      Next(s)
    }
    Input("case5", _args) => {
      let s = { ..s, count: 2.7.to_int() }
      Next(s)
    }
    Input("case6", _args) => {
      let s = { ..s, ratio: 2.7 }
      Next(s)
    }
    Input("case8", _args) => {
      let d0 = 0.0
      guard d0 != 0.0 else { return Unchanged }
      let s = { ..s, count: (1.0 / d0).to_int() }
      Next(s)
    }
    Input("case11", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => ctx.send("flash", [(Str("hi") : @tutuca.Value)]))
      let d0 = 0.0
      guard d0 != 0.0 else { return Unchanged }
      let s = { ..s, count: (1.0 / d0).to_int() }
      for f in effects {
        f()
      }
      Next(s)
    }
    Input("case18", _args) => {
      let s = { ..s, count: (10.0 - 3.0 - 2.0).to_int() }
      Next(s)
    }
    Input("case19", _args) => {
      let d0 = 3.0
      guard d0 != 0.0 else { return Unchanged }
      let s = { ..s, count: (s.count.to_double() + 1.0).to_int() % d0.to_int() }
      Next(s)
    }
    Input("case20", _args) => {
      let d0 = 4.0
      guard d0 != 0.0 else { return Unchanged }
      let s = { ..s, ratio: (s.count.to_double() + 5.0) / d0 }
      Next(s)
    }
    Input("case21", _args) => {
      let s = { ..s, name: s.name + "!" }
      Next(s)
    }
    Input("case22", _args) => {
      let s = {
        ..s,
        name: (Str(s.name) : @tutuca.Value).to_display_string() +
        " has " +
        (Num(s.items.length().to_double()) : @tutuca.Value).to_display_string(),
      }
      Next(s)
    }
    Input("case23", _args) => {
      let s = { ..s, name: if s.ok { "yes" } else { "no" } }
      Next(s)
    }
    Input("case24", _args) => {
      let s = if s.ok {
        let s = { ..s, count: 1 }
        s
      } else {
        let s = { ..s, count: 2 }
        s
      }
      Next(s)
    }
    Input("case25", _args) => {
      let s = { ..s, count: 7 }
      let s = if s.ok {
        let s = { ..s, count: 1 }
        s
      } else {
        s
      }
      Next(s)
    }
    Input("case26", args) => {
      guard args.get(0) is Some(Num(p)) else { return Unchanged }
      let s = {
        ..s,
        page: (if s.items.length().to_double() - 1.0 < 0.0 {
          0.0
        } else if p < 0.0 {
          0.0
        } else if p > s.items.length().to_double() - 1.0 {
          s.items.length().to_double() - 1.0
        } else {
          p
        }).to_int(),
      }
      Next(s)
    }
    Input("case27", _args) => {
      let s = {
        ..s,
        ok: ({
          let m : Map[String, @tutuca.Value] = Map([])
          for k, b in s.tags {
            m[k] = Bool(b)
          }
          (Map(m) : @tutuca.Value)
        })
        is Null ||
        @tutuca.size_of(
          {
            let m : Map[String, @tutuca.Value] = Map([])
            for k, b in s.tags {
              m[k] = Bool(b)
            }
            (Map(m) : @tutuca.Value)
          },
        )
        is Some(0),
      }
      Next(s)
    }
    Input("case28", _args) => {
      let s = {
        ..s,
        ok: match @tutuca.builtin("truthy?") {
          Some(b) =>
            (b.apply)([
              {
                let m : Map[String, @tutuca.Value] = Map([])
                for k, b in s.tags {
                  m[k] = Bool(b)
                }
                (Map(m) : @tutuca.Value)
              },
            ]).is_truthy()
          None => false
        },
      }
      Next(s)
    }
    Input("case30", _args) => {
      let s = { ..s, items: s.items + ["c"] }
      Next(s)
    }
    Input("case31", _args) => {
      guard 0 >= 0 && 0 <= s.items.length() else { return Unchanged }
      let s = {
        ..s,
        items: s.items[0:0].to_owned() + ["z"] + s.items[0:].to_owned(),
      }
      Next(s)
    }
    Input("case32", _args) => {
      guard 1 >= 0 && 1 < s.items.length() else { return Unchanged }
      let s = {
        ..s,
        items: {
          let a = s.items.copy()
          a[1] = "B"
          a
        },
      }
      Next(s)
    }
    Input("case33", _args) => {
      guard 0 >= 0 && 0 < s.items.length() else { return Unchanged }
      let s = {
        ..s,
        items: s.items[0:0].to_owned() + s.items[0 + 1:].to_owned(),
      }
      Next(s)
    }
    Input("case34", _args) => {
      guard 9 >= 0 && 9 < s.items.length() else { return Unchanged }
      let s = {
        ..s,
        items: s.items[0:9].to_owned() + s.items[9 + 1:].to_owned(),
      }
      Next(s)
    }
    Input("case35", _args) => {
      let s = {
        ..s,
        tags: {
          let m = s.tags.copy()
          m["x"] = true
          m
        },
      }
      let s = {
        ..s,
        tags: {
          let m = s.tags.copy()
          m["y"] = true
          m
        },
      }
      let s = {
        ..s,
        tags: {
          let m = s.tags.copy()
          m.remove("x")
          m
        },
      }
      let s = {
        ..s,
        tags: {
          let m = s.tags.copy()
          let k = "z"
          if m.get(k) is Some(true) {
            m.remove(k)
          } else {
            m[k] = true
          }
          m
        },
      }
      Next(s)
    }
    Input("case36", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => ctx.request("loadData", [], @tutuca.RequestOpts::new()))
      let s = { ..s, ok: true }
      effects.push(() => ctx.send("flash", [(Str(s.name) : @tutuca.Value)]))
      effects.push(() => ctx.stop_propagation())
      for f in effects {
        f()
      }
      Next(s)
    }
    Input("case37", args) => {
      guard args.get(0) is Some(Num(k)) else { return Unchanged }
      let effects : Array[() -> Unit] = []
      effects.push(() => ctx.bubble("rowPicked", [(Num(k) : @tutuca.Value)]))
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("resetTo", args) => {
      guard args.get(0) is Some(Num(n)) else { return Unchanged }
      let s = { ..s, count: n.to_int() }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// The Corpus component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `CorpusState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn corpus_component(
  name? : String = "Corpus",
  views? : Map[String, @anode.View] = corpus_views(),
  init? : CorpusState = CorpusState::zero(),
  common_style? : String = corpus_common_style,
  global_style? : String = corpus_global_style,
  update? : (CorpusState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    CorpusState,
  ],
  compute? : (CorpusMethod) -> ((CorpusState, Array[@tutuca.Value]) -> @tutuca.Value)?,
  swap? : (CorpusInput) -> ((CorpusState, Array[@tutuca.Value], &@tutuca.Ctx) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match corpus_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    compute=match compute {
      Some(f) =>
        @component.build_bucket(
          ([Long] : Array[CorpusMethod]),
          CorpusMethod::name,
          f,
        )
      None => Map([])
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          (
            [
              Case0,
              Case1,
              Case10,
              Case11,
              Case12,
              Case13,
              Case14,
              Case15,
              Case16,
              Case17,
              Case18,
              Case19,
              Case2,
              Case20,
              Case21,
              Case22,
              Case23,
              Case24,
              Case25,
              Case26,
              Case27,
              Case28,
              Case29,
              Case3,
              Case30,
              Case31,
              Case32,
              Case33,
              Case34,
              Case35,
              Case36,
              Case37,
              Case39,
              Case4,
              Case5,
              Case6,
              Case7,
              Case8,
              Case9,
            ] : Array[CorpusInput]),
          CorpusInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
  )
}
