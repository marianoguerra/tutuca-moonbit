///|
/// The Corpus component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `CorpusState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn corpus_component(
  name? : String = "Corpus",
  views? : Map[String, @anode.View] = corpus_views(),
  init? : CorpusState = CorpusState::zero(),
  common_style? : String = corpus_common_style,
  global_style? : String = corpus_global_style,
  update? : (CorpusState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    CorpusState,
  ],
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match corpus_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    compute=corpus_inline_compute(),
    slots~,
    slot_args~,
    provide~,
    lookup~,
  )
}
