///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn corpus_views() -> Map[String, @anode.View] {
  { "main": corpus_main_view_ir() }
}

///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn corpus_inline_update(
  s : CorpusState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[CorpusState] {
  match msg {
    Input("case0", args) => {
      guard args.get(0) is Some(f) else { return Unchanged }
      let s = {
        ..s,
        name: f.field_opt("name").unwrap_or(Null).to_display_string(),
      }
      Next(s)
    }
    Input("case1", args) => {
      guard args.get(0) is Some(f) else { return Unchanged }
      let s = {
        ..s,
        name: f
        .field_opt("meta")
        .unwrap_or(Null)
        .field_opt("kind")
        .unwrap_or(Null)
        .to_display_string(),
      }
      Next(s)
    }
    Input("case2", args) => {
      guard args.get(0) is Some(f) else { return Unchanged }
      let s = {
        ..s,
        name: f.field_opt("missing").unwrap_or(Null).to_display_string(),
      }
      Next(s)
    }
    Input("case3", args) => {
      guard args.get(0) is Some(f) else { return Unchanged }
      let s = {
        ..s,
        name: f.field_opt("name").unwrap_or(Null).to_display_string(),
      }
      Next(s)
    }
    Input("case4", _args) => {
      let s = { ..s, count: 5 }
      Next(s)
    }
    Input("case5", args) => {
      guard args.get(0) is Some(Num(d)) else { return Unchanged }
      let s = { ..s, count: (s.count.to_double() + d).to_int() }
      Next(s)
    }
    Input("case6", args) => {
      guard args.get(0) is Some(Str(_)) else { return Unchanged }
      guard args.get(1) is Some(Str(b)) else { return Unchanged }
      let s = { ..s, name: b }
      Next(s)
    }
    Input("case8", _args) => {
      let s = { ..s, count: 1 }
      let s = { ..s, count: (s.count.to_double() + 1.0).to_int() }
      let s = { ..s, count: (s.count.to_double() + 1.0).to_int() }
      Next(s)
    }
    Input("case9", _args) => {
      let s = { ..s, count: 2.7.to_int() }
      Next(s)
    }
    Input("case10", _args) => {
      let s = { ..s, ratio: 2.7 }
      Next(s)
    }
    Input("case12", _args) => {
      let d0 = 0.0
      guard d0 != 0.0 else { return Unchanged }
      let s = { ..s, count: (1.0 / d0).to_int() }
      Next(s)
    }
    Input("case15", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => ctx.send("flash", [(Str("hi") : @tutuca.Value)]))
      let d0 = 0.0
      guard d0 != 0.0 else { return Unchanged }
      let s = { ..s, count: (1.0 / d0).to_int() }
      for f in effects {
        f()
      }
      Next(s)
    }
    Input("case19", _args) => {
      let cur0 : CorpusLabel = { text: "", done: false }
      let cur0 = { ..cur0, text: "z" }
      let cur0 = { ..cur0, done: true }
      let s = { ..s, labels: s.labels + [cur0] }
      Next(s)
    }
    Input("case20", _args) => {
      let cur1 : CorpusLabel = { text: "", done: false }
      let s = { ..s, labels: s.labels + [cur1] }
      Next(s)
    }
    Input("case21", _args) => {
      let cur2 : CorpusLabel = { text: "", done: false }
      let cur2 = { ..cur2, text: "p" }
      let s = { ..s, labels: s.labels + [cur2] }
      let cur3 : CorpusLabel = { text: "", done: false }
      let cur3 = { ..cur3, text: "q" }
      let s = { ..s, labels: s.labels + [cur3] }
      Next(s)
    }
    Input("case22", _args) => {
      let cur4 : Array[String] = []
      let cur4 = cur4 + ["p"]
      let cur4 = cur4 + ["q"]
      let s = { ..s, items: cur4 }
      Next(s)
    }
    Input("case27", _args) => {
      let s = { ..s, count: (10.0 - 3.0 - 2.0).to_int() }
      Next(s)
    }
    Input("case28", _args) => {
      let d0 = 3.0
      guard d0 != 0.0 else { return Unchanged }
      let s = { ..s, count: (s.count.to_double() + 1.0).to_int() % d0.to_int() }
      Next(s)
    }
    Input("case29", _args) => {
      let d0 = 4.0
      guard d0 != 0.0 else { return Unchanged }
      let s = { ..s, ratio: (s.count.to_double() + 5.0) / d0 }
      Next(s)
    }
    Input("case30", _args) => {
      let s = { ..s, name: s.name + "!" }
      Next(s)
    }
    Input("case31", _args) => {
      let s = {
        ..s,
        name: (Str(s.name) : @tutuca.Value).to_display_string() +
        " has " +
        (Num(s.items.length().to_double()) : @tutuca.Value).to_display_string(),
      }
      Next(s)
    }
    Input("case32", _args) => {
      let s = { ..s, name: if s.ok { "yes" } else { "no" } }
      Next(s)
    }
    Input("case33", _args) => {
      let s = if s.ok {
        let s = { ..s, count: 1 }
        s
      } else {
        let s = { ..s, count: 2 }
        s
      }
      Next(s)
    }
    Input("case34", _args) => {
      let s = { ..s, count: 7 }
      let s = if s.ok {
        let s = { ..s, count: 1 }
        s
      } else {
        s
      }
      Next(s)
    }
    Input("case35", args) => {
      guard args.get(0) is Some(Num(p)) else { return Unchanged }
      let s = {
        ..s,
        page: (if s.items.length().to_double() - 1.0 < 0.0 {
          0.0
        } else if p < 0.0 {
          0.0
        } else if p > s.items.length().to_double() - 1.0 {
          s.items.length().to_double() - 1.0
        } else {
          p
        }).to_int(),
      }
      Next(s)
    }
    Input("case36", _args) => {
      let s = {
        ..s,
        ok: ({
          let m : Map[String, @tutuca.Value] = Map([])
          for k, b in s.tags {
            m[k] = Bool(b)
          }
          (Map(m) : @tutuca.Value)
        })
        is Null ||
        @tutuca.size_of(
          {
            let m : Map[String, @tutuca.Value] = Map([])
            for k, b in s.tags {
              m[k] = Bool(b)
            }
            (Map(m) : @tutuca.Value)
          },
        )
        is Some(0),
      }
      Next(s)
    }
    Input("case37", _args) => {
      let s = {
        ..s,
        ok: match @tutuca.builtin("truthy?") {
          Some(b) =>
            (b.apply)([
              {
                let m : Map[String, @tutuca.Value] = Map([])
                for k, b in s.tags {
                  m[k] = Bool(b)
                }
                (Map(m) : @tutuca.Value)
              },
            ]).is_truthy()
          None => false
        },
      }
      Next(s)
    }
    Input("case39", _args) => {
      let s = { ..s, items: s.items + ["c"] }
      Next(s)
    }
    Input("case40", _args) => {
      guard 0 >= 0 && 0 <= s.items.length() else { return Unchanged }
      let s = {
        ..s,
        items: s.items[0:0].to_owned() + ["z"] + s.items[0:].to_owned(),
      }
      Next(s)
    }
    Input("case41", _args) => {
      guard 1 >= 0 && 1 < s.items.length() else { return Unchanged }
      let s = {
        ..s,
        items: {
          let a = s.items.copy()
          a[1] = "B"
          a
        },
      }
      Next(s)
    }
    Input("case42", _args) => {
      guard 0 >= 0 && 0 < s.items.length() else { return Unchanged }
      let s = {
        ..s,
        items: s.items[0:0].to_owned() + s.items[0 + 1:].to_owned(),
      }
      Next(s)
    }
    Input("case43", _args) => {
      guard 9 >= 0 && 9 < s.items.length() else { return Unchanged }
      let s = {
        ..s,
        items: s.items[0:9].to_owned() + s.items[9 + 1:].to_owned(),
      }
      Next(s)
    }
    Input("case44", _args) => {
      let s = {
        ..s,
        tags: {
          let m = s.tags.copy()
          m["x"] = true
          m
        },
      }
      let s = {
        ..s,
        tags: {
          let m = s.tags.copy()
          m["y"] = true
          m
        },
      }
      let s = {
        ..s,
        tags: {
          let m = s.tags.copy()
          m.remove("x")
          m
        },
      }
      let s = {
        ..s,
        tags: {
          let m = s.tags.copy()
          let k = "z"
          if m.get(k) is Some(true) {
            m.remove(k)
          } else {
            m[k] = true
          }
          m
        },
      }
      Next(s)
    }
    Input("case45", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => ctx.request("loadData", [], @tutuca.RequestOpts::new()))
      let s = { ..s, ok: true }
      effects.push(() => ctx.send("flash", [(Str(s.name) : @tutuca.Value)]))
      effects.push(() => ctx.stop_propagation())
      for f in effects {
        f()
      }
      Next(s)
    }
    Input("case46", args) => {
      guard args.get(0) is Some(Num(k)) else { return Unchanged }
