///|
/// `pred hasSome` from the `<script type="tutuca/script">` block. GENERATED — edit
/// the block, not this.
fn corpus_compute_hasSome(
  s : CorpusState,
  _args : Array[@tutuca.Value],
) -> @tutuca.Value {
  (Bool(s.count.to_double() > 0.0) : @tutuca.Value)
}

///|
