import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

struct Entry {
  id : String
  root : String
  title : String
  summary : String
  learn : String
} derive(FromJson, ToJson)

async fn main {
  let check = @env.args().contains("--check")
  let catalog : Array[Entry] = @json.from_json(@json.parse(@fs.read_file("showcase/catalog.json").text()))
  let cards : Array[Json] = []
  let starters : Map[String, Json] = Map([])
  let stories : Array[String] = []
  let landing : Array[String] = []
  let tutorial : Array[String] = []
  let card_tutorial : Array[String] = []
  let skill : Array[String] = []
  let services = @fs.read_file("showcase/services.mbt").text()
  for entry in catalog {
    let source = @fs.read_file("showcase/\{entry.id}.tutu").text()
    guard source.has_prefix("spec:") else { fail("\{entry.id}: start the source with spec:") }
    let prefix = entry.id.replace(old="-", new="_")
    let number = tutorial.length() + 1
    let practice = match entry.id {
      "quantity-picker" => "Increase the quantity to ten, then try both controls at their limits. The handlers enforce the bounds even when a message comes from somewhere other than a button. The total is derived from quantity and unit price."
      "notification-preferences" => "Enable email updates and apply an empty address. Enter an address, apply it, then edit and reset the draft. Draft fields and saved fields have distinct jobs; hiding an input does not discard its value."
      "task-list" => "Add two tasks, complete one, and switch filters. Remove the completed task. Each child keeps its identity when the visible list changes; the parent owns collection membership and the completion index."
      "contact-directory" => "Go to the second page, search for Alex Chen, and edit the selected name to Avery. The selection keeps its key even when the edited contact no longer matches the search. The host filters before slicing a page."
      _ => "Edit a document, switch to the other document, and switch back. Preview the Markdown, simulate a failed save, then retry. Drafts stay with their document. Load and save use an in-memory demo service; restarting the example resets that storage."
    }
    let q = (s : String) => Json::string(s).stringify()
    stories.push("@sb.Story::new(id=\{q(entry.id)}, title=\{q(entry.title)}, section=\"Learn\", description=\{q(entry.summary)}, module_=@showcase.\{prefix}_module(), root=\{q(entry.root)}),")
    let embed = if entry.id == "contact-directory" {
      "<mb-playground src=\"./site/examples/\{entry.id}.mbt\" view=\"./site/examples/\{entry.id}.tutu\"></mb-playground>"
    } else {
      "<mb-card src=\"./site/cards/\{entry.id}.tutu\" margaui codemirror></mb-card>"
    }
    landing.push("<section id=\"\{entry.id}\"><h2>\{number}. \{entry.title}</h2><p>\{entry.summary} \{entry.learn}</p>\{embed}<p><a href=\"./tutucard/?example=\{entry.id}\">Open card playground</a> · <a href=\"./storybook/?story=\{entry.id}\">Inspect in Storybook</a></p></section>")
    let example_source = source.split("\nfixtures:").to_array()[0].to_owned().trim_end().to_owned()
    tutorial.push("## \{number}. \{entry.title}\n\n\{entry.summary} \{entry.learn}\n\n\{practice}\n\n```tutu\n\{example_source}\n```\n\n[Open the card](https://marianoguerra.github.io/tutuca-moonbit/tutucard/?example=\{entry.id}) · [Compiled assembly](https://github.com/marianoguerra/tutuca-moonbit/blob/main/showcase/\{entry.id}.mbt)\n")
    card_tutorial.push("<section id=\"\{entry.id}\"><h2>Step \{number}: \{entry.title}</h2><p>\{entry.learn}</p><p>\{practice}</p><mb-card src=\"./site/cards/\{entry.id}.tutu\" margaui codemirror></mb-card></section>")
    skill.push("- **\{entry.title}** — \{entry.learn} Read [the shared source](examples/\{entry.id}.tutu). \{practice}")
    let assembly = @fs.read_file("showcase/\{entry.id}.mbt").text()
    let code = "fn build() -> @component.ModuleDef {\n  \{prefix}_module()\n}\n\n" + assembly +
      (if entry.id == "contact-directory" || entry.id == "document-workspace" { "\n" + services } else { "" })
    cards.push({ "name": entry.id, "title": entry.title, "group": "Learn", "source": source })
    starters[entry.title] = { "code": code, "view": source, "group": "Learn" }
    write("playground/site/cards/\{entry.id}.tutu", source, check~)
    write("playground/site/examples/\{entry.id}.tutu", source, check~)
    write("playground/site/examples/\{entry.id}.mbt", code, check~)
    write("skill/tutuca/examples/\{entry.id}.tutu", source, check~)
    if entry.id == "quantity-picker" {
      write("storybook/template/page/quantity-picker.tutu", source, check~)
      write("storybook/template/page/quantity-picker.mbt", assembly, check~)
    }
  }
  write("storybook/examples/showcase_gen.mbt", "// GENERATED by gen-showcase from showcase/catalog.json.\n///|\nfn primary_stories() -> Array[@sb.Story] {\n[\n" + stories.join("\n") + "\n]\n}\n", check~)
  let page = @fs.read_file("showcase/landing.html").text()
  write("playground/site/index.html", page.replace(old="<!-- examples -->", new=landing.join("\n")), check~)
  let card_page = @fs.read_file("showcase/tutorial.html").text()
  write("playground/site/cards.html", card_page.replace(old="<!-- examples -->", new=card_tutorial.join("\n")), check~)
  write("docs/tutorial.mbt.md", "# Build practical components with Tutuca\n\nFollow these five examples in order. Each keeps its spec, logic and views together in a `.tutu` file. The same sources run in the card playground and supply the compiled examples. Their interaction tests cover both paths. Start in the card editor; read the MoonBit assembly when you need host integration or an ahead-of-time backend adapter.\n\nState is one immutable value tree. Views read it; handlers update it; messages and intents connect components by path. No external services are needed for this tutorial.\n\n" + tutorial.join("\n") + "\n## Test and integrate\n\nEach shared source carries `tests:` scenarios. Run them in the card playground's Tests pane. Compiled components use `moon test` with the component harness; this repository runs their tests in `showcase/`. Quantity picker and notification preferences need only module assembly. The other compiled examples include adapters for script declarations the ahead-of-time backend refuses; the adjacent `.mbt` files implement those adapters once. The directory's host handler filters and paginates; the workspace's host owns demo storage.\n\nFor a project of your own, keep component behavior in `.tutu`, register host services on its module, and mount it with your chosen browser adapter. [First principles](first_principles.mbt.md) explains the runtime; [the authoring reference](../skill/tutuca/SKILL.md) covers the full language.\n", check~)
  write("skill/tutuca/examples.md", "# Practical component progression\n\nUse these examples in order when learning, and choose the smallest relevant one when implementing a component. These are shared sources, not separate skill editions.\n\n" + skill.join("\n\n") + "\n\nOn the landing page use Tutucard when MoonBit only assembles or mounts the component. Use the MoonBit playground when its displayed code supplies behavior the card source cannot express. Put explanations outside editors; the first visible line should be code. Keep focused language recipes in the reference section.\n\nThe directory needs the `contact_page` host handler. The workspace needs `load_document` and `save_document` handlers; the hosted playground provides demo implementations. In a standalone host, register your own handlers and test success, failure and route exhaustion.\n", check~)
  write("tutucard/web/showcase.js", "export const SHOWCASE = " + Json::array(cards).stringify(indent=2) + ";\n", check~)
  write("playground/web/showcase.js", "window.SHOWCASE = " + Json::object(starters).stringify(indent=2) + ";\n", check~)
  println(if check { "Shared example assets match their sources." } else { "Generated shared example assets." })
}

async fn write(path : String, source : String, check~ : Bool) -> Unit {
  let source = if path.has_suffix("_gen.mbt") {
    let temp = @fs.tmpdir(prefix="showcase-format-")
    defer @fs.rmdir(temp, recursive=true)
    @fs.write_file(temp + "/source.mbt", source, create_mode=CreateOrTruncate)
    let result = @shell.Cmd("moonfmt", [temp + "/source.mbt"]).output()
    result.check()
    result.stdout()
  } else { source }
  if check {
    guard @fs.read_file(path).text() == source else { fail("\{path}: run gen-showcase to refresh this asset") }
  } else {
    let parts = path.split("/").to_array()
    let parent = parts[:parts.length() - 1].map(p => p.to_owned()).join("/")
    if !@fs.exists(parent) { @fs.mkdir(parent, recursive=true) }
    @fs.write_file(path, source, create_mode=CreateOrTruncate)
  }
}
