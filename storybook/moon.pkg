// Storybook — the gallery's data model: what a story IS (a ModuleDef, a root
// component, seed args, and the metadata the sidebar shows), how stories group
// into sections, and how to project a module's own `examples` into stories.
//
// Pure data: no app, no vdom, no DOM. The interactive gallery is
// `storybook/ui`, and the browser host that mounts it is `storybook/ui/wasm`.
// This package holds no story list of its own — the story SET belongs to
// whoever owns the gallery. This repo's own 52 stories live in
// `storybook/examples`, which does not ship.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/component",
}
