///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn composability_views() -> Map[String, @anode.View] {
  { "main": composability_main_view_ir() }
}

///|
/// The Composability component: `component()` with everything the view file already
/// states filled in — its name, its compiled views, its styles, its schema
/// and its direct codec. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn composability_component(
  name? : String = "Composability",
  views? : Map[String, @anode.View] = composability_views(),
  init? : ComposabilityState = ComposabilityState::zero(),
  common_style? : String = composability_common_style,
  global_style? : String = composability_global_style,
  update? : (ComposabilityState, @component.Dispatch, &@tutuca.Ctx) -> ComposabilityState?,
  swap? : (ComposabilityInput) -> ((
    ComposabilityState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  specs? : Map[String, @component.FieldSpec] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    swap=match swap {
      Some(f) => composability_swap(f)
      None => Map([])
    },
    specs~,
    provide~,
    lookup~,
  )
}
