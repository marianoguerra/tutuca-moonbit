// Ports of the JS docs examples (docs/examples/*.js in the tutuca repo), one
// file per example. Each exports a `<name>_module() -> @component.ModuleDef`
// — the MoonBit analogue of the JS module's getComponents / getMacros /
// getRequestHandlers / getExamples exports.
//
// Target-agnostic on purpose: the modules are plain values, so the same
// definition drives the headless tests here, the storybook gallery
// (../ + ../ui, hosted by demo/storybook_wasm) and the CLI (`tutuca render` /
// `tutuca lint` via plan_with_module).
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/storybook/inspector",
  // the story model + the section grouping; stories.mbt is this repo's own
  // story SET over it, which is why the set lives here and the model ships
  "marianoguerra/tutuca/storybook" @sb,
  "moonbitlang/core/cmp",
  "moonbitlang/core/string",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
}

// The headless harness (@harness) mounts a module as a live app on the
// in-memory DOM and dispatches real events through it.
// @viewgen here (never the other way round): the view-corpus sweep drives the
// generator over every view in this corpus. Neither cli/ nor viewgen/ depends
// on the storybook packages, which is what lets them stay repo demos and be
// excluded from the published archive.
import {
  "marianoguerra/tutuca/testing/harness",
  // the gallery itself: gallery_test.mbt mounts this corpus through it. The
  // dependency points this way because `storybook/ui` ships and this package
  // does not — a `for "test"` block survives `moon publish`, so the shipping
  // package may not reach in here.
  "marianoguerra/tutuca/storybook/ui" @sbui,
  // the standard panel layer, so the corpus test drives the whole gallery —
  // tabs, recorder and fuzz runs included
  "marianoguerra/tutuca/storybook/ui/panels",
  // `MemFiles`: the trace round-trip test downloads a recording and loads it
  // back, and the seam is what lets that happen with no browser in the room.
  "marianoguerra/tutuca/files",
  "marianoguerra/tutuca/app",
  "marianoguerra/tutuca/vdom",
  "marianoguerra/tutuca/render",
  "marianoguerra/tutuca/vdom/memdom",
  "marianoguerra/tutuca/viewgen",
  "marianoguerra/tutuca/viewfile",
  "moonbitlang/core/test",
  // The spec-derived generators, for `svg_more_property_test.mbt`: a
  // component's own `<script type="tutuca/spec">` block, parsed at test time,
  // is what says which states and which messages exist. Nothing is generated
  // from a MoonBit type here, because the declaration is not one.
  "marianoguerra/tutuca/statedef",
  "marianoguerra/tutuca/statedef/arb",
  // The driver the storybook's Fuzz tab runs, so the property here and the run
  // a reader watches there are the same run.
  "marianoguerra/tutuca/testing/fuzz",
  "moonbitlang/quickcheck" @qc,
  "moonbitlang/quickcheck/gen",
} for "test"

// Warning 73 (`unnecessary_annotation`) is off here because this package holds
// GENERATED modules, and `gen` writes `@anode.`/`@tutuca.` qualifiers on
// purpose: the same emitter writes into a CONSUMER's package, whose imports it
// does not control, and a bare name there is one collision away from not
// compiling. The qualifier is redundant in this repo and load-bearing outside
// it, so the lint is the thing that gives way.

warnings = "-73"
