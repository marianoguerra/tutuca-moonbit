///|
/// The compiled `main` view.
fn json_array_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "section",
      [
        @anode.attr(
          "class", "join join-vertical gap-3 pl-3 border-l-1 border-l-neutral-500 json-array",
        ),
      ],
      [
        @anode.h(
          "button",
          [
            @anode.attr("class", "btn btn-sm btn-soft btn-primary add"),
            @anode.eid(0),
          ],
          [@anode.text("+")],
        ),
        @anode.text(" "),
        @anode.h("div", [@anode.attr("class", "join join-vertical gap-3")], [
          @anode.each(
            1,
            @tutuca.Expr::field("items"),
            @anode.h(
              "div",
              [
                @anode.attr(
                  "class", "join gap-3 justify-between items-center group entry",
                ),
                @anode.attr("draggable", "true"),
                @anode.attr("data-dragtype", "json-list-item"),
                @anode.attr("data-droptarget", "json-list-item"),
                @anode.eid(2),
              ],
              [
                @anode.render_it(0),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr(
                      "class", "btn btn-sm btn-soft btn-circle btn-error font-mono opacity-20 group-hover:opacity-100 rm",
                    ),
                    @anode.eid(1),
                  ],
                  [@anode.text("x")],
                ),
              ],
            ),
          ),
        ]),
      ],
    ),
    [
      [@anode.on("click", @tutuca.Expr::name("addItem"))],
      [
        @anode.on(
          "click",
          @anode.const_null(),
          action=@anode.call_property_action("items", "removeAt", [
            @tutuca.Expr::bind("key"),
          ]),
        ),
      ],
      [
        @anode.on("drop", @tutuca.Expr::name("onDropOnItem"), args=[
          @tutuca.Expr::bind("key"),
          @tutuca.Expr::event_path(["dragInfo"]),
        ]),
      ],
    ],
    style="[data-draggingover=\"json-list-item\"] {\n  border-top: 4rem solid transparent;\n  transition: 0.15s border-top ease;\n}",
  )
}

