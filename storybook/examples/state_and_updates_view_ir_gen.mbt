///|
/// The compiled `main` view.
fn conditional_attributes_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("section", [], [
      @anode.h(
        "button",
        [
          @anode.if_attr(
            "class",
            @tutuca.Expr::field("is_active"),
            then_val=@anode.const_str("btn btn-success"),
            else_val=@anode.const_str("btn btn-ghost"),
          ),
          @anode.if_attr(
            "title",
            @tutuca.Expr::field("is_active"),
            then_val=@anode.const_str("Click to disable"),
            else_val=@anode.const_str("Click to enable"),
          ),
          @anode.eid(0),
        ],
        [
          @anode.show(
            @tutuca.Expr::field("is_active"),
            @anode.h("span", [@anode.attr("class", "on")], [
              @anode.text("Enabled"),
            ]),
          ),
          @anode.text(" "),
          @anode.hide(
            @tutuca.Expr::field("is_active"),
            @anode.h("span", [@anode.attr("class", "off")], [
              @anode.text("Disabled"),
            ]),
          ),
        ],
      ),
    ]),
    [
      [
        @anode.on(
          "click",
          @anode.const_null(),
          action=@anode.set_property_action(
            "is_active",
            @tutuca.Expr::app("not", [@tutuca.Expr::field("is_active")]),
          ),
        ),
      ],
    ],
  )
}

