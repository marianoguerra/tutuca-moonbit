fn conditional_attributes_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("section", [], [
      @anode.h(
        "button",
        [
          @anode.if_attr(
            "class",
            Field("isActive"),
            then_val=@anode.const_str("btn btn-success"),
            else_val=@anode.const_str("btn btn-ghost"),
          ),
          @anode.if_attr(
            "title",
            Field("isActive"),
            then_val=@anode.const_str("Click to disable"),
            else_val=@anode.const_str("Click to enable"),
          ),
          @anode.eid(0),
        ],
        [
          @anode.show(
            Field("isActive"),
            @anode.h("span", [@anode.attr("class", "on")], [
              @anode.text("Enabled"),
            ]),
          ),
          @anode.text(" "),
          @anode.hide(
            Field("isActive"),
            @anode.h("span", [@anode.attr("class", "off")], [
              @anode.text("Disabled"),
            ]),
          ),
        ],
      ),
    ]),
    [[@anode.on("click", HandlerName(name="toggleIsActive", ns=Input))]],
  )
}

