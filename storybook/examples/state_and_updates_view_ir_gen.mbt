///|
/// The compiled `main` view.
fn show_hide_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("section", [@anode.attr("class", "flex flex-col gap-2")], [
      @anode.h(
        "button",
        [@anode.attr("class", "btn btn-primary toggle-btn"), @anode.eid(0)],
        [@anode.dyn_text(@tutuca.Expr::method_("label"), id=0)],
      ),
      @anode.text(" "),
      @anode.show(
        @tutuca.Expr::field("is_open"),
        @anode.h("div", [@anode.attr("class", "card p-3 border details")], [
          @anode.h("p", [], [
            @anode.text("Details panel — only visible when "),
            @anode.h("code", [], [@anode.text("isOpen")]),
            @anode.text(" is true."),
          ]),
          @anode.text(" "),
          @anode.h(
            "button",
            [@anode.attr("class", "btn btn-sm bump"), @anode.eid(1)],
            [@anode.text("Click me")],
          ),
          @anode.text(" "),
          @anode.h("p", [], [
            @anode.text("Clicked "),
            @anode.dyn_text(@tutuca.Expr::field("count"), id=1),
            @anode.text(" times."),
          ]),
        ]),
      ),
      @anode.text(" "),
      @anode.hide(
        @tutuca.Expr::field("is_open"),
        @anode.h("p", [@anode.attr("class", "text-sm opacity-60 hint")], [
          @anode.text("(details are hidden)"),
        ]),
      ),
      @anode.text(" "),
      @anode.h("p", [@anode.attr("class", "peek")], [
        @anode.text("Count, only when open: "),
        @anode.show(
          @tutuca.Expr::field("is_open"),
          @anode.dyn_text(@tutuca.Expr::field("count"), id=2),
          id=3,
        ),
      ]),
    ]),
    [
      [
        @anode.on(
          "click",
          @anode.const_null(),
          action=@anode.set_property_action(
            "is_open",
            @tutuca.Expr::app("not", [@tutuca.Expr::field("is_open")]),
          ),
        ),
      ],
      [@anode.on("click", @tutuca.Expr::name("inc_count"))],
    ],
  )
}

