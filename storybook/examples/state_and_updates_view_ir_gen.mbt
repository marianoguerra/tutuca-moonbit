///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn show_hide_inline_update(
  s : ShowHideState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[ShowHideState] {
  match msg {
    Receive("inc_count", _args) => {
      let s = { ..s, count: (s.count.to_double() + 1.0).to_int(), }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [{ field: "count", domain: DCompare(op=DGe, rhs=DLit(0)), }],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="inc_count",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

