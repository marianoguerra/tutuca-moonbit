///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn root_component(
  name? : String = "Root",
  views? : Map[String, @anode.View] = root_views(),
  init? : RootState = RootState::zero(),
  common_style? : String = root_common_style,
  global_style? : String = root_global_style,
  update? : (RootState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    RootState,
  ],
  compute? : (RootMethod) -> ((RootState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value)?,
  when? : (RootWhen) -> ((
    RootState,
    @tutuca.Value,
    @tutuca.Value,
    @tutuca.Value,
    &@tutuca.Stack,
  ) -> Bool)?,
  enrich? : (RootEnrich) -> ((
    RootState,
    Map[String, @tutuca.Value],
    @tutuca.Value,
    @tutuca.Value,
    @tutuca.Value,
    &@tutuca.Stack,
  ) -> Unit)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match root_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    compute=match compute {
      Some(f) =>
        @component.build_bucket(
          ([HasActiveFilters] : Array[RootMethod]),
          RootMethod::name,
          f,
        )
      None => Map([])
    },
    when=match when {
      Some(f) =>
        @component.build_bucket(
          ([FilterEntry] : Array[RootWhen]),
          RootWhen::name,
          f,
        )
      None => Map([])
    },
    enrich=match enrich {
      Some(f) =>
        @component.build_bucket(
          ([EnrichCategoryBindings, EnrichRoleBindings] : Array[RootEnrich]),
          RootEnrich::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=alt_url_spec_source,
