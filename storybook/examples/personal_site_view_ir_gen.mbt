pub fn root_component(
  name? : String = "Root",
  views? : Map[String, @anode.View] = root_views(),
  initial? : RootState = RootState::zero(),
  common_style? : String = root_common_style,
  global_style? : String = root_global_style,
  update? : (RootState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    RootState,
  ],
  compute? : (RootCompute) -> ((RootState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value)?,
  when? : (RootWhen) -> ((
    RootState,
    @tutuca.Value,
    @tutuca.Value,
    @tutuca.Value,
    &@tutuca.Stack,
  ) -> Bool)?,
  enrich? : (RootEnrich) -> ((
    RootState,
    Map[String, @tutuca.Value],
    @tutuca.Value,
    @tutuca.Value,
    @tutuca.Value,
    &@tutuca.Stack,
  ) -> Unit)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    initial~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match root_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
