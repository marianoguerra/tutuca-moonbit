          ([EnrichCategoryBindings, EnrichRoleBindings] : Array[RootEnrich]),
          RootEnrich::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=alt_url_spec_source,
