///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn root_inline_update(
  s : RootState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[RootState] {
  match msg {
    Receive("init", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "loadData",
          [],
          @tutuca.IntentOpts::new(
            route=[@tutuca.Leg::Lex],
            on_ok_name="loadDataOk",
          ),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// The Root component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `RootState` states them
/// through `@component.Fields`, and `component()` reads them off the
