spec:
  Greeting:
    field name :: String

  Page:
    field greeting :: Instance.of(Greeting)

  Entry:
    field title :: String
    field description :: String

  MultipleViews:
    field value :: Instance.of(Entry)

logic:
  Entry:
    /// Whether this entry matches a query, for a parent's `@when` filter.
    ///
    /// It used to be a `func` in the state block — the one thing that put
    /// behaviour in a block whose own header says it holds none. It is a
    /// callable, so it lives with the callables.
    ///
    /// No view of Entry calls it: a parent's `@when` does, holding Entry
    /// instances and knowing nothing of their fields. That is why the block says
    /// `for="Entry"` — this file declares four components, and a `.title` here
    /// has to mean exactly one of them.
    pred contains_text(q): ((it.title.lower()).contains(q.lower()) || (it.description.lower()).contains(q.lower()))

view:
  Greeting:
    p(class: "p-2 border rounded"):
      " Hello, "
      strong():
        @(it.name)
      "! "

  Page:
    section(class: "flex flex-col gap-2"):
      h2(class: "text-lg"):
        "Page header"
      " "
      render(it.greeting)
      " "
      p(class: "opacity-60"):
        "— end of page —"

  Entry:
    div(class: "card bg-base-100 shadow-sm"):
      div(class: "card-body"):
        h2(class: "card-title"):
          @(it.title)
        p():
          @(it.description)

  Entry.edit:
    div(class: "card bg-base-100 shadow-sm gap-3"):
      div(class: "card-body"):
        input(class: "input title", value: it.title, ~on_input: it.title := e.value)
        " "
        input(class: "input desc", value: it.description, ~on_input: it.description := e.value)

  MultipleViews:
    section(class: "flex flex-col gap-3"):
      render(it.value)
      " "
      render(it.value, ~as: "edit")
