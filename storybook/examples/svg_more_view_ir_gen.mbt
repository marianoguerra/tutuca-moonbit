///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn bar_chart_inline_update(
  s : BarChartState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[BarChartState] {
  match msg {
    Receive("addBar", _args) => {
      guard s.values.length().to_double() < 9.0 else {
        @tutuca.precondition_failed(
          handler="addBar",
          pred="hasRoom",
          sentence="nine bars is the cap, and there are already " +
            (Num(s.values.length().to_double()) : @tutuca.Value).to_display_string(),
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let d0 = 90.0
      guard d0 != 0.0 else { return Unchanged }
      let s : BarChartState = {
        values: s.values +
        [
          (
            Num(
              ((s.values.length().to_double() * 17.0 + 23.0).to_int() %
              d0.to_int()).to_double() +
              10.0,
            ) : @tutuca.Value),
        ],
      }
      guard s.values.length().to_double() > 0.0 else {
        @tutuca.invariant_failed(
          handler="addBar",
          pred="neverEmpty",
          sentence="the chart lost its last bar",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      Next(s)
    }
    Receive("removeBar", _args) => {
      guard s.values.length().to_double() > 1.0 else {
        @tutuca.precondition_failed(
          handler="removeBar",
          pred="hasSpare",
          sentence="one bar has to stay, or there is no chart left to look at",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let at = (s.values.length().to_double() - 1.0).to_int()
      guard at >= 0 && at < s.values.length() else { return Unchanged }
      let s : BarChartState = {
        values: s.values[0:at].to_owned() + s.values[at + 1:].to_owned(),
      }
      guard s.values.length().to_double() > 0.0 else {
        @tutuca.invariant_failed(
          handler="removeBar",
          pred="neverEmpty",
          sentence="the chart lost its last bar",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      Next(s)
    }
    _ => Unhandled
  }
}

