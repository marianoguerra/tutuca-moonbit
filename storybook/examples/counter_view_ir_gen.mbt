///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn counter_inline_update(
  s : CounterState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[CounterState] {
  match msg {
    Receive("inc", _args) => {
      let s : CounterState = { count: (s.count.to_double() + 1.0).to_int(), }
      Next(s)
    }
    Receive("dec", _args) => {
      let s : CounterState = { count: (s.count.to_double() - 1.0).to_int(), }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// `get magnitude` from the `<script type="tutuca/script">` block. GENERATED — edit
/// the block, not this.
fn counter_compute_magnitude(
  s : CounterState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Num(
      if s.count.to_double() < 0.0 {
        -s.count.to_double()
      } else {
        s.count.to_double()
      },
    ) : @tutuca.Value)
}

///|
fn counter_property_set_magnitude(
  s : CounterState,
  value : @tutuca.Value,
) -> @component.Update[CounterState] {
  match (Receive("magnitude", [value]) : @component.Dispatch) {
    Receive("magnitude", args) => {
      guard args.get(0) is Some(Num(value_)) else { return Unchanged }
      let s = if s.count.to_double() < 0.0 {
        let s : CounterState = { count: (-value_).to_int(), }
        s
      } else {
        let s : CounterState = { count: value_.to_int(), }
        s
      }
      Next(s)
    }
    _ => Unhandled
  }
}

