spec:
  StylesExample

  StylesExampleRoot:
    field value :: Instance.of(StylesExample)

view:
  style():
    padding: rem(0.75)
    border: px(1) solid currentColor
    border_radius: rem(0.5)
    class(common):
      color: yellow

  style(~global):
    class(styles_example_global_class):
      color: green

  StylesExample:
    style():
      class(mine):
        color: red
    section():
      p():
        "View: main"
      "\n"
      p(class: "mine"):
        "My Style"
      "\n"
      p(class: "common"):
        "Common Style"
      "\n"
      p(class: "styles-example-global-class"):
        "Global Style"

  StylesExample.one:
    section():
      p():
        "View: one"
      "\n"
      p(class: "mine"):
        "My Style"
      "\n"
      p(class: "common"):
        "Common Style"
      "\n"
      p(class: "styles-example-global-class"):
        "Global Style"

  StylesExample.two:
    style():
      class(mine):
        color: orange
        text_decoration: underline
    section():
      p():
        "View: two"
      "\n"
      p(class: "mine"):
        "My Style"
      "\n"
      p(class: "common"):
        "Common Style"
      "\n"
      p(class: "styles-example-global-class"):
        "Global Style"

  StylesExampleRoot:
    section(class: "flex flex-col gap-3"):
      render(it.value)
      " "
      render(it.value, ~as: "one")
      " "
      render(it.value, ~as: "two")
