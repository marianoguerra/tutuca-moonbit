/// callers treat as a no-op write — the same contract as the JSON path.
fn workspace_decode(f : Map[String, @tutuca.Value]) -> WorkspaceState? {
  let v_sheet = f.get("sheet").unwrap_or(Null)
  Some(WorkspaceState::{ sheet: v_sheet })
}

