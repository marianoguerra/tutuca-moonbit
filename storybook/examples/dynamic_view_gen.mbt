  f : (WorkspaceMethod) -> ((S, Array[@tutuca.Value]) -> S)?,
) -> Map[String, (S, Array[@tutuca.Value]) -> S] {
  let out : Map[String, (S, Array[@tutuca.Value]) -> S] = Map([])
  for m in ([SheetTitle] : Array[WorkspaceMethod]) {
    match f(m) {
      Some(h) => out[m.name()] = h
      None => ()
