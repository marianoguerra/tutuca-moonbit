        @tutuca.invariant_failed(
          handler="toggleView",
          pred="notFailedWhileLoading",
          sentence="the spinner is up and an error is already showing",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
