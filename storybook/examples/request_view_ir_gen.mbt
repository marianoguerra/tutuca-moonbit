    Receive("init", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "loadData",
          [],
          @tutuca.IntentOpts::new(
            route=[@tutuca.Leg::Lex],
            on_ok_name="loadDataOk",
            on_failed_name="loadDataFailed",
            on_unhandled_name="loadDataUnhandled",
          ),
        )
      })
      let s = { ..s, isLoading: true, }
      guard !s.isLoading ||
        (match @tutuca.builtin("null?") {
          Some(b) =>
            (b.apply)([
              match s.error {
                Some(x) => Str(x)
                None => Null
              },
            ]).is_truthy()
          None => false
        }) else {
        @tutuca.invariant_failed(
          handler="init",
          pred="notFailedWhileLoading",
          sentence="the spinner is up and an error is already showing",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [{ field: "view", domain: DOneOf([Str("main"), Str("edit")]), }],
          domain_fields,
