/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through: it is exactly what `with_value_stash` exists to rescue from
/// the JSON path, and this way it never enters one.
fn vw_memory_encode(s : VwMemoryState) -> Map[String, @tutuca.Value] {
  { "n": Num(s.n.to_double()), "m": Num(s.m.to_double()) }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
fn vw_memory_decode(f : Map[String, @tutuca.Value]) -> VwMemoryState? {
  guard f.get("n") is Some(Num(n_n)) else { return None }
  let v_n = n_n.to_int()
  guard f.get("m") is Some(Num(n_m)) else { return None }
  let v_m = n_m.to_int()
  Some(VwMemoryState::{ n: v_n, m: v_m })
}

///|
/// The state of the VwPicker component.
///
/// Declared as `interface vw-picker` in the state block. Adding a
/// field there adds it here, so a view that reads it type-checks and one
/// that reads a name this struct lacks fails generation.
priv struct VwPickerState {
  currentSection : String
  instructions : Array[@tutuca.Value]
  filter : String
} derive(ToJson, FromJson)

///|
/// The zero state: every field at its type's empty value.
///
/// WIT declares no defaults — a default is a value, not a type — so this
/// is type-directed, and `init` spreads it to name only what differs:
///
///   init={ ..VwPickerState::zero(), label: "Counter" }
fn VwPickerState::zero() -> VwPickerState {
  VwPickerState::{ currentSection: "", instructions: [], filter: "" }
}

///|
/// The zero state as component arguments — the default a ModuleDef
/// example takes when it sets nothing of its own.
pub fn vw_picker_zero_args() -> Map[String, @tutuca.Value] {
  match @tutuca.Value::from_json(ToJson::to_json(VwPickerState::zero())) {
    Map(m) => m
    _ => Map([])
  }
}

///|
/// Every field the VwPicker state declares — typed field names for tests and inspectors.
pub(all) enum VwPickerField {
  CurrentSection
  Instructions
  Filter
} derive(Eq, @debug.Debug)

///|
pub fn VwPickerField::name(self : VwPickerField) -> String {
  match self {
    CurrentSection => "currentSection"
    Instructions => "instructions"
    Filter => "filter"
  }
}

///|
/// The runtime kind this field carries. Declared, not inferred: the old
/// `FieldSpec::of_default` had to guess FInt from whether the seed value
/// happened to be integral.
pub fn VwPickerField::kind(self : VwPickerField) -> @component.FieldKind {
  match self {
    CurrentSection => @component.FText
    Instructions => @component.FList
    Filter => @component.FText
  }
}

///|
/// Every field, in declaration order.
pub let vw_picker_field_names : Array[String] = [
  "currentSection", "instructions", "filter",
]

///|
/// The `specs~` map for this component, derived from the schema.
///
/// Sets, ordered maps and child slots all encode to a plain Map or Null,
/// so the runtime cannot tell them apart from the init value alone. Every
/// other field's kind it infers correctly and is left to it.
pub fn vw_picker_specs() -> Map[String, @component.FieldSpec] {
  Map([])
}

///|
/// The structural fingerprint of this component's schema. Changes when
/// the SHAPE changes — a renamed or retyped field, a new message case —
/// and not when the block is merely reformatted.
pub let vw_picker_schema_fingerprint : String = "e5eda1d1115e0e30"

///|
/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through: it is exactly what `with_value_stash` exists to rescue from
/// the JSON path, and this way it never enters one.
fn vw_picker_encode(s : VwPickerState) -> Map[String, @tutuca.Value] {
  {
    "currentSection": Str(s.currentSection),
    "instructions": (List(s.instructions.map(x => x)) : @tutuca.Value),
    "filter": Str(s.filter),
  }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
fn vw_picker_decode(f : Map[String, @tutuca.Value]) -> VwPickerState? {
  guard f.get("currentSection") is Some(Str(v_currentSection)) else {
    return None
  }
  guard f.get("instructions") is Some(List(l_instructions)) else { return None }
  let v_instructions : Array[@tutuca.Value] = []
  for x in l_instructions {
    v_instructions.push(x)
  }
  guard f.get("filter") is Some(Str(v_filter)) else { return None }
  Some(VwPickerState::{
    currentSection: v_currentSection,
    instructions: v_instructions,
    filter: v_filter,
  })
}
