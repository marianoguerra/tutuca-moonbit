              @anode.attr("id", "t-features"),
              @anode.if_attr(
                "class",
                Predicate(pred=Equals, args=[
                  Field("tab"),
                  @anode.const_str("features"),
                ]),
                then_val=@anode.const_str("tab tab-active"),
                else_val=@anode.const_str("tab"),
              ),
              @anode.eid(1),
