          when_val=HandlerName(name="filterItem", ns=Alter),
        ),
      ]),
    ]),
    [
      [
        @anode.on("input", HandlerName(name="setQuery", ns=Input), args=[
          Name("value"),
        ]),
        @anode.on("keydown", HandlerName(name="resetQuery", ns=Input), modifiers=[
          "cancel",
        ]),
      ],
    ],
  )
}

