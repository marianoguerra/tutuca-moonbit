          @anode.attr("class", "input"),
          @anode.dyn_attr("value", Field("query")),
          @anode.eid(0),
          @anode.attr("placeholder", "Filter entries"),
        ],
        [],
      ),
      @anode.text(" "),
      @anode.h("ul", [], [
        @anode.each(
          1,
          Field("items"),
          @anode.h("li", [], [
            @anode.h("span", [], [@anode.dyn_text(Bind("key"))]),
            @anode.text(": "),
            @anode.dyn_text(Bind("value"), id=0),
