                then_val=@anode.const_str("tab tab-active"),
                else_val=@anode.const_str("tab"),
              ),
              @anode.eid(2),
            ],
            [@anode.text("Pricing")],
          ),
        ],
      ),
      @anode.text(" "),
      @anode.show(
        Predicate(pred=Equals, args=[Field("tab"), @anode.const_str("overview")]),
        @anode.h("div", [@anode.attr("class", "card p-3 border panel")], [
          @anode.h("h4", [], [@anode.text("Overview")]),
          @anode.h("p", [], [
            @anode.text("A short summary of what this product does."),
          ]),
        ]),
      ),
      @anode.text(" "),
      @anode.show(
        Predicate(pred=Equals, args=[Field("tab"), @anode.const_str("features")]),
        @anode.h("div", [@anode.attr("class", "card p-3 border panel")], [
          @anode.h("h4", [], [@anode.text("Features")]),
          @anode.h("p", [], [
            @anode.text("The list of features lives on this tab."),
          ]),
        ]),
      ),
      @anode.text(" "),
      @anode.show(
        Predicate(pred=Equals, args=[Field("tab"), @anode.const_str("pricing")]),
        @anode.h("div", [@anode.attr("class", "card p-3 border panel")], [
          @anode.h("h4", [], [@anode.text("Pricing")]),
          @anode.h("p", [], [@anode.text("What it costs.")]),
