///|
/// The compiled `main` view.
fn list_and_filter_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("section", [@anode.attr("class", "flex flex-col gap-3")], [
      @anode.h(
        "input",
        [
          @anode.attr("type", "search"),
          @anode.attr("class", "input"),
          @anode.dyn_attr("value", @tutuca.Expr::field("query")),
          @anode.eid(0),
          @anode.attr("placeholder", "Filter entries"),
        ],
        [],
      ),
      @anode.text(" "),
      @anode.h("ul", [], [
        @anode.each(
          1,
          @tutuca.Expr::field("items"),
          @anode.h("li", [], [
            @anode.h("span", [], [@anode.dyn_text(@tutuca.Expr::bind("key"))]),
            @anode.text(": "),
            @anode.dyn_text(@tutuca.Expr::bind("value"), id=0),
          ]),
          when_val=@tutuca.Expr::name("filterItem"),
        ),
      ]),
    ]),
    [
      [
        @anode.on(
          "input",
          @anode.const_null(),
          action=@anode.set_property_action(
            "query",
            @tutuca.Expr::event_path(["value"]),
          ),
        ),
        @anode.on(
          "keydown",
          @anode.const_null(),
          modifiers=["cancel"],
          action=@anode.reset_property_action("query"),
        ),
      ],
    ],
  )
}

