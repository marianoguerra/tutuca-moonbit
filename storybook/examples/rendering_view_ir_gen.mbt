///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn pagination_inline_update(
  s : PaginationState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[PaginationState] {
  match msg {
    Receive("prev", _args) => {
      let s = {
        ..s,
        page: (if 0.0 > s.page.to_double() - 1.0 {
          0.0
        } else {
          s.page.to_double() - 1.0
        }).to_int(),
      }
      guard (Num(s.page.to_double()) : @tutuca.Value) ==
        (Num(0.0) : @tutuca.Value) ||
        s.page.to_double() * s.page_size.to_double() <
        s.items.length().to_double() else {
        @tutuca.invariant_failed(
          handler="prev",
          pred="page_exists",
          sentence="page " +
            (Num(s.page.to_double()) : @tutuca.Value).to_display_string() +
            " is past the last one",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            { field: "page_size", domain: DBetween(lo=DLit(1), hi=DLit(100)), },
            { field: "page", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="prev",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    Receive("next", _args) => {
      let d0 = s.page_size.to_double()
      guard d0 != 0.0 else { return Unchanged }
      let s = {
        ..s,
        page: (if s.page.to_double() + 1.0 <
          (s.items.length().to_double() - 1.0) / d0 {
          s.page.to_double() + 1.0
        } else {
          (s.items.length().to_double() - 1.0) / d0
        }).to_int(),
      }
      guard (Num(s.page.to_double()) : @tutuca.Value) ==
        (Num(0.0) : @tutuca.Value) ||
        s.page.to_double() * s.page_size.to_double() <
        s.items.length().to_double() else {
        @tutuca.invariant_failed(
          handler="next",
          pred="page_exists",
          sentence="page " +
            (Num(s.page.to_double()) : @tutuca.Value).to_display_string() +
            " is past the last one",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            { field: "page_size", domain: DBetween(lo=DLit(1), hi=DLit(100)), },
            { field: "page", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="next",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
