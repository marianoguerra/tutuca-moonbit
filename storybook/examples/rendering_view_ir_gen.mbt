}

///|
/// `invariant page_exists` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn pagination_compute_page_exists(
  s : PaginationState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      (Num(s.page.to_double()) : @tutuca.Value) == (Num(0.0) : @tutuca.Value) ||
      s.page.to_double() * s.page_size.to_double() <
      s.items.length().to_double(),
    ) : @tutuca.Value)
}

