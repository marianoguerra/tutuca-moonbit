                ),
                @anode.dyn_attr(
                  "disabled",
                  @tutuca.Expr::method_("is_items_empty"),
                ),
                @anode.eid(0),
              ],
              [
                @anode.h("span", [], [
                  @anode.dyn_text(@tutuca.Expr::method_("arrow_text"), id=0),
                ]),
                @anode.text(" "),
                @anode.h(
                  "span",
                  [@anode.attr("class", "font-semibold comp-section")],
                  [@anode.dyn_text(@tutuca.Expr::method_("type_text"), id=1)],
                ),
                @anode.text(" "),
                @anode.h("span", [], [
                  @anode.dyn_text(@tutuca.Expr::method_("count_text"), id=2),
                ]),
              ],
            ),
            @anode.text(" "),
            @anode.show(
              @tutuca.Expr::method_("show_pagination"),
              @anode.h("div", [@anode.attr("class", "join")], [
                @anode.h(
                  "button",
                  [
                    @anode.attr("type", "button"),
                    @anode.attr("class", "join-item btn btn-xs pg-prev"),
                    @anode.dyn_attr(
                      "disabled",
                      @tutuca.Expr::method_("cannot_prev_page"),
                    ),
                    @anode.eid(1),
                  ],
                  [@anode.text("«")],
                ),
                @anode.text(" "),
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "join-item badge font-mono text-xs pg-label",
                    ),
                  ],
                  [
                    @anode.dyn_text(
                      @tutuca.Expr::method_("page_indicator_text"),
                      id=3,
                    ),
                  ],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr("type", "button"),
                    @anode.attr("class", "join-item btn btn-xs pg-next"),
                    @anode.dyn_attr(
                      "disabled",
                      @tutuca.Expr::method_("cannot_next_page"),
