  name? : String = "CompSection",
  views? : Map[String, @anode.View] = comp_section_views(),
  init? : CompSectionState = CompSectionState::zero(),
  common_style? : String = comp_section_common_style,
  global_style? : String = comp_section_global_style,
  update? : (CompSectionState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    CompSectionState,
  ],
  compute? : (CompSectionMethod) -> ((
    CompSectionState,
    Array[@tutuca.Value],
    &@tutuca.Stack,
  ) -> @tutuca.Value)?,
  swap? : (CompSectionInput) -> ((
    CompSectionState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  loop_with? : (CompSectionLoopWith) -> ((
    CompSectionState,
    @tutuca.Value,
    @component.LoopCtx,
  ) -> @component.LoopWith)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    compute={
      let bucket = match compute {
        Some(f) =>
          @component.build_bucket(
            (
              [
                ArrowText,
                CannotNextPage,
                CannotPrevPage,
                CountText,
                IsItemsEmpty,
                PageIndicatorText,
                ShowPagination,
                TypeText,
              ] : Array[CompSectionMethod]),
            CompSectionMethod::name,
            f,
          )
        None => Map([])
      }
      for k, h in comp_section_inline_compute() {
        bucket[k] = h
      }
      bucket
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([NextPage, PrevPage, Toggle] : Array[CompSectionInput]),
          CompSectionInput::name,
          f,
        )
      None => Map([])
    },
    loop_with=match loop_with {
      Some(f) =>
        @component.build_bucket(
          ([GetPageRange] : Array[CompSectionLoopWith]),
          CompSectionLoopWith::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=comp_name_spec_source,
  )
