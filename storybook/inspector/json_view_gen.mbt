pub fn JsonObjectMsg::from_dispatch(d : @component.Dispatch) -> JsonObjectMsg? {
  guard d is Receive(name, args) else { return None }
  Some(
    match (name, args) {
      ("nextPage", []) => NextPage
      ("prevPage", []) => PrevPage
