        answered => answered
      }
    },
    compute=fuzz_controls_inline_compute(),
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=fuzz_row_spec_source,
  )
}

///|
/// The compiled `main` view.
fn fuzz_verdict_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.show(
      @tutuca.Expr::app("not", [
        @tutuca.Expr::app("is", [
          @tutuca.Expr::field("kind"),
          @anode.const_str("none"),
        ]),
      ]),
      @anode.h(
        "div",
        [@anode.attr("class", "fuzz-verdict flex flex-col gap-1 p-2")],
        [
          @anode.h(
            "div",
            [@anode.attr("class", "flex items-center gap-2 flex-wrap")],
            [
              @anode.h(
                "span",
                [@anode.dyn_attr("class", @tutuca.Expr::field("badgeClass"))],
                [@anode.dyn_text(@tutuca.Expr::field("kind"))],
              ),
              @anode.text(" "),
              @anode.h(
                "span",
                [@anode.attr("class", "text-sm verdict-headline")],
                [@anode.dyn_text(@tutuca.Expr::field("headline"))],
              ),
              @anode.text(" "),
              @anode.show(
                @tutuca.Expr::app("truthy?", [@tutuca.Expr::field("rule")]),
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "text-xs opacity-40 font-mono verdict-rule",
                    ),
                  ],
                  [@anode.dyn_text(@tutuca.Expr::field("rule"), id=0)],
                ),
              ),
            ],
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::app("truthy?", [@tutuca.Expr::field("sentence")]),
            @anode.h(
              "div",
              [@anode.attr("class", "text-sm opacity-80 verdict-sentence")],
              [@anode.dyn_text(@tutuca.Expr::field("sentence"))],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("hasUnchecked"),
            @anode.h(
              "div",
              [@anode.attr("class", "text-xs opacity-60 verdict-unchecked")],
              [
                @anode.dyn_text(@anode.const_str("not checked: "), id=1),
                @anode.dyn_text(@tutuca.Expr::field("unchecked"), id=2),
              ],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("hasReproducer"),
            @anode.h("div", [@anode.attr("class", "flex flex-col gap-1")], [
              @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
                @anode.text("the shortest script that still does it"),
              ]),
              @anode.text(" "),
              @anode.each(
                4,
                @tutuca.Expr::field("reproducer"),
                @anode.render_it(3),
                from_render_each=true,
              ),
            ]),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::app("not", [
              @tutuca.Expr::app("is", [
                @tutuca.Expr::field("kind"),
                @anode.const_str("held"),
              ]),
            ]),
            @anode.hide(
              @tutuca.Expr::field("hasReproducer"),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-xs btn-ghost verdict-shrink"),
                  @anode.eid(0),
                ],
                [@anode.text("Shrink it")],
              ),
            ),
          ),
        ],
      ),
    ),
    [[@anode.on("click", @tutuca.Expr::name("shrink"))]],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn fuzz_verdict_views() -> Map[String, @anode.View] {
  { "main": fuzz_verdict_main_view_ir() }
}

///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn fuzz_verdict_inline_update(
  s : FuzzVerdictState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[FuzzVerdictState] {
  match msg {
    Receive("shrink", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "fuzzShrink",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      guard !((Str(s.kind) : @tutuca.Value) == (Str("broke") : @tutuca.Value) ||
        (Str(s.kind) : @tutuca.Value) == (Str("disagreed") : @tutuca.Value)) ||
        s.rule.length().to_double() > 0.0 else {
        @tutuca.invariant_failed(
          handler="shrink",
          pred="findingsNameTheirRule",
          sentence="a " +
            (Str(s.kind) : @tutuca.Value).to_display_string() +
            " verdict with no rule on it",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard (Bool(s.hasUnchecked) : @tutuca.Value) ==
        (Bool(s.unchecked.length().to_double() > 0.0) : @tutuca.Value) else {
        @tutuca.invariant_failed(
          handler="shrink",
          pred="hasUncheckedTracksUnchecked",
          sentence="hasUnchecked and the unchecked list disagree",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard (Bool(s.hasReproducer) : @tutuca.Value) ==
        (Bool(s.reproducer.length().to_double() > 0.0) : @tutuca.Value) else {
        @tutuca.invariant_failed(
          handler="shrink",
          pred="hasReproducerTracksReproducer",
          sentence="hasReproducer and the reproducer disagree",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            {
              field: "kind",
              domain: DOneOf([
                Str("none"),
                Str("held"),
                Str("broke"),
                Str("disagreed"),
                Str("stuck"),
              ]),
            },
            { field: "at", domain: DCompare(op=DGe, rhs=DLit(-1)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="shrink",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// `invariant findingsNameTheirRule` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn fuzz_verdict_compute_findingsNameTheirRule(
  s : FuzzVerdictState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      !((Str(s.kind) : @tutuca.Value) == (Str("broke") : @tutuca.Value) ||
      (Str(s.kind) : @tutuca.Value) == (Str("disagreed") : @tutuca.Value)) ||
      s.rule.length().to_double() > 0.0,
    ) : @tutuca.Value)
}

///|
/// `invariant hasReproducerTracksReproducer` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn fuzz_verdict_compute_hasReproducerTracksReproducer(
  s : FuzzVerdictState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      (Bool(s.hasReproducer) : @tutuca.Value) ==
      (Bool(s.reproducer.length().to_double() > 0.0) : @tutuca.Value),
    ) : @tutuca.Value)
}

///|
/// `invariant hasUncheckedTracksUnchecked` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn fuzz_verdict_compute_hasUncheckedTracksUnchecked(
  s : FuzzVerdictState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      (Bool(s.hasUnchecked) : @tutuca.Value) ==
      (Bool(s.unchecked.length().to_double() > 0.0) : @tutuca.Value),
    ) : @tutuca.Value)
}

///|
/// The `compute` names the `<script type="tutuca/script">` block answers.
/// GENERATED — edit the block, not this.
fn fuzz_verdict_inline_compute() -> Map[
  String,
  (FuzzVerdictState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value,
] {
  {
    "findingsNameTheirRule": fuzz_verdict_compute_findingsNameTheirRule,
    "hasReproducerTracksReproducer": fuzz_verdict_compute_hasReproducerTracksReproducer,
    "hasUncheckedTracksUnchecked": fuzz_verdict_compute_hasUncheckedTracksUnchecked,
  }
}

