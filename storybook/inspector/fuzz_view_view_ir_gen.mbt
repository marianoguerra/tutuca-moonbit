///|
/// The compiled `main` view.
fn fuzz_panel_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("div", [@anode.attr("class", "fuzz-panel flex flex-col gap-2")], [
      @anode.h(
        "div",
        [
          @anode.attr(
            "class", "flex items-center gap-2 border-b border-base-content/10 px-2 pb-1",
          ),
        ],
        [
          @anode.h("span", [@anode.attr("class", "text-xs opacity-60")], [
            @anode.text("Property run"),
          ]),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("has_run"),
            @anode.h(
              "span",
              [
                @anode.attr(
                  "class", "ml-auto text-xs opacity-40 tabular-nums panel-pos",
                ),
              ],
              [
                @anode.dyn_text(@tutuca.Expr::field("at"), id=0),
                @anode.dyn_text(@anode.const_str(" / "), id=1),
                @anode.dyn_text(@tutuca.Expr::field("total"), id=2),
              ],
            ),
          ),
        ],
      ),
      @anode.text(" "),
      @anode.render(3, @tutuca.Expr::field("controls")),
      @anode.text(" "),
      @anode.render(4, @tutuca.Expr::field("verdict")),
      @anode.text(" "),
      @anode.render(5, @tutuca.Expr::field("log")),
    ]),
    [],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn fuzz_panel_views() -> Map[String, @anode.View] {
  { "main": fuzz_panel_main_view_ir() }
}

///|
/// `invariant at_within_total` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn fuzz_panel_compute_at_within_total(
  s : FuzzPanelState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (Bool(s.at.to_double() <= s.total.to_double()) : @tutuca.Value)
}

///|
