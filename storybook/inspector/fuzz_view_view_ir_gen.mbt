///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn fuzz_row_inline_update(
  s : FuzzRowState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[FuzzRowState] {
  match msg {
    Receive("toggle", _args) => {
      let s = { ..s, open: !s.open, }
      guard !s.broke || s.brokeRule.length().to_double() > 0.0 else {
        @tutuca.invariant_failed(
          handler="toggle",
          pred="breakNamesARule",
          sentence="the row says a rule broke and does not say which",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard !s.refused || s.refusedRule.length().to_double() > 0.0 else {
        @tutuca.invariant_failed(
          handler="toggle",
          pred="refusalNamesSomething",
          sentence="the row says it was refused and has nothing to show for it",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            {
              field: "verb",
              domain: DOneOf([
                Str("send"),
                Str("intent"),
                Str("set"),
                Str("write"),
              ]),
            },
            { field: "at", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "renders", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="toggle",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

