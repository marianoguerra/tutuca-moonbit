fn fuzz_panel_inline_compute() -> Map[
  String,
  (FuzzPanelState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value,
] {
  { "at_within_total": fuzz_panel_compute_at_within_total }
}

