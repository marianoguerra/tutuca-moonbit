fn fuzz_controls_inline_update(
  s : FuzzControlsState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[FuzzControlsState] {
  match msg {
    Receive("setSeed", args) => {
      guard args.get(0) is Some(Str(s_)) else { return Unchanged }
      let effects : Array[() -> Unit] = []
      let s = { ..s, seed: s_, }
      effects.push(() => {
        ctx.intent(
          "fuzzConfig",
          [
            (Str(s_) : @tutuca.Value),
            (Str(s.steps) : @tutuca.Value),
            (Str(s.source) : @tutuca.Value),
          ],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("setSteps", args) => {
      guard args.get(0) is Some(Str(n_)) else { return Unchanged }
      let effects : Array[() -> Unit] = []
      let s = { ..s, steps: n_, }
      effects.push(() => {
        ctx.intent(
          "fuzzConfig",
          [
            (Str(s.seed) : @tutuca.Value),
            (Str(n_) : @tutuca.Value),
            (Str(s.source) : @tutuca.Value),
          ],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("setSource", args) => {
      guard args.get(0) is Some(Str(s_)) else { return Unchanged }
      let effects : Array[() -> Unit] = []
      let s = { ..s, source: s_, }
      effects.push(() => {
        ctx.intent(
          "fuzzConfig",
          [
            (Str(s.seed) : @tutuca.Value),
            (Str(s.steps) : @tutuca.Value),
            (Str(s_) : @tutuca.Value),
          ],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("burst", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "fuzzBurst",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("play", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "fuzzPlay",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("stop", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "fuzzStop",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("step", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "fuzzStep",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("reset", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "fuzzReset",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
