  )
}

///|
/// The compiled `main` view.
fn fuzz_verdict_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.show(
      App(name="not", args=[
        App(name="is", args=[Field("kind"), @anode.const_str("none")]),
      ]),
      @anode.h(
        "div",
        [@anode.attr("class", "fuzz-verdict flex flex-col gap-1 p-2")],
        [
          @anode.h(
            "div",
            [@anode.attr("class", "flex items-center gap-2 flex-wrap")],
            [
              @anode.h(
                "span",
                [@anode.dyn_attr("class", Field("badgeClass"))],
                [@anode.dyn_text(Field("kind"))],
              ),
              @anode.text(" "),
              @anode.h(
                "span",
                [@anode.attr("class", "text-sm verdict-headline")],
                [@anode.dyn_text(Field("headline"))],
              ),
              @anode.text(" "),
              @anode.show(
                App(name="truthy?", args=[Field("rule")]),
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "text-xs opacity-40 font-mono verdict-rule",
                    ),
                  ],
                  [@anode.dyn_text(Field("rule"), id=0)],
                ),
              ),
            ],
          ),
          @anode.text(" "),
          @anode.show(
            App(name="truthy?", args=[Field("sentence")]),
            @anode.h(
              "div",
              [@anode.attr("class", "text-sm opacity-80 verdict-sentence")],
              [@anode.dyn_text(Field("sentence"))],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasUnchecked"),
            @anode.h(
              "div",
              [@anode.attr("class", "text-xs opacity-60 verdict-unchecked")],
              [
                @anode.dyn_text(@anode.const_str("not checked: "), id=1),
                @anode.dyn_text(Field("unchecked"), id=2),
              ],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasReproducer"),
            @anode.h("div", [@anode.attr("class", "flex flex-col gap-1")], [
              @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
                @anode.text("the shortest script that still does it"),
              ]),
              @anode.text(" "),
              @anode.each(
                4,
                Field("reproducer"),
                @anode.render_it(3),
                from_render_each=true,
              ),
            ]),
          ),
          @anode.text(" "),
          @anode.show(
            App(name="not", args=[
              App(name="is", args=[Field("kind"), @anode.const_str("held")]),
            ]),
            @anode.hide(
              Field("hasReproducer"),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-xs btn-ghost verdict-shrink"),
                  @anode.eid(0),
                ],
                [@anode.text("Shrink it")],
              ),
            ),
          ),
        ],
      ),
    ),
    [[@anode.on("click", HandlerName(name="shrink", ns=Receive))]],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn fuzz_verdict_views() -> Map[String, @anode.View] {
  { "main": fuzz_verdict_main_view_ir() }
}

///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn fuzz_verdict_inline_update(
  s : FuzzVerdictState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[FuzzVerdictState] {
  match msg {
    Receive("shrink", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "fuzzShrink",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// The FuzzVerdict component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `FuzzVerdictState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn fuzz_verdict_component(
  name? : String = "FuzzVerdict",
  views? : Map[String, @anode.View] = fuzz_verdict_views(),
  init? : FuzzVerdictState = FuzzVerdictState::zero(),
  common_style? : String = fuzz_verdict_common_style,
  global_style? : String = fuzz_verdict_global_style,
  update? : (FuzzVerdictState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    FuzzVerdictState,
  ],
  swap? : (FuzzVerdictInput) -> ((
    FuzzVerdictState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match fuzz_verdict_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([Shrink] : Array[FuzzVerdictInput]),
          FuzzVerdictInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=fuzz_row_spec_source,
  )
}

///|
