/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `FuzzControlsState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn fuzz_controls_component(
  name? : String = "FuzzControls",
  views? : Map[String, @anode.View] = fuzz_controls_views(),
  initial? : FuzzControlsState = FuzzControlsState::zero(),
  common_style? : String = fuzz_controls_common_style,
  global_style? : String = fuzz_controls_global_style,
  update? : (FuzzControlsState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    FuzzControlsState,
  ],
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    initial~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match fuzz_controls_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    compute=fuzz_controls_inline_compute(),
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=fuzz_row_spec_source,
  )
}

///|
/// The compiled `main` view.
fn fuzz_verdict_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.show(
      @tutuca.Expr::app("not", [
        @tutuca.Expr::app("is", [
          @tutuca.Expr::field("kind"),
          @anode.const_str("none"),
        ]),
      ]),
      @anode.h(
        "div",
        [@anode.attr("class", "fuzz-verdict flex flex-col gap-1 p-2")],
        [
          @anode.h(
            "div",
            [@anode.attr("class", "flex items-center gap-2 flex-wrap")],
            [
              @anode.h(
                "span",
                [@anode.dyn_attr("class", @tutuca.Expr::field("badge_class"))],
                [@anode.dyn_text(@tutuca.Expr::field("kind"), id=0)],
              ),
              @anode.text(" "),
              @anode.h(
                "span",
                [@anode.attr("class", "text-sm verdict-headline")],
                [@anode.dyn_text(@tutuca.Expr::field("headline"), id=1)],
              ),
              @anode.text(" "),
              @anode.show(
                @tutuca.Expr::app("truthy?", [@tutuca.Expr::field("rule")]),
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "text-xs opacity-40 font-mono verdict-rule",
                    ),
                  ],
                  [@anode.dyn_text(@tutuca.Expr::field("rule"), id=2)],
                ),
              ),
            ],
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::app("truthy?", [@tutuca.Expr::field("sentence")]),
            @anode.h(
              "div",
              [@anode.attr("class", "text-sm opacity-80 verdict-sentence")],
              [@anode.dyn_text(@tutuca.Expr::field("sentence"), id=3)],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("has_unchecked"),
            @anode.h(
              "div",
              [@anode.attr("class", "text-xs opacity-60 verdict-unchecked")],
              [
                @anode.dyn_text(@anode.const_str("not checked: "), id=4),
                @anode.dyn_text(@tutuca.Expr::field("unchecked"), id=5),
              ],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("has_reproducer"),
            @anode.h("div", [@anode.attr("class", "flex flex-col gap-1")], [
              @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
                @anode.text("the shortest script that still does it"),
              ]),
              @anode.text(" "),
              @anode.each(
                7,
                @tutuca.Expr::field("reproducer"),
                @anode.render_it(6),
                from_render_each=true,
              ),
            ]),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::app("not", [
              @tutuca.Expr::app("is", [
                @tutuca.Expr::field("kind"),
                @anode.const_str("held"),
              ]),
            ]),
            @anode.hide(
              @tutuca.Expr::field("has_reproducer"),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-xs btn-ghost verdict-shrink"),
                  @anode.eid(0),
                ],
                [@anode.text("Shrink it")],
              ),
            ),
          ),
        ],
      ),
    ),
    [[@anode.on("click", @tutuca.Expr::name("shrink"))]],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn fuzz_verdict_views() -> Map[String, @anode.View] {
  { "main": fuzz_verdict_main_view_ir() }
}

///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn fuzz_verdict_inline_update(
  s : FuzzVerdictState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[FuzzVerdictState] {
  match msg {
    Receive("shrink", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "fuzz_shrink",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      guard !((Str(s.kind) : @tutuca.Value) == (Str("broke") : @tutuca.Value) ||
        (Str(s.kind) : @tutuca.Value) == (Str("disagreed") : @tutuca.Value)) ||
        s.rule.length().to_double() > 0.0 else {
        @tutuca.invariant_failed(
          handler="shrink",
          pred="findings_name_their_rule",
          sentence="a " +
            (Str(s.kind) : @tutuca.Value).to_display_string() +
            " verdict with no rule on it",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard (Bool(s.has_unchecked) : @tutuca.Value) ==
        (Bool(s.unchecked.length().to_double() > 0.0) : @tutuca.Value) else {
        @tutuca.invariant_failed(
          handler="shrink",
          pred="has_unchecked_tracks_unchecked",
          sentence="hasUnchecked and the unchecked list disagree",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard (Bool(s.has_reproducer) : @tutuca.Value) ==
        (Bool(s.reproducer.length().to_double() > 0.0) : @tutuca.Value) else {
        @tutuca.invariant_failed(
          handler="shrink",
          pred="has_reproducer_tracks_reproducer",
          sentence="hasReproducer and the reproducer disagree",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            {
              field: "kind",
              domain: DOneOf([
                Str("none"),
                Str("held"),
                Str("broke"),
                Str("disagreed"),
                Str("stuck"),
              ]),
            },
            { field: "at", domain: DCompare(op=DGe, rhs=DLit(-1)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="shrink",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// `invariant findings_name_their_rule` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn fuzz_verdict_compute_findings_name_their_rule(
  s : FuzzVerdictState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      !((Str(s.kind) : @tutuca.Value) == (Str("broke") : @tutuca.Value) ||
      (Str(s.kind) : @tutuca.Value) == (Str("disagreed") : @tutuca.Value)) ||
      s.rule.length().to_double() > 0.0,
    ) : @tutuca.Value)
}

///|
/// `invariant has_reproducer_tracks_reproducer` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn fuzz_verdict_compute_has_reproducer_tracks_reproducer(
  s : FuzzVerdictState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      (Bool(s.has_reproducer) : @tutuca.Value) ==
      (Bool(s.reproducer.length().to_double() > 0.0) : @tutuca.Value),
    ) : @tutuca.Value)
}

///|
/// `invariant has_unchecked_tracks_unchecked` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn fuzz_verdict_compute_has_unchecked_tracks_unchecked(
  s : FuzzVerdictState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      (Bool(s.has_unchecked) : @tutuca.Value) ==
      (Bool(s.unchecked.length().to_double() > 0.0) : @tutuca.Value),
    ) : @tutuca.Value)
}

///|
/// The `compute` names the file's `logic:` section answers.
/// GENERATED — edit the block, not this.
fn fuzz_verdict_inline_compute() -> Map[
  String,
  (FuzzVerdictState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value,
] {
  {
    "findings_name_their_rule": fuzz_verdict_compute_findings_name_their_rule,
    "has_reproducer_tracks_reproducer": fuzz_verdict_compute_has_reproducer_tracks_reproducer,
    "has_unchecked_tracks_unchecked": fuzz_verdict_compute_has_unchecked_tracks_unchecked,
  }
}

