///|
/// The compiled `main` view.
fn schema_conditional_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "span",
      [
        @anode.attr(
          "class", "font-mono text-sm leading-tight inline-block schema-conditional",
        ),
      ],
      [
        @anode.h(
          "span",
          [@anode.attr("class", "inline-flex items-center gap-2 flex-wrap")],
          [
            @anode.h(
              "span",
              [@anode.attr("class", "text-accent font-semibold")],
              [@anode.text("conditional")],
            ),
            @anode.text(" "),
            @anode.show(
              Field("deprecated"),
              @anode.h(
                "span",
                [@anode.attr("class", "badge badge-xs badge-warning")],
                [@anode.text("deprecated")],
              ),
            ),
          ],
        ),
        @anode.text(" "),
        @anode.show(
          App(name="truthy?", args=[Field("title")]),
          @anode.h(
            "span",
            [@anode.attr("class", "block text-base-content/80 italic")],
            [@anode.dyn_text(Field("title"))],
          ),
        ),
        @anode.text(" "),
        @anode.show(
          App(name="truthy?", args=[Field("description")]),
          @anode.h(
            "span",
            [@anode.attr("class", "block text-base-content/50")],
            [@anode.dyn_text(Field("description"))],
          ),
        ),
        @anode.text(" "),
        @anode.h(
          "div",
          [
            @anode.attr(
              "class", "ml-1 grid gap-x-2 gap-y-0.5 items-baseline border-l border-base-content/10 pl-2 mt-0.5",
            ),
            @anode.attr("style", "grid-template-columns: auto 1fr"),
          ],
          [
            @anode.show(
              App(name="truthy?", args=[Field("ifNode")]),
              @anode.h("div", [@anode.attr("class", "contents")], [
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "font-mono text-sm flex items-center gap-1 leading-tight",
                    ),
                  ],
                  [
                    @anode.h("span", [@anode.attr("class", "text-info")], [
                      @anode.text("if"),
                    ]),
                    @anode.text(" "),
                    @anode.h(
                      "span",
                      [@anode.attr("class", "text-base-content/30")],
                      [@anode.text(":")],
                    ),
                  ],
                ),
                @anode.text(" "),
                @anode.render(0, Field("ifNode")),
              ]),
            ),
            @anode.text(" "),
            @anode.show(
              App(name="truthy?", args=[Field("thenNode")]),
              @anode.h("div", [@anode.attr("class", "contents")], [
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "font-mono text-sm flex items-center gap-1 leading-tight",
                    ),
                  ],
                  [
                    @anode.h("span", [@anode.attr("class", "text-success")], [
                      @anode.text("then"),
                    ]),
                    @anode.text(" "),
                    @anode.h(
                      "span",
                      [@anode.attr("class", "text-base-content/30")],
                      [@anode.text(":")],
                    ),
                  ],
                ),
                @anode.text(" "),
                @anode.render(1, Field("thenNode")),
              ]),
            ),
            @anode.text(" "),
            @anode.show(
              App(name="truthy?", args=[Field("elseNode")]),
              @anode.h("div", [@anode.attr("class", "contents")], [
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "font-mono text-sm flex items-center gap-1 leading-tight",
                    ),
                  ],
                  [
                    @anode.h("span", [@anode.attr("class", "text-warning")], [
                      @anode.text("else"),
                    ]),
                    @anode.text(" "),
                    @anode.h(
                      "span",
                      [@anode.attr("class", "text-base-content/30")],
                      [@anode.text(":")],
                    ),
                  ],
                ),
                @anode.text(" "),
                @anode.render(2, Field("elseNode")),
              ]),
            ),
          ],
        ),
      ],
    ),
    [],
  )
}

