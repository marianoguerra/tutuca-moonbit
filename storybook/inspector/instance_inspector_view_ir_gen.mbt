        @anode.attr(
          "class", "font-mono text-sm leading-snug flex flex-col gap-3 instance-explorer",
        ),
      ],
      [
        @anode.h(
          "div",
          [@anode.attr("role", "tablist"), @anode.attr("class", "tabs")],
          [
            @anode.h(
              "a",
              [
                @anode.attr("role", "tab"),
                @anode.if_attr(
                  "class",
                  @tutuca.Expr::app("is", [
                    @tutuca.Expr::field("activeTab"),
                    @anode.const_str("instance"),
