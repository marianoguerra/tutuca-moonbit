              ]),
            ),
            @anode.text(" "),
            @anode.hide(
              @tutuca.Expr::field("hasComponent"),
              @anode.h(
                "div",
                [@anode.attr("class", "text-base-content/50 text-xs")],
                [
                  @anode.text(
                    "\n      Pass the Component descriptor to inspect its definition.\n    ",
                  ),
                ],
              ),
            ),
          ]),
        ),
      ],
    ),
    [
      [
        @anode.on(
          "click",
          @anode.const_null(),
          action=@anode.set_property_action(
            "activeTab",
            @anode.const_str("instance"),
          ),
        ),
      ],
      [
