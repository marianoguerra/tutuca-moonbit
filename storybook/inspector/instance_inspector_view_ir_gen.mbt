              [@anode.text("\n      Instance\n    ")],
            ),
            @anode.text(" "),
            @anode.show(
              @tutuca.Expr::field("hasComponent"),
              @anode.h(
                "a",
                [
                  @anode.attr("role", "tab"),
                  @anode.if_attr(
                    "class",
                    @tutuca.Expr::app("is", [
                      @tutuca.Expr::field("activeTab"),
                      @anode.const_str("component"),
                    ]),
                    then_val=@anode.const_str("tab tab-active tab-component"),
                    else_val=@anode.const_str("tab tab-component"),
                  ),
                  @anode.eid(1),
                ],
                [@anode.text("\n      Component\n    ")],
              ),
            ),
          ],
        ),
        @anode.text(" "),
        @anode.show(
          @tutuca.Expr::app("is", [
            @tutuca.Expr::field("activeTab"),
            @anode.const_str("instance"),
          ]),
          @anode.h("div", [], [
            @anode.render(0, @tutuca.Expr::field("instanceView")),
          ]),
        ),
        @anode.text(" "),
        @anode.show(
          @tutuca.Expr::app("is", [
            @tutuca.Expr::field("activeTab"),
            @anode.const_str("component"),
          ]),
          @anode.h("div", [], [
            @anode.show(
              @tutuca.Expr::field("hasComponent"),
              @anode.h("div", [], [
