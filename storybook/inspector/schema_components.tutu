spec:
  SchemaScalar:
    field items :: List.of(Instance)
    field is_expanded :: Bool
    field items_per_page :: Int
    field current_page :: Int
    field type_label :: String
    field badges :: List.of(String)
    field title :: String
    field description :: String
    field deprecated :: Bool

    /// Where the window actually falls. `itemsPerPage` is at least 1 by the
    /// clause above, so the multiplication is safe wherever this is asked —
    /// and page 0 is legal over an empty list, which is what the first
    /// disjunct is for.
    invariant page_exists:
      ~format: @str{page @(it.current_page) is past the end of @(it.items.length()) items}
      ((it.current_page == 0) || ((it.current_page * it.items_per_page) < it.items.length()))

    /// A page is a window onto `items`, and both numbers that place it are
    /// counts. A size of zero divides the list into no pages at all and the
    /// pager silently shows nothing; the ceiling keeps a generated
    /// `setItemsPerPage` from asking for a page nothing could paint.
    where it.items_per_page in_range(1, 500)

    where it.current_page >= 0

  SchemaObject:
    field items :: List.of(Instance)
    field is_expanded :: Bool
    field items_per_page :: Int
    field current_page :: Int
    field type_label :: String
    field badges :: List.of(String)
    field title :: String
    field description :: String
    field deprecated :: Bool

    /// Where the window actually falls. `itemsPerPage` is at least 1 by the
    /// clause above, so the multiplication is safe wherever this is asked —
    /// and page 0 is legal over an empty list, which is what the first
    /// disjunct is for.
    invariant page_exists:
      ~format: @str{page @(it.current_page) is past the end of @(it.items.length()) items}
      ((it.current_page == 0) || ((it.current_page * it.items_per_page) < it.items.length()))

    /// A page is a window onto `items`, and both numbers that place it are
    /// counts. A size of zero divides the list into no pages at all and the
    /// pager silently shows nothing; the ceiling keeps a generated
    /// `setItemsPerPage` from asking for a page nothing could paint.
    where it.items_per_page in_range(1, 500)

    where it.current_page >= 0

  SchemaArray:
    field items :: List.of(Instance)
    field is_expanded :: Bool
    field items_per_page :: Int
    field current_page :: Int
    field type_label :: String
    field badges :: List.of(String)
    field title :: String
    field description :: String
    field deprecated :: Bool

    /// Where the window actually falls. `itemsPerPage` is at least 1 by the
    /// clause above, so the multiplication is safe wherever this is asked —
    /// and page 0 is legal over an empty list, which is what the first
    /// disjunct is for.
    invariant page_exists:
      ~format: @str{page @(it.current_page) is past the end of @(it.items.length()) items}
      ((it.current_page == 0) || ((it.current_page * it.items_per_page) < it.items.length()))

    /// A page is a window onto `items`, and both numbers that place it are
    /// counts. A size of zero divides the list into no pages at all and the
    /// pager silently shows nothing; the ceiling keeps a generated
    /// `setItemsPerPage` from asking for a page nothing could paint.
    where it.items_per_page in_range(1, 500)

    where it.current_page >= 0

  SchemaEnum:
    field items :: List.of(Instance)
    field is_expanded :: Bool
    field items_per_page :: Int
    field current_page :: Int
    field type_label :: String
    field badges :: List.of(String)
    field title :: String
    field description :: String
    field deprecated :: Bool

    /// Where the window actually falls. `itemsPerPage` is at least 1 by the
    /// clause above, so the multiplication is safe wherever this is asked —
    /// and page 0 is legal over an empty list, which is what the first
    /// disjunct is for.
    invariant page_exists:
      ~format: @str{page @(it.current_page) is past the end of @(it.items.length()) items}
      ((it.current_page == 0) || ((it.current_page * it.items_per_page) < it.items.length()))

    /// A page is a window onto `items`, and both numbers that place it are
    /// counts. A size of zero divides the list into no pages at all and the
    /// pager silently shows nothing; the ceiling keeps a generated
    /// `setItemsPerPage` from asking for a page nothing could paint.
    where it.items_per_page in_range(1, 500)

    where it.current_page >= 0

  SchemaCombinator:
    field items :: List.of(Instance)
    field is_expanded :: Bool
    field items_per_page :: Int
    field current_page :: Int
    field type_label :: String
    field badges :: List.of(String)
    field title :: String
    field description :: String
    field deprecated :: Bool

    /// Where the window actually falls. `itemsPerPage` is at least 1 by the
    /// clause above, so the multiplication is safe wherever this is asked —
    /// and page 0 is legal over an empty list, which is what the first
    /// disjunct is for.
    invariant page_exists:
      ~format: @str{page @(it.current_page) is past the end of @(it.items.length()) items}
      ((it.current_page == 0) || ((it.current_page * it.items_per_page) < it.items.length()))

    /// A page is a window onto `items`, and both numbers that place it are
    /// counts. A size of zero divides the list into no pages at all and the
    /// pager silently shows nothing; the ceiling keeps a generated
    /// `setItemsPerPage` from asking for a page nothing could paint.
    where it.items_per_page in_range(1, 500)

    where it.current_page >= 0

  SchemaConst:
    field value :: Any

  SchemaConditional:
    field if_node :: Any
    field then_node :: Any
    field else_node :: Any
    field title :: String
    field description :: String
    field deprecated :: Bool

  SchemaNot:
    field child :: Any

  SchemaBoolean:
    field value :: Bool

  SchemaRef:
    field target :: String

    /// A `$ref` is a pointer, and an empty one points at the whole document
    /// — which renders as a node claiming to be its own parent.
    where it.target non_empty

view:
  SchemaScalar:
    @span(~class: "font-mono text-sm leading-tight inline-block"){@span(~class: "inline-flex items-center gap-2 flex-wrap"){@button(~type: "button", ~class: "cursor-pointer text-base-content/70 hover:text-base-content inline-flex items-center gap-1", ~disabled: is_items_empty(), ~on_click: it.is_expanded := !it.is_expanded){@hide(is_items_empty()){@span{@(arrow_text())}} @span(~class: "text-success schema-scalar font-semibold"){@(type_text())} @span(~class: "text-base-content/50"){@(count_text())}} @each(value, key in it.badges){@span(~class: "badge badge-xs badge-ghost font-mono font-normal"){@(value)}} @show(it.deprecated){@span(~class: "badge badge-xs badge-warning"){deprecated}} @show(show_pagination()){@div(~class: "join"){@button(~type: "button", ~class: "join-item btn btn-xs pg-prev", ~disabled: cannot_prev_page(), ~on_click: prev_page){«} @span(~class: "join-item badge font-mono text-xs pg-label"){@(page_indicator_text())} @button(~type: "button", ~class: "join-item btn btn-xs pg-next", ~disabled: cannot_next_page(), ~on_click: next_page){»}}}} @show(it.title.is_truthy()){@span(~class: "block text-base-content/80 italic"){@(it.title)}} @show(it.description.is_truthy()){@span(~class: "block text-base-content/50"){@(it.description)}} @show(it.is_expanded){@div(~class: "ml-1 grid gap-x-2 gap-y-0.5 items-baseline border-l border-base-content/10 pl-2 mt-0.5", ~style: "grid-template-columns: auto 1fr"){@each(value, key in it.items, ~loop_with: get_page_range){@render(value)}}}}

