///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn recorder_bar_inline_update(
  s : RecorderBarState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[RecorderBarState] {
  match msg {
    Receive("setScope", args) => {
      guard args.get(0) is Some(Str(s_)) else { return Unchanged }
      let s = { ..s, scope: s_, }
      let s = {
        ..s,
        scopeLabel: if (Str(s_) : @tutuca.Value) ==
          (Str("section") : @tutuca.Value) {
          "the active section"
        } else if (Str(s_) : @tutuca.Value) == (Str("example") : @tutuca.Value) {
          "this example"
        } else {
          "the whole storybook"
        },
      }
      let s = {
        ..s,
        allClass: if (Str(s_) : @tutuca.Value) == (Str("all") : @tutuca.Value) {
          "btn btn-sm pick-all btn-primary"
        } else {
          "btn btn-sm pick-all btn-outline"
        },
      }
      let s = {
        ..s,
        sectionClass: if (Str(s_) : @tutuca.Value) ==
          (Str("section") : @tutuca.Value) {
          "btn btn-sm pick-section btn-primary"
        } else {
          "btn btn-sm pick-section btn-outline"
        },
      }
      let s = {
        ..s,
        exampleClass: if (Str(s_) : @tutuca.Value) ==
          (Str("example") : @tutuca.Value) {
          "btn btn-sm pick-example btn-primary"
        } else {
          "btn btn-sm pick-example btn-outline"
        },
      }
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="setScope",
          pred="turnsAreEvents",
          sentence=(Num(s.turns.to_double()) : @tutuca.Value).to_display_string() +
            " turns out of " +
            (Num(s.events.to_double()) : @tutuca.Value).to_display_string() +
            " events",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            { field: "scope", domain: DOneOf(["all", "section", "example"]), },
            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="setScope",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    Receive("openPicker", _args) => {
      let s = { ..s, picking: true, }
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="openPicker",
          pred="turnsAreEvents",
          sentence=(Num(s.turns.to_double()) : @tutuca.Value).to_display_string() +
            " turns out of " +
            (Num(s.events.to_double()) : @tutuca.Value).to_display_string() +
            " events",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            { field: "scope", domain: DOneOf(["all", "section", "example"]), },
            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="openPicker",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    Receive("closePicker", _args) => {
      let s = { ..s, picking: false, }
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="closePicker",
          pred="turnsAreEvents",
          sentence=(Num(s.turns.to_double()) : @tutuca.Value).to_display_string() +
            " turns out of " +
            (Num(s.events.to_double()) : @tutuca.Value).to_display_string() +
            " events",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            { field: "scope", domain: DOneOf(["all", "section", "example"]), },
            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="closePicker",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    Receive("startRecording", _args) => {
      let effects : Array[() -> Unit] = []
      let s = { ..s, picking: false, }
      effects.push(() => {
        ctx.intent(
          "traceStart",
          [(Str(s.scope) : @tutuca.Value)],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="startRecording",
          pred="turnsAreEvents",
          sentence=(Num(s.turns.to_double()) : @tutuca.Value).to_display_string() +
            " turns out of " +
            (Num(s.events.to_double()) : @tutuca.Value).to_display_string() +
            " events",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            { field: "scope", domain: DOneOf(["all", "section", "example"]), },
            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="startRecording",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("stopRecording", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "traceStop",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="stopRecording",
          pred="turnsAreEvents",
          sentence=(Num(s.turns.to_double()) : @tutuca.Value).to_display_string() +
            " turns out of " +
            (Num(s.events.to_double()) : @tutuca.Value).to_display_string() +
            " events",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            { field: "scope", domain: DOneOf(["all", "section", "example"]), },
            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="stopRecording",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("clearRecording", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "traceDiscard",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="clearRecording",
          pred="turnsAreEvents",
          sentence=(Num(s.turns.to_double()) : @tutuca.Value).to_display_string() +
            " turns out of " +
            (Num(s.events.to_double()) : @tutuca.Value).to_display_string() +
            " events",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            { field: "scope", domain: DOneOf(["all", "section", "example"]), },
            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="clearRecording",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// `invariant turnsAreEvents` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn recorder_bar_compute_turnsAreEvents(
  s : RecorderBarState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (Bool(s.turns.to_double() <= s.events.to_double()) : @tutuca.Value)
}

///|
/// The `compute` names the `<script type="tutuca/script">` block answers.
/// GENERATED — edit the block, not this.
fn recorder_bar_inline_compute() -> Map[
  String,
  (RecorderBarState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value,
] {
  { "turnsAreEvents": recorder_bar_compute_turnsAreEvents }
}

///|
/// The RecorderBar component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `RecorderBarState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn recorder_bar_component(
  name? : String = "RecorderBar",
  views? : Map[String, @anode.View] = recorder_bar_views(),
  init? : RecorderBarState = RecorderBarState::zero(),
  common_style? : String = recorder_bar_common_style,
  global_style? : String = recorder_bar_global_style,
  update? : (RecorderBarState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    RecorderBarState,
  ],
  swap? : (RecorderBarInput) -> ((
    RecorderBarState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match recorder_bar_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    compute=recorder_bar_inline_compute(),
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          (
            [
              ClearRecording,
              ClosePicker,
              OpenPicker,
              SetScope,
              StartRecording,
              StopRecording,
            ] : Array[RecorderBarInput]),
          RecorderBarInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=trace_row_spec_source,
  )
}

///|
/// The compiled `main` view.
fn trace_panel_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("div", [@anode.attr("class", "trace-panel flex flex-col gap-2")], [
      @anode.h(
        "div",
        [
          @anode.attr(
            "class", "flex items-center gap-2 border-b border-base-content/10 px-2",
          ),
        ],
        [
          @anode.h(
            "button",
            [@anode.dyn_attr("class", Field("recordTabClass")), @anode.eid(0)],
            [@anode.text("Record")],
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasTrace"),
            @anode.h(
              "button",
              [@anode.dyn_attr("class", Field("traceTabClass")), @anode.eid(1)],
              [@anode.text("Trace")],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasTrace"),
            @anode.h(
              "button",
              [@anode.dyn_attr("class", Field("replayTabClass")), @anode.eid(2)],
              [@anode.text("Replay")],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasTrace"),
            @anode.h(
              "button",
              [@anode.dyn_attr("class", Field("selectTabClass")), @anode.eid(3)],
              [@anode.dyn_text(Field("selectLabel"))],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasTrace"),
            @anode.h(
              "span",
              [
                @anode.attr(
                  "class", "ml-auto text-xs opacity-40 tabular-nums panel-pos",
                ),
              ],
              [
                @anode.dyn_text(Field("at"), id=0),
                @anode.dyn_text(@anode.const_str(" / "), id=1),
                @anode.dyn_text(Field("total"), id=2),
              ],
            ),
          ),
        ],
      ),
      @anode.text(" "),
      @anode.comment(
        " Above every pane, because it is about the thing the reader just did\n       and not about the pane they happen to be looking at. A parse error on\n       import belongs where they can see it without changing tabs. ",
      ),
      @anode.text(" "),
      @anode.show(
        Field("hasNotice"),
        @anode.h(
          "div",
          [
            @anode.attr(
              "class", "trace-notice alert alert-warning text-xs mx-2 py-1",
            ),
          ],
          [@anode.dyn_text(Field("notice"))],
        ),
      ),
      @anode.text(" "),
      @anode.render(3, Field("bar")),
      @anode.text(" "),
      @anode.show(
        Field("showTrace"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-trace flex flex-col gap-2")],
          [
            @anode.h(
              "div",
              [@anode.attr("class", "flex items-center gap-2 px-2 flex-wrap")],
              [
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-sm btn-ghost trace-export"),
                    @anode.eid(4),
                  ],
                  [@anode.text("\n        Download\n      ")],
                ),
                @anode.text(" "),
                @anode.comment(
                  " Enabled by a pick, and the pick is a separate press for the reason\n           the host's comment gives: choosing a place is the thing a person\n           does several times before they mean it. ",
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-sm btn-ghost trace-cut"),
                    @anode.eid(5),
                  ],
                  [@anode.text("\n        Cut to the picked place\n      ")],
                ),
              ],
            ),
            @anode.text(" "),
            @anode.render(4, Field("header")),
            @anode.text(" "),
            @anode.render(5, Field("places")),
            @anode.text(" "),
            @anode.render(6, Field("log")),
          ],
        ),
      ),
      @anode.text(" "),
      @anode.comment(
        " The rerun. It drives the STORY, not a preview of one: the gallery is a\n       single transactor with every story mounted under it, so the events go\n       into the instance already on screen and the reader watches it move. ",
      ),
      @anode.text(" "),
      @anode.show(
        Field("showReplay"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-replay flex flex-col gap-2 p-2")],
          [
            @anode.show(
              Field("canReplay"),
              @anode.h("div", [@anode.attr("class", "flex gap-2 flex-wrap")], [
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-sm btn-primary replay-step"),
                    @anode.eid(6),
                  ],
                  [@anode.text("Step")],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [@anode.attr("class", "btn btn-sm replay-run"), @anode.eid(7)],
                  [@anode.text("Run")],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-sm btn-ghost replay-reset"),
                    @anode.eid(8),
                  ],
                  [@anode.text("Reset")],
                ),
                @anode.text(" "),
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "text-xs opacity-60 tabular-nums replay-pos self-center",
                    ),
                  ],
                  [
                    @anode.dyn_text(Field("at"), id=7),
                    @anode.dyn_text(@anode.const_str(" of "), id=8),
                    @anode.dyn_text(Field("total"), id=9),
                  ],
                ),
              ]),
            ),
            @anode.text(" "),
            @anode.show(
              Field("canReplay"),
              @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
                @anode.text(
                  "\n      The story above is the one being driven. A step feeds one whole turn —\n      what the recording drained together — so the app is never left\n      mid-cascade in a state it was never in.\n    ",
                ),
              ]),
            ),
          ],
        ),
      ),
      @anode.text(" "),
      @anode.comment(
        " Import lives on the empty pane as well as the full one: the reader who\n       has no recording is exactly the reader who wants to load somebody\n       else's. ",
      ),
      @anode.text(" "),
      @anode.show(
        Field("showImport"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-import flex flex-col gap-2 p-2")],
          [
            @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
              @anode.text("Paste a .trace.jsonl to load it."),
            ]),
            @anode.text(" "),
            @anode.h(
              "textarea",
              [
                @anode.attr("class", "textarea textarea-sm trace-draft"),
                @anode.attr("rows", "3"),
                @anode.dyn_attr("value", Field("draft")),
                @anode.eid(9),
              ],
              [],
            ),
            @anode.text(" "),
            @anode.h("div", [], [
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm trace-import"),
                  @anode.eid(10),
                ],
                [@anode.text("Load")],
              ),
            ]),
          ],
        ),
      ),
      @anode.text(" "),
      @anode.hide(
        Field("hasTrace"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-empty flex flex-col gap-2 px-2 pb-2")],
          [
            @anode.h("div", [@anode.attr("class", "text-xs opacity-40")], [
              @anode.text(
                "\n      Nothing recorded yet. Press Record, use the component, then stop —\n      or paste a recording somebody else made.\n    ",
              ),
            ]),
            @anode.text(" "),
            @anode.h(
              "textarea",
              [
                @anode.attr("class", "textarea textarea-sm trace-draft-empty"),
                @anode.attr("rows", "3"),
                @anode.dyn_attr("value", Field("draft")),
                @anode.eid(11),
              ],
              [],
            ),
            @anode.text(" "),
            @anode.h("div", [], [
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm trace-import-empty"),
                  @anode.eid(12),
                ],
                [@anode.text("Load")],
              ),
            ]),
          ],
        ),
      ),
    ]),
    [
      [
        @anode.on("click", HandlerName(name="setTab", ns=Receive), args=[
          @anode.const_str("record"),
        ]),
      ],
      [
        @anode.on("click", HandlerName(name="setTab", ns=Receive), args=[
          @anode.const_str("trace"),
        ]),
      ],
      [
        @anode.on("click", HandlerName(name="setTab", ns=Receive), args=[
          @anode.const_str("replay"),
        ]),
      ],
      [@anode.on("click", HandlerName(name="toggleSelecting", ns=Receive))],
      [@anode.on("click", HandlerName(name="exportTrace", ns=Receive))],
      [@anode.on("click", HandlerName(name="cutToPlace", ns=Receive))],
      [@anode.on("click", HandlerName(name="replayStep", ns=Receive))],
      [@anode.on("click", HandlerName(name="replayRun", ns=Receive))],
      [@anode.on("click", HandlerName(name="replayReset", ns=Receive))],
      [
        @anode.on(
          "input",
          @anode.const_null(),
          binding=@anode.BindString,
          action=@anode.set_property_action("draft", EventPath(["value"])),
        ),
      ],
      [@anode.on("click", HandlerName(name="importDraft", ns=Receive))],
      [
        @anode.on(
          "input",
          @anode.const_null(),
          binding=@anode.BindString,
          action=@anode.set_property_action("draft", EventPath(["value"])),
        ),
      ],
      [@anode.on("click", HandlerName(name="importDraft", ns=Receive))],
    ],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn trace_panel_views() -> Map[String, @anode.View] {
  { "main": trace_panel_main_view_ir() }
}

///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn trace_panel_inline_update(
  s : TracePanelState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[TracePanelState] {
  match msg {
    Receive("toggleSelecting", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "traceSelect",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      guard s.at.to_double() <= s.total.to_double() else {
        @tutuca.invariant_failed(
          handler="toggleSelecting",
          pred="atWithinTotal",
          sentence="parked at " +
            (Num(s.at.to_double()) : @tutuca.Value).to_display_string() +
            " of " +
            (Num(s.total.to_double()) : @tutuca.Value).to_display_string(),
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard !s.canReplay || s.hasTrace else {
        @tutuca.invariant_failed(
          handler="toggleSelecting",
          pred="canReplayNeedsATrace",
          sentence="the replay controls are live without a trace behind them",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard !s.showTrace || s.hasTrace else {
        @tutuca.invariant_failed(
          handler="toggleSelecting",
          pred="showTraceNeedsATrace",
          sentence="the trace pane is showing without a trace behind it",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard (Bool(s.hasNotice) : @tutuca.Value) ==
        (Bool(s.notice.length().to_double() > 0.0) : @tutuca.Value) else {
        @tutuca.invariant_failed(
          handler="toggleSelecting",
          pred="hasNoticeTracksNotice",
          sentence="hasNotice says " +
            (Bool(s.hasNotice) : @tutuca.Value).to_display_string() +
            " for a notice of " +
            (Num(s.notice.length().to_double()) : @tutuca.Value).to_display_string(),
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard !s.replaying || s.canReplay else {
        @tutuca.invariant_failed(
          handler="toggleSelecting",
          pred="replayingNeedsAReplay",
          sentence="a rerun is playing that was never mounted",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      guard !s.showReplay || s.hasTrace else {
        @tutuca.invariant_failed(
          handler="toggleSelecting",
          pred="showReplayNeedsATrace",
          sentence="the replay pane is showing without a trace behind it",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
