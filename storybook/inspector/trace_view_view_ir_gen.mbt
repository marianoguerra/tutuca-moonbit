///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn recorder_bar_inline_update(
  s : RecorderBarState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[RecorderBarState] {
  match msg {
    Receive("set_scope", args) => {
      guard args.get(0) is Some(Str(s_)) else { return Unchanged }
      let s = { ..s, scope: s_, }
      let s = {
        ..s,
        scope_label: if (Str(s_) : @tutuca.Value) ==
          (Str("section") : @tutuca.Value) {
          "the active section"
        } else if (Str(s_) : @tutuca.Value) == (Str("example") : @tutuca.Value) {
          "this example"
        } else {
          "the whole storybook"
        },
      }
      let s = {
        ..s,
        all_class: if (Str(s_) : @tutuca.Value) == (Str("all") : @tutuca.Value) {
          "btn btn-sm pick-all btn-primary"
        } else {
          "btn btn-sm pick-all btn-outline"
        },
      }
      let s = {
        ..s,
        section_class: if (Str(s_) : @tutuca.Value) ==
          (Str("section") : @tutuca.Value) {
          "btn btn-sm pick-section btn-primary"
        } else {
          "btn btn-sm pick-section btn-outline"
        },
      }
      let s = {
        ..s,
        example_class: if (Str(s_) : @tutuca.Value) ==
          (Str("example") : @tutuca.Value) {
          "btn btn-sm pick-example btn-primary"
        } else {
          "btn btn-sm pick-example btn-outline"
        },
      }
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="set_scope",
          pred="turns_are_events",
          sentence=(Num(s.turns.to_double()) : @tutuca.Value).to_display_string() +
            " turns out of " +
            (Num(s.events.to_double()) : @tutuca.Value).to_display_string() +
            " events",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            {
              field: "scope",
              domain: DOneOf([Str("all"), Str("section"), Str("example")]),
            },
            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="set_scope",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    Receive("open_picker", _args) => {
      let s = { ..s, picking: true, }
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="open_picker",
