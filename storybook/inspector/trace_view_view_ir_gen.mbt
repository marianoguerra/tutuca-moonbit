///|
/// The compiled `main` view.
fn recorder_bar_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("div", [@anode.attr("class", "flex flex-col gap-1")], [
      @anode.h(
        "div",
        [
          @anode.attr(
            "class", "recorder-bar flex items-center gap-2 p-2 flex-wrap",
          ),
        ],
        [
          @anode.show(
            @tutuca.Expr::field("recording"),
            @anode.h(
              "button",
              [
                @anode.attr("class", "btn btn-sm btn-error rec-stop"),
                @anode.eid(0),
              ],
              [@anode.text(" Stop recording ")],
            ),
          ),
          @anode.text(" "),
          @anode.hide(
            @tutuca.Expr::field("recording"),
            @anode.h(
              "button",
              [
                @anode.attr("class", "btn btn-sm btn-primary rec-start"),
                @anode.eid(1),
              ],
              [@anode.text(" Record ")],
            ),
          ),
          @anode.text(" "),
          @anode.h(
            "span",
            [@anode.attr("class", "badge badge-sm badge-ghost rec-scope")],
            [@anode.dyn_text(@tutuca.Expr::field("scope_label"), id=0)],
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("recording"),
            @anode.h(
              "span",
              [
                @anode.attr(
                  "class", "text-xs opacity-60 tabular-nums rec-count",
                ),
              ],
              [
                @anode.dyn_text(@tutuca.Expr::field("events"), id=1),
                @anode.dyn_text(@anode.const_str(" events · "), id=2),
                @anode.dyn_text(@tutuca.Expr::field("turns"), id=3),
                @anode.dyn_text(@anode.const_str(" turns"), id=4),
              ],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("has_trace"),
            @anode.hide(
              @tutuca.Expr::field("recording"),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm btn-ghost rec-clear"),
                  @anode.eid(2),
                ],
                [@anode.text(" Discard ")],
              ),
            ),
          ),
        ],
      ),
      @anode.text(" "),
      @anode.comment(
        " Inline rather than a view of its own: what a recording covers has to be asked in the place the Record button is, and a second template holding the same three buttons is a second place for them to drift. ",
      ),
      @anode.text(" "),
      @anode.show(
        @tutuca.Expr::field("picking"),
        @anode.h(
          "div",
          [@anode.attr("class", "recorder-picker flex flex-col gap-2 p-2")],
          [
            @anode.h("div", [@anode.attr("class", "text-sm")], [
              @anode.text("What should this recording cover?"),
            ]),
            @anode.h("div", [@anode.attr("class", "flex gap-2 flex-wrap")], [
              @anode.h(
                "button",
                [
                  @anode.dyn_attr("class", @tutuca.Expr::field("all_class")),
                  @anode.eid(3),
                ],
                [@anode.text("The whole storybook")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [
                  @anode.dyn_attr("class", @tutuca.Expr::field("section_class")),
                  @anode.eid(4),
                ],
                [@anode.text("The active section")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [
                  @anode.dyn_attr("class", @tutuca.Expr::field("example_class")),
                  @anode.eid(5),
                ],
                [@anode.text("This example only")],
              ),
            ]),
            @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
              @anode.text(
                " A narrower scope is not a filter applied afterwards — it is what gets mounted with a recorder on it, so nothing else is ever captured. You can still cut a recording down to one component when you stop. ",
              ),
            ]),
            @anode.h("div", [@anode.attr("class", "flex gap-2")], [
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm btn-primary picker-go"),
                  @anode.eid(6),
                ],
                [@anode.text("Start")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm btn-ghost picker-cancel"),
                  @anode.eid(7),
                ],
                [@anode.text("Cancel")],
              ),
            ]),
          ],
        ),
      ),
    ]),
    [
      [@anode.on("click", @tutuca.Expr::name("stop_recording"))],
      [@anode.on("click", @tutuca.Expr::name("open_picker"))],
      [@anode.on("click", @tutuca.Expr::name("clear_recording"))],
      [
        @anode.on("click", @tutuca.Expr::name("set_scope"), args=[
          @anode.const_str("all"),
        ]),
      ],
      [
        @anode.on("click", @tutuca.Expr::name("set_scope"), args=[
          @anode.const_str("section"),
        ]),
      ],
      [
        @anode.on("click", @tutuca.Expr::name("set_scope"), args=[
          @anode.const_str("example"),
        ]),
      ],
      [@anode.on("click", @tutuca.Expr::name("start_recording"))],
      [@anode.on("click", @tutuca.Expr::name("close_picker"))],
    ],
  )
}

