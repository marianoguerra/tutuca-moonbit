        }
        None => ()
      }
      Next(s)
    }
    Receive("close_picker", _args) => {
      let s = { ..s, picking: false, }
      guard s.turns.to_double() <= s.events.to_double() else {
        @tutuca.invariant_failed(
          handler="close_picker",
          pred="turns_are_events",
          sentence=(Num(s.turns.to_double()) : @tutuca.Value).to_display_string() +
            " turns out of " +
            (Num(s.events.to_double()) : @tutuca.Value).to_display_string() +
            " events",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            {
              field: "scope",
              domain: DOneOf([Str("all"), Str("section"), Str("example")]),
            },
            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
