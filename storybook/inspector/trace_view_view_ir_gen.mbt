            { field: "events", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turns", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="clear_recording",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// `invariant turns_are_events` from the `spec:` section. GENERATED — edit
/// the file, not this.
fn recorder_bar_compute_turns_are_events(
  s : RecorderBarState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (Bool(s.turns.to_double() <= s.events.to_double()) : @tutuca.Value)
}

///|
/// The `compute` names the file's `logic:` section answers.
/// GENERATED — edit the `logic:` section, not this.
fn recorder_bar_inline_compute() -> Map[
  String,
  (RecorderBarState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value,
] {
  { "turns_are_events": recorder_bar_compute_turns_are_events }
}

///|
/// The RecorderBar component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `RecorderBarState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn recorder_bar_component(
  name? : String = "RecorderBar",
  views? : Map[String, @anode.View] = recorder_bar_views(),
  initial? : RecorderBarState = RecorderBarState::zero(),
  common_style? : String = recorder_bar_common_style,
  global_style? : String = recorder_bar_global_style,
  update? : (RecorderBarState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    RecorderBarState,
  ],
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    initial~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match recorder_bar_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    compute=recorder_bar_inline_compute(),
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=trace_row_spec_source,
  )
}

///|
/// The compiled `main` view.
fn trace_panel_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("div", [@anode.attr("class", "trace-panel flex flex-col gap-2")], [
      @anode.h(
        "div",
        [
          @anode.attr(
            "class", "flex items-center gap-2 border-b border-base-content/10 px-2",
          ),
        ],
        [
          @anode.h(
            "button",
            [
              @anode.dyn_attr("class", @tutuca.Expr::field("record_tab_class")),
              @anode.eid(0),
            ],
            [@anode.text("Record")],
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("has_trace"),
            @anode.h(
              "button",
              [
                @anode.dyn_attr("class", @tutuca.Expr::field("trace_tab_class")),
                @anode.eid(1),
              ],
              [@anode.text("Trace")],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("has_trace"),
            @anode.h(
              "button",
              [
                @anode.dyn_attr(
                  "class",
                  @tutuca.Expr::field("replay_tab_class"),
                ),
                @anode.eid(2),
              ],
              [@anode.text("Replay")],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("has_trace"),
            @anode.h(
              "button",
              [
                @anode.dyn_attr(
                  "class",
                  @tutuca.Expr::field("select_tab_class"),
                ),
                @anode.eid(3),
              ],
              [@anode.dyn_text(@tutuca.Expr::field("select_label"), id=0)],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            @tutuca.Expr::field("has_trace"),
            @anode.h(
              "span",
              [
                @anode.attr(
                  "class", "ml-auto text-xs opacity-40 tabular-nums panel-pos",
                ),
              ],
              [
                @anode.dyn_text(@tutuca.Expr::field("at"), id=1),
                @anode.dyn_text(@anode.const_str(" / "), id=2),
                @anode.dyn_text(@tutuca.Expr::field("total"), id=3),
              ],
            ),
          ),
        ],
      ),
      @anode.text(" "),
      @anode.comment(
        " Above every pane, because it is about the thing the reader just did and not about the pane they happen to be looking at. A parse error on import belongs where they can see it without changing tabs. ",
      ),
      @anode.text(" "),
      @anode.show(
        @tutuca.Expr::field("has_notice"),
        @anode.h(
          "div",
          [
            @anode.attr(
              "class", "trace-notice alert alert-warning text-xs mx-2 py-1",
            ),
          ],
          [@anode.dyn_text(@tutuca.Expr::field("notice"), id=4)],
        ),
      ),
      @anode.text(" "),
      @anode.render(5, @tutuca.Expr::field("bar")),
      @anode.text(" "),
      @anode.show(
        @tutuca.Expr::field("show_trace"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-trace flex flex-col gap-2")],
          [
            @anode.h(
              "div",
              [@anode.attr("class", "flex items-center gap-2 px-2 flex-wrap")],
              [
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-sm btn-ghost trace-export"),
                    @anode.eid(4),
                  ],
                  [@anode.text(" Download ")],
                ),
                @anode.text(" "),
                @anode.comment(
                  " Enabled by a pick, and the pick is a separate press for the reason the host's comment gives: choosing a place is the thing a person does several times before they mean it. ",
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-sm btn-ghost trace-cut"),
                    @anode.eid(5),
                  ],
                  [@anode.text(" Cut to the picked place ")],
                ),
              ],
            ),
            @anode.text(" "),
            @anode.render(6, @tutuca.Expr::field("header")),
            @anode.text(" "),
            @anode.render(7, @tutuca.Expr::field("places")),
            @anode.text(" "),
            @anode.render(8, @tutuca.Expr::field("log")),
          ],
        ),
      ),
      @anode.text(" "),
      @anode.comment(
        " The rerun. It drives the STORY, not a preview of one: the gallery is a single transactor with every story mounted under it, so the events go into the instance already on screen and the reader watches it move. ",
      ),
      @anode.text(" "),
      @anode.show(
        @tutuca.Expr::field("show_replay"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-replay flex flex-col gap-2 p-2")],
          [
            @anode.show(
              @tutuca.Expr::field("can_replay"),
              @anode.h("div", [@anode.attr("class", "flex gap-2 flex-wrap")], [
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-sm btn-primary replay-step"),
                    @anode.eid(6),
                  ],
                  [@anode.text("Step")],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [@anode.attr("class", "btn btn-sm replay-run"), @anode.eid(7)],
                  [@anode.text("Run")],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-sm btn-ghost replay-reset"),
                    @anode.eid(8),
                  ],
                  [@anode.text("Reset")],
                ),
                @anode.text(" "),
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "text-xs opacity-60 tabular-nums replay-pos self-center",
                    ),
                  ],
                  [
                    @anode.dyn_text(@tutuca.Expr::field("at"), id=9),
                    @anode.dyn_text(@anode.const_str(" of "), id=10),
                    @anode.dyn_text(@tutuca.Expr::field("total"), id=11),
                  ],
                ),
              ]),
            ),
            @anode.text(" "),
            @anode.show(
              @tutuca.Expr::field("can_replay"),
              @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
                @anode.text(
                  " The story above is the one being driven. A step feeds one whole turn — what the recording drained together — so the app is never left mid-cascade in a state it was never in. ",
                ),
              ]),
            ),
          ],
        ),
      ),
      @anode.text(" "),
      @anode.comment(
        " Import lives on the empty pane as well as the full one: the reader who has no recording is exactly the reader who wants to load somebody else's. ",
      ),
      @anode.text(" "),
      @anode.show(
        @tutuca.Expr::field("show_import"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-import flex flex-col gap-2 p-2")],
          [
            @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
              @anode.text("Paste a .trace.jsonl to load it."),
            ]),
            @anode.text(" "),
            @anode.h(
              "textarea",
              [
                @anode.attr("class", "textarea textarea-sm trace-draft"),
                @anode.attr("rows", "3"),
                @anode.dyn_attr("value", @tutuca.Expr::field("draft")),
                @anode.eid(9),
              ],
              [],
            ),
            @anode.text(" "),
            @anode.h("div", [], [
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm trace-import"),
                  @anode.eid(10),
                ],
                [@anode.text("Load")],
              ),
            ]),
          ],
        ),
      ),
      @anode.text(" "),
      @anode.hide(
        @tutuca.Expr::field("has_trace"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-empty flex flex-col gap-2 px-2 pb-2")],
          [
            @anode.h("div", [@anode.attr("class", "text-xs opacity-40")], [
              @anode.text(
                " Nothing recorded yet. Press Record, use the component, then stop — or paste a recording somebody else made. ",
              ),
            ]),
            @anode.text(" "),
            @anode.h(
              "textarea",
              [
                @anode.attr("class", "textarea textarea-sm trace-draft-empty"),
                @anode.attr("rows", "3"),
                @anode.dyn_attr("value", @tutuca.Expr::field("draft")),
                @anode.eid(11),
              ],
              [],
            ),
            @anode.text(" "),
            @anode.h("div", [], [
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm trace-import-empty"),
                  @anode.eid(12),
                ],
                [@anode.text("Load")],
              ),
            ]),
          ],
        ),
      ),
    ]),
    [
      [
        @anode.on("click", @tutuca.Expr::name("set_tab"), args=[
          @anode.const_str("record"),
        ]),
      ],
      [
        @anode.on("click", @tutuca.Expr::name("set_tab"), args=[
          @anode.const_str("trace"),
        ]),
      ],
      [
        @anode.on("click", @tutuca.Expr::name("set_tab"), args=[
          @anode.const_str("replay"),
        ]),
      ],
      [@anode.on("click", @tutuca.Expr::name("toggle_selecting"))],
      [@anode.on("click", @tutuca.Expr::name("export_trace"))],
      [@anode.on("click", @tutuca.Expr::name("cut_to_place"))],
      [@anode.on("click", @tutuca.Expr::name("replay_step"))],
      [@anode.on("click", @tutuca.Expr::name("replay_run"))],
      [@anode.on("click", @tutuca.Expr::name("replay_reset"))],
      [
        @anode.on(
          "input",
          @anode.const_null(),
          binding=@anode.BindString,
          action=@anode.set_property_action(
            "draft",
            @tutuca.Expr::event_path(["value"]),
          ),
        ),
      ],
      [@anode.on("click", @tutuca.Expr::name("import_draft"))],
      [
        @anode.on(
          "input",
          @anode.const_null(),
          binding=@anode.BindString,
          action=@anode.set_property_action(
            "draft",
            @tutuca.Expr::event_path(["value"]),
          ),
        ),
      ],
      [@anode.on("click", @tutuca.Expr::name("import_draft"))],
    ],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn trace_panel_views() -> Map[String, @anode.View] {
  { "main": trace_panel_main_view_ir() }
}

///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn trace_panel_inline_update(
  s : TracePanelState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[TracePanelState] {
  match msg {
    Receive("toggle_selecting", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "trace_select",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      guard s.at.to_double() <= s.total.to_double() else {
