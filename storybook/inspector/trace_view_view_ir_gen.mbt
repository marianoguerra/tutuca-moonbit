  match msg {
    Receive("setTurn", args) => {
      guard args.get(0) is Some(Num(t_)) else { return Unchanged }
      let s = { ..s, turn: t_.to_int(), }
      guard (Bool(s.hasRows) : @tutuca.Value) ==
        (Bool(s.rows.length().to_double() > 0.0) : @tutuca.Value) else {
        @tutuca.invariant_failed(
          handler="setTurn",
          pred="hasRowsTracksRows",
          sentence="hasRows says " +
            (Bool(s.hasRows) : @tutuca.Value).to_display_string() +
            " for " +
            (Num(s.rows.length().to_double()) : @tutuca.Value).to_display_string() +
            " rows",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [{ field: "turn", domain: DCompare(op=DGe, rhs=DLit(0)), }],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="setTurn",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    Receive("showAllTurns", _args) => {
      let s = { ..s, turn: 0, }
      guard (Bool(s.hasRows) : @tutuca.Value) ==
        (Bool(s.rows.length().to_double() > 0.0) : @tutuca.Value) else {
        @tutuca.invariant_failed(
          handler="showAllTurns",
          pred="hasRowsTracksRows",
          sentence="hasRows says " +
            (Bool(s.hasRows) : @tutuca.Value).to_display_string() +
            " for " +
            (Num(s.rows.length().to_double()) : @tutuca.Value).to_display_string() +
            " rows",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [{ field: "turn", domain: DCompare(op=DGe, rhs=DLit(0)), }],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="showAllTurns",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
