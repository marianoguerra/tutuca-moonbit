///|
/// The TracePanel component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `TracePanelState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn trace_panel_component(
  name? : String = "TracePanel",
  views? : Map[String, @anode.View] = trace_panel_views(),
  init? : TracePanelState = TracePanelState::zero(),
  common_style? : String = trace_panel_common_style,
  global_style? : String = trace_panel_global_style,
  update? : (TracePanelState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    TracePanelState,
  ],
  swap? : (TracePanelInput) -> ((
    TracePanelState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match trace_panel_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    compute=trace_panel_inline_compute(),
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          (
            [
              CutToPlace,
              ExportTrace,
              ImportDraft,
              ReplayReset,
              ReplayRun,
              ReplayStep,
              SetTab,
              ToggleSelecting,
            ] : Array[TracePanelInput]),
          TracePanelInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=trace_row_spec_source,
  )
}
