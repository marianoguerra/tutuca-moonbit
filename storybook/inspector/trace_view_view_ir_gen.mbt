///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn trace_row_inline_update(
  s : TraceRowState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[TraceRowState] {
  match msg {
    Receive("toggle", _args) => {
      let s = { ..s, open: !s.open, }
      guard (Bool(s.hasWalk) : @tutuca.Value) ==
        (
          Bool(
            !((Num(s.walk.to_double()) : @tutuca.Value) ==
            (Num(0.0) : @tutuca.Value)),
          ) : @tutuca.Value) else {
        @tutuca.invariant_failed(
          handler="toggle",
          pred="hasWalkTracksWalk",
          sentence="hasWalk says " +
            (Bool(s.hasWalk) : @tutuca.Value).to_display_string() +
            " for walk " +
            (Num(s.walk.to_double()) : @tutuca.Value).to_display_string(),
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      let domain_fields = @component.Fields::encode(s)
      match
        @tutuca.first_broken_domain(
          [
            {
              field: "verb",
              domain: DOneOf(["send", "intent", "offered", "answer", "refused"]),
            },
            { field: "seq", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "turn", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "walk", domain: DCompare(op=DGe, rhs=DLit(0)), },
            { field: "depth", domain: DCompare(op=DGe, rhs=DLit(0)), },
          ],
          domain_fields,
        ) {
        Some(domain_broke) => {
          @tutuca.domain_failed(
            handler="toggle",
            field=domain_broke.field,
            sentence=@tutuca.broken_domain_sentence(domain_broke, domain_fields),
            state=(Map(domain_fields) : @tutuca.Value),
          )
          return Unchanged
        }
        None => ()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

