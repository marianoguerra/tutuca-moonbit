        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([PickPlace] : Array[TracePlaceInput]),
          TracePlaceInput::name,
