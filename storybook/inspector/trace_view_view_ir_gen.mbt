            @anode.h(
              "button",
              [
                @anode.attr("class", "btn btn-sm btn-primary rec-start"),
                @anode.eid(1),
              ],
              [@anode.text("\n      Record\n    ")],
            ),
          ),
          @anode.text(" "),
          @anode.h(
            "span",
            [@anode.attr("class", "badge badge-sm badge-ghost rec-scope")],
            [@anode.dyn_text(Field("scopeLabel"))],
          ),
          @anode.text(" "),
          @anode.show(
            Field("recording"),
            @anode.h(
              "span",
              [
                @anode.attr(
                  "class", "text-xs opacity-60 tabular-nums rec-count",
                ),
              ],
              [
                @anode.dyn_text(Field("events"), id=0),
                @anode.dyn_text(@anode.const_str(" events · "), id=1),
                @anode.dyn_text(Field("turns"), id=2),
                @anode.dyn_text(@anode.const_str(" turns"), id=3),
              ],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasTrace"),
            @anode.hide(
              Field("recording"),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm btn-ghost rec-clear"),
                  @anode.eid(2),
                ],
                [@anode.text("\n      Discard\n    ")],
              ),
            ),
          ),
        ],
      ),
      @anode.text(" "),
      @anode.comment(
        " Inline rather than a view of its own: what a recording covers has to be\n       asked in the place the Record button is, and a second template holding\n       the same three buttons is a second place for them to drift. ",
      ),
      @anode.text(" "),
      @anode.show(
        Field("picking"),
        @anode.h(
          "div",
          [@anode.attr("class", "recorder-picker flex flex-col gap-2 p-2")],
          [
            @anode.h("div", [@anode.attr("class", "text-sm")], [
              @anode.text("What should this recording cover?"),
            ]),
            @anode.h("div", [@anode.attr("class", "flex gap-2 flex-wrap")], [
              @anode.h(
                "button",
                [@anode.dyn_attr("class", Field("allClass")), @anode.eid(3)],
                [@anode.text("The whole storybook")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [@anode.dyn_attr("class", Field("sectionClass")), @anode.eid(4)],
                [@anode.text("The active section")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [@anode.dyn_attr("class", Field("exampleClass")), @anode.eid(5)],
                [@anode.text("This example only")],
              ),
            ]),
            @anode.h("div", [@anode.attr("class", "text-xs opacity-50")], [
              @anode.text(
                "\n    A narrower scope is not a filter applied afterwards — it is what gets mounted with a\n    recorder on it, so nothing else is ever captured. You can still cut a recording down\n    to one component when you stop.\n  ",
              ),
            ]),
            @anode.h("div", [@anode.attr("class", "flex gap-2")], [
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm btn-primary picker-go"),
                  @anode.eid(6),
                ],
                [@anode.text("Start")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-sm btn-ghost picker-cancel"),
                  @anode.eid(7),
                ],
                [@anode.text("Cancel")],
              ),
            ]),
          ],
        ),
      ),
    ]),
    [
      [@anode.on("click", HandlerName(name="stopRecording", ns=Receive))],
      [@anode.on("click", HandlerName(name="openPicker", ns=Receive))],
      [@anode.on("click", HandlerName(name="clearRecording", ns=Receive))],
      [
        @anode.on("click", HandlerName(name="setScope", ns=Receive), args=[
          @anode.const_str("all"),
        ]),
      ],
      [
        @anode.on("click", HandlerName(name="setScope", ns=Receive), args=[
          @anode.const_str("section"),
        ]),
      ],
      [
        @anode.on("click", HandlerName(name="setScope", ns=Receive), args=[
          @anode.const_str("example"),
        ]),
      ],
      [@anode.on("click", HandlerName(name="startRecording", ns=Receive))],
      [@anode.on("click", HandlerName(name="closePicker", ns=Receive))],
    ],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn recorder_bar_views() -> Map[String, @anode.View] {
  { "main": recorder_bar_main_view_ir() }
}

///|
/// The dispatches the `<script type="tutuca/script">` block answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn recorder_bar_inline_update(
  s : RecorderBarState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[RecorderBarState] {
  match msg {
    Receive("setScope", args) => {
      guard args.get(0) is Some(Str(s_)) else { return Unchanged }
      let s = { ..s, scope: s_, }
      let s = {
        ..s,
        scopeLabel: if (Str(s_) : @tutuca.Value) ==
          (Str("section") : @tutuca.Value) {
          "the active section"
        } else if (Str(s_) : @tutuca.Value) == (Str("example") : @tutuca.Value) {
          "this example"
        } else {
          "the whole storybook"
        },
      }
      let s = {
        ..s,
        allClass: if (Str(s_) : @tutuca.Value) == (Str("all") : @tutuca.Value) {
          "btn btn-sm pick-all btn-primary"
        } else {
          "btn btn-sm pick-all btn-outline"
        },
      }
      let s = {
        ..s,
        sectionClass: if (Str(s_) : @tutuca.Value) ==
          (Str("section") : @tutuca.Value) {
          "btn btn-sm pick-section btn-primary"
        } else {
          "btn btn-sm pick-section btn-outline"
        },
      }
      let s = {
        ..s,
        exampleClass: if (Str(s_) : @tutuca.Value) ==
          (Str("example") : @tutuca.Value) {
          "btn btn-sm pick-example btn-primary"
        } else {
          "btn btn-sm pick-example btn-outline"
        },
      }
      Next(s)
    }
    Receive("openPicker", _args) => {
      let s = { ..s, picking: true, }
      Next(s)
    }
    Receive("closePicker", _args) => {
      let s = { ..s, picking: false, }
      Next(s)
    }
    Receive("startRecording", _args) => {
      let effects : Array[() -> Unit] = []
      let s = { ..s, picking: false, }
      effects.push(() => {
        ctx.intent(
          "traceStart",
          [(Str(s.scope) : @tutuca.Value)],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("stopRecording", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "traceStop",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("clearRecording", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "traceDiscard",
          [],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Lex]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// The RecorderBar component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `RecorderBarState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn recorder_bar_component(
  name? : String = "RecorderBar",
  views? : Map[String, @anode.View] = recorder_bar_views(),
  init? : RecorderBarState = RecorderBarState::zero(),
  common_style? : String = recorder_bar_common_style,
  global_style? : String = recorder_bar_global_style,
  update? : (RecorderBarState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    RecorderBarState,
  ],
  swap? : (RecorderBarInput) -> ((
    RecorderBarState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match recorder_bar_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          (
            [
              ClearRecording,
              ClosePicker,
              OpenPicker,
              SetScope,
              StartRecording,
              StopRecording,
            ] : Array[RecorderBarInput]),
          RecorderBarInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
  )
}

///|
/// The compiled `main` view.
fn trace_panel_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("div", [@anode.attr("class", "trace-panel flex flex-col gap-2")], [
      @anode.h(
        "div",
        [
          @anode.attr(
            "class", "flex items-center gap-2 border-b border-base-content/10 px-2",
          ),
        ],
        [
          @anode.h(
            "button",
            [@anode.dyn_attr("class", Field("recordTabClass")), @anode.eid(0)],
            [@anode.text("Record")],
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasTrace"),
            @anode.h(
              "button",
              [@anode.dyn_attr("class", Field("traceTabClass")), @anode.eid(1)],
              [@anode.text("Trace")],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasTrace"),
            @anode.h(
              "button",
              [@anode.dyn_attr("class", Field("selectTabClass")), @anode.eid(2)],
              [@anode.dyn_text(Field("selectLabel"))],
            ),
          ),
          @anode.text(" "),
          @anode.show(
            Field("hasTrace"),
            @anode.h(
              "span",
              [
                @anode.attr(
                  "class", "ml-auto text-xs opacity-40 tabular-nums panel-pos",
                ),
              ],
              [
                @anode.dyn_text(Field("at"), id=0),
                @anode.dyn_text(@anode.const_str(" / "), id=1),
                @anode.dyn_text(Field("total"), id=2),
              ],
            ),
          ),
        ],
      ),
      @anode.text(" "),
      @anode.render(3, Field("bar")),
      @anode.text(" "),
      @anode.show(
        Field("showTrace"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-trace flex flex-col gap-2")],
          [
            @anode.render(4, Field("header")),
            @anode.text(" "),
            @anode.render(5, Field("places")),
            @anode.text(" "),
            @anode.render(6, Field("log")),
          ],
        ),
      ),
      @anode.text(" "),
      @anode.hide(
        Field("hasTrace"),
        @anode.h(
          "div",
          [@anode.attr("class", "panel-empty text-xs opacity-40 px-2 pb-2")],
          [
            @anode.text(
              "\n    Nothing recorded yet. Press Record, use the component, then stop.\n  ",
            ),
          ],
        ),
      ),
    ]),
    [
      [
        @anode.on("click", HandlerName(name="setTab", ns=Receive), args=[
          @anode.const_str("record"),
        ]),
      ],
      [
        @anode.on("click", HandlerName(name="setTab", ns=Receive), args=[
          @anode.const_str("trace"),
        ]),
      ],
      [@anode.on("click", HandlerName(name="toggleSelecting", ns=Receive))],
    ],
  )
}

///|
