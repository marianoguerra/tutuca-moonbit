///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn trace_log_inline_update(
  s : TraceLogState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[TraceLogState] {
  match msg {
    Receive("setTurn", args) => {
      guard args.get(0) is Some(Num(t_)) else { return Unchanged }
      let s = { ..s, turn: t_.to_int(), }
      Next(s)
    }
    Receive("showAllTurns", _args) => {
      let s = { ..s, turn: 0, }
      Next(s)
    }
    _ => Unhandled
  }
}

