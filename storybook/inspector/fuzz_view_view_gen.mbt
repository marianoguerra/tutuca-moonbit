        field: "kind",
        domain: DOneOf([
          Str("none"),
          Str("held"),
          Str("broke"),
          Str("disagreed"),
          Str("stuck"),
        ]),
      },
      { field: "at", domain: DCompare(op=DGe, rhs=DLit(-1)), },
