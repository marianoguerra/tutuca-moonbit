  /// `held`, `broke`, `disagreed` or `none`.
  kind : String
  badge_class : String
  headline : String
  /// The rule's own `format` — the sentence its author wrote for exactly
  /// this moment, which is why it is carried rather than recomposed.
  sentence : String
  rule : String
  at : Int
  /// Rules the block declares that `@core.Expr` could not lower, so the run
  /// is quieter than a green verdict looks.
  unchecked : String
  has_unchecked : Bool
  /// The shrunk reproducer, as dispatch lines.
  reproducer : Array[@tutuca.Value]
  has_reproducer : Bool
}

///|
/// The zero state: every field at its type's empty value.
///
/// The `spec:` section states no defaults here — a default is a value,
/// not a type — so this is type-directed, and `init` spreads it to name
/// only what differs:
///
///   initial={ ..FuzzVerdictState::zero(), label: "Counter" }
pub fn FuzzVerdictState::zero() -> FuzzVerdictState {
  {
    kind: "",
    badge_class: "",
    headline: "",
    sentence: "",
    rule: "",
    at: 0,
    unchecked: "",
    has_unchecked: false,
    reproducer: [],
    has_reproducer: false,
  }
}

///|
/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through. That is the case a JSON round trip could not do at all: an
/// `Obj` or an `Fn` does not survive one.
impl @component.Fields for FuzzVerdictState with fn encode(s) {
  {
    "kind": Str(s.kind),
    "badge_class": Str(s.badge_class),
    "headline": Str(s.headline),
    "sentence": Str(s.sentence),
    "rule": Str(s.rule),
    "at": Num(s.at.to_double()),
    "unchecked": Str(s.unchecked),
    "has_unchecked": Bool(s.has_unchecked),
    "reproducer": (List(s.reproducer.map(x => x)) : @tutuca.Value),
    "has_reproducer": Bool(s.has_reproducer),
  }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
impl @component.Fields for FuzzVerdictState with fn decode(f) {
  guard f.get("kind") is Some(Str(v_kind)) else { return None }
  guard f.get("badge_class") is Some(Str(v_badge_class)) else { return None }
  guard f.get("headline") is Some(Str(v_headline)) else { return None }
  guard f.get("sentence") is Some(Str(v_sentence)) else { return None }
  guard f.get("rule") is Some(Str(v_rule)) else { return None }
  guard f.get("at") is Some(Num(t1_at)) else { return None }
  let v_at = t1_at.to_int()
  guard f.get("unchecked") is Some(Str(v_unchecked)) else { return None }
  guard f.get("has_unchecked") is Some(Bool(v_has_unchecked)) else {
    return None
  }
  guard f.get("reproducer") is Some(t1_reproducer) else { return None }
  guard t1_reproducer is List(u1_reproducer) else { return None }
  let v_reproducer : Array[@tutuca.Value] = []
  for e1_reproducer in u1_reproducer {
    let x1_reproducer = e1_reproducer
    v_reproducer.push(x1_reproducer)
  }
  guard f.get("has_reproducer") is Some(Bool(v_has_reproducer)) else {
    return None
  }
  Some({
    kind: v_kind,
    badge_class: v_badge_class,
    headline: v_headline,
    sentence: v_sentence,
    rule: v_rule,
    at: v_at,
    unchecked: v_unchecked,
    has_unchecked: v_has_unchecked,
    reproducer: v_reproducer,
    has_reproducer: v_has_reproducer,
  })
}

///|
/// The Receive arm of @component.Dispatch, decoded.
///
/// Every addressed name: the `message` the `spec:` section declares,
/// plus every bare `~on_<event>` handler the views write. One bucket holds
/// them
/// however they were sent, so one type covers it — where the two overlap
/// the schema's declared payload wins, and a view whose call sites
/// disagree with it is a build error.
///
/// The script block answers shrink, so an `update` arm for
/// one of those can never run — the wrapper consults `update` only for a
/// dispatch the block did not claim. They are still here because raising
/// one is what a parent does, and `to_dispatch` is how.
pub(all) enum FuzzVerdictMsg {
  Shrink
  /// A message the schema does not declare, or a declared name whose
  /// runtime arguments did not match the declared types.
  Unknown(String, Array[@tutuca.Value])
}

///|
/// Decode a Receive dispatch. None for any other bucket.
///
/// A payload that does not match falls into `Unknown` rather than being
/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,
/// and silently truncating it would hide that.
///
/// It is also REPORTED. `Unknown` answers two different questions —
/// nobody declares this name, and this name is declared here and was
/// handed the wrong shape — and the second one is a bug in the sender
/// that used to be indistinguishable from silence. Every arm below that
/// can fail on a DECLARED name says so through `@tutuca.bad_payload`,
/// which costs nothing unless a host is listening.
pub fn FuzzVerdictMsg::from_dispatch(
  d : @component.Dispatch,
) -> FuzzVerdictMsg? {
  guard d is Receive(name, args) else { return None }
  Some(
    match (name, args) {
      ("shrink", []) => Shrink
      _ => {
        match name {
          "shrink" => @tutuca.bad_payload(name, "", args)
          _ => ()
        }
        Unknown(name, args)
      }
    },
  )
}

///|
/// The dispatch name and arguments this message raises as.
pub fn FuzzVerdictMsg::to_dispatch(
  self : FuzzVerdictMsg,
) -> (String, Array[@tutuca.Value]) {
  match self {
    Shrink => ("shrink", [])
    Unknown(n, args) => (n, args)
  }
}

///|
/// Send this message to self; it arrives as a later Receive dispatch.
///
/// The name comes from the schema, so it cannot drift from the one
/// `from_dispatch` decodes.
pub fn FuzzVerdictMsg::send(self : FuzzVerdictMsg, ctx : &@tutuca.Ctx) -> Unit {
  let (name, args) = self.to_dispatch()
  ctx.send(name, args)
}

