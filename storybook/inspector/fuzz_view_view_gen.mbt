///|
/// The verdict, in the words the declaration used.
///
/// Declared as `state` in the state block. Adding a field there adds it
/// here, so a view that reads it type-checks and one that reads a name
/// this struct lacks fails generation.
pub(all) struct FuzzVerdictState {
  /// `held`, `broke`, `disagreed` or `none`.
  kind : String
  badgeClass : String
  headline : String
  /// The rule's own `format` — the sentence its author wrote for exactly
  /// this moment, which is why it is carried rather than recomposed.
  sentence : String
  rule : String
  at : Int
  /// Rules the block declares that `@core.Val` could not lower, so the run
  /// is quieter than a green verdict looks.
  unchecked : String
  hasUnchecked : Bool
  /// The shrunk reproducer, as dispatch lines.
  reproducer : Array[@tutuca.Value]
  hasReproducer : Bool
}

