/// answers `schema()` with, so a holder of a bare `@tutuca.Value`
/// can name these fields without a component registry.
impl @component.Fields for FuzzVerdictState with fn schema() {
  @component.SchemaInfo::new(
    name="FuzzVerdict",
    fingerprint="483dbd7bc2520f55",
    fields=[
      @component.FieldInfo::new("kind", TyText),
      @component.FieldInfo::new("badge_class", TyText),
      @component.FieldInfo::new("headline", TyText),
      @component.FieldInfo::new("sentence", TyText),
      @component.FieldInfo::new("rule", TyText),
      @component.FieldInfo::new("at", TyInt(width=32, signed=true)),
      @component.FieldInfo::new("unchecked", TyText),
      @component.FieldInfo::new("has_unchecked", TyBool),
      @component.FieldInfo::new("reproducer", TyList(TyComp(Some("FuzzRow")))),
      @component.FieldInfo::new("has_reproducer", TyBool),
    ],
    view_handlers=["shrink"],
    methods=[
      "findings_name_their_rule", "has_reproducer_tracks_reproducer", "has_unchecked_tracks_unchecked",
    ],
    invariants=[
      "findings_name_their_rule", "has_reproducer_tracks_reproducer", "has_unchecked_tracks_unchecked",
    ],
    domains=[
      {
        field: "kind",
        domain: DOneOf([
          Str("none"),
          Str("held"),
          Str("broke"),
          Str("disagreed"),
          Str("stuck"),
        ]),
      },
      { field: "at", domain: DCompare(op=DGe, rhs=DLit(-1)), },
    ],
    view_names=["main"],
  )
}

///|
/// The state of the FuzzPanel component.
///
/// Declared with `field` in the `spec:` section. Adding one there adds it
/// here, so a view that reads it type-checks and one that reads a name
/// this struct lacks fails generation.
pub(all) struct FuzzPanelState {
  controls : @tutuca.Value
  verdict : @tutuca.Value
  log : @tutuca.Value
  has_run : Bool
  /// Cursor position, 1-based for display.
  at : Int
  total : Int
}

///|
/// The zero state: every field at its type's empty value.
///
/// The `spec:` section states no defaults here — a default is a value,
/// not a type — so this is type-directed, and `init` spreads it to name
/// only what differs:
///
///   initial={ ..FuzzPanelState::zero(), label: "Counter" }
pub fn FuzzPanelState::zero() -> FuzzPanelState {
  { controls: Null, verdict: Null, log: Null, has_run: false, at: 0, total: 0, }
}

///|
/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through. That is the case a JSON round trip could not do at all: an
/// `Obj` or an `Fn` does not survive one.
impl @component.Fields for FuzzPanelState with fn encode(s) {
  {
    "controls": s.controls,
    "verdict": s.verdict,
    "log": s.log,
    "has_run": Bool(s.has_run),
    "at": Num(s.at.to_double()),
    "total": Num(s.total.to_double()),
  }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
impl @component.Fields for FuzzPanelState with fn decode(f) {
  let v_controls = f.get("controls").unwrap_or(Null)
  let v_verdict = f.get("verdict").unwrap_or(Null)
  let v_log = f.get("log").unwrap_or(Null)
  guard f.get("has_run") is Some(Bool(v_has_run)) else { return None }
  guard f.get("at") is Some(Num(t1_at)) else { return None }
  let v_at = t1_at.to_int()
  guard f.get("total") is Some(Num(t1_total)) else { return None }
  let v_total = t1_total.to_int()
  Some({
    controls: v_controls,
    verdict: v_verdict,
    log: v_log,
    has_run: v_has_run,
    at: v_at,
    total: v_total,
  })
}

