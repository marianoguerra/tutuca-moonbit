// Port of the tutuca inspector component library (src/components/ in the JS
// repo, shipped there as `tutuca/components`): pure tutuca components that
// render inspectors as collapsible trees — any Value, a JSON Schema, a
// component descriptor snapshot, a live instance, lint findings, and dispatch
// activity (transactor.observe).
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/transactor",
  "marianoguerra/tutuca/trace",
  // The Fuzz pane's rows ARE `@fuzz.Step`s — a projection of the driver's own
  // values, the way the trace rows project a `@trace.Event`.
  "marianoguerra/tutuca/testing/fuzz",
  "moonbitlang/core/cmp",
  // parse_double: a text control hands back a String for a numeric field
  "moonbitlang/core/string",
  "moonbitlang/core/json",
  // the generated *_view_gen.mbt modules derive @debug.Debug on their
  // vocabulary enums
  "moonbitlang/core/debug",
}

// The headless harness (@harness) mounts the inspector module as a live app on
// the in-memory DOM.
import {
  "marianoguerra/tutuca/testing/harness",
  "marianoguerra/tutuca/render",
  "moonbitlang/core/test",
} for "test"

// The whitebox suite drives the Fuzz pane's own fixture through the real
// driver, so the hand-built example steps cannot drift from the component they
// describe. Whitebox because that fixture is package-private, which it should
// stay.
import {
  "marianoguerra/tutuca/testing/harness",
} for "wbtest"
