    @anode.h(
      "span",
      [@anode.attr("class", "font-mono text-sm leading-tight inline-block")],
      [
        @anode.h(
          "span",
          [@anode.attr("class", "inline-flex items-center gap-2")],
          [
            @anode.h(
              "button",
              [
                @anode.attr("type", "button"),
                @anode.attr(
                  "class", "cursor-pointer text-base-content/70 hover:text-base-content inline-flex items-center gap-1",
                ),
                @anode.dyn_attr(
                  "disabled",
                  @tutuca.Expr::method_("isItemsEmpty"),
                ),
                @anode.eid(0),
              ],
              [
                @anode.h("span", [], [
                  @anode.dyn_text(@tutuca.Expr::method_("arrowText")),
                ]),
                @anode.text(" "),
                @anode.h("span", [@anode.attr("class", "json-object")], [
                  @anode.dyn_text(@tutuca.Expr::method_("typeText")),
                ]),
                @anode.text(" "),
                @anode.h("span", [], [
                  @anode.dyn_text(@tutuca.Expr::method_("countText")),
                ]),
              ],
            ),
            @anode.text(" "),
            @anode.show(
              @tutuca.Expr::method_("showPagination"),
              @anode.h("div", [@anode.attr("class", "join")], [
                @anode.h(
                  "button",
                  [
                    @anode.attr("type", "button"),
                    @anode.attr("class", "join-item btn btn-xs pg-prev"),
                    @anode.dyn_attr(
                      "disabled",
                      @tutuca.Expr::method_("cannotPrevPage"),
                    ),
                    @anode.eid(1),
                  ],
                  [@anode.text("«")],
                ),
                @anode.text(" "),
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "join-item badge font-mono text-xs pg-label",
                    ),
                  ],
                  [@anode.dyn_text(@tutuca.Expr::method_("pageIndicatorText"))],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr("type", "button"),
                    @anode.attr("class", "join-item btn btn-xs pg-next"),
                    @anode.dyn_attr(
                      "disabled",
                      @tutuca.Expr::method_("cannotNextPage"),
                    ),
                    @anode.eid(2),
                  ],
                  [@anode.text("»")],
                ),
              ]),
            ),
          ],
        ),
        @anode.text(" "),
        @anode.show(
          @tutuca.Expr::field("isExpanded"),
          @anode.h(
            "div",
            [
              @anode.attr(
                "class", "ml-1 flex flex-col gap-0.5 border-l border-base-content/10 pl-2 mt-0.5",
              ),
            ],
            [
              @anode.each(
                1,
                @tutuca.Expr::field("items"),
                @anode.render_it(0),
                loop_with_val=@tutuca.Expr::name("getPageRange"),
                from_render_each=true,
              ),
            ],
          ),
        ),
      ],
    ),
    [
      [
        @anode.on(
          "click",
          @anode.const_null(),
          action=@anode.set_property_action(
            "isExpanded",
            @tutuca.Expr::app("not", [@tutuca.Expr::field("isExpanded")]),
          ),
        ),
      ],
      [@anode.on("click", @tutuca.Expr::name("prevPage"))],
      [@anode.on("click", @tutuca.Expr::name("nextPage"))],
    ],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn json_object_views() -> Map[String, @anode.View] {
  { "main": json_object_main_view_ir() }
}

///|
/// `invariant pageExists` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn json_object_compute_pageExists(
  s : JsonObjectState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      (Num(s.currentPage.to_double()) : @tutuca.Value) ==
      (Num(0.0) : @tutuca.Value) ||
      s.currentPage.to_double() * s.itemsPerPage.to_double() <
      s.items.length().to_double(),
    ) : @tutuca.Value)
}

///|
/// The `compute` names the `<script type="tutuca/script">` block answers.
/// GENERATED — edit the block, not this.
fn json_object_inline_compute() -> Map[
  String,
  (JsonObjectState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value,
] {
  { "pageExists": json_object_compute_pageExists }
}

///|
/// The JsonObject component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `JsonObjectState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn json_object_component(
  name? : String = "JsonObject",
  views? : Map[String, @anode.View] = json_object_views(),
  initial? : JsonObjectState = JsonObjectState::zero(),
  common_style? : String = json_object_common_style,
  global_style? : String = json_object_global_style,
  update? : (JsonObjectState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    JsonObjectState,
  ],
  compute? : (JsonObjectCompute) -> ((
    JsonObjectState,
    Array[@tutuca.Value],
    &@tutuca.Stack,
  ) -> @tutuca.Value)?,
  loop_with? : (JsonObjectLoopWith) -> ((
    JsonObjectState,
    @tutuca.Value,
    @component.LoopCtx,
  ) -> @component.LoopWith)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    initial~,
    common_style~,
    global_style~,
    update?,
    compute={
      let bucket = match compute {
        Some(f) =>
          @component.build_bucket(
            (
              [
                ArrowText,
                CannotNextPage,
                CannotPrevPage,
                CountText,
                IsItemsEmpty,
                PageIndicatorText,
                ShowPagination,
                TypeText,
              ] : Array[JsonObjectCompute]),
            JsonObjectCompute::name,
            f,
          )
        None => Map([])
      }
      for k, h in json_object_inline_compute() {
        bucket[k] = h
      }
      bucket
    },
    loop_with=match loop_with {
      Some(f) =>
        @component.build_bucket(
          ([GetPageRange] : Array[JsonObjectLoopWith]),
          JsonObjectLoopWith::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=json_null_spec_source,
  )
}

