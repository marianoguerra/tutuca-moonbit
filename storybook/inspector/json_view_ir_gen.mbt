///|
/// The compiled `main` view.
fn json_array_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "span",
      [@anode.attr("class", "font-mono text-sm leading-tight inline-block")],
      [
        @anode.h(
          "span",
          [@anode.attr("class", "inline-flex items-center gap-2")],
          [
            @anode.h(
              "button",
              [
                @anode.attr("type", "button"),
                @anode.attr(
                  "class", "cursor-pointer text-base-content/70 hover:text-base-content inline-flex items-center gap-1",
                ),
                @anode.dyn_attr(
                  "disabled",
                  @tutuca.Expr::method_("isItemsEmpty"),
                ),
                @anode.eid(0),
              ],
              [
                @anode.h("span", [], [
                  @anode.dyn_text(@tutuca.Expr::method_("arrowText")),
                ]),
                @anode.text(" "),
                @anode.h("span", [@anode.attr("class", "json-array")], [
                  @anode.dyn_text(@tutuca.Expr::method_("typeText")),
                ]),
                @anode.text(" "),
                @anode.h("span", [], [
                  @anode.dyn_text(@tutuca.Expr::method_("countText")),
                ]),
              ],
            ),
            @anode.text(" "),
            @anode.show(
              @tutuca.Expr::method_("showPagination"),
              @anode.h("div", [@anode.attr("class", "join")], [
                @anode.h(
                  "button",
                  [
                    @anode.attr("type", "button"),
                    @anode.attr("class", "join-item btn btn-xs pg-prev"),
                    @anode.dyn_attr(
                      "disabled",
                      @tutuca.Expr::method_("cannotPrevPage"),
                    ),
                    @anode.eid(1),
                  ],
                  [@anode.text("«")],
                ),
                @anode.text(" "),
                @anode.h(
                  "span",
                  [
                    @anode.attr(
                      "class", "join-item badge font-mono text-xs pg-label",
                    ),
                  ],
                  [@anode.dyn_text(@tutuca.Expr::method_("pageIndicatorText"))],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr("type", "button"),
                    @anode.attr("class", "join-item btn btn-xs pg-next"),
                    @anode.dyn_attr(
                      "disabled",
                      @tutuca.Expr::method_("cannotNextPage"),
                    ),
                    @anode.eid(2),
                  ],
                  [@anode.text("»")],
                ),
              ]),
            ),
          ],
        ),
        @anode.text(" "),
        @anode.show(
          @tutuca.Expr::field("isExpanded"),
          @anode.h(
            "div",
            [
              @anode.attr(
                "class", "ml-1 flex flex-col gap-0.5 border-l border-base-content/10 pl-2 mt-0.5",
              ),
            ],
            [
              @anode.each(
                1,
                @tutuca.Expr::field("items"),
                @anode.render_it(0),
                loop_with_val=@tutuca.Expr::name("getPageRange"),
                from_render_each=true,
              ),
            ],
          ),
        ),
      ],
    ),
    [
      [
        @anode.on(
          "click",
          @anode.const_null(),
          action=@anode.set_property_action(
            "isExpanded",
            @tutuca.Expr::app("not", [@tutuca.Expr::field("isExpanded")]),
          ),
        ),
      ],
      [@anode.on("click", @tutuca.Expr::name("prevPage"))],
      [@anode.on("click", @tutuca.Expr::name("nextPage"))],
    ],
  )
}

