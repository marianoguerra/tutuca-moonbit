/// The Receive arm of @component.Dispatch, decoded.
///
/// Every addressed name: the `message` the `spec:` section declares,
/// plus every bare `~on_<event>` handler the views write. One bucket holds
/// them
/// however they were sent, so one type covers it — where the two overlap
/// the schema's declared payload wins, and a view whose call sites
/// disagree with it is a build error.
pub(all) enum TracePanelMsg {
  SetTab(String)
  SetAt(Int)
  ToggleSelecting
  ExportTrace
  ImportDraft
  CutToPlace
  ReplayStep
  ReplayRun
  ReplayReset
  /// A message the schema does not declare, or a declared name whose
  /// runtime arguments did not match the declared types.
  Unknown(String, Array[@tutuca.Value])
}

///|
/// Decode a Receive dispatch. None for any other bucket.
///
/// A payload that does not match falls into `Unknown` rather than being
/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,
/// and silently truncating it would hide that.
///
/// It is also REPORTED. `Unknown` answers two different questions —
/// nobody declares this name, and this name is declared here and was
/// handed the wrong shape — and the second one is a bug in the sender
/// that used to be indistinguishable from silence. Every arm below that
/// can fail on a DECLARED name says so through `@tutuca.bad_payload`,
/// which costs nothing unless a host is listening.
pub fn TracePanelMsg::from_dispatch(d : @component.Dispatch) -> TracePanelMsg? {
  guard d is Receive(name, args) else { return None }
  Some(
    match (name, args) {
      ("set_tab", [Str(a0)]) => SetTab(a0)
      ("set_at", [Num(a0)]) if a0.to_int().to_double() == a0 &&
        a0 >= -2147483648.0 &&
        a0 <= 2147483647.0 => SetAt(a0.to_int())
      ("toggle_selecting", []) => ToggleSelecting
      ("export_trace", []) => ExportTrace
      ("import_draft", []) => ImportDraft
      ("cut_to_place", []) => CutToPlace
      ("replay_step", []) => ReplayStep
      ("replay_run", []) => ReplayRun
      ("replay_reset", []) => ReplayReset
      _ => {
        match name {
          "set_tab" => @tutuca.bad_payload(name, "String", args)
          "set_at" => @tutuca.bad_payload(name, "Int", args)
          "toggle_selecting" => @tutuca.bad_payload(name, "", args)
          "export_trace" => @tutuca.bad_payload(name, "", args)
          "import_draft" => @tutuca.bad_payload(name, "", args)
          "cut_to_place" => @tutuca.bad_payload(name, "", args)
          "replay_step" => @tutuca.bad_payload(name, "", args)
          "replay_run" => @tutuca.bad_payload(name, "", args)
          "replay_reset" => @tutuca.bad_payload(name, "", args)
          _ => ()
        }
        Unknown(name, args)
      }
    },
  )
}

///|
/// The dispatch name and arguments this message raises as.
pub fn TracePanelMsg::to_dispatch(
  self : TracePanelMsg,
) -> (String, Array[@tutuca.Value]) {
  match self {
    SetTab(a0) => ("set_tab", [Str(a0)])
    SetAt(a0) => ("set_at", [Num(a0.to_double())])
    ToggleSelecting => ("toggle_selecting", [])
    ExportTrace => ("export_trace", [])
    ImportDraft => ("import_draft", [])
    CutToPlace => ("cut_to_place", [])
    ReplayStep => ("replay_step", [])
    ReplayRun => ("replay_run", [])
    ReplayReset => ("replay_reset", [])
    Unknown(n, args) => (n, args)
  }
}

///|
/// Send this message to self; it arrives as a later Receive dispatch.
///
/// The name comes from the schema, so it cannot drift from the one
/// `from_dispatch` decodes.
pub fn TracePanelMsg::send(self : TracePanelMsg, ctx : &@tutuca.Ctx) -> Unit {
  let (name, args) = self.to_dispatch()
  ctx.send(name, args)
}

///|
/// The file-level style — pass as `common_style~`.
pub let trace_panel_common_style : String = ""

///|
/// The `data-global` style — pass as `global_style~`.
pub let trace_panel_global_style : String = ""

///|
/// What this component's schema declares, for `schema~`.
///
/// This is the only thing consulted for a field's KIND — there is no
/// inference off the init value behind it — and it is what an instance
/// answers `schema()` with, so a holder of a bare `@tutuca.Value`
/// can name these fields without a component registry.
impl @component.Fields for TracePanelState with fn schema() {
  @component.SchemaInfo::new(
    name="TracePanel",
    fingerprint="625cccadb0a09365",
    fields=[
      @component.FieldInfo::new("bar", TyComp(Some("RecorderBar"))),
      @component.FieldInfo::new("header", TyComp(Some("TraceHeader"))),
      @component.FieldInfo::new("places", TyComp(Some("TracePlaces"))),
      @component.FieldInfo::new("log", TyComp(Some("TraceLog"))),
      @component.FieldInfo::new("record_tab_class", TyText),
      @component.FieldInfo::new("trace_tab_class", TyText),
      @component.FieldInfo::new("select_tab_class", TyText),
      @component.FieldInfo::new("select_label", TyText),
      @component.FieldInfo::new("tab", TyText),
      @component.FieldInfo::new("has_trace", TyBool),
      @component.FieldInfo::new("selecting", TyBool),
      @component.FieldInfo::new("show_trace", TyBool),
      @component.FieldInfo::new("show_replay", TyBool),
      @component.FieldInfo::new("show_import", TyBool),
      @component.FieldInfo::new("at", TyInt(width=32, signed=true)),
      @component.FieldInfo::new("total", TyInt(width=32, signed=true)),
      @component.FieldInfo::new("notice", TyText),
      @component.FieldInfo::new("has_notice", TyBool),
      @component.FieldInfo::new("draft", TyText),
      @component.FieldInfo::new("can_replay", TyBool),
      @component.FieldInfo::new("replaying", TyBool),
      @component.FieldInfo::new("replay_tab_class", TyText),
    ],
    view_handlers=[
      "cut_to_place", "export_trace", "import_draft", "replay_reset", "replay_run",
      "replay_step", "set_tab", "toggle_selecting",
    ],
    receives=[
      "set_tab", "set_at", "toggle_selecting", "export_trace", "import_draft", "cut_to_place",
      "replay_step", "replay_run", "replay_reset",
    ],
    methods=[
      "at_within_total", "can_replay_needs_a_trace", "has_notice_tracks_notice",
      "replaying_needs_a_replay", "show_replay_needs_a_trace", "show_trace_needs_a_trace",
    ],
    invariants=[
      "at_within_total", "can_replay_needs_a_trace", "has_notice_tracks_notice",
      "replaying_needs_a_replay", "show_replay_needs_a_trace", "show_trace_needs_a_trace",
    ],
    domains=[
      {
        field: "tab",
        domain: DOneOf([Str("record"), Str("trace"), Str("pick"), Str("replay")]),
      },
      { field: "at", domain: DCompare(op=DGe, rhs=DLit(0)), },
      { field: "total", domain: DCompare(op=DGe, rhs=DLit(0)), },
    ],
    view_names=["main"],
  )
}
