  }
  guard f.get("selectLabel") is Some(Str(v_selectLabel)) else { return None }
  guard f.get("tab") is Some(Str(v_tab)) else { return None }
  guard f.get("hasTrace") is Some(Bool(v_hasTrace)) else { return None }
  guard f.get("selecting") is Some(Bool(v_selecting)) else { return None }
  guard f.get("showTrace") is Some(Bool(v_showTrace)) else { return None }
  guard f.get("at") is Some(Num(t1_at)) else { return None }
  let v_at = t1_at.to_int()
  guard f.get("total") is Some(Num(t1_total)) else { return None }
  let v_total = t1_total.to_int()
  Some({
    bar: v_bar,
    header: v_header,
    places: v_places,
    log: v_log,
    recordTabClass: v_recordTabClass,
    traceTabClass: v_traceTabClass,
    selectTabClass: v_selectTabClass,
    selectLabel: v_selectLabel,
    tab: v_tab,
    hasTrace: v_hasTrace,
    selecting: v_selecting,
    showTrace: v_showTrace,
    at: v_at,
    total: v_total,
  })
}

///|
/// The Receive arm of @component.Dispatch, decoded.
///
/// Declared as `variant receive` in the state block. These names are
/// raised by component code rather than written in a view, so the views
/// cannot type them — the schema is the only place they can be declared.
pub(all) enum TracePanelReceive {
  SetTab(String)
  SetAt(Int)
  ToggleSelecting
  /// A receive the schema does not declare, or a declared name whose
  /// runtime arguments did not match the declared types.
  Unknown(String, Array[@tutuca.Value])
}

///|
/// Decode a Receive dispatch. None for any other bucket.
///
/// A payload that does not match falls into `Unknown` rather than being
/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,
/// and silently truncating it would hide that.
///
/// It is also REPORTED. `Unknown` answers two different questions —
/// nobody declares this name, and this name is declared here and was
/// handed the wrong shape — and the second one is a bug in the sender
/// that used to be indistinguishable from silence. Every arm below that
/// can fail on a DECLARED name says so through `@tutuca.bad_payload`,
/// which costs nothing unless a host is listening.
pub fn TracePanelReceive::from_dispatch(
  d : @component.Dispatch,
) -> TracePanelReceive? {
  guard d is Receive(name, args) else { return None }
  Some(
    match (name, args) {
      ("setTab", [Str(a0)]) => SetTab(a0)
      ("setAt", [Num(a0)]) if a0.to_int().to_double() == a0 &&
        a0 >= -2147483648.0 &&
        a0 <= 2147483647.0 => SetAt(a0.to_int())
      ("toggleSelecting", []) => ToggleSelecting
      _ => {
        match name {
          "setTab" => @tutuca.bad_payload(name, "String", args)
          "setAt" => @tutuca.bad_payload(name, "Int", args)
          "toggleSelecting" => @tutuca.bad_payload(name, "", args)
          _ => ()
        }
        Unknown(name, args)
      }
    },
  )
}

///|
/// The dispatch name and arguments this message raises as.
pub fn TracePanelReceive::to_dispatch(
  self : TracePanelReceive,
) -> (String, Array[@tutuca.Value]) {
  match self {
    SetTab(a0) => ("setTab", [Str(a0)])
    SetAt(a0) => ("setAt", [Num(a0.to_double())])
    ToggleSelecting => ("toggleSelecting", [])
    Unknown(n, args) => (n, args)
  }
}

///|
/// Send this message to self; it arrives as a later Receive dispatch.
///
/// The name comes from the schema, so it cannot drift from the one
/// `from_dispatch` decodes.
pub fn TracePanelReceive::send(
  self : TracePanelReceive,
  ctx : &@tutuca.Ctx,
) -> Unit {
  let (name, args) = self.to_dispatch()
  ctx.send(name, args)
}

