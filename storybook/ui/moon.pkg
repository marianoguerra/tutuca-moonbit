// Storybook — the gallery shell. Generates a single tutuca root component
// (sidebar + per-story preview panes) and mounts it as a live app, with each
// story's module registered in its OWN child scope so same-named components
// across examples don't collide.
//
// Note what is NOT imported: no inspector, no recorder, no fuzz driver, no
// renderer internals. The tabs beside Story are `PanelDef`s the caller hands
// in — a key, a label, a field prefix and a closure — and
// `storybook/ui/panels` is what supplies the standard set. A gallery that
// wants none of them links none of that.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/app",
  "marianoguerra/tutuca/vdom",
  "marianoguerra/tutuca/storybook" @sb,
  // `@string.parse_int`, for the story-index suffix in a pane name
  "moonbitlang/core/string",
}

import {
  "marianoguerra/tutuca/vdom/memdom",
  "moonbitlang/core/test",
} for "test"
