        @anode.dyn_text(Const(lit=LStr("Beta"), from_macro=true)),
      ]),
      @anode.text(" "),
      @anode.h("span", [], [@anode.text("Feature C")]),
      @anode.text(" "),
      @anode.h("span", [@anode.attr("class", "badge")], [
        @anode.dyn_text(Field("status")),
      ]),
    ]),
    [],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn features_views() -> Map[String, @anode.View] {
  { "main": features_main_view_ir() }
}

///|
/// The Features component: `component()` with everything the view file already
/// states filled in — its name, its compiled views, its styles, its schema
/// and its direct codec. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn features_component(
  name? : String = "Features",
  views? : Map[String, @anode.View] = features_views(),
  init? : FeaturesState = FeaturesState::zero(),
  common_style? : String = features_common_style,
  global_style? : String = features_global_style,
  update? : (FeaturesState, @component.Dispatch, &@tutuca.Ctx) -> FeaturesState?,
  specs? : Map[String, @component.FieldSpec] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    specs~,
    provide~,
    lookup~,
  )
}
