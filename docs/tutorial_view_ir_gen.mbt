///|
/// The compiled `main` view.
fn chat_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h("section", [], [
      @anode.render(0, Field("status")),
      @anode.text(" "),
      @anode.h(
        "input",
        [
          @anode.attr("class", "draft"),
          @anode.dyn_attr("value", Field("draft")),
          @anode.eid(0),
        ],
        [],
      ),
      @anode.text(" "),
      @anode.h("button", [@anode.attr("class", "send"), @anode.eid(1)], [
        @anode.text("send"),
      ]),
    ]),
    [
      [
        @anode.on("input", HandlerName(name="setDraft", ns=Receive), args=[
          EventPath(["value"]),
        ]),
      ],
      [@anode.on("click", HandlerName(name="submit", ns=Receive))],
    ],
  )
}

