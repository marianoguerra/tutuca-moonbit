fn task_item_inline_update(
  s : TaskItemState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[TaskItemState] {
  match msg {
    Receive("toggle", _args) => {
      let effects : Array[() -> Unit] = []
      let s = { ..s, done: !s.done, }
      effects.push(() => {
        ctx.intent(
          "task_done",
          [(Str(s.id) : @tutuca.Value), (Bool(s.done) : @tutuca.Value)],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Dyn]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("remove", _args) => {
      let effects : Array[() -> Unit] = []
      effects.push(() => {
        ctx.intent(
          "remove_task",
          [(Str(s.id) : @tutuca.Value)],
          @tutuca.IntentOpts::new(route=[@tutuca.Leg::Dyn]),
        )
      })
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

