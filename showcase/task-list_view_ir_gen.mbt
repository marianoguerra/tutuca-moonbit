fn task_list_inline_update(
  s : TaskListState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[TaskListState] {
  match msg {
    Intent("remove_task", args) => {
      guard args.get(0) is Some(Str(id_)) else { return Unchanged }
      let s = {
        ..s,
        items: {
          let m = s.items.copy()
          m.remove(id_)
          m
        },
      }
      let s = {
        ..s,
        completed: {
          let m = s.completed.copy()
          m.remove(id_)
          m
        },
      }
      Next(s)
    }
    Intent("task_done", args) => {
      guard args.get(0) is Some(Str(id_)) else { return Unchanged }
      guard args.get(1) is Some(Bool(done_)) else { return Unchanged }
      let s = if done_ {
        let s = {
          ..s,
          completed: {
            let m = s.completed.copy()
            m[id_] = true
            m
          },
        }
        s
      } else {
        let s = {
          ..s,
          completed: {
            let m = s.completed.copy()
            m.remove(id_)
            m
          },
        }
        s
      }
      Next(s)
    }
    _ => Unhandled
  }
}

