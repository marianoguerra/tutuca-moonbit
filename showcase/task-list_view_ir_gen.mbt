            [],
          ),
          @anode.h(
            "span",
            [
              @anode.if_attr(
                "class",
                @tutuca.Expr::field("done"),
                then_val=@anode.const_str("label line-through"),
                else_val=@anode.const_str("label"),
              ),
            ],
            [@anode.dyn_text(@tutuca.Expr::field("text"), id=0)],
          ),
        ],
      ),
      @anode.h(
        "button",
        [@anode.attr("class", "btn btn-sm remove"), @anode.eid(1)],
        [@anode.text("Remove")],
      ),
    ]),
    [
      [@anode.on("click", @tutuca.Expr::name("toggle"))],
      [@anode.on("click", @tutuca.Expr::name("remove"))],
    ],
  )
}

