///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn document_editor_inline_update(
  s : DocumentEditorState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[DocumentEditorState] {
  match msg {
    Receive("edit", args) => {
      guard args.get(0) is Some(Str(text_)) else { return Unchanged }
      let s = { ..s, source: text_, }
      let s = { ..s, revision: (s.revision.to_double() + 1.0).to_int(), }
      let s = { ..s, feedback: "", }
      Next(s)
    }
    Receive("load", _args) => {
      let effects : Array[() -> Unit] = []
      let s = if !s.busy {
        let s = { ..s, busy: true, }
        let s = { ..s, load_revision: s.revision, }
        let s = { ..s, feedback: "Loading…", }
        effects.push(() => {
          ctx.intent(
            "load_document",
            [(Str(s.id) : @tutuca.Value), (Bool(s.fail_next) : @tutuca.Value)],
            @tutuca.IntentOpts::new(
              route=[@tutuca.Leg::Lex],
              on_ok_name="load_document_ok",
              on_failed_name="load_document_failed",
              on_unhandled_name="load_document_unhandled",
            ),
          )
        })
        let s = { ..s, fail_next: false, }
        s
      } else {
        s
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("save", _args) => {
      let effects : Array[() -> Unit] = []
      let s = if !s.busy {
        let s = { ..s, busy: true, }
        let s = { ..s, feedback: "Saving…", }
        effects.push(() => {
          ctx.intent(
            "save_document",
            [
              (Str(s.id) : @tutuca.Value),
              (Str(s.source) : @tutuca.Value),
              (Bool(s.fail_next) : @tutuca.Value),
            ],
            @tutuca.IntentOpts::new(
              route=[@tutuca.Leg::Lex],
              on_ok_name="save_document_ok",
              on_failed_name="save_document_failed",
              on_unhandled_name="save_document_unhandled",
            ),
          )
        })
        let s = { ..s, fail_next: false, }
        s
      } else {
        s
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("load_document_ok", args) => {
      guard args.get(0) is Some(result_) else { return Unchanged }
      let s = if result_.field_opt("id").unwrap_or(Null) ==
        (Str(s.id) : @tutuca.Value) {
        let s = { ..s, busy: false, }
        let s = if (Num(s.revision.to_double()) : @tutuca.Value) ==
          (Num(s.load_revision.to_double()) : @tutuca.Value) &&
          (Str(s.source) : @tutuca.Value) ==
          (Str(s.saved_source) : @tutuca.Value) {
          let s = {
            ..s,
            source: result_
            .field_opt("source")
            .unwrap_or(Null)
            .to_display_string(),
          }
          let s = {
            ..s,
            saved_source: result_
            .field_opt("source")
            .unwrap_or(Null)
            .to_display_string(),
          }
          let s = { ..s, feedback: "Document loaded.", }
          s
        } else {
          let s = { ..s, feedback: "Your unsaved draft was kept.", }
          s
        }
        s
      } else {
        s
      }
      Next(s)
    }
    Receive("load_document_failed", args) => {
      guard args.get(0) is Some(_) else { return Unchanged }
      let s = { ..s, busy: false, }
      let s = { ..s, feedback: "Could not load. Choose Reload to retry.", }
      Next(s)
    }
    Receive("load_document_unhandled", _args) => {
      let s = { ..s, busy: false, }
      let s = {
        ..s,
        feedback: "Connect the load_document host handler to reload.",
      }
      Next(s)
    }
    Receive("save_document_ok", args) => {
      guard args.get(0) is Some(result_) else { return Unchanged }
      let s = if result_.field_opt("id").unwrap_or(Null) ==
        (Str(s.id) : @tutuca.Value) {
        let s = { ..s, busy: false, }
        let s = {
          ..s,
          saved_source: result_
          .field_opt("source")
          .unwrap_or(Null)
          .to_display_string(),
        }
        let s = { ..s, feedback: "Saved in this demo session.", }
        s
      } else {
        s
      }
      Next(s)
    }
    Receive("save_document_failed", args) => {
      guard args.get(0) is Some(_) else { return Unchanged }
      let s = { ..s, busy: false, }
      let s = {
        ..s,
        feedback: "Could not save. Your draft is kept; choose Save to retry.",
      }
      Next(s)
    }
    Receive("save_document_unhandled", _args) => {
      let s = { ..s, busy: false, }
      let s = {
        ..s,
        feedback: "Connect the save_document host handler to save.",
      }
      Next(s)
    }
    _ => Unhandled
  }
}

