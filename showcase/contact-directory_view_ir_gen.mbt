///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn contact_editor_inline_update(
  s : ContactEditorState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[ContactEditorState] {
  match msg {
    Receive("save", _args) => {
      let effects : Array[() -> Unit] = []
      let s = if (Str(s.name.trim(chars=" \t\n\r").to_owned()) : @tutuca.Value) ==
        (Str("") : @tutuca.Value) ||
        !s.email.contains("@") {
        let s = {
          ..s,
          feedback: "Enter a name and an email address containing @.",
        }
        s
      } else {
        effects.push(() => {
          ctx.intent(
            "update_contact",
            [
              (Str(s.id) : @tutuca.Value),
              (Str(s.name.trim(chars=" \t\n\r").to_owned()) : @tutuca.Value),
              (Str(s.email.trim(chars=" \t\n\r").to_owned()) : @tutuca.Value),
            ],
            @tutuca.IntentOpts::new(route=[@tutuca.Leg::Dyn]),
          )
        })
        let s = { ..s, feedback: "Contact updated for this session.", }
        s
      }
      for f in effects {
        f()
      }
      Next(s)
    }
    _ => Unhandled
  }
}

