      ]),
      @anode.h("label", [], [
        @anode.text("Email"),
        @anode.h(
          "input",
          [
            @anode.attr("class", "input w-full email"),
            @anode.dyn_attr("value", @tutuca.Expr::field("email")),
            @anode.eid(1),
          ],
          [],
        ),
      ]),
      @anode.h(
        "button",
        [@anode.attr("class", "btn btn-primary save"), @anode.eid(2)],
        [@anode.text("Save contact")],
