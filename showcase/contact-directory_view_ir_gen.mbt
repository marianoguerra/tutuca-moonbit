      Next(s)
    }
    Receive("search", args) => {
      guard args.get(0) is Some(Str(query_)) else { return Unchanged }
      let effects : Array[() -> Unit] = []
      let s = { ..s, query: query_, }
      let s = { ..s, page: 0, }
      effects.push(() => ctx.send("init", []))
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("previous", _args) => {
      let effects : Array[() -> Unit] = []
      let s = {
        ..s,
        page: (if 0.0 > s.page.to_double() - 1.0 {
          0.0
        } else {
          s.page.to_double() - 1.0
        }).to_int(),
      }
      effects.push(() => ctx.send("init", []))
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("next", _args) => {
      let effects : Array[() -> Unit] = []
      let s = {
        ..s,
        page: (if s.pages.to_double() - 1.0 < s.page.to_double() + 1.0 {
          s.pages.to_double() - 1.0
        } else {
          s.page.to_double() + 1.0
        }).to_int(),
      }
      effects.push(() => ctx.send("init", []))
      for f in effects {
        f()
      }
      Next(s)
    }
    Receive("contact_page_failed", args) => {
      guard args.get(0) is Some(_) else { return Unchanged }
      let s = { ..s, error: "Could not search contacts. Try again.", }
      Next(s)
    }
    Receive("contact_page_unhandled", _args) => {
      let s = {
        ..s,
        error: "Connect the contact_page host handler to search contacts.",
      }
      Next(s)
    }
    Intent("update_contact", args) => {
      guard args.get(0) is Some(Str(id_)) else { return Unchanged }
      guard args.get(1) is Some(Str(name_)) else { return Unchanged }
      guard args.get(2) is Some(Str(email_)) else { return Unchanged }
