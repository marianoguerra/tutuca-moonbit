fn notification_preferences_inline_update(
  s : NotificationPreferencesState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[NotificationPreferencesState] {
  match msg {
    Receive("apply", _args) => {
      let s = if s.enabled && !s.email.contains("@") {
        let s = { ..s, feedback: "Enter an email address containing @.", }
        s
      } else {
        let s = { ..s, saved_enabled: s.enabled, }
        let s = { ..s, saved_email: s.email.trim(chars=" \t\n\r").to_owned(), }
        let s = { ..s, saved_frequency: s.frequency, }
        let s = { ..s, feedback: "Preferences applied for this session.", }
        s
      }
      Next(s)
    }
    Receive("reset", _args) => {
      let s = { ..s, enabled: s.saved_enabled, }
      let s = { ..s, email: s.saved_email, }
      let s = { ..s, frequency: s.saved_frequency, }
      let s = { ..s, feedback: "Draft reset.", }
      Next(s)
    }
    _ => Unhandled
  }
}

