///|
/// Every declared initial state keeps every declared invariant.
///
/// A rule that does not hold in the state a component STARTS in is broken
/// before anything happens, and every transition after it is refused — so
/// this is the one check worth making before the component ever runs.
/// GENERATED — edit the `spec:` section, not this.
test "QuantityPicker: the declared initial states keep the invariants" {
  let s = QuantityPickerState::fresh()
  assert_false(
    quantity_picker_compute_quantity_in_range(s, [], @tutuca.NullStack::{ })
    is Bool(false),
    msg="the `fresh` initial state breaks `quantity_in_range`",
  )
  let s = QuantityPickerState::maximum()
  assert_false(
    quantity_picker_compute_quantity_in_range(s, [], @tutuca.NullStack::{ })
    is Bool(false),
    msg="the `maximum` initial state breaks `quantity_in_range`",
  )
}
