fn quantity_picker_compute_total(
  s : QuantityPickerState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  let d0 = 100.0
  guard d0 != 0.0 else { return Null }
  (
    Str(
      "Total: €" +
      (
        Num(s.quantity.to_double() * s.unit_cents.to_double() / d0) :
        @tutuca.Value).to_display_string(),
    ) : @tutuca.Value)
}

