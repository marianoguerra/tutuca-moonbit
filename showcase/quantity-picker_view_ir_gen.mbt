///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn quantity_picker_inline_update(
  s : QuantityPickerState,
  msg : @component.Dispatch,
  _ctx : &@tutuca.Ctx,
) -> @component.Update[QuantityPickerState] {
  match msg {
    Receive("decrease", _args) => {
      let s = {
        ..s,
        quantity: (if 1.0 > s.quantity.to_double() - 1.0 {
          1.0
        } else {
          s.quantity.to_double() - 1.0
        }).to_int(),
      }
      guard s.quantity.to_double() >= 1.0 && s.quantity.to_double() <= 10.0 else {
        @tutuca.invariant_failed(
          handler="decrease",
          pred="quantity_in_range",
          sentence="Choose a quantity from 1 to 10.",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      Next(s)
    }
    Receive("increase", _args) => {
      let s = {
        ..s,
        quantity: (if 10.0 < s.quantity.to_double() + 1.0 {
          10.0
        } else {
          s.quantity.to_double() + 1.0
        }).to_int(),
      }
      guard s.quantity.to_double() >= 1.0 && s.quantity.to_double() <= 10.0 else {
        @tutuca.invariant_failed(
          handler="increase",
          pred="quantity_in_range",
          sentence="Choose a quantity from 1 to 10.",
          state=(Map(@component.Fields::encode(s)) : @tutuca.Value),
        )
        return Unchanged
      }
      Next(s)
    }
    _ => Unhandled
  }
}

