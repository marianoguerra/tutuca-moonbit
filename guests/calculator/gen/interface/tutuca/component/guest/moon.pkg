warnings = "-44"

import {
  "tutuca/component/interface/tutuca/component/values",
  // the SDK's bytes_of / text_of: a persisted state is UTF-8 text
  "moonbitlang/core/encoding/utf8",
  // what this guest persists AS: its own JSON, which the host never reads
  "moonbitlang/core/json",
  // parse_double, for reading the display back as a number
  "moonbitlang/core/string",
}
