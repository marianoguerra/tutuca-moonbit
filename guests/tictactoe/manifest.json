  "moduleName": "gameslib",
  "doc": "Small games, as loadable components.",
  "version": "0.4.0",
  "homepage": "",
  "authors": [],
  "stringEncoding": "utf16",
  "components": [
    {
      "name": "TicTacToe",
      "doc": "Noughts and crosses on a three-by-three board, for two people sharing a screen.",
      "keywords": [
        "game",
        "tictactoe",
        "noughts",
        "crosses",
        "board",
        "two-player",
        "play"
      ],
      "category": "game",
      "messageDocs": [
        {
          "name": "play",
          "doc": "Take the square at an index."
        },
        {
          "name": "reset",
          "doc": "Clear the board and start again."
        },
        {
          "name": "status",
          "doc": "Whose turn it is, or who won."
        }
      ],
      "views": [
        {
          "name": "main",
          "src": "views/TicTacToe.main.html"
        }
      ],
