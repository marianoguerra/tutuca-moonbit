          "items": [],
          "name": "square",
          "members": []
        },
        {
          "kind": "ty-list",
          "elem": 1,
          "items": [],
          "name": "",
          "members": []
        }
      ],
      "fields": [
        {
          "name": "squares",
          "ty": 2,
          "doc": "The nine squares, left to right and top to bottom: each a mark (\"X\", \"O\" or blank) and whether it is part of the winning line.",
