    mbt_ffi_store32(iter_base + 0, ptr0)

    match iter_elem.1 {
      Nil => {
        mbt_ffi_store8(iter_base + 8, 0)

        ()
      }
      Boolean(payload1) => {
        mbt_ffi_store8(iter_base + 8, 1)
        mbt_ffi_store8(iter_base + 16, if payload1 { 1 } else { 0 })

        ()
      }
      Number(payload2) => {
        mbt_ffi_store8(iter_base + 8, 2)
        mbt_ffi_storef64(iter_base + 16, payload2)

        ()
      }
      Text(payload3) => {
        mbt_ffi_store8(iter_base + 8, 3)

        let ptr4 = mbt_ffi_str2ptr(payload3)
        mbt_ffi_store32(iter_base + 20, payload3.length())
        mbt_ffi_store32(iter_base + 16, ptr4)
        cleanup_list.push(ptr4)

        ()
      }
      List(payload5) => {
        mbt_ffi_store8(iter_base + 8, 4)
        mbt_ffi_store64(iter_base + 16, payload5.reinterpret_as_int64())

        ()
      }
      Map(payload6) => {
        mbt_ffi_store8(iter_base + 8, 5)
        mbt_ffi_store64(iter_base + 16, payload6.reinterpret_as_int64())

        ()
      }
      Instance(payload7) => {
        mbt_ffi_store8(iter_base + 8, 6)
        mbt_ffi_store64(iter_base + 16, payload7.reinterpret_as_int64())

        ()
