{
  "manifestVersion": 2,
  "apiVersion": 10,
  "moduleName": "{{name}}",
  "doc": "A tutuca:component bundle.",
  "version": "0.1.0",
  "homepage": "",
  "authors": [],
  "stringEncoding": "utf16",
  "components": [
    {
      "name": "{{Name}}",
      "doc": "A number with a label, and buttons that raise and lower it.",
      "keywords": ["counter", "number", "{{name}}"],
      "category": "input",
      "messageDocs": [
        { "name": "inc", "doc": "Add one." },
        { "name": "dec", "doc": "Subtract one." },
        { "name": "set", "doc": "Set the count outright." },
        { "name": "announce", "doc": "Tell the parent what the count is now." },
        { "name": "caption", "doc": "The label and count as one sentence." }
      ],
      "views": [{ "name": "main", "src": "views/{{Name}}.main.html" }],
      "types": [
        { "kind": "ty-float", "elem": null, "items": [], "name": "", "members": [] },
        { "kind": "ty-text", "elem": null, "items": [], "name": "", "members": [] }
      ],
      "fields": [
        { "name": "count", "ty": 0, "doc": "How many.", "required": false, "constraint": null },
        { "name": "label", "ty": 1, "doc": "What to call it.", "required": false, "constraint": null }
      ],
      "properties": [
        { "name": "count", "ty": 0, "writable": true, "doc": "The public count." }
      ],
      "receives": ["set"],
      "intents": ["counted"],
      "methods": ["caption"],
      "whens": [],
      "serves": [],
      "inits": [],
      "style": ""
    }
  ]
}
