      Map(payload12) => {
        mbt_ffi_store8(iter_base + 0, 5)
        mbt_ffi_store64(iter_base + 8, payload12.reinterpret_as_int64())

        ()
      }
      Instance(payload13) => {
        mbt_ffi_store8(iter_base + 0, 6)
        mbt_ffi_store64(iter_base + 8, payload13.reinterpret_as_int64())

        ()
      }
    }
  }
  wasmImportSendAt(
    address,
    path.length(),
    ptr5,
    name.length(),
    address14,
    args.length(),
  )
  mbt_ffi_free(address)
  mbt_ffi_free(ptr5)
  mbt_ffi_free(address14)

  cleanup_list.each(mbt_ffi_free)
}

///|
/// Answer whoever sent the message being handled, under a name this handler
/// picks.
///
/// An intent answers under a name the runtime derives (`<name>Ok`), because
/// its raiser asked a question and declared arms for it. A message carries
/// no such expectation and its sender declares no arms, so the replier names
/// the reply and the sender handles it like any other message.
///
/// The reply reaches the sender's position as pinned when they sent. With
/// nobody waiting — a view's own `@on.*`, or the host's send-at-root — the
/// host refuses NO_SENDER and nothing is dispatched, which is a refusal the
/// guest is not told about: it did what it could, and who was listening was
/// never its question.
pub fn send_reply(name : String, args : Array[@values.Value]) -> Unit {
  let cleanup_list : Array[Int] = []

  let ptr = mbt_ffi_str2ptr(name)

  let address = mbt_ffi_malloc(args.length() * 16)
  for index = 0; index < args.length(); index = index + 1 {
    let iter_elem : @values.Value = args[index]
    let iter_base = address + index * 16

    match iter_elem {
      Nil => {
        mbt_ffi_store8(iter_base + 0, 0)

        ()
      }
      Boolean(payload0) => {
        mbt_ffi_store8(iter_base + 0, 1)
        mbt_ffi_store8(iter_base + 8, if payload0 { 1 } else { 0 })

        ()
      }
      Number(payload1) => {
        mbt_ffi_store8(iter_base + 0, 2)
        mbt_ffi_storef64(iter_base + 8, payload1)

        ()
      }
      Text(payload2) => {
        mbt_ffi_store8(iter_base + 0, 3)

        let ptr3 = mbt_ffi_str2ptr(payload2)
        mbt_ffi_store32(iter_base + 12, payload2.length())
        mbt_ffi_store32(iter_base + 8, ptr3)
        cleanup_list.push(ptr3)

        ()
      }
      List(payload4) => {
        mbt_ffi_store8(iter_base + 0, 4)
        mbt_ffi_store64(iter_base + 8, payload4.reinterpret_as_int64())

        ()
      }
      Map(payload5) => {
        mbt_ffi_store8(iter_base + 0, 5)
        mbt_ffi_store64(iter_base + 8, payload5.reinterpret_as_int64())

        ()
      }
      Instance(payload6) => {
        mbt_ffi_store8(iter_base + 0, 6)
        mbt_ffi_store64(iter_base + 8, payload6.reinterpret_as_int64())

        ()
      }
    }
  }
  wasmImportSendReply(ptr, name.length(), address, args.length())
  mbt_ffi_free(ptr)
  mbt_ffi_free(address)

  cleanup_list.each(mbt_ffi_free)
}

///|
/// Read a name this component DECLARED a lookup for — the handler-side twin
/// of a view's `*name`.
///
/// The only import that answers rather than buffering, and the only one that
/// can: everything else here is an effect the host applies after the call,
/// and a value a handler is in the middle of using cannot wait for that.
///
/// It takes no route, and the omission is the contract rather than a gap.
/// The host resolves this component's declared lookups BEFORE entering the
/// guest and this reads one of the answers — so a route the guest named
/// could not change what came back. Which environments were walked is the
/// host's business, the same way the default route is.
///
/// Every entry point resolves them from the position it stands in: a
/// message/intent handler walks its dispatch route, while a render operation
/// (`compute`, `when`, `enrich`, `enrich-scope`) asks the render chain the
/// call is being made under — which is what a `*name` in this component's
/// own VIEW reads. So a `*name` in a `pred` and a `*name` in the template
/// beside it answer the same thing.
///
/// `nil` for a name the manifest's `lookup` list does not declare, and for a
/// declared one that nothing above supplies and that carries no default.
/// There is no error arm: a name nothing supplies is the ordinary case a
/// default exists FOR, and a view's `*name` answers it the same way.
///
/// A guest reads what an ancestor deliberately published to its subtree
/// and nothing else — the reach its own views already had, moved to where
/// a handler can use it.
pub fn lookup(name : String) -> @values.Value {
  let ptr = mbt_ffi_str2ptr(name)
  let return_area = mbt_ffi_malloc(16)
  wasmImportLookup(ptr, name.length(), return_area)

  let lifted = match mbt_ffi_load8_u(return_area + 0) {
    0 => @values.Value::Nil
    1 => @values.Value::Boolean(mbt_ffi_load8_u(return_area + 8) != 0)
    2 => @values.Value::Number(mbt_ffi_loadf64(return_area + 8))
    3 => {
      let result = mbt_ffi_ptr2str(
        mbt_ffi_load32(return_area + 8),
        mbt_ffi_load32(return_area + 12),
      )

      @values.Value::Text(result)
    }
    4 =>
      @values.Value::List(
        mbt_ffi_load64(return_area + 8).reinterpret_as_uint64(),
      )
    5 =>
      @values.Value::Map(
        mbt_ffi_load64(return_area + 8).reinterpret_as_uint64(),
      )
    6 =>
      @values.Value::Instance(
        mbt_ffi_load64(return_area + 8).reinterpret_as_uint64(),
      )
    _ => panic()
  }
  let ret = lifted
  mbt_ffi_free(ptr)
  mbt_ffi_free(return_area)
  return ret
}

///|
/// End the walk with no answer — "served, and no answer". The sender hears
/// nothing, even if it named an outcome, which is what separates this from
/// letting the route run out.
///
/// (host `ctx.stop-propagation`; only meaningful while handling an intent.)
pub fn stop_propagation() -> Unit {
  wasmImportStopPropagation()
}

///|
/// Create a same-bundle child instance and return its HOST-ASSIGNED token
/// (the only instance-token space; `value.instance` payloads use it).
/// Callable from constructors and handlers; the child becomes a field of
/// the parent (return it from get-field as instance(token), accept it in
/// with-field) and the host renders it with `<x render=".field">`.
pub fn make_instance(
  component : String,
  args : Array[(String, @values.Value)],
) -> UInt64 {
  let cleanup_list : Array[Int] = []

  let ptr = mbt_ffi_str2ptr(component)

  let address = mbt_ffi_malloc(args.length() * 24)
  for index = 0; index < args.length(); index = index + 1 {
    let iter_elem : (String, @values.Value) = args[index]
    let iter_base = address + index * 24

    let ptr0 = mbt_ffi_str2ptr(iter_elem.0)
    mbt_ffi_store32(iter_base + 4, iter_elem.0.length())
    mbt_ffi_store32(iter_base + 0, ptr0)

    match iter_elem.1 {
      Nil => {
        mbt_ffi_store8(iter_base + 8, 0)

        ()
      }
      Boolean(payload1) => {
        mbt_ffi_store8(iter_base + 8, 1)
        mbt_ffi_store8(iter_base + 16, if payload1 { 1 } else { 0 })

        ()
      }
      Number(payload2) => {
        mbt_ffi_store8(iter_base + 8, 2)
        mbt_ffi_storef64(iter_base + 16, payload2)

        ()
      }
      Text(payload3) => {
        mbt_ffi_store8(iter_base + 8, 3)

        let ptr4 = mbt_ffi_str2ptr(payload3)
        mbt_ffi_store32(iter_base + 20, payload3.length())
        mbt_ffi_store32(iter_base + 16, ptr4)
        cleanup_list.push(ptr4)

        ()
      }
      List(payload5) => {
        mbt_ffi_store8(iter_base + 8, 4)
        mbt_ffi_store64(iter_base + 16, payload5.reinterpret_as_int64())

        ()
      }
      Map(payload6) => {
        mbt_ffi_store8(iter_base + 8, 5)
        mbt_ffi_store64(iter_base + 16, payload6.reinterpret_as_int64())

        ()
      }
      Instance(payload7) => {
        mbt_ffi_store8(iter_base + 8, 6)
        mbt_ffi_store64(iter_base + 16, payload7.reinterpret_as_int64())

        ()
      }
    }
    cleanup_list.push(ptr0)
  }
  let result : Int64 = wasmImportMakeInstance(
    ptr,
    component.length(),
    address,
    args.length(),
  )
  let ret = result.reinterpret_as_uint64()
  mbt_ffi_free(ptr)
  mbt_ffi_free(address)

  cleanup_list.each(mbt_ffi_free)
  return ret
}

///|
/// Release a child token that will no longer be returned from get-field.
pub fn drop_instance(token : UInt64) -> Unit {
  wasmImportDropInstance(token.reinterpret_as_int64())
}
