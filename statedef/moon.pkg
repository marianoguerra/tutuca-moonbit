// The state schema: a component's state record, its named types, and its
// message buckets.
//
// Pure and target-agnostic like viewgen/ and cli/: source text in -> a typed
// StateDef out, never touching the filesystem. viewgen/ threads the result
// through view generation; cmd/tutuca does the I/O.
//
// The surface is tutuca's own and the lexer/parser live in this package. State
// names map directly onto view and JSON names, sum declarations cover both
// payload-free and payload-bearing cases, and every diagnostic carries a span.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/scenedef",
  // A rule body is an EXPRESSION, and this is what reads one out of the block
  // language. The other front end reads it out of shrubbery.
  "marianoguerra/tutuca/tscript",
  // The second front end: a `.tutu` file's own shrubbery, and the readers that
  // turn it into an expression and a member.
  "marianoguerra/tutuca/tutufile",
  "marianoguerra/tutuca/tutufile/shrub" @sh,
  "marianoguerra/shrubbery/ast",
  "marianoguerra/error-report" @report,
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

import {
  // The printer this front end is held against, and nothing in the package
  // itself imports it.
  "marianoguerra/tutuca/tutufile/lower",
} for "test"
