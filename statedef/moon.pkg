// The state schema: a component's state record, its named types, and its
// message buckets.
//
// Pure and target-agnostic like viewgen/ and cli/: source text in -> a typed
// StateDef out, never touching the filesystem. viewgen/ threads the result
// through view generation; cmd/main does the I/O.
//
// The surface is tutuca's own and the lexer/parser live in this package. State
// names map directly onto view and JSON names, sum declarations cover both
// payload-free and payload-bearing cases, and every diagnostic carries a span.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
