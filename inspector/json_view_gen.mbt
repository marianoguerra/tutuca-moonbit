    ],
    inputs: [],
    receives: [],
    bubbles: [],
    responses: [],
    methods: [],
    ids: [],
    view_names: ["main"],
    init_names: [],
  }
}

///|
/// The state of the DataInspector component.
///
/// Declared as `interface data-inspector` in the state block. Adding a
/// field there adds it here, so a view that reads it type-checks and one
/// that reads a name this struct lacks fails generation.
pub(all) struct DataInspectorState {
  value : @tutuca.Value
}

///|
/// The zero state: every field at its type's empty value.
///
/// WIT declares no defaults — a default is a value, not a type — so this
/// is type-directed, and `init` spreads it to name only what differs:
///
///   init={ ..DataInspectorState::zero(), label: "Counter" }
fn DataInspectorState::zero() -> DataInspectorState {
  DataInspectorState::{ value: Null }
}

///|
/// The zero state as component arguments — the default a ModuleDef
/// example takes when it sets nothing of its own.
pub fn data_inspector_zero_args() -> Map[String, @tutuca.Value] {
  data_inspector_encode(DataInspectorState::zero())
}

///|
/// Every field the DataInspector state declares — typed field names for tests and inspectors.
pub(all) enum DataInspectorField {
  Value
} derive(Eq, @debug.Debug)

///|
pub fn DataInspectorField::name(self : DataInspectorField) -> String {
  match self {
    Value => "value"
  }
}

///|
/// The runtime kind this field carries. Declared, not inferred: the old
/// `FieldSpec::of_default` had to guess FInt from whether the seed value
/// happened to be integral.
pub fn DataInspectorField::kind(
  self : DataInspectorField,
) -> @component.FieldKind {
  match self {
    Value => @component.FAny
  }
}

///|
/// Every field, in declaration order.
pub let data_inspector_field_names : Array[String] = ["value"]

///|
/// The structural fingerprint of this component's schema. Changes when
/// the SHAPE changes — a renamed or retyped field, a new message case —
/// and not when the block is merely reformatted.
pub let data_inspector_schema_fingerprint : String = "d5f8be83eb3069b1"

///|
/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through. That is the case a JSON round trip could not do at all: an
/// `Obj` or an `Fn` does not survive one.
fn data_inspector_encode(s : DataInspectorState) -> Map[String, @tutuca.Value] {
  { "value": s.value }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
fn data_inspector_decode(f : Map[String, @tutuca.Value]) -> DataInspectorState? {
  let v_value = f.get("value").unwrap_or(Null)
  Some(DataInspectorState::{ value: v_value })
}

///|
/// The views declared in json.html.
pub(all) enum DataInspectorView {
  Main
} derive(Eq, @debug.Debug)

///|
pub fn DataInspectorView::name(self : DataInspectorView) -> String {
  match self {
    Main => "main"
  }
}

///|
/// The file-level style — pass as `common_style~`.
pub let data_inspector_common_style : String = ""

///|
/// The `data-global` style — pass as `global_style~`.
pub let data_inspector_global_style : String = ""

///|
/// What this component's schema declares, for `schema~`.
///
/// Passing it to `component` also stops the runtime inferring field
/// kinds from the init value — the schema states them.
pub fn data_inspector_schema() -> @component.SchemaInfo {
  {
    fingerprint: "d5f8be83eb3069b1",
    fields: [
      {
        name: "value",
        ty: "any",
        kind: @component.FAny,
        elem: Some("any"),
        slot: None,
        members: [],
      },
    ],
    inputs: [],
    receives: [],
    bubbles: [],
    responses: [],
    methods: [],
    ids: [],
    view_names: ["main"],
    init_names: [],
  }
}
