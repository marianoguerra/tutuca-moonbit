/// A field that already holds a `@tutuca.Value` is passed straight
/// through: it is exactly what `with_value_stash` exists to rescue from
/// the JSON path, and this way it never enters one.
fn schema_combinator_encode(
  s : SchemaCombinatorState,
) -> Map[String, @tutuca.Value] {
  {
    "items": (List(s.items.map(x => x)) : @tutuca.Value),
    "isExpanded": Bool(s.isExpanded),
    "itemsPerPage": Num(s.itemsPerPage.to_double()),
    "currentPage": Num(s.currentPage.to_double()),
    "typeLabel": Str(s.typeLabel),
    "badges": (List(s.badges.map(x => x)) : @tutuca.Value),
    "title": Str(s.title),
    "description": Str(s.description),
    "deprecated": Bool(s.deprecated),
  }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
fn schema_combinator_decode(
  f : Map[String, @tutuca.Value],
) -> SchemaCombinatorState? {
  guard f.get("items") is Some(t1_items) else { return None }
  guard t1_items is List(u1_items) else { return None }
  let v_items : Array[@tutuca.Value] = []
  for e1_items in u1_items {
    let x1_items = e1_items
    v_items.push(x1_items)
  }
  guard f.get("isExpanded") is Some(Bool(v_isExpanded)) else { return None }
  guard f.get("itemsPerPage") is Some(Num(t1_itemsPerPage)) else { return None }
  let v_itemsPerPage = t1_itemsPerPage.to_int()
  guard f.get("currentPage") is Some(Num(t1_currentPage)) else { return None }
  let v_currentPage = t1_currentPage.to_int()
  guard f.get("typeLabel") is Some(Str(v_typeLabel)) else { return None }
  guard f.get("badges") is Some(t1_badges) else { return None }
  guard t1_badges is List(u1_badges) else { return None }
  let v_badges : Array[@tutuca.Value] = []
  for e1_badges in u1_badges {
    let x1_badges = e1_badges
    v_badges.push(x1_badges)
  }
  guard f.get("title") is Some(Str(v_title)) else { return None }
  guard f.get("description") is Some(Str(v_description)) else { return None }
  guard f.get("deprecated") is Some(Bool(v_deprecated)) else { return None }
  Some(SchemaCombinatorState::{
    items: v_items,
    isExpanded: v_isExpanded,
    itemsPerPage: v_itemsPerPage,
    currentPage: v_currentPage,
    typeLabel: v_typeLabel,
    badges: v_badges,
    title: v_title,
    description: v_description,
    deprecated: v_deprecated,
  })
}

