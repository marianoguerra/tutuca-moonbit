]

///|
/// The structural fingerprint of this component's schema. Changes when
/// the SHAPE changes — a renamed or retyped field, a new message case —
/// and not when the block is merely reformatted.
pub let component_inspector_schema_fingerprint : String = "177c6b469255fb1e"

///|
/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through. That is the case a JSON round trip could not do at all: an
/// `Obj` or an `Fn` does not survive one.
impl @component.Fields for ComponentInspectorState with fn encode(s) {
  {
    "compName": Str(s.compName),
    "compId": Num(s.compId.to_double()),
    "sections": (List(s.sections.map(x => x)) : @tutuca.Value),
  }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
impl @component.Fields for ComponentInspectorState with fn decode(f) {
  guard f.get("compName") is Some(Str(v_compName)) else { return None }
  guard f.get("compId") is Some(Num(t1_compId)) else { return None }
  let v_compId = t1_compId.to_int()
  guard f.get("sections") is Some(t1_sections) else { return None }
  guard t1_sections is List(u1_sections) else { return None }
  let v_sections : Array[@tutuca.Value] = []
  for e1_sections in u1_sections {
    let x1_sections = e1_sections
    v_sections.push(x1_sections)
  }
  Some(ComponentInspectorState::{
    compName: v_compName,
    compId: v_compId,
    sections: v_sections,
  })
}

///|
/// The Bubble arm of @component.Dispatch, decoded.
///
/// Declared as `variant bubble` in the state block. These names are
/// raised by component code rather than written in a view, so the views
/// cannot type them — the schema is the only place they can be declared.
pub(all) enum ComponentInspectorBubble {
  ToggleAllSections(Bool)
  ToggleAllViews(Bool)
  /// A bubble the schema does not declare, or a declared name whose
  /// runtime arguments did not match the declared types.
  Unknown(String, Array[@tutuca.Value])
}

///|
/// Decode a Bubble dispatch. None for any other bucket.
///
/// A payload that does not match falls into `Unknown` rather than being
/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,
/// and silently truncating it would hide that.
pub fn ComponentInspectorBubble::from_dispatch(
  d : @component.Dispatch,
) -> ComponentInspectorBubble? {
  guard d is Bubble(name, args) else { return None }
  Some(
    match (name, args) {
      ("toggleAllSections", [Bool(a0)]) => ToggleAllSections(a0)
      ("toggleAllViews", [Bool(a0)]) => ToggleAllViews(a0)
      _ => Unknown(name, args)
    },
  )
}

///|
/// The dispatch name and arguments this message raises as.
pub fn ComponentInspectorBubble::to_dispatch(
  self : ComponentInspectorBubble,
) -> (String, Array[@tutuca.Value]) {
  match self {
    ToggleAllSections(a0) => ("toggleAllSections", [Bool(a0)])
    ToggleAllViews(a0) => ("toggleAllViews", [Bool(a0)])
    Unknown(n, args) => (n, args)
  }
}

///|
/// Bubble this message to the parent component.
///
/// The name comes from the schema, so it cannot drift from the one
/// `from_dispatch` decodes.
pub fn ComponentInspectorBubble::bubble(
  self : ComponentInspectorBubble,
  ctx : &@tutuca.Ctx,
) -> Unit {
  let (name, args) = self.to_dispatch()
  ctx.bubble(name, args)
}

