          (
            [
              ArrowText,
              CannotNextPage,
              CannotPrevPage,
              CountText,
              IsItemsEmpty,
              PageIndicatorText,
              ShowPagination,
              TypeText,
            ] : Array[JsonObjectMethod]),
          JsonObjectMethod::name,
          f,
        )
      None => Map([])
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([NextPage, PrevPage, ToggleIsExpanded] : Array[JsonObjectInput]),
          JsonObjectInput::name,
          f,
        )
      None => Map([])
    },
    loop_with=match loop_with {
      Some(f) =>
        @component.build_bucket(
          ([GetPageRange] : Array[JsonObjectLoopWith]),
          JsonObjectLoopWith::name,
          f,
        )
      None => Map([])
    },
    specs~,
    provide~,
    lookup~,
  )
}

///|
/// The compiled `main` view.
fn json_property_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "div",
      [
        @anode.attr(
          "class", "flex items-center gap-2 leading-tight json-property",
        ),
      ],
      [
        @anode.h(
          "span",
          [@anode.attr("class", "text-base-content/60 font-mono text-sm")],
          [@anode.dyn_text(Field("key"))],
        ),
        @anode.text(" "),
        @anode.h("span", [@anode.attr("class", "text-base-content/30")], [
          @anode.text(":"),
        ]),
        @anode.text(" "),
        @anode.render(0, Field("child")),
      ],
    ),
    [],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn json_property_views() -> Map[String, @anode.View] {
  { "main": json_property_main_view_ir() }
}

///|
/// The JsonProperty component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `JsonPropertyState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn json_property_component(
  name? : String = "JsonProperty",
  views? : Map[String, @anode.View] = json_property_views(),
  init? : JsonPropertyState = JsonPropertyState::zero(),
  common_style? : String = json_property_common_style,
  global_style? : String = json_property_global_style,
  update? : (JsonPropertyState, @component.Dispatch, &@tutuca.Ctx) -> JsonPropertyState?,
  specs? : Map[String, @component.FieldSpec] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    specs~,
    provide~,
    lookup~,
  )
}

