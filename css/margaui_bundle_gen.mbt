    "src/badge.css",
    (
      #|/* Component: badge */
      #|
      #|/* Base badge utility */
      #|@utility badge {
      #|  display: inline-flex;
      #|  align-items: center;
      #|  justify-content: center;
      #|  gap: calc(0.25rem * 2);
