    "src/radial-progress.css",
    (
      #|/* Component: radial-progress.
      #|   The `@property --radialprogress` (inherits: true) registration lives in
      #|   base/properties.css — declaring it here too caused Tailwind v4.2.1's
      #|   in-browser compiler to emit `inherits: false` regardless of source,
      #|   which broke the conic-gradient on `::before` (the pseudo couldn't
      #|   inherit the value from its host `.radial-progress`). */
      #|
      #|/* Base radial-progress */
      #|@utility radial-progress {
      #|  position: relative;
      #|  display: inline-grid;
      #|  height: var(--size);
      #|  width: var(--size);
      #|  place-content: center;
      #|  border-radius: calc(infinity* 1px);
      #|  background-color: transparent;
      #|  color: var(--color-base-content);
      #|  vertical-align: middle;
      #|  box-sizing: content-box;
      #|  --value: 0;
      #|  --size: 5rem;
      #|  --thickness: calc(var(--size) / 10);
      #|  --radialprogress: calc(var(--value) * 1%);
      #|  transition: --radialprogress 0.3s linear;
      #|
      #|  &:before {
      #|    position: absolute;
      #|    inset: 0;
      #|    border-radius: calc(infinity* 1px);
      #|    content: "";
      #|    /* Tailwind v4.2.1's in-browser compiler forces `@property --radialprogress`
      #|       to `inherits: false` and emits `*, ::before, ::after { --radialprogress: 0% }`
      #|       which kills inheritance AND any attempt to re-assign --radialprogress in this
      #|       block. Compute the stop directly from --value (which does inherit). */
      #|    background:
      #|      radial-gradient(farthest-side, currentColor 98%, #0000) top / var(--thickness)
      #|        var(--thickness) no-repeat,
      #|      conic-gradient(currentColor calc(var(--value) * 1%), #0000 0);
      #|    -webkit-mask: radial-gradient(
      #|      farthest-side,
      #|      #0000 calc(100% - var(--thickness)),
      #|      #000 calc(100% + 0.5px - var(--thickness))
      #|    );
      #|    mask: radial-gradient(
      #|      farthest-side,
      #|      #0000 calc(100% - var(--thickness)),
      #|      #000 calc(100% + 0.5px - var(--thickness))
      #|    );
      #|  }
      #|
      #|  &:after {
      #|    position: absolute;
      #|    border-radius: calc(infinity* 1px);
      #|    background-color: currentcolor;
      #|    transition: transform 0.3s linear;
      #|    content: "";
      #|    inset: calc(50% - var(--thickness) / 2);
      #|    transform: rotate(calc(var(--value) * 3.6deg - 90deg)) translate(calc(var(--size) / 2 - 50%));
      #|  }
      #|}
      #|
    ),
  ),
