      #|  --alert-border-color: var(--color-warning);
      #|  --alert-color: var(--color-warning);
      #|}
      #|
      #|@utility alert-error {
      #|  --alert-fg: var(--color-error-content);
      #|  --alert-border-color: var(--color-error);
      #|  --alert-color: var(--color-error);
      #|}
      #|
      #|/* Style variants (initial values — real overrides are below in plain rules
      #|   because Tailwind reorders `@utility` declarations, making the color variants
      #|   like `alert-info` land after these and reclaim `--alert-fg`/`color`). */
      #|@utility alert-dash {
      #|  background-color: transparent;
      #|  border-style: dashed;
      #|  box-shadow: none;
      #|  background-image: none;
      #|}
      #|
      #|@utility alert-outline {
      #|  background-color: transparent;
      #|  box-shadow: none;
      #|  background-image: none;
      #|}
      #|
      #|@utility alert-soft {
      #|  background: var(--alert-color, var(--color-base-content));
      #|  box-shadow: none;
      #|  background-image: none;
      #|
      #|  @supports (color: color-mix(in lab, red, red)) {
      #|    background: color-mix(
      #|      in oklab,
      #|      var(--alert-color, var(--color-base-content)) 8%,
      #|      var(--color-base-100)
      #|    );
      #|  }
      #|}
      #|
      #|/* Style-variant color overrides live outside `@utility` so they win over the
      #|   alert-info/success/warning/error utilities regardless of Tailwind's rule
      #|   ordering. On dash/outline the text becomes the alert-color itself (cyan/
      #|   green/yellow/red) so it reads against the transparent background, not the
      #|   dark *-content color that's designed for the filled variant. */
      #|.alert-dash,
      #|.alert-outline {
      #|  --alert-fg: var(--alert-color, var(--color-base-content));
      #|  color: var(--alert-fg);
      #|}
      #|
      #|.alert-soft {
      #|  --alert-fg: var(--alert-color, var(--color-base-content));
      #|  color: var(--alert-fg);
      #|  --alert-border-color: var(--color-base-100);
      #|
      #|  @supports (color: color-mix(in lab, red, red)) {
      #|    --alert-border-color: color-mix(
      #|      in oklab,
      #|      var(--alert-color, var(--color-base-content)) 10%,
      #|      var(--color-base-100)
      #|    );
      #|  }
      #|}
      #|
    ),
