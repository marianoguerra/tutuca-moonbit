    "src/tooltip.css",
    (
      #|/* Component: tooltip */
      #|
      #|/* Base tooltip */
      #|@utility tooltip {
      #|  position: relative;
      #|  display: inline-block;
      #|  --tt-bg: var(--color-neutral);
      #|  --tt-off: calc(100% + 0.5rem);
      #|  --tt-tail: calc(100% + 1px + 0.25rem);
      #|}
      #|
      #|/* Tooltip content and data-tip pseudo-element */
      #|.tooltip > .tooltip-content,
      #|.tooltip[data-tip]:before {
      #|  position: absolute;
      #|  max-width: 20rem;
      #|  border-radius: var(--radius-field);
      #|  padding-inline: 0.5rem;
      #|  padding-block: 0.25rem;
      #|  text-align: center;
      #|  white-space: normal;
      #|  color: var(--tt-fg, var(--color-neutral-content));
      #|  opacity: 0%;
      #|  font-size: 0.875rem;
      #|  line-height: 1.25;
      #|  background-color: var(--tt-bg);
      #|  width: max-content;
      #|  pointer-events: none;
      #|  z-index: 2;
      #|  content: attr(data-tip);
      #|  transform: translateX(var(--tt-trans, -50%)) translateY(var(--tt-pos, 0.25rem));
      #|  inset: auto auto var(--tt-off) 50%;
      #|}
      #|
      #|/* Tooltip arrow/tail */
      #|.tooltip:after {
      #|  opacity: 0%;
      #|  background-color: var(--tt-bg);
      #|  content: "";
      #|  pointer-events: none;
      #|  width: 0.625rem;
      #|  height: 0.25rem;
      #|  display: block;
      #|  position: absolute;
      #|  mask-repeat: no-repeat;
      #|  mask-position: -1px 0;
      #|  --mask-tooltip: url("data:image/svg+xml,%3Csvg width='10' height='4' viewBox='0 0 8 4' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0.500009 1C3.5 1 3.00001 4 5.00001 4C7 4 6.5 1 9.5 1C10 1 10 0.499897 10 0H0C-1.99338e-08 0.5 0 1 0.500009 1Z' fill='black'/%3E%3C/svg%3E%0A");
      #|  mask-image: var(--mask-tooltip);
      #|  transform: translateX(var(--tt-trans, -50%)) translateY(var(--tt-pos, 0.25rem));
      #|  inset: auto auto var(--tt-tail) 50%;
      #|}
      #|
      #|/* Tooltip transitions */
      #|@media (prefers-reduced-motion: no-preference) {
      #|  .tooltip > .tooltip-content,
      #|  .tooltip[data-tip]:before,
      #|  .tooltip:after {
      #|    transition:
      #|      opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1) 75ms,
      #|      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1) 75ms;
      #|  }
      #|}
      #|
      #|/* Show tooltip on hover/focus/open - for data-tip tooltips */
      #|.tooltip[data-tip]:not([data-tip=""]).tooltip-open > .tooltip-content,
      #|.tooltip[data-tip]:not([data-tip=""]).tooltip-open[data-tip]:before,
      #|.tooltip[data-tip]:not([data-tip=""]).tooltip-open:after,
      #|.tooltip[data-tip]:not([data-tip=""]):hover > .tooltip-content,
      #|.tooltip[data-tip]:not([data-tip=""]):hover[data-tip]:before,
      #|.tooltip[data-tip]:not([data-tip=""]):hover:after,
      #|.tooltip[data-tip]:not([data-tip=""]):has(:focus-visible) > .tooltip-content,
      #|.tooltip[data-tip]:not([data-tip=""]):has(:focus-visible)[data-tip]:before,
      #|.tooltip[data-tip]:not([data-tip=""]):has(:focus-visible):after {
      #|  opacity: 100%;
      #|  --tt-pos: 0rem;
      #|}
      #|
      #|/* Show tooltip on hover/focus/open - for tooltip-content tooltips */
      #|.tooltip:has(.tooltip-content:not(:empty)).tooltip-open > .tooltip-content,
      #|.tooltip:has(.tooltip-content:not(:empty)).tooltip-open:after,
      #|.tooltip:has(.tooltip-content:not(:empty)):hover > .tooltip-content,
      #|.tooltip:has(.tooltip-content:not(:empty)):hover:after,
