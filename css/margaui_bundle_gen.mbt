    "src/typography.css",
    (
      #|/* Utility: typography — overrides for Tailwind Typography's `.prose` class.
      #|   Routes prose theme variables through daisyUI theme tokens so that prose
      #|   content recolors with the active theme. No `@utility` because this is a
      #|   descendant rule on an existing class (matches upstream daisyUI). */
      #|
      #|:root .prose,
      #|:host .prose {
      #|  --tw-prose-body: color-mix(in oklab, var(--color-base-content) 80%, transparent);
      #|  --tw-prose-headings: var(--color-base-content);
      #|  --tw-prose-lead: var(--color-base-content);
      #|  --tw-prose-links: var(--color-base-content);
      #|  --tw-prose-bold: var(--color-base-content);
      #|  --tw-prose-counters: var(--color-base-content);
