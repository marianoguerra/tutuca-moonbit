      #|  --badge-bg: var(--badge-color, var(--color-base-100));
      #|  --badge-fg: var(--color-base-content);
      #|  --size: var(--mg-selector-md);
      #|  height: var(--size);
      #|  padding-inline: calc(var(--size) / 2 - var(--border));
