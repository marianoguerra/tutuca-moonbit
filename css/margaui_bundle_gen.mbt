      #|/* Utility: radius — per-corner helpers for the three daisyUI radius tokens.
      #|   Base `rounded-box/field/selector` already live in colors.css; this file adds
      #|   the edge (t/b/l/r) and corner (tl/tr/br/bl) variants. */
      #|
      #|@utility rounded-t-box {
      #|  border-top-left-radius: var(--radius-box);
      #|  border-top-right-radius: var(--radius-box);
