      #|@property --radialprogress {
      #|  syntax: "<percentage>";
      #|  inherits: true;
      #|  initial-value: 0%;
      #|}
      #|
      #|/*
      #| * Registered so the aura component's rotation animation can interpolate it.
      #| * An unregistered custom property has no type, so @keyframes can only switch
      #| * it discretely (it would jump to 360deg at the end) and the aura never spins.
      #| */
      #|@property --aura-angle {
      #|  syntax: "<angle>";
      #|  inherits: false;
      #|  initial-value: 0deg;
      #|}
      #|
      #|/*
      #| * Shared size-variant ramps. Each component's xs/sm/md/lg/xl variants
      #| * resolve to these values, so the scale lives in one place instead of
      #| * being re-encoded in every form component. The `calc` expressions are
      #| * stored as tokens and re-resolved against the current scope's
      #| * --size-field / --size-selector, so theme overrides still apply.
      #| */
      #|:root,
      #|:host {
      #|  --mg-field-xs: calc(var(--size-field, 0.25rem) * 6);
      #|  --mg-field-sm: calc(var(--size-field, 0.25rem) * 8);
      #|  --mg-field-md: calc(var(--size-field, 0.25rem) * 10);
      #|  --mg-field-lg: calc(var(--size-field, 0.25rem) * 12);
      #|  --mg-field-xl: calc(var(--size-field, 0.25rem) * 14);
      #|
      #|  --mg-selector-xs: calc(var(--size-selector, 0.25rem) * 4);
      #|  --mg-selector-sm: calc(var(--size-selector, 0.25rem) * 5);
      #|  --mg-selector-md: calc(var(--size-selector, 0.25rem) * 6);
      #|  --mg-selector-lg: calc(var(--size-selector, 0.25rem) * 7);
      #|  --mg-selector-xl: calc(var(--size-selector, 0.25rem) * 8);
      #|}
      #|
    ),
  ),
