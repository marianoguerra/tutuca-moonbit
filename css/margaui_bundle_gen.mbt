  (
    "themes/light.css",
    (
      #|/* Light theme - default for :root and explicit [data-theme="light"] selection.
      #|   Deliberately NOT pinned to :host: pinning defaults onto a shadow host blocks
      #|   the ambient page theme (--color-* set on <html data-theme=…>) from inheriting
      #|   across the shadow boundary. To theme a shadow tree, set data-theme on its host. */
      #|:root,
      #|[data-theme="light"] {
      #|  color-scheme: light;
      #|  --color-base-100: oklch(100% 0 0);
      #|  --color-base-200: oklch(98% 0 0);
      #|  --color-base-300: oklch(95% 0 0);
      #|  --color-base-content: oklch(21% 0.006 285.885);
      #|  --color-primary: oklch(45% 0.24 277.023);
      #|  --color-primary-content: oklch(93% 0.034 272.788);
      #|  --color-secondary: oklch(65% 0.241 354.308);
      #|  --color-secondary-content: oklch(94% 0.028 342.258);
      #|  --color-accent: oklch(77% 0.152 181.912);
      #|  --color-accent-content: oklch(38% 0.063 188.416);
      #|  --color-neutral: oklch(14% 0.005 285.823);
      #|  --color-neutral-content: oklch(92% 0.004 286.32);
      #|  --color-info: oklch(74% 0.16 232.661);
      #|  --color-info-content: oklch(29% 0.066 243.157);
      #|  --color-success: oklch(76% 0.177 163.223);
      #|  --color-success-content: oklch(37% 0.077 168.94);
      #|  --color-warning: oklch(82% 0.189 84.429);
      #|  --color-warning-content: oklch(41% 0.112 45.904);
      #|  --color-error: oklch(71% 0.194 13.428);
      #|  --color-error-content: oklch(27% 0.105 12.094);
      #|  --radius-selector: 0.5rem;
      #|  --radius-field: 0.25rem;
      #|  --radius-box: 0.5rem;
      #|  --size-selector: 0.25rem;
      #|  --size-field: 0.25rem;
      #|  --border: 1px;
      #|  --depth: 1;
      #|  --noise: 0;
      #|}
      #|
    ),
  ),
  (
    "themes/theme.css",
    (
      #|/**
      #| * Default themes bundle — light + dark.
      #| *
      #| * light.css sets :root defaults so pages work without data-theme. (It is not
      #| * pinned to :host, so components in shadow DOM inherit the ambient page theme;
      #| * set data-theme on a shadow host to theme that subtree.)
      #| * The playground skips this file and imports all themes individually.
      #| *
      #| * For additional themes, import them in your input.css:
      #| *   @import "./themes/dracula.css";
      #| */
      #|
      #|/* Default theme (light) - sets :root defaults */
      #|@import "./light.css";
      #|
      #|/* Dark theme */
      #|@import "./dark.css";
      #|
    ),
  ),
  (
    "base/colormix.css",
    (
      #|/*
      #| * Shared color-mix tokens used by components that want a theme-derived
      #| * tint of --color-base-content for subtle borders, placeholders, and
      #| * disabled text. Lazy substitution means these still respect per-theme
      #| * overrides of --color-base-content.
      #| *
      #| * Every consumer still wraps its reference in
      #| *   @supports (color: color-mix(in lab, red, red)) { ... }
      #| * with a plain-var fallback — these tokens only remove value-level
      #| * duplication, not the fallback ceremony. Extend this file as more
      #| * cross-component mixes appear.
