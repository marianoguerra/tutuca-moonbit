      #|  font-size: 0.625rem;
      #|}
      #|
      #|@utility badge-sm {
      #|  --size: var(--mg-selector-sm);
      #|  font-size: 0.75rem;
      #|}
      #|
      #|@utility badge-md {
      #|  --size: var(--mg-selector-md);
      #|  font-size: 0.875rem;
      #|}
      #|
      #|@utility badge-lg {
      #|  --size: var(--mg-selector-lg);
      #|  font-size: 1rem;
      #|}
      #|
      #|@utility badge-xl {
      #|  --size: var(--mg-selector-xl);
      #|  font-size: 1.125rem;
      #|}
      #|
      #|/* Color variants — one functional utility resolves all 8 semantic colors
      #|   (badge-primary … badge-error) via --value(); non-color suffixes such as
      #|   badge-outline/soft/ghost fall through to their own utilities below. */
