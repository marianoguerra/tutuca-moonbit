// The baseline, which is applied whatever else a config says.

///|
/// The elements the spec calls XSS-unsafe, in the namespaces anode can
/// express.
///
/// Held against the spec's own machine-readable baseline by a test
/// (`spec_baseline_removes`, regenerated by
/// `scripts/fetch-sanitizer-defaults.mjs`), because this list was written from
/// a summary once and the summary was wrong. What it got wrong was **SVG's
/// `script`**: element identity here is namespace-qualified
/// (`ElementName::key`), so `html("script")` does not match the `<script>`
/// inside an `<svg>`, and `<svg><script>alert(1)</script></svg>` passed
/// `check_view` with no violation at all. The spec's baseline lists the two
/// separately for exactly this reason.
///
/// `base` is tutuca's own addition and is NOT in the spec's baseline — a
/// `<base href>` retargets every relative URL on the host's page, which is
/// worth refusing outright even though the spec leaves it to the config layer.
/// The test asserts containment rather than equality so that this stays
/// deliberate: everything the spec removes must be here, and more is allowed.
///
/// SVG's `use` is here because `<use href="…">` pulls in a subtree from
/// elsewhere, the same capability as an include.
///
/// **The four SMIL elements are tutuca's own addition too, and they are here
/// because neither of tutuca's two passes can see what they do.** `<animate>`,
/// `<animateMotion>`, `<animateTransform>` and `<set>` assign an attribute
/// named by `attributeName` to a value named by `to`, and they do it in the
/// browser, AFTER `check` has read the tree and after the render-time filter
/// has read the built nodes. So
/// `<a><animate attributeName="href" to="javascript:…"/></a>` is a live script
/// URL that both passes watched go by: the `href` the filter checked was the
/// one in the source, and the one that navigates is the one SMIL wrote. There
/// is no value here to inspect and no later point to inspect it at, which
/// leaves refusing the ELEMENT as the only decision available — the same shape
/// of argument `dyncomp/policy` already made when it put these four in
/// `untrusted_sink_element`. They are in the baseline rather than in that list
/// alone because a plain app has no Pass 1 at all, and reaches the same markup
/// through `@setinnerhtml`, `@setinnersvg` and markdown's HTML blocks.
///
/// Case is the parser's: `moonbit-community/html` runs the HTML5 "adjust SVG
/// tag name" table, so `<animatetransform>` in source arrives as
/// `animateTransform` and matches the entry below.
pub let unsafe_elements : Array[ElementName] = [
  html("base"),
  html("embed"),
  html("frame"),
  html("iframe"),
  html("object"),
  html("script"),
  svg("script"),
  svg("use"),
  svg("animate"),
  svg("animateMotion"),
  svg("animateTransform"),
  svg("set"),
]

///|
/// An event-handler content attribute, by the `on` prefix.
///
/// The spec enumerates them (`onafterprint`, `onbeforeinput`, …). A prefix test
/// is a superset of that enumeration and cannot fall behind it as the platform
/// adds handlers, which for a REMOVE rule is the safe direction to be wrong in.
/// No non-handler attribute in HTML, SVG or MathML begins with `on`.
pub fn is_event_handler_attr(name : String) -> Bool {
  name is ['o' | 'O', 'n' | 'N', _, ..]
}

///|
/// Whether the baseline alone refuses this element, whatever a config says.
fn is_unsafe_element(key : String) -> Bool {
  unsafe_element_keys.contains(key)
}

///|
let unsafe_element_keys : @set.Set[String] = @set.Set::from_array(
  unsafe_elements.map(ElementName::key),
)

///|
/// The config a host gets by asking for nothing: the empty config.
///
/// The BASELINE is not in here, and that is the spec's shape rather than an
/// omission. Safety in the Sanitizer API comes from the entry point, not from
/// the config: `setHTML()` applies unsafe-removal on top of whatever config it
/// is handed, so a config that allows `script` still does not get `script`.
/// `Sanitizer` here has only the safe entry point — there is no
/// `setHTMLUnsafe` analogue and no reason to build one for a host rendering
/// views it did not write — so the baseline is unconditional and a config's
/// job is only to narrow further.
///
/// What this is NOT is the spec's *default configuration*, which is a large
/// allow-list of elements with per-element attributes. That list is worth
/// having and is not transcribed yet: it has to come from the specification
/// text rather than a summary of it, because an allow-list that quietly lost an
/// entry is a component that mysteriously fails to render, and one that quietly
/// gained an entry is a hole. Until then a host that wants an allow-list
/// supplies one and gets `validate()` to keep it honest.
pub fn SanitizerConfig::default() -> SanitizerConfig {
  SanitizerConfig::empty()
}

///|
/// The baseline as a sanitizer: everything except the unsafe elements, the
/// event handlers, comments, `data-*` and raw markup.
///
/// Constructed directly rather than through `new`, because the empty config
/// cannot be invalid and this way the constructor's `raise` does not
/// propagate to every caller that wants the default.
pub fn Sanitizer::default() -> Sanitizer {
  {
    allow_elements: None,
    remove_elements: @set.Set::from_array([]),
    replace_with_children: @set.Set::from_array([]),
    allow_attributes: None,
    remove_attributes: @set.Set::from_array([]),
    // Kept — see `Sanitizer::new`. The baseline is the unsafe elements and the
    // event handlers, and nothing else.
    comments: true,
    data_attributes: false,
    raw_markup: false,
    // Off here, and switched on by the filters that need it
    // (`Sanitizer::without_css`). The default sanitizer is what every ordinary
    // view is checked against, and an ordinary view's `style` attribute is the
    // author's own.
    css: @safecss.CssPolicy::app(),
  }
}
