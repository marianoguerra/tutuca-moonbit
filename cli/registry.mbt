// Command registry: single source of truth for dispatch, `help`, and the
// `agent-context` schema.
//
// One command set. tutuca-mb compiles ahead of time, so there is nothing here
// that inspects a user's components: `gen-views` makes their views typed
// MoonBit at build time (a bad field or an unhandled handler is a compile
// error) and `moon test` runs their behaviour. What is left is the work that
// really does happen outside the compiler.

///|
let help_flag : FlagSpec = flag("help", short="h", type_="boolean")

///|
fn flag(
  name : String,
  short? : String,
  type_~ : String,
  enum_? : Array[String],
  description? : String,
) -> FlagSpec {
  { name, short, type_, enum_, description }
}

///|
fn positional(
  name : String,
  required~ : Bool,
  description? : String,
  note? : String,
) -> PositionalSpec {
  { name, required, description, note }
}

///|
/// Shared by both CSS commands: they differ only in which stylesheets the
/// collected classes compile against, so one flag set covers both and cannot
/// drift apart.
let css_flags : Array[FlagSpec] = [
  flag(
    "out",
    short="o",
    type_="string",
    description="Write the CSS here (default: stdout).",
  ),
  flag(
    "entry",
    type_="string",
    description="Compile this CSS entry instead of the embedded one, resolving its @imports from disk.",
  ),
  flag(
    "classes",
    type_="string",
    description="Extra candidate class names, one per line, for names a view assembles at run time.",
  ),
  flag(
    "print-classes",
    type_="boolean",
    description="Print the collected class names instead of the CSS.",
  ),
  flag(
    "polyfills",
    type_="string",
    enum_=["0", "1", "2", "3"],
    description="0=none, 1=@property, 2=color-mix, 3=all (default 3).",
  ),
  help_flag,
]

///|
let css_positional : PositionalSpec = positional(
  "path",
  required=false,
  description="View files or directories to search (default: the current directory).",
  note="A directory contributes the .html files that already have a generated sibling.",
)

///|
/// Every command, in the order `agent-context` reports them and did-you-mean
/// ranks them.
let commands : Array[CommandSpec] = [
  {
    name: "help",
    describe: "Show usage. `help <command>` for per-command detail.",
    flags: [help_flag],
    positionals: [positional("command", required=false)],
  },
  {
    name: "feedback",
    describe: "Record freeform feedback (bug, confusion, suggestion) to ~/.tutuca/feedback.jsonl.",
    flags: [help_flag],
    positionals: [
      positional(
        "message",
        required=false,
        note="Falls back to piped stdin when omitted.",
      ),
    ],
  },
  // The skill assets are embedded in the binary at compile time
  // (skill_assets_gen.mbt, regenerated by `cmd/dev -- skill-embed`). Only
  // the tutuca skill ships with the MoonBit port — no margaui/immutable-js
  // selection flags.
  {
    name: "install-skill",
    describe: "Install the bundled tutuca Claude Code skill into .claude/skills/.",
    flags: [
      flag("user", type_="boolean", description="Install at ~/.claude/skills/."),
      flag(
        "project",
        type_="boolean",
        description="Install at ./.claude/skills/ (default).",
      ),
      flag(
        "dot-agents",
        type_="boolean",
        description="Use .agents/skills/ instead of .claude/skills/.",
      ),
      flag(
        "dry-run",
        type_="boolean",
        description="Print files that would be written; don't touch disk.",
      ),
      flag(
        "force",
        short="f",
        type_="boolean",
        description="Overwrite existing files.",
      ),
      help_flag,
    ],
    positionals: [],
  },
  // The other half of dyncomp: `dyncomp/` lets a host LOAD a component from
  // anywhere, and this is how someone writes one. The whole guest tree —
  // contract, bindings, SDK, a working component, the build scripts — is
  // embedded in the binary (guest_template_gen.mbt, regenerated by
  // `cmd/dev -- guest-template-embed`), so scaffolding needs no network and no
  // wit-bindgen.
  {
    name: "new-guest",
    describe: "Scaffold a tutuca:component guest — a wasm component a running app can load.",
    flags: [
      flag(
        "dir",
        type_="string",
        description="Write somewhere other than ./<name>/.",
      ),
      flag(
        "dry-run",
        type_="boolean",
        description="Print files that would be written; don't touch disk.",
      ),
      flag(
        "force",
        short="f",
        type_="boolean",
        description="Overwrite existing files.",
      ),
      help_flag,
    ],
    positionals: [
      positional(
        "name",
        required=true,
        note="kebab-case; becomes the directory, the bundle name and the source file you edit.",
      ),
    ],
  },
  // A pre-built static bundle, served or copied. The gallery itself is a wasm
  // host built by `cmd/dev -- dist`; this command is a static file server and
  // nothing else, so it needs no knowledge of the story registry.
  {
    name: "storybook",
    describe: "Serve (or copy) the pre-built storybook gallery bundle.",
    flags: [
      flag(
        "port",
        type_="string",
        description="Preferred port (default 4321; falls back to a free port).",
      ),
      flag(
        "out",
        type_="string",
        description="Copy the static bundle to <dir> instead of serving.",
      ),
      help_flag,
    ],
    positionals: [
      positional(
        "dir",
        required=false,
        description="A pre-built bundle directory to serve (default: the bundle shipped next to the binary, dist/storybook).",
      ),
    ],
  },
  // Ahead-of-time view compilation (gen_views.mbt + the viewgen package).
  // Needs no module: it reads an .html file and writes a .mbt file, so it
  // works before the component that will use the generated types exists.
  {
    name: "gen-views",
    describe: "Compile .html files of views into MoonBit modules of typed view surfaces.",
    flags: [
      flag(
        "name",
        type_="string",
        description="Component name heading the generated types (default: the file's basename). Refused with more than one path.",
      ),
      flag(
        "out",
        type_="string",
        description="Output directory, or an explicit .mbt path (default: beside each input). The .mbt form is refused with more than one path.",
      ),
      flag(
        "dry-run",
        type_="boolean",
        description="Print the generated modules instead of writing them.",
      ),
      flag(
        "no-ir",
        type_="boolean",
        description="Skip the companion compiled-tree module (<stem>_view_ir_gen.mbt).",
      ),
      help_flag,
    ],
    positionals: [
      positional(
        "path",
        required=true,
        description="View files or directories to compile.",
        note="A directory contributes the .html files that already have a generated sibling. The paths passed are also the set the cross-component checks can see.",
      ),
    ],
  },
  // Build-time CSS (gen_css.mbt). The same class collection a running host does
  // before injecting a <style>, run over the view files instead — so an
  // ahead-of-time project can ship a stylesheet holding only what it uses. Two
  // commands rather than one flag, because the stylesheet set is the whole
  // decision: stock Tailwind, or Tailwind plus margaui's components.
  {
    name: "gen-tailwind-css",
    describe: "Compile the classes a project's views use into CSS, against stock Tailwind.",
    flags: css_flags,
    positionals: [css_positional],
  },
  {
    name: "gen-margaui-css",
    describe: "Compile the classes a project's views use into CSS, against Tailwind + margaui.",
    flags: css_flags,
    positionals: [css_positional],
  },
  // The authoring loop for views: `gen-views` on every save (watch.mbt).
  {
    name: "watch",
    describe: "Watch view files and regenerate their MoonBit modules on change.",
    flags: [
      flag(
        "name",
        type_="string",
        description="Component name, when watching a single unnamed file.",
      ),
      flag(
        "out",
        type_="string",
        description="Output directory (default: beside each input).",
      ),
      flag(
        "no-ir",
        type_="boolean",
        description="Skip the companion compiled-tree module.",
      ),
      flag(
        "tailwind-css",
        type_="string",
        description="Also rewrite this stylesheet from the watched views, against stock Tailwind.",
      ),
      flag(
        "margaui-css",
        type_="string",
        description="Also rewrite this stylesheet from the watched views, against Tailwind + margaui.",
      ),
      flag(
        "css-entry",
        type_="string",
        description="The CSS commands' --entry, for the stylesheet watch writes.",
      ),
      flag(
        "css-classes",
        type_="string",
        description="The CSS commands' --classes, for the stylesheet watch writes.",
      ),
      help_flag,
    ],
    positionals: [
      positional(
        "path",
        required=false,
        description="View files or directories to watch (default: the current directory).",
      ),
    ],
  },
  {
    name: "agent-context",
    describe: "Print a machine-readable schema (commands, flags, exit codes) as JSON.",
    flags: [],
    positionals: [],
  },
]

///|
pub fn find_command(name : String) -> CommandSpec? {
  for c in commands {
    if c.name == name {
      return Some(c)
    }
  }
  None
}

///|
pub fn command_names() -> Array[String] {
  commands.map(c => c.name)
}
