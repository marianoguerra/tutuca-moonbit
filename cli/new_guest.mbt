// `tutuca new-guest <name>` — scaffold a `tutuca:component` guest.
//
// The other half of the dynamic-component story. `dyncomp/` lets a host LOAD a
// component from anywhere; this is how someone writes one. It emits a complete
// MoonBit guest module — the WIT contract, the checked-in wit-bindgen bindings,
// the SDK, a working component to edit, and the build/pack scripts — from the
// tree embedded in this binary (guest_template_gen.mbt, regenerated by
// `moon run --target native cmd/dev -- guest-template-embed`).
//
// It does NOT run wit-bindgen, and a guest author does not need it installed:
// the bindings ship generated and drift-checked, and the WIT is the contract
// rather than something to regenerate against. That also keeps this command
// inside the CLI's rule that the core decides and the shell only writes —
// cmd/tutuca spawns no subprocesses.
//
// Why a scaffolder rather than a package to depend on: `sdk.mbt` implements the
// `declare`s in the generated `top.mbt` and defines methods on `Instance`, and
// MoonBit puts both in the package that declares the type. There is no import
// edge that can carry them, so the SDK travels as source.

///|
/// What the shell should write: `files` are (path-relative-to-`dir`, contents)
/// with every placeholder already substituted; `dir` is relative to the cwd.
pub(all) struct GuestScaffoldPlan {
  dir : String
  name : String
  force : Bool
  files : Array[(String, String)]
} derive(Debug, Eq)

///|
let new_guest_help : String =
  #|tutuca new-guest <name> [--dir <path>] [--dry-run] [--force]
  #|
  #|  Scaffolds a tutuca:component guest — a WebAssembly component a running
  #|  tutuca app can load — into ./<name>/ (or --dir).
  #|
  #|  <name> is kebab-case: it becomes the directory, the bundle name, and the
  #|  source file you edit. `temp-conv` gives you TempConv in temp_conv.mbt.
  #|
  #|  --dir <path> writes somewhere other than ./<name>/.
  #|  --dry-run prints the files that would be written without touching disk.
  #|  --force overwrites existing files.
  #|
  #|  Then: npm install && node build.mjs && node pack.mjs
  #|  Needs moon, wasm-tools and node — NOT wit-bindgen; the bindings ship
  #|  generated, and wit/tutuca-component.wit is the contract, not a source to
  #|  regenerate from.
  #|

///|
/// Is this a name that can be a directory, a WIT-ish bundle name, a MoonBit
/// identifier stem and a file name all at once? Kebab-lowercase is the
/// intersection, so that is the rule. `None` = fine; `Some(hint)` = why not.
pub fn guest_name_check(name : String) -> String? {
  if name.is_empty() {
    return Some("a name is required")
  }
  let first = name[0]
  if !(first >= 'a' && first <= 'z') {
    return Some("must start with a lowercase letter")
  }
  if name.has_suffix("-") {
    return Some("must not end with '-'")
  }
  let mut prev_dash = false
  for c in name {
    let ok = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-'
    if !ok {
      return Some("only lowercase letters, digits and '-' are allowed")
    }
    if c == '-' && prev_dash {
      return Some("must not contain '--'")
    }
    prev_dash = c == '-'
  }
  // The name becomes a FILE name, and MoonBit reads `*_test.mbt` /
  // `*_wbtest.mbt` as test files rather than package source. A guest called
  // `smoke-test` would compile — its `dyn_module` would just be in test scope,
  // leaving the SDK's `declare` unimplemented — and produce a bundle that
  // declares nothing. That is a warning, not an error, so it is exactly the
  // kind of thing someone ships without noticing.
  if name.has_suffix("-test") || name.has_suffix("-wbtest") {
    return Some(
      "'-test'/'-wbtest' would make the source a MoonBit TEST file, and your components would vanish from the bundle",
    )
  }
  None
}

///|
/// `temp-conv` -> `TempConv`: the struct and component name.
pub fn pascal_case(name : String) -> String {
  let sb = StringBuilder()
  let mut upper = true
  for c in name {
    if c == '-' {
      upper = true
    } else if upper {
      sb.write_char(c.to_ascii_uppercase())
      upper = false
    } else {
      sb.write_char(c)
    }
  }
  sb.to_string()
}

///|
/// `temp-conv` -> `temp_conv`: the file stem and function prefix. A MoonBit
/// identifier cannot hold a hyphen, and a file named with one cannot be a
/// module path either.
pub fn snake_case(name : String) -> String {
  let sb = StringBuilder()
  for c in name {
    sb.write_char(if c == '-' { '_' } else { c })
  }
  sb.to_string()
}

///|
/// Substitute the three placeholders. Applied to every emitted path AND to
/// every file's contents, so the embedded tree can stay name-agnostic and one
/// embed serves every guest.
pub fn substitute_guest_name(text : String, name : String) -> String {
  text
  .replace_all(old="{{name_ident}}", new=snake_case(name))
  .replace_all(old="{{Name}}", new=pascal_case(name))
  .replace_all(old="{{name}}", new=name)
}

///|
/// Parse new-guest's own args and either finish purely (help, dry-run, usage
/// errors, missing assets) or hand the shell a write plan.
fn run_new_guest(args : Array[String], opts : GlobalOpts) -> Outcome {
  let parsed = match parse_flags(args, command_spec("new-guest")) {
    Ok(p) => p
    Err(e) => return Done(error_emit(opts, e))
  }
  if parsed.bool("help") || opts.help {
    return Done({ out: new_guest_help, err: "", exit_code: 0 })
  }
  let dry_run = parsed.bool("dry-run")
  let force = parsed.bool("force")
  let dir = parsed.str("dir").unwrap_or("")
  // One name, because one bundle per directory. A second positional is the
  // user meaning two guests, and saying so beats silently building the first.
  if parsed.positionals.length() > 1 {
    return Done(
      error_emit(
        opts,
        err(
          CODE_USAGE_UNKNOWN_FLAG,
          "new-guest takes one name, got '\{parsed.positionals[0]}' and '\{parsed.positionals[1]}'",
          hint="one bundle per directory; run it again for the second.",
        ),
      ),
    )
  }
  let name = parsed.positionals.get(0).unwrap_or("")
  if name == "" {
    return Done(
      error_emit(
        opts,
        err(
          CODE_USAGE_MISSING_ARGUMENT,
          "new-guest needs a name",
          hint="e.g. `tutuca new-guest clock`; see -h for the naming rule",
        ),
      ),
    )
  }
  match guest_name_check(name) {
    Some(why) =>
      return Done(
        error_emit(
          opts,
          err(
            CODE_GUEST_NAME_INVALID,
            "'\{name}' is not a usable guest name: \{why}",
            hint="kebab-case only — it becomes a directory, a bundle name and a MoonBit file all at once. `temp-conv`, not `TempConv`.",
          ),
        ),
      )
    None => ()
  }
  if guest_template_files.is_empty() {
    return Done(
      error_emit(
        opts,
        err(
          CODE_GUEST_TEMPLATE_MISSING,
          "no guest template embedded in this binary",
          hint="regenerate with `moon run --target native cmd/dev -- guest-template-embed` and rebuild",
        ),
      ),
    )
  }
  let target = if dir == "" { name } else { dir }
  let files : Array[(String, String)] = []
  for pair in guest_template_files {
    files.push(
      (substitute_guest_name(pair.0, name), substitute_guest_name(pair.1, name)),
    )
  }
  if dry_run {
    let sb = StringBuilder()
    sb.write_string("would scaffold guest '\{name}' → \{target}/\n")
    for pair in files {
      sb.write_string("  + \{pair.0}\n")
    }
    return Done({ out: sb.to_string(), err: "", exit_code: 0 })
  }
  NewGuest(opts, plan={ dir: target, name, force, files })
}

///|
/// The already-exists refusal, pre-rendered for the shell once it has found a
/// file it would overwrite. Scaffolding into a directory someone has been
/// working in is the one way this command can destroy work, so it refuses on
/// the FIRST collision rather than asking afterwards.
pub fn new_guest_target_exists(opts : GlobalOpts, dir : String) -> Emit {
  error_emit(
    opts,
    err(
      CODE_GUEST_TARGET_EXISTS,
      "\{dir} already contains guest files",
      hint="Re-run with --force to overwrite, or --dry-run to see what would change.",
    ),
  )
}

///|
/// What the shell prints after writing. It names the three commands in order
/// and the one file to edit, because "what do I do now" is the only question a
/// freshly scaffolded directory raises.
pub fn new_guest_success(name : String, dir : String) -> String {
  "scaffolded tutuca guest '\{name}' → \{dir}/\n" +
  "\n" +
  "  cd \{dir}\n" +
  "  npm install        # @bytecodealliance/jco\n" +
  "  node build.mjs     # moon build → wasm-tools embed/new → jco transpile\n" +
  "  node pack.mjs      # \{name}.tutuca.tar.gz\n" +
  "\n" +
  "Drop \{name}.tutuca.tar.gz on a universal host page and every component it\n" +
  "declares joins the catalog.\n" +
  "\n" +
  "Edit gen/interface/tutuca/component/guest/\{snake_case(name)}.mbt — it is the\n" +
  "only file you write. See README.md in the new directory.\n"
}
