// GENERATED by `moon run --target native cmd/dev -- storybook-template-embed`
// — DO NOT EDIT. Embeds a whole gallery project in the CLI so
// `tutuca new-storybook` can write one out.
//
// Assembled from storybook/template/, whose `page/counter.tutu` is in the
// repo's `gen` sweep — so the generated view module the template
// hands out cannot drift from the generator that would rewrite it.

///|
pub let storybook_template_files : Array[(String, String)] = [
  (".gitignore", "_build/\ndist/\n.mooncakes/\ntarget/\n"),
  (
    "README.md", "# {{name}}\n\nA storybook gallery of this project's tutuca components: a sidebar of stories,\na live pane for each, and per-story Instance, Trace, Fuzz, Spec and Raw\ninspectors.\n\n## Build and serve\n\n```sh\nnode build.mjs        # moon build --target wasm-gc --release page, then dist/\npython3 -m http.server --directory dist # or any static server over dist/\n```\n\nNeeds `moon` and Node >= 20, and a browser with the JS String Builtins proposal\n(Chrome/Edge). The first build fetches `marianoguerra/tutuca` from mooncakes.\n\n## Adding a story\n\nA story is an **example on a `ModuleDef`**, not an entry in a list:\n\n```moonbit\npub fn quantity_picker_module() -> @component.ModuleDef {\n  @component.ModuleDef::new(name=\"quantity-picker\", components=[quantity_picker_component(initial=QuantityPickerState::fresh())], examples=[\n    { component: \"QuantityPicker\", title: \"Minimum\", args: Map([]), view: None },\n    { component: \"QuantityPicker\", title: \"Seeded\", args: { \"quantity\": Num(7) }, view: None },\n  ])\n}\n```\n\n`page/main.mbt` projects those into stories with\n`@sb.stories_of_modules([...])`. Add a module to that call and every example it\ndeclares shows up. The same examples are what `@harness.mount_example` mounts in\na test, so a story and a test cannot disagree.\n\nOverrides are ordinary `.map`s over the projected list — `Story` is `pub(all)`:\n\n```moonbit\nstories.map(s => if s.id == \"quantity-picker-quantitypicker-seeded\" { { ..s, init: true } } else { s })\n```\n\n- `init: true` — the host dispatches `init` into the pane after mount, for a\n  story whose root loads its data that way. Tutuca has no lifecycle, so nothing\n  infers this.\n- `renderable: false` — listed in the sidebar, never mounted. For a fixture\n  whose view is deliberately malformed.\n- `section` / `description` — sidebar grouping and the blurb under the title.\n\n## Adding a component\n\nWrite the view file, then generate its MoonBit module:\n\n```sh\ntutuca gen page/my_thing.tutu\n```\n\nThe generated `page/my_thing_view_gen.mbt` is checked in and never hand-edited;\n`tutuca watch page/` regenerates on save. Then build a `ModuleDef` around\n`my_thing_component()` and add it to `sections()` in `page/main.mbt`.\n\n## What each file is\n\n| File | |\n| --- | --- |\n| `page/main.mbt` | the story set and the wasm entry points |\n| `page/quantity-picker.tutu` | a demo component's spec, logic and views |\n| `page/quantity-picker_view_gen.mbt` | generated from it — regenerate, never edit |\n| `page/moon.pkg` | the executable's `link.exports` list |\n| `index.html` | the page: the margaui `<style>` slot, `#app`, the loader |\n| `build.mjs` | wasm build, wasm-opt, and the JS the page needs beside it |\n\nThe gallery itself is `marianoguerra/tutuca/storybook/ui/wasm`. This project is\nthe executable around it, because a wasm-gc export list is per-package `link`\nconfiguration and cannot come from a dependency.\n\n## Options\n\n`@sbw.mount` takes more than the sections:\n\n```moonbit\nlet sections = sections()\n@sbw.mount(\n  sections,\n  themes=[\"light\", \"dark\"],        // the palettes the switcher offers\n  panels=@panelsw.all(sections),   // the tabs — drop it for stories only\n) |> ignore\n```\n\nThe tabs are opt-in because they are what most of the wasm IS: dropping the\n`panels~` argument and the `@panelsw` import takes the page from ~3.1 MB to\n~1.25 MB (`--release`, before wasm-opt).\n",
  ),
  (
    "build.mjs", "#!/usr/bin/env node\n// Build this gallery into ./dist:\n//\n//   moon build --target wasm-gc --release page   the page\n//   moon-wasm-opt -Oz                            shrink it\n//   copy the loader out of .mooncakes            the JS a wasm-gc page needs\n//\n// Then: python3 -m http.server --directory dist    (or any static server over dist/)\n//\n// A plain Node script on purpose: `moon` and `node` are all it needs, and it\n// reaches nothing outside this directory.\n//\n// Prereqs: moon (brings moon-wasm-opt), Node >= 20, and network on first run.\nimport { execFileSync } from \"node:child_process\";\nimport {\n  copyFileSync,\n  existsSync,\n  mkdirSync,\n  readFileSync,\n  writeFileSync,\n} from \"node:fs\";\nimport { dirname, join } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst dist = join(here, \"dist\");\n\nconst step = (msg) => console.log(`\\n\\x1b[1m→ ${msg}\\x1b[0m`);\nconst run = (prog, args, cwd = here) =>\n  execFileSync(prog, args, { stdio: \"inherit\", cwd });\n\nfunction tryRun(prog, args, cwd = here) {\n  try {\n    execFileSync(prog, args, { stdio: \"inherit\", cwd });\n    return true;\n  } catch (err) {\n    if (err.code === \"ENOENT\") return false;\n    throw err;\n  }\n}\n\n// --- 1. the page ----------------------------------------------------------\n\nstep(\"moon build --target wasm-gc --release page\");\nrun(\"moon\", [\"build\", \"--target\", \"wasm-gc\", \"--release\", \"page\"]);\n\nconst pageWasm = join(here, \"_build/wasm-gc/release/build/page/page.wasm\");\nif (!existsSync(pageWasm)) {\n  console.error(`build: expected ${pageWasm} — did the package name change?`);\n  process.exit(1);\n}\n\n// --- 2. find the installed tutuca -----------------------------------------\n\n// A wasm-gc module cannot reach the DOM, so the JavaScript that gives it one\n// comes down with the package and has to land beside the page. Find it where\n// `moon` put it. Walking up covers a dependency hoisted to a parent module's\n// .mooncakes; the `src/` variant covers modules published with a source root.\nfunction findTutuca() {\n  const probe = \"app/wasm/loader.mjs\";\n  let dir = here;\n  for (;;) {\n    for (const rel of [\"\", \"src/\"]) {\n      const root = join(dir, \".mooncakes/marianoguerra/tutuca\", rel);\n      if (existsSync(join(root, probe))) return root;\n    }\n    const up = dirname(dir);\n    if (up === dir) return null;\n    dir = up;\n  }\n}\n\nconst tutuca = findTutuca();\nif (!tutuca) {\n  console.error(\n    \"build: could not find marianoguerra/tutuca in .mooncakes.\\n\" +\n      \"  A stale local index resolves an older release that has no storybook\\n\" +\n      \"  packages. Run:\\n\\n    moon update && node build.mjs\\n\",\n  );\n  process.exit(1);\n}\nstep(`using ${tutuca}`);\n\n// --- 3. assemble dist ------------------------------------------------------\n\nmkdirSync(dist, { recursive: true });\n\nstep(\"assembling dist/\");\ncopyFileSync(pageWasm, join(dist, \"page.wasm\"));\n\n// -Oz on the release wasm: roughly 4x smaller, and it is the same module.\n// moon-wasm-opt ships with the moon toolchain, so it is there if moon is; bare\n// `wasm-opt` is the fallback for a PATH with binaryen but not moon's copy.\n// Neither is required — an unoptimized page works, it is just fat.\nconst optArgs = [\n  \"--all-features\",\n  \"--disable-custom-descriptors\",\n  \"-Oz\",\n  join(dist, \"page.wasm\"),\n  \"-o\",\n  join(dist, \"page.wasm\"),\n];\nif (!tryRun(\"moon-wasm-opt\", optArgs) && !tryRun(\"wasm-opt\", optArgs)) {\n  console.warn(\n    \"  ! neither moon-wasm-opt nor wasm-opt found — shipping the unoptimized wasm\",\n  );\n}\n\ncopyFileSync(join(here, \"index.html\"), join(dist, \"index.html\"));\ncopyFileSync(join(tutuca, \"app/wasm/loader.mjs\"), join(dist, \"app-loader.mjs\"));\n// The Trace tab's file service. Rewritten rather than copied: it imports the\n// app loader by the path the two have inside the package, and in dist/ they\n// land flat beside each other.\nwriteFileSync(\n  join(dist, \"files-loader.mjs\"),\n  readFileSync(join(tutuca, \"files/wasm/loader.mjs\"), \"utf8\").replace(\n    \"../../app/wasm/loader.mjs\",\n    \"./app-loader.mjs\",\n  ),\n);\n\n// The copy list is not the check. Reading what landed is: resolve every\n// relative specifier — static AND dynamic — in the JS now sitting in dist/, and\n// fail if one of them is not there. That turns \"the copy list is wrong\" into a\n// build error instead of a 404 a reader finds by clicking.\nconst SPECIFIER = /(?:\\bfrom\\s*|\\bimport\\s*\\(\\s*)[\"'](\\.[^\"']*)[\"']/g;\nconst missing = [];\nconst scan = [\"index.html\", \"app-loader.mjs\", \"files-loader.mjs\"];\nfor (const file of scan.filter((f) => existsSync(join(dist, f)))) {\n  const src = readFileSync(join(dist, file), \"utf8\");\n  for (const [, spec] of src.matchAll(SPECIFIER)) {\n    const target = join(dist, dirname(file), spec);\n    if (!existsSync(target)) {\n      missing.push(`  ${file} imports \"${spec}\" — not in dist/`);\n    }\n  }\n}\nif (missing.length > 0) {\n  console.error(\"build: dist/ is missing modules its own JS imports:\");\n  console.error(missing.join(\"\\n\"));\n  process.exit(1);\n}\n\nconsole.log(\n  \"\\n\\x1b[1m✓ dist/ is ready\\x1b[0m\\n\\n\" +\n    \"  python3 -m http.server --directory dist            # or any static server over dist/\\n\",\n);\n",
  ),
  (
    "index.html", "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>storybook</title>\n    <!-- margaui CSS (utilities + light/dark theme vars) is compiled in MoonBit\n         and injected here by mount(); pre-placed early so lazily-loaded palette\n         <link>s (dracula, …) win the cascade over the light block. Keep the\n         empty element: the injector upserts into it. -->\n    <style id=\"margaui-css\"></style>\n    <style>\n      body {\n        font-family: system-ui, sans-serif;\n        margin: 0;\n      }\n    </style>\n  </head>\n  <body>\n    <div id=\"app\"></div>\n    <!--\n      Build:  node build.mjs\n      Serve:  python3 -m http.server --directory dist     (or any static server over dist/)\n      Needs a browser with the JS String Builtins proposal (Chrome/Edge).\n    -->\n    <script type=\"module\">\n      import { instantiate } from \"./app-loader.mjs\";\n      import { createFilesImports } from \"./files-loader.mjs\";\n      // `tfiles` is the Trace tab's Download and Load. The gallery's wasm\n      // declares the import because `@panelsw.all` links `files/wasm`, so a\n      // page that leaves it out does not instantiate at all.\n      const exports = await instantiate(\"./page.wasm\", (getExports) => ({\n        tfiles: createFilesImports(getExports),\n      }));\n      exports.mount();\n      // Re-restore selection/filter/focus on Back/Forward. tutuca has no\n      // lifecycle, so the host re-sends `init` (which re-reads the URL).\n      // Programmatic push/replaceState don't fire popstate, so this only runs\n      // on real navigation.\n      window.addEventListener(\"popstate\", () => exports.on_popstate());\n      // The Fuzz tab's frame. MoonBit pulls this when a Play needs the next\n      // step; it schedules ONE frame and nothing re-arms it once the run stops,\n      // so there is no permanent rAF loop here. Drop it and Play silently does\n      // nothing while Step and Burst still work.\n      globalThis.__tutucaFuzzTick = () =>\n        requestAnimationFrame(() => exports.on_fuzz_tick());\n    </script>\n  </body>\n</html>\n",
  ),
  (
    "moon.mod", "// A gallery of this project's own tutuca components.\n//\n// `mizchi/js` is declared directly because `page/` imports `mizchi/js/core`\n// for the `@core.Any` in `on_event`, and a package may only import from a\n// module its own module declares. Pin it to the version tutuca resolves, so\n// there is one copy of it in the graph.\n//\n// Build: node build.mjs   Serve: python3 -m http.server --directory dist\n\nname = \"{{name}}\"\n\nversion = \"0.1.0\"\n\ndescription = \"A storybook gallery of {{name}}'s tutuca components\"\n\npreferred_target = \"wasm-gc\"\n\nimport {\n  \"marianoguerra/tutuca@{{tutuca_version}}\",\n  \"mizchi/js@0.12.2\",\n}\n",
  ),
  (
    "page/main.mbt", "///|\nfn main {\n\n}\n\n///|\n/// The gallery's sections, in the order the sidebar shows them. Add a module\n/// to the list and every example it declares becomes a story.\nfn sections() -> Array[@sb.Section] {\n  let stories = @sb.stories_of_modules([quantity_picker_module()], section_of=m => match\n    m.name {\n      \"quantity-picker\" => \"Learn\"\n      _ => \"Other\"\n    })\n  @sb.sections_of(stories, order=[\"Learn\", \"Other\"])\n}\n\n///|\n/// Mount the gallery on #app. Called from JS once the DOM is ready.\n///\n/// `panels~` is asked for by name because `storybook/ui/wasm` links no panel\n/// layer of its own: this line is what puts the Instance, Trace, Fuzz, Spec and\n/// Raw tabs in the page. Drop it (and the `@panelsw` import) and the gallery is\n/// stories only — and megabytes lighter.\npub fn mount() -> Unit {\n  let sections = sections()\n  @sbw.mount(sections, panels=@panelsw.all(sections)) |> ignore\n}\n\n///|\n/// The delegated DOM event entry point JS calls (via tdom.add_listener).\npub fn on_event(ev : @core.Any) -> Unit {\n  @panelsw.on_event(ev)\n}\n\n///|\n/// Back/Forward: re-read the URL and restore the selection/filter/focus.\npub fn on_popstate() -> Unit {\n  @sbw.on_popstate()\n}\n\n///|\n/// One animation frame of a playing fuzz run.\npub fn on_fuzz_tick() -> Unit {\n  @panelsw.on_fuzz_tick()\n}\n\n///|\n/// Recompile + reinject the margaui sheet for the mounted gallery.\npub fn refresh_margaui() -> Unit {\n  @sbw.refresh_margaui()\n}\n\n///|\n/// The page's answer to a file the Trace tab asked to read.\n///\n/// An export for the reason `on_fuzz_tick` is one: a closure cannot cross into\n/// JS on wasm-gc, so the browser answers an asynchronous read by calling back\n/// in. Drop it and the Trace tab's Download still works — a download is\n/// one-way — but Load reads the file and never delivers it.\npub fn on_file_text(req_id : Int, ok : Bool, text : String) -> Unit {\n  @panelsw.on_file_text(req_id, ok, text)\n}\n",
  ),
  (
    "page/moon.pkg", "// The gallery page: the executable around `storybook/ui/wasm`.\n//\n// That package is a LIBRARY and does everything — mounts the gallery, owns the\n// URL and theme services, bridges DOM events, compiles margaui. This package\n// exists for one reason: a wasm-gc export list is per-package `link`\n// configuration and cannot come from a dependency. So the entry points the\n// page calls are re-exported here as one-line forwards, and the only real\n// content is which stories to show.\n//\n// Build: moon build --target wasm-gc --release page   (or ../build.mjs)\nimport {\n  \"marianoguerra/tutuca/core\" @tutuca,\n  \"marianoguerra/tutuca/anode\",\n  \"marianoguerra/tutuca/component\",\n  // the story model: `stories_of_modules` and `sections_of`\n  \"marianoguerra/tutuca/storybook\" @sb,\n  // the browser host: mount + the page's other entry points\n  \"marianoguerra/tutuca/storybook/ui/wasm\" @sbw,\n  // the standard tabs (Instance/Trace/Fuzz/Spec/Raw) and the page effects they\n  // need. Naming it is what links them: drop this import and the `panels~`\n  // argument in main.mbt and the gallery is stories only.\n  \"marianoguerra/tutuca/storybook/ui/panels/wasm\" @panelsw,\n  // @core.Any: the DOM event the exported on_event receives from JS\n  \"mizchi/js/core\",\n  // `derive(Eq, @debug.Debug)` in the generated view module\n  \"moonbitlang/core/debug\",\n}\n\nsupported_targets = \"wasm-gc\"\n\npkgtype(kind: \"executable\")\n\noptions(\n  link: {\n    \"wasm-gc\": {\n      \"exports\": [\n        \"mount\",\n        \"on_event\",\n        \"on_popstate\",\n        // The Fuzz tab's animation frame. An export rather than a callback for\n        // the reason `on_event` is one: closures cannot cross into JS on\n        // wasm-gc.\n        \"on_fuzz_tick\",\n        // The Trace tab's file read, answered asynchronously by the page.\n        \"on_file_text\",\n        \"refresh_margaui\",\n      ],\n      \"use-js-builtin-string\": true,\n    },\n  },\n)\n",
  ),
  (
    "page/quantity-picker.mbt", "///|\npub fn quantity_picker_module() -> @component.ModuleDef {\n  @component.ModuleDef::new(\n    name=\"quantity-picker\",\n    components=[quantity_picker_component(initial=QuantityPickerState::fresh())],\n    examples=[\n      {\n        component: \"QuantityPicker\",\n        title: \"Quantity picker\",\n        args: Map([]),\n        view: None,\n      },\n      {\n        component: \"QuantityPicker\",\n        title: \"Maximum quantity\",\n        args: quantity_picker_init_args(\"maximum\").unwrap(),\n        view: None,\n      },\n    ],\n  )\n}\n",
  ),
  (
    "page/quantity-picker.tutu", "spec:\n  QuantityPicker:\n    field quantity :: Int\n    field unit_cents :: Int\n\n    invariant quantity_in_range:\n      ~format: \"Choose a quantity from 1 to 10.\"\n      (it.quantity >= 1 && it.quantity <= 10)\n\nlogic:\n  QuantityPicker:\n    receive decrease:\n      it.quantity := math.max(1, it.quantity - 1)\n\n    receive increase:\n      it.quantity := math.min(10, it.quantity + 1)\n\n    compute total_cents: it.quantity * it.unit_cents\n    compute total: @str{Total: €@((it.quantity * it.unit_cents) / 100)}\n    pred minimum: it.quantity <= 1\n    pred maximum: it.quantity >= 10\n\nview:\n  QuantityPicker:\n    section(class: \"card bg-base-200 max-w-md\"):\n      div(class: \"card-body gap-3\"):\n        h2(class: \"card-title\"): \"Quantity picker\"\n        p(): \"Notebook · €5 each\"\n        div(class: \"join items-center\"):\n          button(class: \"btn join-item decrease\", aria_label: \"Decrease quantity\", disabled: minimum(), ~on_click: decrease): \"−\"\n          output(class: \"px-4 quantity\", aria_live: \"polite\"): @(it.quantity)\n          button(class: \"btn join-item increase\", aria_label: \"Increase quantity\", disabled: maximum(), ~on_click: increase): \"+\"\n        p(class: \"total\"): @(total())\n\nfixtures:\n  \"fresh\" ~default:\n    it.quantity = 1\n    it.unit_cents = 500\n\n  \"maximum\":\n    it.quantity = 10\n    it.unit_cents = 500\n\ntests:\n  \"quantity changes the total\":\n    ~init: \"fresh\"\n    click(\"button.increase\")\n    expect text(\"output.quantity\") == \"2\"\n    expect text(\"p.total\") == \"Total: €10\"\n    click(\"button.decrease\")\n    click(\"button.decrease\")\n    expect text(\"output.quantity\") == \"1\"\n\n  \"the upper bound is enforced\":\n    ~init: \"fresh\"\n    send(\"increase\")\n    send(\"increase\")\n    send(\"increase\")\n    send(\"increase\")\n    send(\"increase\")\n    send(\"increase\")\n    send(\"increase\")\n    send(\"increase\")\n    send(\"increase\")\n    send(\"increase\")\n    expect text(\"output.quantity\") == \"10\"\n",
  ),
  (
    "page/quantity-picker_view_gen.mbt", "// GENERATED by `tutuca gen` from quantity-picker.tutu — DO NOT EDIT.\n// Regenerate with:\n//\n//   tutuca gen quantity-picker.tutu --name QuantityPicker --out <dir>\n//\n// The package this file lives in must import:\n//   \"marianoguerra/tutuca/core\" @tutuca, \"marianoguerra/tutuca/component\",\n//   \"moonbitlang/core/debug\"\n\n///|\n/// The state of the QuantityPicker component.\n///\n/// Declared with `field` in the `spec:` section. Adding one there adds it\n/// here, so a view that reads it type-checks and one that reads a name\n/// this struct lacks fails generation.\npub(all) struct QuantityPickerState {\n  quantity : Int\n  unit_cents : Int\n}\n\n///|\n/// The zero state: every field at its type's empty value.\n///\n/// The `spec:` section states no defaults here — a default is a value,\n/// not a type — so this is type-directed, and `init` spreads it to name\n/// only what differs:\n///\n///   initial={ ..QuantityPickerState::zero(), label: \"Counter\" }\npub fn QuantityPickerState::zero() -> QuantityPickerState {\n  {\n    quantity: 0,\n    unit_cents: 0,\n  }\n}\n\n///|\n/// The `fresh` initial state, from the init block. Checked against\n/// the schema at generation time, so a field the schema dropped fails\n/// the build instead of being coerced away at runtime.\nfn QuantityPickerState::fresh() -> QuantityPickerState {\n  {\n    quantity: 1,\n    unit_cents: 500,\n  }\n}\n\n///|\n/// The `maximum` initial state, from the init block. Checked against\n/// the schema at generation time, so a field the schema dropped fails\n/// the build instead of being coerced away at runtime.\nfn QuantityPickerState::maximum() -> QuantityPickerState {\n  {\n    quantity: 10,\n    unit_cents: 500,\n  }\n}\n\n///|\n/// A named fixture, or None when no fixture has that name.\n///\n/// Keyed by the name as WRITTEN, for a caller holding one at run time — a\n/// storybook, a host, a test driven by a table. The functions above are\n/// one per fixture and are the spelling to reach for inside this package,\n/// where the name is known and a typo should not compile; their names are\n/// mangled to be identifiers, so `with-history` answers to\n/// `with_history()`, which is why this one exists for everybody else.\npub fn QuantityPickerState::fixture(name : String) -> QuantityPickerState? {\n  match name {\n    \"fresh\" => Some(QuantityPickerState::fresh())\n    \"maximum\" => Some(QuantityPickerState::maximum())\n    _ => None\n  }\n}\n\n///|\n/// A named initial state as component arguments — what a ModuleDef\n/// example takes. None when no fixture has that name.\n///\n/// This is the public face of the fixtures: they return the private state\n/// type, so they cannot be public themselves, and a storybook needs the\n/// encoded form anyway.\npub fn quantity_picker_init_args(name : String) -> Map[String, @tutuca.Value]? {\n  match name {\n    \"fresh\" => Some(@component.Fields::encode(QuantityPickerState::fresh()))\n    \"maximum\" => Some(@component.Fields::encode(QuantityPickerState::maximum()))\n    _ => None\n  }\n}\n\n///|\n/// The state as the fields map the render and path layers read, built\n/// field by field rather than through a `Json` round trip.\n///\n/// A field that already holds a `@tutuca.Value` is passed straight\n/// through. That is the case a JSON round trip could not do at all: an\n/// `Obj` or an `Fn` does not survive one.\nimpl @component.Fields for QuantityPickerState with fn encode(s) {\n  {\n    \"quantity\": Num(s.quantity.to_double()),\n    \"unit_cents\": Num(s.unit_cents.to_double()),\n  }\n}\n\n///|\n/// The fields map back into the state. None on a shape mismatch, which\n/// callers treat as a no-op write — the same contract as the JSON path.\nimpl @component.Fields for QuantityPickerState with fn decode(f) {\n  guard f.get(\"quantity\") is Some(Num(t1_quantity)) else { return None }\n  let v_quantity = t1_quantity.to_int()\n  guard f.get(\"unit_cents\") is Some(Num(t1_unit_cents)) else { return None }\n  let v_unit_cents = t1_unit_cents.to_int()\n  Some({\n    quantity: v_quantity,\n    unit_cents: v_unit_cents,\n  })\n}\n\n///|\n/// The Receive arm of @component.Dispatch, decoded.\n///\n/// Every addressed name: the `message` the `spec:` section declares,\n/// plus every bare `~on_<event>` handler the views write. One bucket holds\n/// them\n/// however they were sent, so one type covers it — where the two overlap\n/// the schema's declared payload wins, and a view whose call sites\n/// disagree with it is a build error.\n///\n/// The `logic:` section answers decrease, increase, so an `update` arm for\n/// one of those can never run — the wrapper consults `update` only for a\n/// dispatch the section did not claim. They are still here because raising\n/// one is what a parent does, and `to_dispatch` is how.\npub(all) enum QuantityPickerMsg {\n  Decrease\n  Increase\n  /// A message the schema does not declare, or a declared name whose\n  /// runtime arguments did not match the declared types.\n  Unknown(String, Array[@tutuca.Value])\n}\n\n///|\n/// Decode a Receive dispatch. None for any other bucket.\n///\n/// A payload that does not match falls into `Unknown` rather than being\n/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,\n/// and silently truncating it would hide that.\n///\n/// It is also REPORTED. `Unknown` answers two different questions —\n/// nobody declares this name, and this name is declared here and was\n/// handed the wrong shape — and the second one is a bug in the sender\n/// that used to be indistinguishable from silence. Every arm below that\n/// can fail on a DECLARED name says so through `@tutuca.bad_payload`,\n/// which costs nothing unless a host is listening.\npub fn QuantityPickerMsg::from_dispatch(d : @component.Dispatch) -> QuantityPickerMsg? {\n  guard d is Receive(name, args) else { return None }\n  Some(\n    match (name, args) {\n      (\"decrease\", []) => Decreas