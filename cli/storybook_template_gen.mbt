// GENERATED by `moon run --target native cmd/dev -- storybook-template-embed`
// — DO NOT EDIT. Embeds a whole gallery project in the CLI so
// `tutuca new-storybook` can write one out.
//
// Assembled from storybook/template/, whose `page/counter.html` is in the
// repo's `gen-views` sweep — so the generated view module the template
// hands out cannot drift from the generator that would rewrite it.

///|
pub let storybook_template_files : Array[(String, String)] = [
  (".gitignore", "_build/\ndist/\n.mooncakes/\ntarget/\n"),
  (
    "README.md", "# {{name}}\n\nA storybook gallery of this project's tutuca components: a sidebar of stories,\na live pane for each, and per-story Instance, Trace, Fuzz, Spec and Raw\ninspectors.\n\n## Build and serve\n\n```sh\nnode build.mjs        # moon build --target wasm-gc --release page, then dist/\ntutuca storybook dist # or any static server over dist/\n```\n\nNeeds `moon` and Node >= 20, and a browser with the JS String Builtins proposal\n(Chrome/Edge). The first build fetches `marianoguerra/tutuca` from mooncakes.\n\n## Adding a story\n\nA story is an **example on a `ModuleDef`**, not an entry in a list:\n\n```moonbit\npub fn counter_module() -> @component.ModuleDef {\n  @component.ModuleDef::new(name=\"counter\", components=[counter_component()], examples=[\n    { component: \"Counter\", title: \"Zero\", args: Map([]), view: None },\n    { component: \"Counter\", title: \"Seeded\", args: { \"count\": Num(7) }, view: None },\n  ])\n}\n```\n\n`page/main.mbt` projects those into stories with\n`@sb.stories_of_modules([...])`. Add a module to that call and every example it\ndeclares shows up. The same examples are what `@harness.mount_example` mounts in\na test, so a story and a test cannot disagree.\n\nOverrides are ordinary `.map`s over the projected list — `Story` is `pub(all)`:\n\n```moonbit\nstories.map(s => if s.id == \"counter-counter-seeded\" { { ..s, init: true } } else { s })\n```\n\n- `init: true` — the host dispatches `init` into the pane after mount, for a\n  story whose root loads its data that way. Tutuca has no lifecycle, so nothing\n  infers this.\n- `renderable: false` — listed in the sidebar, never mounted. For a fixture\n  whose view is deliberately malformed.\n- `section` / `description` — sidebar grouping and the blurb under the title.\n\n## Adding a component\n\nWrite the view file, then generate its MoonBit module:\n\n```sh\ntutuca gen-views page/my_thing.html\n```\n\nThe generated `page/my_thing_view_gen.mbt` is checked in and never hand-edited;\n`tutuca watch page/` regenerates on save. Then build a `ModuleDef` around\n`my_thing_component()` and add it to `sections()` in `page/main.mbt`.\n\n## What each file is\n\n| File | |\n| --- | --- |\n| `page/main.mbt` | the story set and the five wasm entry points |\n| `page/counter.html` | a demo component's views + spec + script |\n| `page/counter_view_gen.mbt` | generated from it — regenerate, never edit |\n| `page/moon.pkg` | the executable's `link.exports` list |\n| `index.html` | the page: the margaui `<style>` slot, `#app`, the loader |\n| `build.mjs` | wasm build, wasm-opt, and the JS the page needs beside it |\n\nThe gallery itself is `marianoguerra/tutuca/storybook/ui/wasm`. This project is\nthe executable around it, because a wasm-gc export list is per-package `link`\nconfiguration and cannot come from a dependency.\n\n## Options\n\n`@sbw.mount` takes more than the sections:\n\n```moonbit\nlet sections = sections()\n@sbw.mount(\n  sections,\n  themes=[\"light\", \"dark\"],        // the palettes the switcher offers\n  panels=@panelsw.all(sections),   // the tabs — drop it for stories only\n) |> ignore\n```\n\nThe tabs are opt-in because they are what most of the wasm IS: dropping the\n`panels~` argument and the `@panelsw` import takes the page from ~3.1 MB to\n~1.25 MB (`--release`, before wasm-opt).\n",
  ),
  (
    "build.mjs", "#!/usr/bin/env node\n// Build this gallery into ./dist:\n//\n//   moon build --target wasm-gc --release page   the page\n//   moon-wasm-opt -Oz                            shrink it\n//   copy the loader out of .mooncakes            the JS a wasm-gc page needs\n//\n// Then: tutuca storybook dist    (or any static server over dist/)\n//\n// A plain Node script on purpose: `moon` and `node` are all it needs, and it\n// reaches nothing outside this directory.\n//\n// Prereqs: moon (brings moon-wasm-opt), Node >= 20, and network on first run.\nimport { execFileSync } from \"node:child_process\";\nimport {\n  copyFileSync,\n  existsSync,\n  mkdirSync,\n  readFileSync,\n  writeFileSync,\n} from \"node:fs\";\nimport { dirname, join } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst dist = join(here, \"dist\");\n\nconst step = (msg) => console.log(`\\n\\x1b[1m→ ${msg}\\x1b[0m`);\nconst run = (prog, args, cwd = here) =>\n  execFileSync(prog, args, { stdio: \"inherit\", cwd });\n\nfunction tryRun(prog, args, cwd = here) {\n  try {\n    execFileSync(prog, args, { stdio: \"inherit\", cwd });\n    return true;\n  } catch (err) {\n    if (err.code === \"ENOENT\") return false;\n    throw err;\n  }\n}\n\n// --- 1. the page ----------------------------------------------------------\n\nstep(\"moon build --target wasm-gc --release page\");\nrun(\"moon\", [\"build\", \"--target\", \"wasm-gc\", \"--release\", \"page\"]);\n\nconst pageWasm = join(here, \"_build/wasm-gc/release/build/page/page.wasm\");\nif (!existsSync(pageWasm)) {\n  console.error(`build: expected ${pageWasm} — did the package name change?`);\n  process.exit(1);\n}\n\n// --- 2. find the installed tutuca -----------------------------------------\n\n// A wasm-gc module cannot reach the DOM, so the JavaScript that gives it one\n// comes down with the package and has to land beside the page. Find it where\n// `moon` put it. Walking up covers a dependency hoisted to a parent module's\n// .mooncakes; the `src/` variant covers modules published with a source root.\nfunction findTutuca() {\n  const probe = \"app/wasm/loader.mjs\";\n  let dir = here;\n  for (;;) {\n    for (const rel of [\"\", \"src/\"]) {\n      const root = join(dir, \".mooncakes/marianoguerra/tutuca\", rel);\n      if (existsSync(join(root, probe))) return root;\n    }\n    const up = dirname(dir);\n    if (up === dir) return null;\n    dir = up;\n  }\n}\n\nconst tutuca = findTutuca();\nif (!tutuca) {\n  console.error(\n    \"build: could not find marianoguerra/tutuca in .mooncakes.\\n\" +\n      \"  A stale local index resolves an older release that has no storybook\\n\" +\n      \"  packages. Run:\\n\\n    moon update && node build.mjs\\n\",\n  );\n  process.exit(1);\n}\nstep(`using ${tutuca}`);\n\n// --- 3. assemble dist ------------------------------------------------------\n\nmkdirSync(dist, { recursive: true });\n\nstep(\"assembling dist/\");\ncopyFileSync(pageWasm, join(dist, \"page.wasm\"));\n\n// -Oz on the release wasm: roughly 4x smaller, and it is the same module.\n// moon-wasm-opt ships with the moon toolchain, so it is there if moon is; bare\n// `wasm-opt` is the fallback for a PATH with binaryen but not moon's copy.\n// Neither is required — an unoptimized page works, it is just fat.\nconst optArgs = [\n  \"--all-features\",\n  \"--disable-custom-descriptors\",\n  \"-Oz\",\n  join(dist, \"page.wasm\"),\n  \"-o\",\n  join(dist, \"page.wasm\"),\n];\nif (!tryRun(\"moon-wasm-opt\", optArgs) && !tryRun(\"wasm-opt\", optArgs)) {\n  console.warn(\n    \"  ! neither moon-wasm-opt nor wasm-opt found — shipping the unoptimized wasm\",\n  );\n}\n\ncopyFileSync(join(here, \"index.html\"), join(dist, \"index.html\"));\ncopyFileSync(join(tutuca, \"app/wasm/loader.mjs\"), join(dist, \"app-loader.mjs\"));\n// The Trace tab's file service. Rewritten rather than copied: it imports the\n// app loader by the path the two have inside the package, and in dist/ they\n// land flat beside each other.\nwriteFileSync(\n  join(dist, \"files-loader.mjs\"),\n  readFileSync(join(tutuca, \"files/wasm/loader.mjs\"), \"utf8\").replace(\n    \"../../app/wasm/loader.mjs\",\n    \"./app-loader.mjs\",\n  ),\n);\n\n// The copy list is not the check. Reading what landed is: resolve every\n// relative specifier — static AND dynamic — in the JS now sitting in dist/, and\n// fail if one of them is not there. That turns \"the copy list is wrong\" into a\n// build error instead of a 404 a reader finds by clicking.\nconst SPECIFIER = /(?:\\bfrom\\s*|\\bimport\\s*\\(\\s*)[\"'](\\.[^\"']*)[\"']/g;\nconst missing = [];\nconst scan = [\"index.html\", \"app-loader.mjs\", \"files-loader.mjs\"];\nfor (const file of scan.filter((f) => existsSync(join(dist, f)))) {\n  const src = readFileSync(join(dist, file), \"utf8\");\n  for (const [, spec] of src.matchAll(SPECIFIER)) {\n    const target = join(dist, dirname(file), spec);\n    if (!existsSync(target)) {\n      missing.push(`  ${file} imports \"${spec}\" — not in dist/`);\n    }\n  }\n}\nif (missing.length > 0) {\n  console.error(\"build: dist/ is missing modules its own JS imports:\");\n  console.error(missing.join(\"\\n\"));\n  process.exit(1);\n}\n\nconsole.log(\n  \"\\n\\x1b[1m✓ dist/ is ready\\x1b[0m\\n\\n\" +\n    \"  tutuca storybook dist            # or any static server over dist/\\n\",\n);\n",
  ),
  (
    "index.html", "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>storybook</title>\n    <!-- margaui CSS (utilities + light/dark theme vars) is compiled in MoonBit\n         and injected here by mount(); pre-placed early so lazily-loaded palette\n         <link>s (dracula, …) win the cascade over the light block. Keep the\n         empty element: the injector upserts into it. -->\n    <style id=\"margaui-css\"></style>\n    <style>\n      body {\n        font-family: system-ui, sans-serif;\n        margin: 0;\n      }\n    </style>\n  </head>\n  <body>\n    <div id=\"app\"></div>\n    <!--\n      Build:  node build.mjs\n      Serve:  tutuca storybook dist     (or any static server over dist/)\n      Needs a browser with the JS String Builtins proposal (Chrome/Edge).\n    -->\n    <script type=\"module\">\n      import { instantiate } from \"./app-loader.mjs\";\n      import { createFilesImports } from \"./files-loader.mjs\";\n      // `tfiles` is the Trace tab's Download and Load. The gallery's wasm\n      // declares the import because `@panelsw.all` links `files/wasm`, so a\n      // page that leaves it out does not instantiate at all.\n      const exports = await instantiate(\"./page.wasm\", (getExports) => ({\n        tfiles: createFilesImports(getExports),\n      }));\n      exports.mount();\n      // Re-restore selection/filter/focus on Back/Forward. tutuca has no\n      // lifecycle, so the host re-sends `init` (which re-reads the URL).\n      // Programmatic push/replaceState don't fire popstate, so this only runs\n      // on real navigation.\n      window.addEventListener(\"popstate\", () => exports.on_popstate());\n      // The Fuzz tab's frame. MoonBit pulls this when a Play needs the next\n      // step; it schedules ONE frame and nothing re-arms it once the run stops,\n      // so there is no permanent rAF loop here. Drop it and Play silently does\n      // nothing while Step and Burst still work.\n      globalThis.__tutucaFuzzTick = () =>\n        requestAnimationFrame(() => exports.on_fuzz_tick());\n    </script>\n  </body>\n</html>\n",
  ),
  (
    "moon.mod", "// A gallery of this project's own tutuca components.\n//\n// `mizchi/js` is declared directly because `page/` imports `mizchi/js/core`\n// for the `@core.Any` in `on_event`, and a package may only import from a\n// module its own module declares. Pin it to the version tutuca resolves, so\n// there is one copy of it in the graph.\n//\n// Build: node build.mjs   Serve: tutuca storybook dist\n\nname = \"{{name}}\"\n\nversion = \"0.1.0\"\n\ndescription = \"A storybook gallery of {{name}}'s tutuca components\"\n\npreferred_target = \"wasm-gc\"\n\nimport {\n  \"marianoguerra/tutuca@{{tutuca_version}}\",\n  \"mizchi/js@0.12.2\",\n}\n",
  ),
  (
    "page/counter.html", "<script type=\"tutuca/spec\">\n  state {\n    /// No clause: a counter with `inc` and `dec` and no floor has the whole of\n    /// `Int` for its domain, and a rule this component does not keep would be\n    /// a lie the Fuzz tab would catch.\n    count : Int\n  }\n\n  /// What this component accepts, declared. The `receive`s below are the\n  /// IMPLEMENTATIONS of these names and the `@on.click`s are call sites, and\n  /// neither is a declaration — so without this block the component's public\n  /// API is empty and the Fuzz tab has nothing to draw. Declaring it is what\n  /// gives the tab a script, and it is the first thing to copy when you add a\n  /// component of your own.\n  handle Counter {\n    message { inc, dec }\n  }\n</script>\n\n<script type=\"tutuca/script\">\n  receive inc {\n    .count += 1\n  }\n\n  receive dec {\n    .count -= 1\n  }\n</script>\n\n<template id=\"Counter\">\n  <div class=\"join join-vertical\">\n    <button class=\"btn btn-error\" @on.click=\"dec\">-</button>\n    <div class=\"stats\">\n      <div class=\"stat text-center\">\n        <div class=\"stat-title\">Count</div>\n        <div class=\"stat-value\" @text=\".count\"></div>\n      </div>\n    </div>\n    <button class=\"btn btn-success\" @on.click=\"inc\">+</button>\n  </div>\n</template>\n\n<template id=\"Counter:compact\">\n  <button class=\"btn btn-sm\" @text=\".count\" @on.click=\"inc\"></button>\n</template>\n",
  ),
  (
    "page/counter_view_gen.mbt", "// GENERATED by `tutuca gen-views` from counter.html — DO NOT EDIT.\n// Regenerate with:\n//\n//   tutuca gen-views counter.html --name Counter --out <dir>\n//\n// The package this file lives in must import:\n//   \"marianoguerra/tutuca/core\" @tutuca, \"marianoguerra/tutuca/component\",\n//   \"moonbitlang/core/debug\"\n\n///|\n/// The state of the Counter component.\n///\n/// Declared as `state` in the state block. Adding a field there adds it\n/// here, so a view that reads it type-checks and one that reads a name\n/// this struct lacks fails generation.\npub(all) struct CounterState {\n  /// No clause: a counter with `inc` and `dec` and no floor has the whole of\n  /// `Int` for its domain, and a rule this component does not keep would be\n  /// a lie the Fuzz tab would catch.\n  count : Int\n}\n\n///|\n/// The zero state: every field at its type's empty value.\n///\n/// The state block declares no defaults — a default is a value, not a\n/// type — so this\n/// is type-directed, and `init` spreads it to name only what differs:\n///\n///   initial={ ..CounterState::zero(), label: \"Counter\" }\npub fn CounterState::zero() -> CounterState {\n  {\n    count: 0,\n  }\n}\n\n///|\n/// The state as the fields map the render and path layers read, built\n/// field by field rather than through a `Json` round trip.\n///\n/// A field that already holds a `@tutuca.Value` is passed straight\n/// through. That is the case a JSON round trip could not do at all: an\n/// `Obj` or an `Fn` does not survive one.\nimpl @component.Fields for CounterState with fn encode(s) {\n  {\n    \"count\": Num(s.count.to_double()),\n  }\n}\n\n///|\n/// The fields map back into the state. None on a shape mismatch, which\n/// callers treat as a no-op write — the same contract as the JSON path.\nimpl @component.Fields for CounterState with fn decode(f) {\n  guard f.get(\"count\") is Some(Num(t1_count)) else { return None }\n  let v_count = t1_count.to_int()\n  Some({\n    count: v_count,\n  })\n}\n\n///|\n/// The Receive arm of @component.Dispatch, decoded.\n///\n/// Every addressed name: the `message` variant the state block declares,\n/// plus every bare `@on` handler the views write. One bucket holds them\n/// however they were sent, so one type covers it — where the two overlap\n/// the schema's declared payload wins, and a view whose call sites\n/// disagree with it is a build error.\npub(all) enum CounterMsg {\n  Inc\n  Dec\n  /// A message the schema does not declare, or a declared name whose\n  /// runtime arguments did not match the declared types.\n  Unknown(String, Array[@tutuca.Value])\n}\n\n///|\n/// Decode a Receive dispatch. None for any other bucket.\n///\n/// A payload that does not match falls into `Unknown` rather than being\n/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,\n/// and silently truncating it would hide that.\n///\n/// It is also REPORTED. `Unknown` answers two different questions —\n/// nobody declares this name, and this name is declared here and was\n/// handed the wrong shape — and the second one is a bug in the sender\n/// that used to be indistinguishable from silence. Every arm below that\n/// can fail on a DECLARED name says so through `@tutuca.bad_payload`,\n/// which costs nothing unless a host is listening.\npub fn CounterMsg::from_dispatch(d : @component.Dispatch) -> CounterMsg? {\n  guard d is Receive(name, args) else { return None }\n  Some(\n    match (name, args) {\n      (\"inc\", []) => Inc\n      (\"dec\", []) => Dec\n      _ => {\n        match name {\n          \"inc\" =>\n            @tutuca.bad_payload(name, \"\", args)\n          \"dec\" =>\n            @tutuca.bad_payload(name, \"\", args)\n          _ => ()\n        }\n        Unknown(name, args)\n      }\n    },\n  )\n}\n\n///|\n/// The dispatch name and arguments this message raises as.\npub fn CounterMsg::to_dispatch(self : CounterMsg) -> (String, Array[@tutuca.Value]) {\n  match self {\n    Inc => (\"inc\", [])\n    Dec => (\"dec\", [])\n    Unknown(n, args) => (n, args)\n  }\n}\n\n///|\n/// Send this message to self; it arrives as a later Receive dispatch.\n///\n/// The name comes from the schema, so it cannot drift from the one\n/// `from_dispatch` decodes.\npub fn CounterMsg::send(self : CounterMsg, ctx : &@tutuca.Ctx) -> Unit {\n  let (name, args) = self.to_dispatch()\n  ctx.send(name, args)\n}\n\n///|\n/// The file-level style — pass as `common_style~`.\npub let counter_common_style : String = \"\"\n\n///|\n/// The `data-global` style — pass as `global_style~`.\npub let counter_global_style : String = \"\"\n\n///|\n/// What this component's schema declares, for `schema~`.\n///\n/// This is the only thing consulted for a field's KIND — there is no\n/// inference off the init value behind it — and it is what an instance\n/// answers `schema()` with, so a holder of a bare `@tutuca.Value`\n/// can name these fields without a component registry.\nimpl @component.Fields for CounterState with fn schema() {\n  @component.SchemaInfo::new(\n    name=\"Counter\",\n    fingerprint=\"f1e7380216f156aa\",\n    fields=[\n      @component.FieldInfo::new(\"count\", TyInt(width=32, signed=true)),\n    ],\n    view_handlers=[\"dec\", \"inc\"],\n    receives=[\"inc\", \"dec\"],\n    view_names=[\"main\", \"compact\"],\n  )\n}\n\n",
  ),
  (
    "page/counter_view_ir_gen.mbt", "// GENERATED by `tutuca gen-views` from counter.html — DO NOT EDIT.\n//\n// The views of Counter, already compiled: the @anode.ANode tree each one\n// parses into, plus its event table, written with anode's builders.\n// Passing counter_views() as `views~` means the template parser\n// never runs at startup.\n//\n// A component that also declares a schema gets a `_component` wrapper\n// beside its views: component() with the name, the views, the styles,\n// the codec and the schema already filled in — pass it the handlers.\n//\n// The package this file lives in must import:\n//   \"marianoguerra/tutuca/anode\", and for the wrapper\n//   \"marianoguerra/tutuca/core\" @tutuca, \"marianoguerra/tutuca/component\"\n//\n// Every builder returns a FRESH tree: View::from_ir stamps and optimizes\n// it in place, and each component that adopts a view stamps its own\n// data-cid onto it.\n\n///|\n/// This file's `<script type=\"tutuca/spec\">` block, as source, with its\n/// doc comments removed.\n///\n/// The schema each component carries is this block's PROJECTION, and the\n/// projection is lossy exactly where a generator needs it: a rule reaches\n/// `SchemaInfo` as a name with no body, and a message as a name with no\n/// payload. Re-parsing this recovers both — see `testing/fuzz`.\npub let counter_spec_source : String =\n  #|  state {\n  #|    count : Int\n  #|  }\n  #|\n  #|  handle Counter {\n  #|    message { inc, dec }\n  #|  }\n\n///|\n/// The compiled `main` view.\nfn counter_main_view_ir() -> @anode.View {\n  @anode.View::from_ir(\n    \"main\",\n    @anode.h(\"div\", [@anode.attr(\"class\", \"join join-vertical\")], [\n      @anode.h(\"button\", [@anode.attr(\"class\", \"btn btn-error\"), @anode.eid(0)], [\n        @anode.text(\"-\"),\n      ]),\n      @anode.text(\" \"),\n      @anode.h(\"div\", [@anode.attr(\"class\", \"stats\")], [\n        @anode.h(\"div\", [@anode.attr(\"class\", \"stat text-center\")], [\n          @anode.h(\"div\", [@anode.attr(\"class\", \"stat-title\")], [\n            @anode.text(\"Count\"),\n          ]),\n          @anode.h(\"div\", [@anode.attr(\"class\", \"stat-value\")], [\n            @anode.dyn_text(@tutuca.Expr::field(\"count\")),\n          ]),\n        ]),\n      ]),\n      @anode.text(\" \"),\n      @anode.h(\"button\", [@anode.attr(\"class\", \"btn btn-success\"), @anode.eid(1)], [\n        @anode.text(\"+\"),\n      ]),\n    ]),\n    [\n      [@anode.on(\"click\", @tutuca.Expr::name(\"dec\"))],\n      [@anode.on(\"click\", @tutuca.Expr::name(\"inc\"))],\n    ],\n  )\n}\n\n///|\n/// The compiled `compact` view.\nfn counter_compact_view_ir() -> @anode.View {\n  @anode.View::from_ir(\n    \"compact\",\n    @anode.h(\"button\", [@anode.attr(\"class\", \"btn btn-sm\"), @anode.eid(0)], [\n      @anode.dyn_text(@tutuca.Expr::field(\"count\")),\n    ]),\n    [\n      [@anode.on(\"click\", @tutuca.Expr::name(\"inc\"))],\n    ],\n  )\n}\n\n///|\n/// The component's views, already compiled — pass as `views~` to\n/// @component.component.\npub fn counter_views() -> Map[String, @anode.View] {\n  {\n    \"main\": counter_main_view_ir(),\n    \"compact\": counter_compact_view_ir(),\n  }\n}\n\n///|\n/// The dispatches the `<script type=\"tutuca/script\">` block answers.\n///\n/// Composed AHEAD of the author's `update~`, which stays optional and is\n/// consulted only for a name this does not answer. GENERATED — edit the\n/// block, not this.\nfn counter_inline_update(\n  s : CounterState,\n  msg : @component.Dispatch,\n  _ctx : &@tutuca.Ctx,\n) -> @component.Update[CounterState] {\n  match msg {\n    Receive(\"inc\", _args) => {\n      let s : CounterState = { count: (s.count.to_double() + 1.0).to_int() }\n      Next(s)\n    }\n    Receive(\"dec\", _args) => {\n      let s : CounterState = { count: (s.count.to_double() - 1.0).to_int() }\n      Next(s)\n    }\n    _ => Unhandled\n  }\n}\n\n///|\n/// The Counter component: `component()` with everything the view file already\n/// states filled in — its name, its compiled views and its styles. The\n/// schema and the codec are not passed at all: `CounterState` states them\n/// through `@component.Fields`, and `component()` reads them off the\n/// bound. What is left is the code no generator can write.\n///\n/// `init` defaults to the zero state and `name` to the name the template\n/// id declares — pass either when yours differs. The signature below is\n/// the whole story: anything not a parameter here, the view file states.\npub fn counter_component(\n  name? : String = \"Counter\",\n  views? : Map[String, @anode.View] = counter_views(),\n  initial? : CounterState = CounterState::zero(),\n  common_style? : String = counter_common_style,\n  global_style? : String = counter_global_style,\n  update? : (CounterState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[CounterState],\n  slots? : Map[String, String] = Map([]),\n  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),\n  provide? : Map[String, String] = Map([]),\n  lookup? : Array[@component.LookupSpec] = [],\n) -> @component.Component {\n  @component.component(\n    name~,\n    views~,\n    initial~,\n    common_style~,\n    global_style~,\n    update=(s, msg, ctx) => match counter_inline_update(s, msg, ctx) {\n      Unhandled =>\n        match update {\n          Some(u) => u(s, msg, ctx)\n          None => Unhandled\n        }\n      answered => answered\n    },\n    slots~,\n    slot_args~,\n    provide~,\n    lookup~,\n    spec=counter_spec_source,\n  )\n}\n\n",
  ),
  (
    "page/main.mbt", "// {{Name}}'s storybook: which components the gallery shows, and the six\n// entry points the page calls.\n//\n// The story set is a PROJECTION of the modules below — one story per example a\n// module declares — so adding a story is adding an example to a `ModuleDef`,\n// not editing a list here. Sections, descriptions and per-story `init` are\n// `.map` overrides on top of it.\n\n///|\nfn main {\n\n}\n\n///|\n/// One module of components. `counter_component` is generated from\n/// counter.html by `tutuca gen-views`; nothing here restates the view file.\n///\n/// The `examples` are the stories: each names a component, the args to make it\n/// with, and optionally the view to render it under. They are also what\n/// `@harness.mount_example` mounts in a test, so a story and a test agree by\n/// construction.\npub fn counter_module() -> @component.ModuleDef {\n  @component.ModuleDef::new(name=\"counter\", components=[counter_component()], examples=[\n    { component: \"Counter\", title: \"Zero\", args: Map([]), view: None },\n    {\n      component: \"Counter\",\n      title: \"Negative start\",\n      args: { \"count\": Num(-5) },\n      view: None,\n    },\n    // `view` picks one of the component's named views — `<template\n    // id=\"Counter:compact\">` in counter.html — instead of its default.\n    {\n      component: \"Counter\",\n      title: \"Compact\",\n      args: { \"count\": Num(3) },\n      view: Some(\"compact\"),\n    },\n  ])\n}\n\n///|\n/// The gallery's sections, in the order the sidebar shows them. Add a module\n/// to the list and every example it declares becomes a story.\nfn sections() -> Array[@sb.Section] {\n  let stories = @sb.stories_of_modules([counter_module()], section_of=m => match\n    m.name {\n      \"counter\" => \"Basics\"\n      _ => \"Other\"\n    })\n  @sb.sections_of(stories, order=[\"Basics\", \"Other\"])\n}\n\n///|\n/// Mount the gallery on #app. Called from JS once the DOM is ready.\n///\n/// `panels~` is asked for by name because `storybook/ui/wasm` links no panel\n/// layer of its own: this line is what puts the Instance, Trace, Fuzz, Spec and\n/// Raw tabs in the page. Drop it (and the `@panelsw` import) and the gallery is\n/// stories only — and megabytes lighter.\npub fn mount() -> Unit {\n  let sections = sections()\n  @sbw.mount(sections, panels=@panelsw.all(sections)) |> ignore\n}\n\n///|\n/// The delegated DOM event entry point JS calls (via tdom.add_listener).\npub fn on_event(ev : @core.Any) -> Unit {\n  @panelsw.on_event(ev)\n}\n\n///|\n/// Back/Forward: re-read the URL and restore the selection/filter/focus.\npub fn on_popstate() -> Unit {\n  @sbw.on_popstate()\n}\n\n///|\n/// One animation frame of a playing fuzz run.\npub fn on_fuzz_tick() -> Unit {\n  @panelsw.on_fuzz_tick()\n}\n\n///|\n/// Recompile + reinject the margaui sheet for the mounted gallery.\npub fn refresh_margaui() -> Unit {\n  @sbw.refresh_margaui()\n}\n\n///|\n/// The page's answer to a file the Trace tab asked to read.\n///\n/// An export for the reason `on_fuzz_tick` is one: a closure cannot cross into\n/// JS on wasm-gc, so the browser answers an asynchronous read by calling back\n/// in. Drop it and the Trace tab's Download still works — a download is\n/// one-way — but Load reads the file and never delivers it.\npub fn on_file_text(req_id : Int, ok : Bool, text : String) -> Unit {\n  @panelsw.on_file_text(req_id, ok, text)\n}\n",
  ),
  (
    "page/moon.pkg", "// The gallery page: the executable around `storybook/ui/wasm`.\n//\n// That package is a LIBRARY and does everything — mounts the gallery, owns the\n// URL and theme services, bridges DOM events, compiles margaui. This package\n// exists for one reason: a wasm-gc export list is per-package `link`\n// configuration and cannot come from a dependency. So the six entry points the\n// page calls are re-exported here as one-line forwards, and the only real\n// content is which stories to show.\n//\n// Build: moon build --target wasm-gc --release page   (or ../build.mjs)\nimport {\n  \"marianoguerra/tutuca/core\" @tutuca,\n  \"marianoguerra/tutuca/anode\",\n  \"marianoguerra/tutuca/component\",\n  // the story model: `stories_of_modules` and `sections_of`\n  \"marianoguerra/tutuca/storybook\" @sb,\n  // the browser host: mount + the four entry points\n  \"marianoguerra/tutuca/storybook/ui/wasm\" @sbw,\n  // the standard tabs (Instance/Trace/Fuzz/Spec/Raw) and the page effects they\n  // need. Naming it is what links them: drop this import and the `panels~`\n  // argument in main.mbt and the gallery is stories only.\n  \"marianoguerra/tutuca/storybook/ui/panels/wasm\" @panelsw,\n  // @core.Any: the DOM event the exported on_event receives from JS\n  \"mizchi/js/core\",\n  // `derive(Eq, @debug.Debug)` in the generated view module\n  \"moonbitlang/core/debug\",\n}\n\nsupported_targets = \"wasm-gc\"\n\npkgtype(kind: \"executable\")\n\noptions(\n  link: {\n    \"wasm-gc\": {\n      \"exports\": [\n        \"mount\",\n        \"on_event\",\n        \"on_popstate\",\n        // The Fuzz tab's animation frame. An export rather than a callback for\n        // the reason `on_event` is one: closures cannot cross into JS on\n        // wasm-gc.\n        \"on_fuzz_tick\",\n        // The Trace tab's file read, answered asynchronously by the page.\n        \"on_file_text\",\n        \"refresh_margaui\",\n      ],\n      \"use-js-builtin-string\": true,\n    },\n  },\n)\n",
  ),
]
