4),\n    )\n\n    array.push(result)\n  }\n  mbt_ffi_free(mbt_ffi_load32(return_area + 0))\n  let ret = array\n  mbt_ffi_free(return_area)\n  return ret\n}\n\n///|\npub fn map_get(h : UInt64, key : String) -> Value? {\n  let ptr = mbt_ffi_str2ptr(key)\n  let return_area = mbt_ffi_malloc(24)\n  wasmImportMapGet(h.reinterpret_as_int64(), ptr, key.length(), return_area)\n\n  let lifted0 : Value? = match mbt_ffi_load8_u(return_area + 0) {\n    0 => Option::None\n    1 => {\n      let lifted = match mbt_ffi_load8_u(return_area + 8) {\n        0 => Value::Nil\n        1 => Value::Boolean(mbt_ffi_load8_u(return_area + 16) != 0)\n        2 => Value::Number(mbt_ffi_loadf64(return_area + 16))\n        3 => {\n          let result = mbt_ffi_ptr2str(\n            mbt_ffi_load32(return_area + 16),\n            mbt_ffi_load32(return_area + 20),\n          )\n\n          Value::Text(result)\n        }\n        4 =>\n          Value::List(mbt_ffi_load64(return_area + 16).reinterpret_as_uint64())\n        5 =>\n          Value::Map(mbt_ffi_load64(return_area + 16).reinterpret_as_uint64())\n        6 =>\n          Value::Instance(\n            mbt_ffi_load64(return_area + 16).reinterpret_as_uint64(),\n          )\n        _ => panic()\n      }\n\n      Option::Some(lifted)\n    }\n    _ => panic()\n  }\n  let ret = lifted0\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(return_area)\n  return ret\n}\n\n///|\n/// construction (fresh handles)\npub fn list_new() -> UInt64 {\n  let result : Int64 = wasmImportListNew()\n  let ret = result.reinterpret_as_uint64()\n  return ret\n}\n\n///|\npub fn list_push(h : UInt64, v : Value) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let (lowered, lowered6, lowered7) = match v {\n    Nil => (0, 0L, 0)\n    Boolean(payload0) => (1, Int::to_int64(if payload0 { 1 } else { 0 }), 0)\n    Number(payload1) => (2, payload1.reinterpret_as_int64(), 0)\n    Text(payload2) => {\n      let ptr = mbt_ffi_str2ptr(payload2)\n      cleanup_list.push(ptr)\n\n      (3, Int