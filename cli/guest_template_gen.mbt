    "gen/moon.pkg", "warnings = \"-44\"\n\nimport {\n  \"tutuca/component/gen/interface/tutuca/component/guest\",\n}\n\noptions(\n  link: {\n    \"wasm\": {\n      \"export-memory-name\": \"memory\",\n      \"heap-start-address\": 16,\n      \"exports\": [\n        \"mbt_ffi_cabi_realloc:cabi_realloc\",\n        \"wasmExportConstructorInstance:tutuca:component/guest@0.4.0#[constructor]instance\",\n        \"wasmExportGetManifest:tutuca:component/guest@0.4.0#get-manifest\",\n        \"wasmExportGetManifestPostReturn:cabi_post_tutuca:component/guest@0.4.0#get-manifest\",\n        \"wasmExportHandleRequest:tutuca:component/guest@0.4.0#handle-request\",\n        \"wasmExportHandleRequestPostReturn:cabi_post_tutuca:component/guest@0.4.0#handle-request\",\n        \"wasmExportInstanceDtor:tutuca:component/guest@0.4.0#[dtor]instance\",\n        \"wasmExportMethodInstanceCallMethod:tutuca:component/guest@0.4.0#[method]instance.call-method\",\n        \"wasmExportMethodInstanceCallMethodPostReturn:cabi_post_tutuca:component/guest@0.4.0#[method]instance.call-method\",\n        \"wasmExportMethodInstanceGetField:tutuca:component/guest@0.4.0#[method]instance.get-field\",\n        \"wasmExportMethodInstanceGetFieldPostReturn:cabi_post_tutuca:component/guest@0.4.0#[method]instance.get-field\",\n        \"wasmExportMethodInstanceHandleEvent:tutuca:component/guest@0.4.0#[method]instance.handle-event\",\n        \"wasmExportMethodInstancePersist:tutuca:component/guest@0.4.0#[method]instance.persist\",\n        \"wasmExportMethodInstancePersistPostReturn:cabi_post_tutuca:component/guest@0.4.0#[method]instance.persist\",\n        \"wasmExportMethodInstanceSeqEntries:tutuca:component/guest@0.4.0#[method]instance.seq-entries\",\n        \"wasmExportMethodInstanceSeqEntriesPostReturn:cabi_post_tutuca:component/guest@0.4.0#[method]instance.seq-entries\",\n        \"wasmExportMethodInstanceWithField:tutuca:component/guest@0.4.0#[method]instance.with-field\",\n        \"wasmExportStaticInstanceRestore:tutuca:component/guest@0.4.0#[static]instance.restore\",\n      ],\n    },\n  },\n)\n",
