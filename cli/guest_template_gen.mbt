  mbt_ffi_store8(iter_base + 0, 1)\n        mbt_ffi_store8(iter_base + 8, if payload0 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload1) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n        mbt_ffi_storef64(iter_base + 8, payload1)\n\n        ()\n      }\n      Text(payload2) => {\n        mbt_ffi_store8(iter_base + 0, 3)\n\n        let ptr3 = mbt_ffi_str2ptr(payload2)\n        mbt_ffi_store32(iter_base + 12, payload2.length())\n        mbt_ffi_store32(iter_base + 8, ptr3)\n        cleanup_list.push(ptr3)\n\n        ()\n      }\n      List(payload4) => {\n        mbt_ffi_store8(iter_base + 0, 4)\n        mbt_ffi_store64(iter_base + 8, payload4.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload5) => {\n        mbt_ffi_store8(iter_base + 0, 5)\n        mbt_ffi_store64(iter_base + 8, payload5.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload6) => {\n        mbt_ffi_store8(iter_base + 0, 6)\n        mbt_ffi_store64(iter_base + 8, payload6.reinterpret_as_int64())\n\n        ()\n      }\n    }\n  }\n  wasmImportSend(ptr, name.length(), address, args.length())\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(address)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// Send to a component in this one's own subtree (`ctx.send-at-path`): the\n/// message arrives as handle-event(receive, ...) at `path`, e.g.\n/// `[field(\"left\")]` for the child a `left` field holds.\npub fn send_at(\n  path : Array[PathStep],\n  name : String,\n  args : Array[@values.Value],\n) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let address = mbt_ffi_malloc(path.length() * 20)\n  for index = 0; index < path.length(); index = index + 1 {\n    let iter_elem : PathStep = path[index]\n    let iter_base = address + index * 20\n\n    match iter_elem {\n      Field(payload) => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        let ptr = mbt_ffi_str2ptr(payload)\n        mbt_ffi_store32(iter_base + 8, payload.length())\n        mbt_ffi_store32(iter_base + 4, ptr)\n        cleanup_list.push(ptr)\n\n        ()\n      }\n      Item(payload0) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n\n        let ptr1 = mbt_ffi_str2ptr(payload0.field)\n        mbt_ffi_store32(iter_base + 8, payload0.field.length())\n        mbt_ffi_store32(iter_base + 4, ptr1)\n\n        let ptr2 = mbt_ffi_str2ptr(payload0.key)\n        mbt_ffi_store32(iter_base + 16, payload0.key.length())\n        mbt_ffi_store32(iter_base + 12, ptr2)\n        cleanup_list.push(ptr1)\n        cleanup_list.push(ptr2)\n\n        ()\n      }\n      At(payload3) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n\n        let ptr4 = mbt_ffi_str2ptr(payload3.field)\n        mbt_ffi_store32(iter_base + 8, payload3.field.length())\n        mbt_ffi_store32(iter_base + 4, ptr4)\n        mbt_ffi_store32(iter_base + 12, payload3.index.reinterpret_as_int())\n        cleanup_list.push(ptr4)\n\n        ()\n      }\n    }\n  }\n\n  let ptr5 = mbt_ffi_str2ptr(name)\n\n  let address14 = mbt_ffi_malloc(args.length() * 16)\n  for index15 = 0; index15 < args.length(); index15 = index15 + 1 {\n    let iter_elem : @values.Value = args[index15]\n    let iter_base = address14 + index15 * 16\n\n    match iter_elem {\n      Nil => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        ()\n      }\n      Boolean(payload7) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n        mbt_ffi_store8(iter_base + 8, if payload7 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload8) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n        mbt_ffi_storef64(iter_base + 8, payload8)\n\n        ()\n      }\n      Text(payload9) => {\n        mbt_ffi_store8(iter_base + 0, 3)\n\n        let ptr10 = mbt_ffi_str2ptr(payload9)\n        mbt_ffi_store32(iter_base + 12, payload9.length())\n        mbt_ffi_store32(iter_base + 8, ptr10)\n        cleanup_list.push(ptr10)\n\n        ()\n      }\n      List(payload11) => {\n        mbt_ffi_store8(iter_base + 0, 4)\n        mbt_ffi_store64(iter_base + 8, payload11.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload12) => {\n        mbt_ffi_store8(iter_base + 0, 5)\n        mbt_ffi_store64(iter_base + 8, payload12.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload13) => {\n        mbt_ffi_store8(iter_base + 0, 6)\n        mbt_ffi_store64(iter_base + 8, payload13.reinterpret_as_int64())\n\n        ()\n      }\n    }\n  }\n  wasmImportSendAt(\n    address,\n    path.length(),\n    ptr5,\n    name.length(),\n    address14,\n    args.length(),\n  )\n  mbt_ffi_free(address)\n  mbt_ffi_free(ptr5)\n  mbt_ffi_free(address14)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// Raise a bubble AT a descendant, which then travels up through it — the\n/// targeted twin of `emit`.\npub fn bubble_at(\n  path : Array[PathStep],\n  name : String,\n  args : Array[@values.Value],\n) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let address = mbt_ffi_malloc(path.length() * 20)\n  for index = 0; index < path.length(); index = index + 1 {\n    let iter_elem : PathStep = path[index]\n    let iter_base = address + index * 20\n\n    match iter_elem {\n      Field(payload) => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        let ptr = mbt_ffi_str2ptr(payload)\n        mbt_ffi_store32(iter_base + 8, payload.length())\n        mbt_ffi_store32(iter_base + 4, ptr)\n        cleanup_list.push(ptr)\n\n        ()\n      }\n      Item(payload0) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n\n        let ptr1 = mbt_ffi_str2ptr(payload0.field)\n        mbt_ffi_store32(iter_base + 8, payload0.field.length())\n        mbt_ffi_store32(iter_base + 4, ptr1)\n\n        let ptr2 = mbt_ffi_str2ptr(payload0.key)\n        mbt_ffi_store32(iter_base + 16, payload0.key.length())\n        mbt_ffi_store32(iter_base + 12, ptr2)\n        cleanup_list.push(ptr1)\n        cleanup_list.push(ptr2)\n\n        ()\n      }\n      At(payload3) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n\n        let ptr4 = mbt_ffi_str2ptr(payload3.field)\n        mbt_ffi_store32(iter_base + 8, payload3.field.length())\n        mbt_ffi_store32(iter_base + 4, ptr4)\n        mbt_ffi_store32(iter_base + 12, payload3.index.reinterpret_as_int())\n        cleanup_list.push(ptr4)\n\n        ()\n      }\n    }\n  }\n\n  let ptr5 = mbt_ffi_str2ptr(name)\n\n  let address14 = mbt_ffi_malloc(args.length() * 16)\n  for index15 = 0; index15 < args.length(); index15 = index15 + 1 {\n    let iter_elem : @values.Value = args[index15]\n    let iter_base = address14 + index15 * 16\n\n    match iter_elem {\n      Nil => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        ()\n      }\n      Boolean(payload7) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n        mbt_ffi_store8(iter_base + 8, if payload7 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload8) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n        mbt_ffi_storef64(iter_base + 8, payload8)\n\n        ()\n      }\n      Text(payload9) => {\n        mbt_ffi_store8(iter_base + 0, 3)\n\n        let ptr10 = mbt_ffi_str2ptr(payload9)\n        mbt_ffi_store32(iter_base + 12, payload9.length())\n        mbt_ffi_store32(iter_base + 8, ptr10)\n        cleanup_list.push(ptr10)\n\n        ()\n      }\n      List(payload11) => {\n        mbt_ffi_store8(iter_base + 0, 4)\n        mbt_ffi_store64(iter_base + 8, payload11.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload12) => {\n        mbt_ffi_store8(iter_base + 0, 5)\n        mbt_ffi_store64(iter_base + 8, payload12.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload13) => {\n        mbt_ffi_store8(iter_base + 0, 6)\n        mbt_ffi_store64(iter_base + 8, payload13.reinterpret_as_int64())\n\n        ()\n      }\n    }\n  }\n  wasmImportBubbleAt(\n    address,\n    path.length(),\n    ptr5,\n    name.length(),\n    address14,\n    args.length(),\n  )\n  mbt_ffi_free(address)\n  mbt_ffi_free(ptr5)\n  mbt_ffi_free(address14)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// Stop the message being handled from travelling any further up the tree\n/// (host `ctx.stop-propagation`). Only meaningful while handling a bubble.\npub fn stop_propagation() -> Unit {\n  wasmImportStopPropagation()\n}\n\n///|\n/// Fire a request handler — one this bundle serves (see\n/// `component-def.requests`) or, failing that, one the HOST registered. The\n/// response arrives as a later handle-event(response, ...), routed by `opts`.\n///\n/// A bundle's OWN handlers run inside the guest, so they inherit the guest's\n/// (absent) authority and need no policy. Reaching a HOST handler is the one\n/// place a guest asks for something it cannot do itself, so the host decides\n/// — by the requester's path, at the moment of the call, not by anything the\n/// manifest claimed. A refusal arrives as an error response.\npub fn request(\n  name : String,\n  args : Array[@values.Value],\n  opts : RequestOpts,\n) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let ptr = mbt_ffi_str2ptr(name)\n\n  let address = mbt_ffi_malloc(args.length() * 16)\n  for index = 0; index < args.length(); index = index + 1 {\n    let iter_elem : @values.Value = args[index]\n    let iter_base = address + index * 16\n\n    match iter_elem {\n      Nil => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        ()\n      }\n      Boolean(payload0) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n        mbt_ffi_store8(iter_base + 8, if payload0 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload1) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n        mbt_ffi_storef64(iter_base + 8, payload1)\n\n        ()\n      }\n      Text(payload2) => {\n        mbt_ffi_store8(iter_base + 0, 3)\n\n        let ptr3 = mbt_ffi_str2ptr(payload2)\n        mbt_ffi_store32(iter_base + 12, payload2.length())\n        mbt_ffi_store32(iter_base + 8, ptr3)\n        cleanup_list.push(ptr3)\n\n        ()\n      }\n      List(payload4) => {\n        mbt_ffi_store8(iter_base + 0, 4)\n        mbt_ffi_store64(iter_base + 8, payload4.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload5) => {\n        mbt_ffi_store8(iter_base + 0, 5)\n        mbt_ffi_store64(iter_base + 8, payload5.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload6) => {\n        mbt_ffi_store8(iter_base + 0, 6)\n        mbt_ffi_store64(iter_base + 8, payload6.reinterpret_as_int64())\n\n        ()\n      }\n    }\n  }\n\n  let (lowered, lowered10, lowered11) = match opts.on_ok {\n    None => (0, 0, 0)\n    Some(payload8) => {\n      let ptr9 = mbt_ffi_str2ptr(payload8)\n      cleanup_list.push(ptr9)\n\n      (1, ptr9, payload8.length())\n    }\n  }\n\n  let (lowered15, lowered16, lowered17) = match opts.on_error {\n    None => (0, 0, 0)\n    Some(payload13) => {\n      let ptr14 = mbt_ffi_str2ptr(payload13)\n      cleanup_list.push(ptr14)\n\n      (1, ptr14, payload13.length())\n    }\n  }\n\n  let (lowered21, lowered22, lowered23) = match opts.on_res {\n    None => (0, 0, 0)\n    Some(payload19) => {\n      let ptr20 = mbt_ffi_str2ptr(payload19)\n      cleanup_list.push(ptr20)\n\n      (1, ptr20, payload19.length())\n    }\n  }\n  wasmImportRequest(\n    ptr,\n    name.length(),\n    address,\n    args.length(),\n    lowered,\n    lowered10,\n    lowered11,\n    lowered15,\n    lowered16,\n    lowered17,\n    lowered21,\n    lowered22,\n    lowered23,\n    if opts.live_path {\n      1\n    } else {\n      0\n    },\n  )\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(address)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// Ask the host to send `name` back to THIS instance after `delay-ms`, as a\n/// later handle-event(receive, ...). Buffered like the rest; the host owns\n/// the timer and may coalesce, delay or drop it. There is no cancel and no\n/// handle: a guest cannot cancel what it does not own, and a component that\n/// wants to stop a tick stops acting on it. Requires `cap-timer`.\npub fn after(\n  delay_ms : UInt,\n  name : String,\n  args : Array[@values.Value],\n) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let ptr = mbt_ffi_str2ptr(name)\n\n  let address = mbt_ffi_malloc(args.length() * 16)\n  for index = 0; index < args.length(); index = index + 1 {\n    let iter_elem : @values.Value = args[index]\n    let iter_base = address + index * 16\n\n    match iter_elem {\n      Nil => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        ()\n      }\n      Boolean(payload0) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n        mbt_ffi_store8(iter_base + 8, if payload0 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload1) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n        mbt_ffi_storef64(iter_base + 8, payload1)\n\n        ()\n      }\n      Text(payload2) => {\n        mbt_ffi_store8(iter_base + 0, 3)\n\n        let ptr3 = mbt_ffi_str2ptr(payload2)\n        mbt_ffi_store32(iter_base + 12, payload2.length())\n        mbt_ffi_store32(iter_base + 8, ptr3)\n        cleanup_list.push(ptr3)\n\n        ()\n      }\n      List(payload4) => {\n        mbt_ffi_store8(iter_base + 0, 4)\n        mbt_ffi_store64(iter_base + 8, payload4.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload5) => {\n        mbt_ffi_store8(iter_base + 0, 5)\n        mbt_ffi_store64(iter_base + 8, payload5.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload6) => {\n        mbt_ffi_store8(iter_base + 0, 6)\n        mbt_ffi_store64(iter_base + 8, payload6.reinterpret_as_int64())\n\n        ()\n      }\n    }\n  }\n  wasmImportAfter(\n    delay_ms.reinterpret_as_int(),\n    ptr,\n    name.length(),\n    address,\n    args.length(),\n  )\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(address)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// Create a same-bundle child instance and return its HOST-ASSIGNED token\n/// (the only instance-token space; `value.instance` payloads use it).\n/// Callable from constructors and handlers; the child becomes a field of\n/// the parent (return it from get-field as instance(token), accept it in\n/// with-field) and the host renders it with `<x render=\".field\">`.\npub fn make_instance(\n  component : String,\n  args : Array[(String, @values.Value)],\n) -> UInt64 {\n  let cleanup_list : Array[Int] = []\n\n  let ptr = mbt_ffi_str2ptr(component)\n\n  let address = mbt_ffi_malloc(args.length() * 24)\n  for index = 0; index < args.length(); index = index + 1 {\n    let iter_elem : (String, @values.Value) = args[index]\n    let iter_base = address + index * 24\n\n    let ptr0 = mbt_ffi_str2ptr(iter_elem.0)\n    mbt_ffi_store32(iter_base + 4, iter_elem.0.length())\n    mbt_ffi_store32(iter_base + 0, ptr0)\n\n    match iter_elem.1 {\n      Nil => {\n        mbt_ffi_store8(iter_base + 8, 0)\n\n        ()\n      }\n      Boolean(payload1) => {\n        mbt_ffi_store8(iter_base + 8, 1)\n        mbt_ffi_store8(iter_base + 16, if payload1 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload2) => {\n        mbt_ffi_store8(iter_base + 8, 2)\n        mbt_ffi_storef64(iter_base + 16, payload2)\n\n        ()\n      }\n      Text(payload3) => {\n        mbt_ffi_store8(iter_base + 8, 3)\n\n        let ptr4 = mbt_ffi_str2ptr(payload3)\n        mbt_ffi_store32(iter_base + 20, payload3.length())\n        mbt_ffi_store32(iter_base + 16, ptr4)\n        cleanup_list.push(ptr4)\n\n        ()\n      }\n      List(payload5) => {\n        mbt_ffi_store8(iter_base + 8, 4)\n        mbt_ffi_store64(iter_base + 16, payload5.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload6) => {\n        mbt_ffi_store8(iter_base + 8, 5)\n        mbt_ffi_store64(iter_base + 16, payload6.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload7) => {\n        mbt_ffi_store8(iter_base + 8, 6)\n        mbt_ffi_store64(iter_base + 16, payload7.reinterpret_as_int64())\n\n        ()\n      }\n    }\n    cleanup_list.push(ptr0)\n  }\n  let result : Int64 = wasmImportMakeInstance(\n    ptr,\n    component.length(),\n    address,\n    args.length(),\n  )\n  let ret = result.reinterpret_as_uint64()\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(address)\n\n  cleanup_list.each(mbt_ffi_free)\n  return ret\n}\n\n///|\n/// Release a child token that will no longer be returned from get-field.\npub fn drop_instance(token : UInt64) -> Unit {\n  wasmImportDropInstance(token.reinterpret_as_int64())\n}\n",
  ),
  (
    "interface/tutuca/component/env/README.md", "The three ambient facts a component cannot compute for itself: what time it\nis, an unpredictable number, and a fresh name. Each one is a CAPABILITY the\nmanifest requests and the host grants (`capability-req`); an ungranted call\ntraps rather than returning a plausible lie.\n\nDeliberately NOT `wasi:clocks` + `wasi:random`. Three reasons, in order:\nthe world imports no WASI and adding it drags preview2 shims into the\nbrowser; a real monotonic clock is the primitive a timing side channel is\nbuilt from, and the coarsened one below is not; and an ambient clock makes\na dispatch unreplayable, which contradicts \"the host is the framework\".",
  ),
  (
    "interface/tutuca/component/env/ffi.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\nextern \"wasm\" fn mbt_ffi_free(position : Int) =\n  #|(func (param i32) local.get 0 call $moonbit.decref)\n\n///|\nextern \"wasm\" fn mbt_ffi_load32(offset : Int) -> Int =\n  #|(func (param i32) (result i32) local.get 0 i32.load)\n\n///|\nextern \"wasm\" fn mbt_ffi_malloc(size : Int) -> Int =\n  #|(func (param i32) (result i32) (local i32)\n  #| local.get 0 i32.const 4 i32.add call $moonbit.gc.malloc\n  #| local.tee 1 i32.const 0 call $moonbit.init_array8\n  #| local.get 1)\n\n///|\nextern \"wasm\" fn mbt_ffi_ptr2str(ptr : Int, len : Int) -> String =\n  #|(func (param i32) (param i32) (result i32)\n  #| local.get 0\n  #| local.get 1 call $moonbit.init_array16\n  #| local.get 0)\n\n///|\nfn wasmImportLocale(p0 : Int) = \"tutuca:component/env@0.4.0\" \"locale\"\n\n///|\nfn wasmImportNewId(p0 : Int) = \"tutuca:component/env@0.4.0\" \"new-id\"\n\n///|\nfn wasmImportNowMs() -> Int64 = \"tutuca:component/env@0.4.0\" \"now-ms\"\n\n///|\nfn wasmImportRandomU64() -> Int64 = \"tutuca:component/env@0.4.0\" \"random-u64\"\n\n///|\nfn wasmImportTzOffsetMin() -> Int = \"tutuca:component/env@0.4.0\" \"tz-offset-min\"\n",
  ),
  ("interface/tutuca/component/env/moon.pkg", "warnings = \"-44\"\n"),
  (
    "interface/tutuca/component/env/top.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\n/// Milliseconds since the Unix epoch, coarsened by the host and FROZEN for\n/// the duration of one dispatch: every call inside one `handle-event`\n/// returns the same instant. That is what lets a session replay, and what\n/// denies a guest the fine-grained timer a side channel needs. Requires\n/// `cap-clock`.\npub fn now_ms() -> UInt64 {\n  let result : Int64 = wasmImportNowMs()\n  let ret = result.reinterpret_as_uint64()\n  return ret\n}\n\n///|\n/// Minutes to add to UTC for the user's local time, and the host's locale.\n/// The host-context a widget would otherwise read off the DOM, handed over\n/// as data. Requires `cap-clock`.\npub fn tz_offset_min() -> Int {\n  let result : Int = wasmImportTzOffsetMin()\n  let ret = result\n  return ret\n}\n\n///|\npub fn locale() -> String {\n  let return_area = mbt_ffi_malloc(8)\n  wasmImportLocale(return_area)\n\n  let result = mbt_ffi_ptr2str(\n    mbt_ffi_load32(return_area + 0),\n    mbt_ffi_load32(return_area + 4),\n  )\n  let ret = result\n  mbt_ffi_free(return_area)\n  return ret\n}\n\n///|\n/// From a PRNG the HOST seeds per instance and records, so a session\n/// replays. NOT cryptographic: a guest that needs unpredictability an\n/// attacker cannot reproduce asks the host through `control.request`.\n/// Requires `cap-random`.\npub fn random_u64() -> UInt64 {\n  let result : Int64 = wasmImportRandomU64()\n  let ret = result.reinterpret_as_uint64()\n  return ret\n}\n\n///|\n/// A fresh identifier, unique within this bundle for this session.\n/// Monotonic, not a UUID — it is for keying a list, not for naming a thing\n/// outside the page. Requires `cap-random`.\npub fn new_id() -> String {\n  let return_area = mbt_ffi_malloc(8)\n  wasmImportNewId(return_area)\n\n  let result = mbt_ffi_ptr2str(\n    mbt_ffi_load32(return_area + 0),\n    mbt_ffi_load32(return_area + 4),\n  )\n  let ret = result\n  mbt_ffi_free(return_area)\n  return ret\n}\n",
  ),
  (
    "interface/tutuca/component/values/README.md", "Dynamic values crossing the boundary. WIT has no recursive types, so\nscalars travel inline and compounds are u64 handles into a host-side\narena, read/built through this interface. Handles are only valid for the\nduration of the current host->guest call: read handles go stale when the\ncall returns, and freshly built handles must be handed back to the host\n(in a return value or an import argument) within the same call.\n`instance` payloads are guest-instance handles (see `guest.instance`),\nused for nested same-bundle child components.",
  ),
