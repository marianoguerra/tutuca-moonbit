n\n        ()\n      }\n    }\n  }\n  wasmImportSend(ptr, name.length(), address, args.length())\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(address)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// Send to a component in this one's own subtree (`ctx.send-at-path`): the\n/// message arrives as handle-event(receive, ...) at `path`, e.g.\n/// `[field(\"left\")]` for the child a `left` field holds.\npub fn send_at(\n  path : Array[PathStep],\n  name : String,\n  args : Array[@values.Value],\n) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let address = mbt_ffi_malloc(path.length() * 20)\n  for index = 0; index < path.length(); index = index + 1 {\n    let iter_elem : PathStep = path[index]\n    let iter_base = address + index * 20\n\n    match iter_elem {\n      Field(payload) => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        let ptr = mbt_ffi_str2ptr(payload)\n        mbt_ffi_store32(iter_base + 8, payload.length())\n        mbt_ffi_store32(iter_base + 4, ptr)\n        cleanup_list.push(ptr)\n\n        ()\n      }\n      Item(payload0) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n\n        let ptr1 = mbt_ffi_str2ptr(payload0.field)\n        mbt_ffi_store32(iter_base + 8, payload0.field.length())\n        mbt_ffi_store32(iter_base + 4, ptr1)\n\n        let ptr2 = mbt_ffi_str2ptr(payload0.key)\n        mbt_ffi_store32(iter_base + 16, payload0.key.length())\n        mbt_ffi_store32(iter_base + 12, ptr2)\n        cleanup_list.push(ptr1)\n        cleanup_list.push(ptr2)\n\n        ()\n      }\n      At(payload3) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n\n        let ptr4 = mbt_ffi_str2ptr(payload3.field)\n        mbt_ffi_store32(iter_base + 8, payload3.field.length())\n        mbt_ffi_store32(iter_base + 4, ptr4)\n        mbt_ffi_store32(iter_base + 12, payload3.index.reinterpret_as_int())\n        cleanup_list.push(ptr4)\n\n        ()\n      }\n    }\n  }\n\n  let ptr5 = mbt_ffi_str2ptr(name)\n\n  let address14 = mbt_ffi_malloc(args.length() * 16)\n  for index15 = 0; index15 < args.length(); index15 = index15 + 1 {\n    let iter_elem : @values.Value = args[index15]\n    let iter_base = address14 + index15 * 16\n\n    match iter_elem {\n      Nil => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        ()\n      }\n      Boolean(payload7) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n        mbt_ffi_store8(iter_base + 8, if payload7 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload8) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n        mbt_ffi_storef64(iter_base + 8, payload8)\n\n        ()\n      }\n      Text(payload9) => {\n        mbt_ffi_store8(iter_base + 0, 3)\n\n        let ptr10 = mbt_ffi_str2ptr(payload9)\n        mbt_ffi_store32(iter_base + 12, payload9.length())\n        mbt_ffi_store32(iter_base + 8, ptr10)\n        cleanup_list.push(ptr10)\n\n        ()\n      }\n      List(payload11) => {\n        mbt_ffi_store8(iter_base + 0, 4)\n        mbt_ffi_store64(iter_base + 8, payload11.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload12) => {\n        mbt_ffi_store8(iter_base + 0, 5)\n        mbt_ffi_store64(iter_base + 8, payload12.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload13) => {\n        mbt_ffi_store8(iter_base + 0, 6)\n        mbt_ffi_store64(iter_base + 8, payload13.reinterpret_as_int64())\n\n        ()\n      }\n    }\n  }\n  wasmImportSendAt(\n    address,\n    path.length(),\n    ptr5,\n    name.length(),\n    address14,\n    args.length(),\n  )\n  mbt_ffi_free(address)\n  mbt_ffi_free(ptr5)\n  mbt_ffi_free(address14)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// End the walk with no answer — \"served, and no answer\". The sender hears\n/// nothing, even if it named an outcome, which is what separates this from\n/// letting the route run out.\n///\n/// (host `ctx.stop-propagation`; only meaningful while handling an intent.)\npub fn stop_propagation() -> Unit {\n  wasmImportStopPropagation()\n}\n\n///|\n/// Ask the host to send `name` back to THIS instance after `delay-ms`, as a\n/// later handle-event(receive, ...). Buffered like the rest; the host owns\n/// the timer and may coalesce, delay or drop it. There is no cancel and no\n/// handle: a guest cannot cancel what it does not own, and a component that\n/// wants to stop a tick stops acting on it. Requires `cap-timer`.\npub fn after(\n  delay_ms : UInt,\n  name : String,\n  args : Array[@values.Value],\n) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let ptr = mbt_ffi_str2ptr(name)\n\n  let address = mbt_ffi_malloc(args.length() * 16)\n  for index = 0; index < args.length(); index = index + 1 {\n    let iter_elem : @values.Value = args[index]\n    let iter_base = address + index * 16\n\n    match iter_elem {\n      Nil => {\n        mbt_ffi_store8(iter_base + 0, 0)\n\n        ()\n      }\n      Boolean(payload0) => {\n        mbt_ffi_store8(iter_base + 0, 1)\n        mbt_ffi_store8(iter_base + 8, if payload0 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload1) => {\n        mbt_ffi_store8(iter_base + 0, 2)\n        mbt_ffi_storef64(iter_base + 8, payload1)\n\n        ()\n      }\n      Text(payload2) => {\n        mbt_ffi_store8(iter_base + 0, 3)\n\n        let ptr3 = mbt_ffi_str2ptr(payload2)\n        mbt_ffi_store32(iter_base + 12, payload2.length())\n        mbt_ffi_store32(iter_base + 8, ptr3)\n        cleanup_list.push(ptr3)\n\n        ()\n      }\n      List(payload4) => {\n        mbt_ffi_store8(iter_base + 0, 4)\n        mbt_ffi_store64(iter_base + 8, payload4.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload5) => {\n        mbt_ffi_store8(iter_base + 0, 5)\n        mbt_ffi_store64(iter_base + 8, payload5.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload6) => {\n        mbt_ffi_store8(iter_base + 0, 6)\n        mbt_ffi_store64(iter_base + 8, payload6.reinterpret_as_int64())\n\n        ()\n      }\n    }\n  }\n  wasmImportAfter(\n    delay_ms.reinterpret_as_int(),\n    ptr,\n    name.length(),\n    address,\n    args.length(),\n  )\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(address)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// Create a same-bundle child instance and return its HOST-ASSIGNED token\n/// (the only instance-token space; `value.instance` payloads use it).\n/// Callable from constructors and handlers; the child becomes a field of\n/// the parent (return it from get-field as instance(token), accept it in\n/// with-field) and the host renders it with `<x render=\".field\">`.\npub fn make_instance(\n  component : String,\n  args : Array[(String, @values.Value)],\n) -> UInt64 {\n  let cleanup_list : Array[Int] = []\n\n  let ptr = mbt_ffi_str2ptr(component)\n\n  let address = mbt_ffi_malloc(args.length() * 24)\n  for index = 0; index < args.length(); index = index + 1 {\n    let iter_elem : (String, @values.Value) = args[index]\n    let iter_base = address + index * 24\n\n    let ptr0 = mbt_ffi_str2ptr(iter_elem.0)\n    mbt_ffi_store32(iter_base + 4, iter_elem.0.length())\n    mbt_ffi_store32(iter_base + 0, ptr0)\n\n    match iter_elem.1 {\n      Nil => {\n        mbt_ffi_store8(iter_base + 8, 0)\n\n        ()\n      }\n      Boolean(payload1) => {\n        mbt_ffi_store8(iter_base + 8, 1)\n        mbt_ffi_store8(iter_base + 16, if payload1 { 1 } else { 0 })\n\n        ()\n      }\n      Number(payload2) => {\n        mbt_ffi_store8(iter_base + 8, 2)\n        mbt_ffi_storef64(iter_base + 16, payload2)\n\n        ()\n      }\n      Text(payload3) => {\n        mbt_ffi_store8(iter_base + 8, 3)\n\n        let ptr4 = mbt_ffi_str2ptr(payload3)\n        mbt_ffi_store32(iter_base + 20, payload3.length())\n        mbt_ffi_store32(iter_base + 16, ptr4)\n        cleanup_list.push(ptr4)\n\n        ()\n      }\n      List(payload5) => {\n        mbt_ffi_store8(iter_base + 8, 4)\n        mbt_ffi_store64(iter_base + 16, payload5.reinterpret_as_int64())\n\n        ()\n      }\n      Map(payload6) => {\n        mbt_ffi_store8(iter_base + 8, 5)\n        mbt_ffi_store64(iter_base + 16, payload6.reinterpret_as_int64())\n\n        ()\n      }\n      Instance(payload7) => {\n        mbt_ffi_store8(iter_base + 8, 6)\n        mbt_ffi_store64(iter_base + 16, payload7.reinterpret_as_int64())\n\n        ()\n      }\n    }\n    cleanup_list.push(ptr0)\n  }\n  let result : Int64 = wasmImportMakeInstance(\n    ptr,\n    component.length(),\n    address,\n    args.length(),\n  )\n  let ret = result.reinterpret_as_uint64()\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(address)\n\n  cleanup_list.each(mbt_ffi_free)\n  return ret\n}\n\n///|\n/// Release a child token that will no longer be returned from get-field.\npub fn drop_instance(token : UInt64) -> Unit {\n  wasmImportDropInstance(token.reinterpret_as_int64())\n}\n",
  ),
  (
    "interface/tutuca/component/env/README.md", "The three ambient facts a component cannot compute for itself: what time it\nis, an unpredictable number, and a fresh name. Each one is a CAPABILITY the\nstatic manifest requests and the host grants; an ungranted call\ntraps rather than returning a plausible lie.\n\nDeliberately NOT `wasi:clocks` + `wasi:random`. Three reasons, in order:\nthe world imports no WASI and adding it drags preview2 shims into the\nbrowser; a real monotonic clock is the primitive a timing side channel is\nbuilt from, and the coarsened one below is not; and an ambient clock makes\na dispatch unreplayable, which contradicts \"the host is the framework\".",
  ),
  (
    "interface/tutuca/component/env/ffi.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\nextern \"wasm\" fn mbt_ffi_free(position : Int) =\n  #|(func (param i32) local.get 0 call $moonbit.decref)\n\n///|\nextern \"wasm\" fn mbt_ffi_load32(offset : Int) -> Int =\n  #|(func (param i32) (result i32) local.get 0 i32.load)\n\n///|\nextern \"wasm\" fn mbt_ffi_malloc(size : Int) -> Int =\n  #|(func (param i32) (result i32) (local i32)\n  #| local.get 0 i32.const 4 i32.add call $moonbit.gc.malloc\n  #| local.tee 1 i32.const 0 call $moonbit.init_array8\n  #| local.get 1)\n\n///|\nextern \"wasm\" fn mbt_ffi_ptr2str(ptr : Int, len : Int) -> String =\n  #|(func (param i32) (param i32) (result i32)\n  #| local.get 0\n  #| local.get 1 call $moonbit.init_array16\n  #| local.get 0)\n\n///|\nfn wasmImportLocale(p0 : Int) = \"tutuca:component/env@0.9.0\" \"locale\"\n\n///|\nfn wasmImportNewId(p0 : Int) = \"tutuca:component/env@0.9.0\" \"new-id\"\n\n///|\nfn wasmImportNowMs() -> Int64 = \"tutuca:component/env@0.9.0\" \"now-ms\"\n\n///|\nfn wasmImportRandomU64() -> Int64 = \"tutuca:component/env@0.9.0\" \"random-u64\"\n\n///|\nfn wasmImportTzOffsetMin() -> Int = \"tutuca:component/env@0.9.0\" \"tz-offset-min\"\n",
  ),
  ("interface/tutuca/component/env/moon.pkg", "warnings = \"-44\"\n"),
  (
    "interface/tutuca/component/env/top.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\n/// Milliseconds since the Unix epoch, coarsened by the host and FROZEN for\n/// the duration of one dispatch: every call inside one `handle-event`\n/// returns the same instant. That is what lets a session replay, and what\n/// denies a guest the fine-grained timer a side channel needs. Requires\n/// `cap-clock`.\npub fn now_ms() -> UInt64 {\n  let result : Int64 = wasmImportNowMs()\n  let ret = result.reinterpret_as_uint64()\n  return ret\n}\n\n///|\n/// Minutes to add to UTC for the user's local time, and the host's locale.\n/// The host-context a widget would otherwise read off the DOM, handed over\n/// as data. Requires `cap-clock`.\npub fn tz_offset_min() -> Int {\n  let result : Int = wasmImportTzOffsetMin()\n  let ret = result\n  return ret\n}\n\n///|\npub fn locale() -> String {\n  let return_area = mbt_ffi_malloc(8)\n  wasmImportLocale(return_area)\n\n  let result = mbt_ffi_ptr2str(\n    mbt_ffi_load32(return_area + 0),\n    mbt_ffi_load32(return_area + 4),\n  )\n  let ret = result\n  mbt_ffi_free(return_area)\n  return ret\n}\n\n///|\n/// From a PRNG the HOST seeds per instance and records, so a session\n/// replays. NOT cryptographic: a guest that needs unpredictability an\n/// attacker cannot reproduce asks the host with an intent on the `lex` leg.\n/// Requires `cap-random`.\npub fn random_u64() -> UInt64 {\n  let result : Int64 = wasmImportRandomU64()\n  let ret = result.reinterpret_as_uint64()\n  return ret\n}\n\n///|\n/// A fresh identifier, unique within this bundle for this session.\n/// Monotonic, not a UUID — it is for keying a list, not for naming a thing\n/// outside the page. Requires `cap-random`.\npub fn new_id() -> String {\n  let return_area = mbt_ffi_malloc(8)\n  wasmImportNewId(return_area)\n\n  let result = mbt_ffi_ptr2str(\n    mbt_ffi_load32(return_area + 0),\n    mbt_ffi_load32(return_area + 4),\n  )\n  let ret = result\n  mbt_ffi_free(return_area)\n  return ret\n}\n",
  ),
  (
    "interface/tutuca/component/tables/README.md", "Tabular data as a set of typed COLUMNS of equal width. Columns rather than\nrows because every operation a table is actually asked for — sort, filter,\naggregate, retype, add a column — touches one column across every row, and\nbecause a column is the only place a type can be stated once instead of\nonce per cell.\n\nThis interface declares NO functions, which is the whole of its cost: it\nexists so every guest is generated the SAME table types rather than\ninventing its own. Values still travel as `values.value` trees; these types\nare what both ends encode to and decode from, and the host's JSON Schema\nprojection of `ty-table` is what an agent generates against.",
  ),
  (
    "interface/tutuca/component/tables/ffi.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n",
  ),
  ("interface/tutuca/component/tables/moon.pkg", "warnings = \"-44\"\n"),
  (
    "interface/tutuca/component/tables/top.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\n/// What a column holds — the four things JSON has, and no more. There is no\n/// date, no decimal and no nested value, because each of those is a\n/// representation argument this contract cannot settle on its callers'\n/// behalf; each is a `str` with a documented spelling until it earns an arm.\n///\n/// `i32` and not `i64`: a table is JSON at every hop between here and the\n/// page — `values.value` carries `number(f64)`, and the host's own runtime\n/// value has one number type — so past 2^53 an integer stops being itself.\n/// A 64-bit id is a `str`.\npub(all) enum ColType {\n  I32\n  F64\n  STR\n  BOOL\n} derive(Debug, Eq)\n\n///|\npub fn ColType::ordinal(self : ColType) -> Int {\n  match self {\n    I32 => 0\n    F64 => 1\n    STR => 2\n    BOOL => 3\n  }\n}\n\n///|\npub fn ColType::from(self : Int) -> ColType {\n  match self {\n    0 => I32\n    1 => F64\n    2 => STR\n    3 => BOOL\n    _ => panic()\n  }\n}\n\n///|\n/// A column's values, all of one type. The ARM is the type: a column cannot\n/// claim `i32` and hold strings, so the invariant is unrepresentable rather\n/// than merely checked. The JSON spelling splits the two back apart into\n/// `\"type\"` beside `\"values\"`, because that is the form a generator writes\n/// and a schema can discriminate on — this is the form that cannot be wrong.\npub(all) enum ColValues {\n  I32s(FixedArray[Int])\n  F64s(FixedArray[Double])\n  Strs(Array[String])\n  Bools(Array[Bool])\n} derive(Debug, Eq)\n\n///|\npub(all) struct Column {\n  id : String\n  label : String\n  values : ColValues\n  nulls : FixedArray[UInt]\n} derive(Debug, Eq)\n\n///|\n/// Columns of EQUAL width — the invariant this record exists to carry.\npub(all) struct Table {\n  columns : Array[Column]\n  row_count : UInt\n} derive(Debug, Eq)\n\n///|\n/// A column's identity WITHOUT its data — the header half of a row.\npub(all) struct FieldRef {\n  id : String\n  label : String\n  ty : ColType\n} derive(Debug, Eq)\n\n///|\n/// One value. `blank` is how a lone cell says what a column says with\n/// `nulls`: there is no column here to carry a list.\npub(all) enum Cell {\n  I32(Int)\n  F64(Double)\n  Str(String)\n  Bool(Bool)\n  Blank\n} derive(Debug, Eq)\n\n///|\n/// One row, self-describing: `fields` and `cells` are parallel and the same\n/// length. `index` is the row's position in the table it came from.\npub(all) struct Row {\n  fields : Array[FieldRef]\n  cells : Array[Cell]\n  index : UInt\n} derive(Debug, Eq)\n\n///|\n/// Many rows sharing one header, for when repeating `fields` per row would\n/// be the larger half of the payload.\npub(all) struct RowSet {\n  fields : Array[FieldRef]\n  rows : Array[Array[Cell]]\n  offset : UInt\n} derive(Debug, Eq)\n\n///|\n/// ── Commands: intents that CHANGE the table. A command answers with no\n///    data, and that is the whole of the split — it is what lets a query be\n///    served from a snapshot, and what makes a command replayable.\npub(all) struct SetCell {\n  column : String\n  row : UInt\n  value : Cell\n} derive(Debug, Eq)\n\n///|\npub(all) struct InsertRows {\n  at : UInt\n  rows : Array[Array[Cell]]\n} derive(Debug, Eq)\n\n///|\npub(all) struct AddColumn {\n  at : UInt\n  column : Column\n} derive(Debug, Eq)\n\n///|\npub(all) struct RenameColumn {\n  column : String\n  label : String\n} derive(Debug, Eq)\n\n///|\npub(all) struct MoveColumn {\n  column : String\n  to : UInt\n} derive(Debug, Eq)\n\n///|\n/// Values that do not convert become missing rather than wrong.\npub(all) struct RetypeColumn {\n  column : String\n  ty : ColType\n} derive(Debug, Eq)\n\n///|\npub(all) struct SortBy {\n  column : String\n  descending : Bool\n} derive(Debug, Eq)\n\n///|\npub(all) enum Command {\n  Load(Table)\n  Clear\n  SetCell(SetCell)\n  AppendRows(Array[Array[Cell]])\n  InsertRows(InsertRows)\n  DeleteRows(FixedArray[UInt])\n  AddColumn(AddColumn)\n  DropColumn(String)\n  RenameColumn(RenameColumn)\n  MoveColumn(MoveColumn)\n  RetypeColumn(RetypeColumn)\n  SortBy(SortBy)\n} derive(Debug, Eq)\n\n///|\n/// ── Queries: OBSERVATIONS. A query never changes the table.\npub(all) struct CellRef {\n  column : String\n  row : UInt\n} derive(Debug, Eq)\n\n///|\n/// `columns` empty means every column.\npub(all) struct Page {\n  offset : UInt\n  limit : UInt\n  columns : Array[String]\n} derive(Debug, Eq)\n\n///|\npub(all) enum AggOp {\n  COUNT\n  SUM\n  MIN\n  MAX\n  MEAN\n  DISTINCT_COUNT\n} derive(Debug, Eq)\n\n///|\npub fn AggOp::ordinal(self : AggOp) -> Int {\n  match self {\n    COUNT => 0\n    SUM => 1\n    MIN => 2\n    MAX => 3\n    MEAN => 4\n    DISTINCT_COUNT => 5\n  }\n}\n\n///|\npub fn AggOp::from(self : Int) -> AggOp {\n  match self {\n    0 => COUNT\n    1 => SUM\n    2 => MIN\n    3 => MAX\n    4 => MEAN\n    5 => DISTINCT_COUNT\n    _ => panic()\n  }\n}\n\n///|\npub(all) struct Aggregate {\n  column : String\n  op : AggOp\n} derive(Debug, Eq)\n\n///|\n/// Dimensions and headers with no values — what a renderer needs before it\n/// decides whether to ask for any data at all.\npub(all) struct Shape {\n  row_count : UInt\n  fields : Array[FieldRef]\n} derive(Debug, Eq)\n\n///|\npub(all) enum Query {\n  Shape\n  Cell(CellRef)\n  Row(UInt)\n  Column(String)\n  Page(Page)\n  Aggregate(Aggregate)\n  Distinct(String)\n} derive(Debug, Eq)\n\n///|\npub(all) enum QueryResult {\n  Shape(Shape)\n  Cell(Cell)\n  Row(Row)\n  Column(Column)\n  Page(RowSet)\n  Number(Double)\n  Values(ColValues)\n} derive(Debug, Eq)\n\n///|\n/// ── Failure. A variant rather than a `result`: an outcome this contract\n///    NAMES is one both ends can match on, and one an agent can be told how\n///    to correct.\npub(all) struct TypeMismatch {\n  column : String\n  expected : ColType\n  got : ColType\n} derive(Debug, Eq)\n\n///|\npub(all) struct WidthMismatch {\n  expected : UInt\n  got : UInt\n} derive(Debug, Eq)\n\n///|\npub(all) enum TableError {\n  NoSuchColumn(String)\n  DuplicateColumnId(String)\n  RowOutOfRange(UInt)\n  TypeMismatch(TypeMismatch)\n  WidthMismatch(WidthMismatch)\n  NotComparable(String)\n  Malformed(String)\n} derive(Debug, Eq)\n\n///|\npub(all) enum CommandResult {\n  Ok(Table)\n  Err(TableError)\n} derive(Debug, Eq)\n",
  ),
  (
    "interface/tutuca/component/values/README.md", "Dynamic values crossing the boundary. WIT has no recursive types, so\nscalars travel inline and compounds are u64 handles into a host-side\narena, read/built through this interface. Handles are only valid for the\nduration of the current host->guest call: read handles go stale when the\ncall returns, and freshly built handles must be handed back to the host\n(in a return value or an import argument) within the same call.\n`instance` payloads are guest-instance handles (see `guest.instance`),\nused for nested same-bundle child components.",
  ),
  (
    "interface/tutuca/component/values/ffi.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\n#owned(str)\nextern \"wasm\" fn mbt_ffi_str2ptr(str : String) -> Int =\n  #|(func (param i32) (result i32) local.get 0)\n\n///|\nextern \"wasm\" fn mbt_ffi_free(position : Int) =\n  #|(func (param i32) local.get 0 call $moonbit.decref)\n\n///|\nextern \"wasm\" fn mbt_ffi_load32(offset : Int) -> Int =\n  #|(func (param i32) (result i32) local.get 0 i32.load)\n\n///|\nextern \"wasm\" fn mbt_ffi_load64(offset : Int) -> Int64 =\n  #|(func (param i32) (result i64) local.get 0 i64.load)\n\n///|\nextern \"wasm\" fn mbt_ffi_load8_u(offset : Int) -> Int =\n  #|(func (param i32) (result i32) local.get 0 i32.load8_u)\n\n///|\nextern \"wasm\" fn mbt_ffi_loadf64(offset : Int) -> Double =\n  #|(func (param i32) (result f64) local.get 0 f64.load)\n\n///|\nextern \"wasm\" fn mbt_ffi_malloc(size : Int) -> Int =\n  #|(func (param i32) (result i32) (local i32)\n  #| local.get 0 i32.const 4 i32.add call $moonbit.gc.malloc\n  #| local.tee 1 i32.const 0 call $moonbit.init_array8\n  #| local.get 1)\n\n///|\nextern \"wasm\" fn mbt_ffi_ptr2str(ptr : Int, len : Int) -> String =\n  #|(func (param i32) (param i32) (result i32)\n  #| local.get 0\n  #| local.get 1 call $moonbit.init_array16\n  #| local.get 0)\n\n///|\nfn wasmImportFromJson(p0 : Int, p1 : Int, p2 : Int) = \"tutuca:component/values@0.9.0\" \"from-json\"\n\n///|\nfn wasmImportListGet(p0 : Int64, p1 : Int, p2 : Int) = \"tutuca:component/values@0.9.0\" \"list-get\"\n\n///|\nfn wasmImportListLen(p0 : Int64) -> Int = \"tutuca:component/values@0.9.0\" \"list-len\"\n\n///|\nfn wasmImportListNew() -> Int64 = \"tutuca:component/values@0.9.0\" \"list-new\"\n\n///|\nfn wasmImportListPush(p0 : Int64, p1 : Int, p2 : Int64, p3 : Int) = \"tutuca:component/values@0.9.0\" \"list-push\"\n\n///|\nfn wasmImportMapGet(p0 : Int64, p1 : Int, p2 : Int, p3 : Int) = \"tutuca:component/values@0.9.0\" \"map-get\"\n\n///|\nfn wasmImportMapKeys(p0 : Int64, p1 : Int) = \"tutuca:component/values@0.9.0\" \"map-keys\"\n\n///|\nfn wasmImportMapLen(p0 : Int64) -> Int = \"tutuca:component/values@0.9.0\" \"map-len\"\n\n///|\nfn wasmImportMapNew() -> Int64 = \"tutuca:component/values@0.9.0\" \"map-new\"\n\n///|\nfn wasmImportMapSet(\n  p0 : Int64,\n  p1 : Int,\n  p2 : Int,\n  p3 : Int,\n  p4 : Int64,\n  p5 : Int,\n) = \"tutuca:component/values@0.9.0\" \"map-set\"\n\n///|\nfn wasmImportToJson(p0 : Int, p1 : Int64, p2 : Int, p3 : Int) = \"tutuca:component/values@0.9.0\" \"to-json\"\n",
