    "interface/tutuca/component/control/top.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\npub(all) enum LogLevel {\n  DEBUG\n  INFO\n  WARN\n  ERROR\n} derive(Debug, Eq)\n\n///|\npub fn LogLevel::ordinal(self : LogLevel) -> Int {\n  match self {\n    DEBUG => 0\n    INFO => 1\n    WARN => 2\n    ERROR => 3\n  }\n}\n\n///|\npub fn LogLevel::from(self : Int) -> LogLevel {\n  match self {\n    0 => DEBUG\n    1 => INFO\n    2 => WARN\n    3 => ERROR\n    _ => panic()\n  }\n}\n\n///|\n/// One hop of a path RELATIVE to the dispatching instance — the guest's\n/// half of `ctx.at`. Absolute paths are deliberately absent: a component\n/// addresses its own subtree, never the tree it happens to be mounted in.\npub(all) struct ItemStep {\n  field : String\n  key : String\n} derive(Debug, Eq)\n\n///|\npub(all) struct IndexStep {\n  field : String\n  index : UInt\n} derive(Debug, Eq)\n\n///|\npub(all) enum PathStep {\n  Field(String)\n  Item(ItemStep)\n  At(IndexStep)\n} derive(Debug, Eq)\n\n///|\n/// Response routing for a request (host `RequestOpts`). All three names are\n/// optional: with none of them the response arrives as\n/// handle-event(response, <request name>, [result, error]); with `on-ok` /\n/// `on-error` it arrives at those names carrying just the value; `on-res`\n/// renames the combined form.\npub(all) struct RequestOpts {\n  on_ok : String?\n  on_error : String?\n  on_res : String?\n  live_path : Bool\n} derive(Debug, Eq)\n\n///|\npub fn log(level : LogLevel, msg : String) -> Unit {\n  let ptr = mbt_ffi_str2ptr(msg)\n  wasmImportLog(level.ordinal(), ptr, msg.length())\n  mbt_ffi_free(ptr)\n}\n\n///|\n/// Bubble a message to the parent component in the host tree.\npub fn emit(name : String, args : Array[@values.Value]) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let ptr = mbt_ffi_str2ptr(name)\n\n  let address = mbt_ffi_malloc(args.length() * 16)\n  for index = 0; index < args.length(); index = index + 1 {\n    let iter_elem : @va