    "interface/tutuca/component/values/top.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\npub(all) enum Value {\n  Nil\n  Boolean(Bool)\n  Number(Double)\n  Text(String)\n  List(UInt64)\n  Map(UInt64)\n  Instance(UInt64)\n} derive(Debug, Eq)\n\n///|\n/// reads (any handle)\npub fn list_len(h : UInt64) -> UInt {\n  let result : Int = wasmImportListLen(h.reinterpret_as_int64())\n  let ret = result.reinterpret_as_uint()\n  return ret\n}\n\n///|\npub fn list_get(h : UInt64, index : UInt) -> Value {\n  let return_area = mbt_ffi_malloc(16)\n  wasmImportListGet(\n    h.reinterpret_as_int64(),\n    index.reinterpret_as_int(),\n    return_area,\n  )\n\n  let lifted = match mbt_ffi_load8_u(return_area + 0) {\n    0 => Value::Nil\n    1 => Value::Boolean(mbt_ffi_load8_u(return_area + 8) != 0)\n    2 => Value::Number(mbt_ffi_loadf64(return_area + 8))\n    3 => {\n      let result = mbt_ffi_ptr2str(\n        mbt_ffi_load32(return_area + 8),\n        mbt_ffi_load32(return_area + 12),\n      )\n\n      Value::Text(result)\n    }\n    4 => Value::List(mbt_ffi_load64(return_area + 8).reinterpret_as_uint64())\n    5 => Value::Map(mbt_ffi_load64(return_area + 8).reinterpret_as_uint64())\n    6 =>\n      Value::Instance(mbt_ffi_load64(return_area + 8).reinterpret_as_uint64())\n    _ => panic()\n  }\n  let ret = lifted\n  mbt_ffi_free(return_area)\n  return ret\n}\n\n///|\npub fn map_len(h : UInt64) -> UInt {\n  let result : Int = wasmImportMapLen(h.reinterpret_as_int64())\n  let ret = result.reinterpret_as_uint()\n  return ret\n}\n\n///|\npub fn map_keys(h : UInt64) -> Array[String] {\n  let return_area = mbt_ffi_malloc(8)\n  wasmImportMapKeys(h.reinterpret_as_int64(), return_area)\n\n  let array : Array[String] = []\n  for index = 0; index < mbt_ffi_load32(return_area + 4); index = index + 1 {\n    let iter_base = mbt_ffi_load32(return_area + 0) + index * 8\n\n    let result = mbt_ffi_ptr2str(\n      mbt_ffi_load32(iter_base + 0),\n      mbt_ffi_load32(iter_base + 4),\n    )\n\n    array.push(result)\n  }\n  mbt_ffi_free(mbt_ffi_load32(return_area + 0))\n  let ret = array\n  mbt_ffi_free(return_area)\n  return ret\n}\n\n///|\npub fn map_get(h : UInt64, key : String) -> Value? {\n  let ptr = mbt_ffi_str2ptr(key)\n  let return_area = mbt_ffi_malloc(24)\n  wasmImportMapGet(h.reinterpret_as_int64(), ptr, key.length(), return_area)\n\n  let lifted0 : Value? = match mbt_ffi_load8_u(return_area + 0) {\n    0 => Option::None\n    1 => {\n      let lifted = match mbt_ffi_load8_u(return_area + 8) {\n        0 => Value::Nil\n        1 => Value::Boolean(mbt_ffi_load8_u(return_area + 16) != 0)\n        2 => Value::Number(mbt_ffi_loadf64(return_area + 16))\n        3 => {\n          let result = mbt_ffi_ptr2str(\n            mbt_ffi_load32(return_area + 16),\n            mbt_ffi_load32(return_area + 20),\n          )\n\n          Value::Text(result)\n        }\n        4 =>\n          Value::List(mbt_ffi_load64(return_area + 16).reinterpret_as_uint64())\n        5 =>\n          Value::Map(mbt_ffi_load64(return_area + 16).reinterpret_as_uint64())\n        6 =>\n          Value::Instance(\n            mbt_ffi_load64(return_area + 16).reinterpret_as_uint64(),\n          )\n        _ => panic()\n      }\n\n      Option::Some(lifted)\n    }\n    _ => panic()\n  }\n  let ret = lifted0\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(return_area)\n  return ret\n}\n\n///|\n/// construction (fresh handles)\npub fn list_new() -> UInt64 {\n  let result : Int64 = wasmImportListNew()\n  let ret = result.reinterpret_as_uint64()\n  return ret\n}\n\n///|\npub fn list_push(h : UInt64, v : Value) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let (lowered, lowered6, lowered7) = match v {\n    Nil => (0, 0L, 0)\n    Boolean(payload0) => (1, Int::to_int64(if payload0 { 1 } else { 0 }), 0)\n    Number(payload1) => (2, payload1.reinterpret_as_int64(), 0)\n    Text(payload2) => {\n      let ptr = mbt_ffi_str2ptr(payload2)\n      cleanup_list.push(ptr)\n\n      (3, Int::to_int64(ptr), payload2.length())\n    }\n    List(payload3) => (4, payload3.reinterpret_as_int64(), 0)\n    Map(payload4) => (5, payload4.reinterpret_as_int64(), 0)\n    Instance(payload5) => (6, payload5.reinterpret_as_int64(), 0)\n  }\n  wasmImportListPush(h.reinterpret_as_int64(), lowered, lowered6, lowered7)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\npub fn map_new() -> UInt64 {\n  let result : Int64 = wasmImportMapNew()\n  let ret = result.reinterpret_as_uint64()\n  return ret\n}\n\n///|\npub fn map_set(h : UInt64, key : String, v : Value) -> Unit {\n  let cleanup_list : Array[Int] = []\n\n  let ptr = mbt_ffi_str2ptr(key)\n\n  let (lowered, lowered7, lowered8) = match v {\n    Nil => (0, 0L, 0)\n    Boolean(payload0) => (1, Int::to_int64(if payload0 { 1 } else { 0 }), 0)\n    Number(payload1) => (2, payload1.reinterpret_as_int64(), 0)\n    Text(payload2) => {\n      let ptr3 = mbt_ffi_str2ptr(payload2)\n      cleanup_list.push(ptr3)\n\n      (3, Int::to_int64(ptr3), payload2.length())\n    }\n    List(payload4) => (4, payload4.reinterpret_as_int64(), 0)\n    Map(payload5) => (5, payload5.reinterpret_as_int64(), 0)\n    Instance(payload6) => (6, payload6.reinterpret_as_int64(), 0)\n  }\n  wasmImportMapSet(\n    h.reinterpret_as_int64(),\n    ptr,\n    key.length(),\n    lowered,\n    lowered7,\n    lowered8,\n  )\n  mbt_ffi_free(ptr)\n\n  cleanup_list.each(mbt_ffi_free)\n}\n\n///|\n/// escape hatch for JSON-native guests; `instance` values serialize as null\npub fn to_json(v : Value) -> String {\n  let cleanup_list : Array[Int] = []\n\n  let (lowered, lowered6, lowered7) = match v {\n    Nil => (0, 0L, 0)\n    Boolean(payload0) => (1, Int::to_int64(if payload0 { 1 } else { 0 }), 0)\n    Number(payload1) => (2, payload1.reinterpret_as_int64(), 0)\n    Text(payload2) => {\n      let ptr = mbt_ffi_str2ptr(payload2)\n      cleanup_list.push(ptr)\n\n      (3, Int::to_int64(ptr), payload2.length())\n    }\n    List(payload3) => (4, payload3.reinterpret_as_int64(), 0)\n    Map(payload4) => (5, payload4.reinterpret_as_int64(), 0)\n    Instance(payload5) => (6, payload5.reinterpret_as_int64(), 0)\n  }\n  let return_area = mbt_ffi_malloc(8)\n  wasmImportToJson(lowered, lowered6, lowered7, return_area)\n\n  let result = mbt_ffi_ptr2str(\n    mbt_ffi_load32(return_area + 0),\n    mbt_ffi_load32(return_area + 4),\n  )\n  let ret = result\n  mbt_ffi_free(return_area)\n\n  cleanup_list.each(mbt_ffi_free)\n  return ret\n}\n\n///|\npub fn from_json(json : String) -> Value {\n  let ptr = mbt_ffi_str2ptr(json)\n  let return_area = mbt_ffi_malloc(16)\n  wasmImportFromJson(ptr, json.length(), return_area)\n\n  let lifted = match mbt_ffi_load8_u(return_area + 0) {\n    0 => Value::Nil\n    1 => Value::Boolean(mbt_ffi_load8_u(return_area + 8) != 0)\n    2 => Value::Number(mbt_ffi_loadf64(return_area + 8))\n    3 => {\n      let result = mbt_ffi_ptr2str(\n        mbt_ffi_load32(return_area + 8),\n        mbt_ffi_load32(return_area + 12),\n      )\n\n      Value::Text(result)\n    }\n    4 => Value::List(mbt_ffi_load64(return_area + 8).reinterpret_as_uint64())\n    5 => Value::Map(mbt_ffi_load64(return_area + 8).reinterpret_as_uint64())\n    6 =>\n      Value::Instance(mbt_ffi_load64(return_area + 8).reinterpret_as_uint64())\n    _ => panic()\n  }\n  let ret = lifted\n  mbt_ffi_free(ptr)\n  mbt_ffi_free(return_area)\n  return ret\n}\n",
