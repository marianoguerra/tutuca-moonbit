    "gen/interface/tutuca/component/guest/{{name_ident}}.mbt", "///| HANDWRITTEN — the one file you write.\n///\n/// Everything around it is generated: `top.mbt` and `ffi.mbt` are wit-bindgen\n/// output for `tutuca:component@0.9.0`, and `sdk.mbt` implements every one of\n/// their `declare`s over the `DynComponent` trait below. You write a struct per\n/// component and one `dyn_module()` saying how to construct it. Its schema,\n/// docs and view live in `manifest.json` and `views/` as ordinary data.\n///\n/// The host is the framework. Your views are DATA — tutuca template strings the\n/// host compiles and renders; you never touch the DOM. Your state is opaque —\n/// the host reads a field at a time through `get_field` while rendering, and a\n/// handler takes self and returns the NEXT self. That is tutuca's copy-on-write\n/// model, and it is why nothing here mutates.\n\n///|\n/// One component. Fields are ordinary MoonBit; only `get_field` decides what\n/// the host may see; `manifest.json` declares their shape.\npriv struct {{Name}} {\n  count : Double\n  label : String\n}\n\n///|\n/// Read a declared field. Called lazily, once per `.name` a rendering view\n/// reaches for — so it runs often, and cheap is the right default.\nimpl DynComponent for {{Name}} with fn get_field(self, name) {\n  match name {\n    \"count\" => Some(@values.Value::Number(self.count))\n    \"label\" => Some(@values.Value::Text(self.label))\n    _ => None\n  }\n}\n\n///|\n/// Handle a message. `self` in, and one of: Changed(next), Unchanged (this is\n/// our name but state stayed put), or Unhandled (the host may try a generated\n/// field mutator).\n///\n/// The two buckets, and one question separates them: does the sender know who\n/// handles this? RECEIVE is an ADDRESSED message — what this component's own\n/// views raise (`@on.click`), what a parent sends it, and every answer it\n/// reads. INTENT is a ROUTED one, offered to each hop of a route until\n/// something replies.\nimpl DynComponent for {{Name}} with fn handle(self, bucket, name, args) {\n  match (bucket, name) {\n    (RECEIVE, \"inc\") =>\n      Changed({ ..self, count: self.count + 1.0 } as &DynComponent)\n    (RECEIVE, \"dec\") =>\n      Changed({ ..self, count: self.count - 1.0 } as &DynComponent)\n    (RECEIVE, \"set\") =>\n      match args {\n        [@values.Value::Number(n), ..] =>\n          Changed({ ..self, count: n } as &DynComponent)\n        _ => Unchanged\n      }\n    // Tell whoever holds this component what the count is now. It walks the\n    // `dyn` leg — the parent, then ITS parent — and the first hop that replies\n    // ends the walk. This component does not know, and must not know, who\n    // answers.\n    (RECEIVE, \"announce\") => {\n      @control.intent(\"counted\", [@values.Value::Number(self.count)], {\n        route: [DYN],\n        on_ok: None,\n        on_error: None,\n        on_unhandled: None,\n        live_path: false,\n      })\n      Unchanged\n    }\n    _ => Unhandled\n  }\n}\n\n///|\n/// Answer a `$name` call from a view. Pure: it computes, it does not change.\nimpl DynComponent for {{Name}} with fn call_method(self, name, _args) {\n  match name {\n    \"caption\" => @values.Value::Text(\"\\{self.label}: \\{self.count}\")\n    _ => @values.Value::Nil\n  }\n}\n\n///|\n/// Write one declared field. The host uses this for the mutators your fields\n/// imply and for the config form, so a component that declares fields wants it\n/// — otherwise every edit has to go through a handler you wrote by hand.\nimpl DynComponent for {{Name}} with fn with_field(self, name, v) {\n  match (name, v) {\n    (\"count\", @values.Value::Number(n)) =>\n      Some({ ..self, count: n } as &DynComponent)\n    (\"label\", @values.Value::Text(t)) =>\n      Some({ ..self, label: t } as &DynComponent)\n    _ => None\n  }\n}\n\n///|\n/// Build one. `args` are the declared fields the caller supplied — from a\n/// generated form, from a named init, or handed back on a hot-swap migration.\nfn make_{{name_ident}}(args : Array[(String, @values.Value)]) -> &DynComponent {\n  let mut count = 0.0\n  let mut label = \"{{Name}}\"\n  for arg in args {\n    match arg {\n      (\"count\", @values.Value::Number(n)) => count = n\n      (\"label\", @values.Value::Text(t)) => label = t\n      _ => ()\n    }\n  }\n  let c : {{Name}} = { count, label }\n  c as &DynComponent\n}\n\n///|\n/// The runtime half of the bundle: every component name and its factory.\nfn dyn_module() -> DynModule {\n  module_def([dyn_comp(\"{{Name}}\", make_{{name_ident}})])\n}\n",
