  ("moon.mod", "name = \"tutuca/component\"\n\npreferred_target = \"wasm\"\n"),
  (
    "pack.mjs", "#!/usr/bin/env node\n// Pack this guest's jco-transpiled output (dist/js) into a SINGLE\n// self-contained `.tutuca.tar.gz` — a gzipped ustar tar a universal host\n// unpacks in the browser with the native DecompressionStream and a tiny tar\n// reader. That is the whole distribution format: one file, dropped on a page.\n//\n// Only runtime files go in — the ESM entry (*.component.js) and its core\n// modules (*.wasm). Type files (*.d.ts, interfaces/) are dropped: nothing at\n// runtime reads them, and they are a third of the archive.\n//\n// No dependency: Node's zlib gzips a tar built by hand here, because Node has\n// no tar writer. Regular files only, stored by basename.\n//\n//   node pack.mjs                     # dist/js -> <name>.tutuca.tar.gz\n//   node pack.mjs <srcDir> <outFile>\nimport { gzipSync } from \"node:zlib\";\nimport { mkdirSync, readdirSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, resolve } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst name = JSON.parse(readFileSync(join(here, \"package.json\"), \"utf8\")).name;\nconst srcDir = resolve(here, process.argv[2] ?? \"dist/js\");\nconst outFile = resolve(here, process.argv[3] ?? `${name}.tutuca.tar.gz`);\n\n// A 512-byte ustar header for a regular file. Octal numeric fields, checksum\n// computed with the checksum field spaced out (POSIX rule). mtime pinned to 0\n// so the archive is byte-for-byte reproducible.\nfunction tarHeader(name, size) {\n  const h = Buffer.alloc(512);\n  h.write(name, 0, 100, \"utf8\");\n  const octal = (n, len) => n.toString(8).padStart(len - 1, \"0\") + \"\\0\";\n  h.write(octal(0o644, 8), 100); // mode\n  h.write(octal(0, 8), 108); // uid\n  h.write(octal(0, 8), 116); // gid\n  h.write(size.toString(8).padStart(11, \"0\") + \"\\0\", 124); // size\n  h.write(octal(0, 12), 136); // mtime\n  h.write(\"        \", 148); // checksum placeholder = 8 spaces\n  h.write(\"0\", 156); // typeflag: regular file\n  h.write(\"ustar\\0\", 257);\n  h.write(\"00\", 263); // version\n  let sum = 0;\n  for (const b of h) sum += b;\n  h.write(sum.toString(8).padStart(6, \"0\") + \"\\0 \", 148); // real checksum\n  return h;\n}\n\nfunction buildTar(files) {\n  const chunks = [];\n  for (const { name, data } of files) {\n    chunks.push(tarHeader(name, data.length));\n    chunks.push(data);\n    const pad = (512 - (data.length % 512)) % 512;\n    if (pad) chunks.push(Buffer.alloc(pad));\n  }\n  chunks.push(Buffer.alloc(1024)); // two zero blocks = end of archive\n  return Buffer.concat(chunks);\n}\n\nconst names = readdirSync(srcDir).filter(\n  (n) => n.endsWith(\".component.js\") || n.endsWith(\".wasm\"),\n);\nif (!names.some((n) => n.endsWith(\".component.js\"))) {\n  console.error(`pack: no *.component.js in ${srcDir} — run \\`node build.mjs\\` first`);\n  process.exit(1);\n}\nconst files = names.map((n) => ({\n  name: basename(n),\n  data: readFileSync(join(srcDir, n)),\n}));\n\nmkdirSync(dirname(outFile), { recursive: true });\nwriteFileSync(outFile, gzipSync(buildTar(files), { level: 9 }));\nconsole.log(`packed ${files.length} files -> ${outFile}`);\nconsole.log(\"Drop it on a universal host page to load it.\");\n",
  ),
  (
    "package.json", "{\n  \"name\": \"{{name}}\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"description\": \"A tutuca:component guest — a WebAssembly component a running tutuca app can load.\",\n  \"scripts\": {\n    \"build\": \"node build.mjs\",\n    \"pack\": \"node pack.mjs\"\n  },\n  \"devDependencies\": {\n    \"@bytecodealliance/jco\": \"^1.25.2\"\n  }\n}\n",
  ),
  (
    "wit/tutuca-component.wit", "/// tutuca:component — dynamic WebAssembly tutuca components.\n///\n/// A guest implementing the `dynamic-component` world is a *logic module*: it\n/// declares its components (views as tutuca HTML template strings, the state\n/// schema, message buckets, styles) in a manifest, and implements the handlers\n/// on an opaque-state `instance` resource. The HOST is the framework: it\n/// compiles the views with anode (`Component::for_type`), renders them,\n/// delegates events at the root, and drives the whole lifecycle. Guest state\n/// never crosses the boundary — the host reads fields lazily (`get-field`)\n/// while rendering and swaps in the NEW instance a handler returns (self in,\n/// self out), which is exactly tutuca's COW model.\n///\n/// Opaque state and a DECLARED schema are not in tension: the schema says what\n/// fields exist and what they hold, the state itself stays inside the guest.\n/// That is the same split a host component has, and it is what lets everything\n/// generic over a schema — equality, the JSON projection, the inspector, the\n/// per-field mutators — work on a guest without the guest implementing any of\n/// it.\n///\n/// The world imports no WASI — only the interfaces below — so bundles run in\n/// the browser via `jco transpile --instantiation async` with host-supplied\n/// imports. That is not an accident of packaging: it is the sandbox. A guest\n/// has no filesystem, no network, no sockets, no environment, no subprocess,\n/// no clock and no entropy except what `env` grants it, and it never touches\n/// the DOM — its views are DATA the host compiles. See ../SECURITY.md for what\n/// that does and does not cover.\npackage tutuca:component@0.4.0;\n\n/// Dynamic values crossing the boundary. WIT has no recursive types, so\n/// scalars travel inline and compounds are u64 handles into a host-side\n/// arena, read/built through this interface. Handles are only valid for the\n/// duration of the current host->guest call: read handles go stale when the\n/// call returns, and freshly built handles must be handed back to the host\n/// (in a return value or an import argument) within the same call.\n/// `instance` payloads are guest-instance handles (see `guest.instance`),\n/// used for nested same-bundle child components.\ninterface values {\n  variant value {\n    nil,\n    boolean(bool),\n    number(f64),\n    text(string),\n    %list(u64),\n    %map(u64),\n    %instance(u64),\n  }\n\n  // reads (any handle)\n  list-len: func(h: u64) -> u32;\n  list-get: func(h: u64, index: u32) -> value;\n  map-len: func(h: u64) -> u32;\n  map-keys: func(h: u64) -> list<string>;\n  map-get: func(h: u64, key: string) -> option<value>;\n\n  // construction (fresh handles)\n  list-new: func() -> u64;\n  list-push: func(h: u64, v: value);\n  map-new: func() -> u64;\n  map-set: func(h: u64, key: string, v: value);\n\n  // escape hatch for JSON-native guests; `instance` values serialize as null\n  to-json: func(v: value) -> string;\n  from-json: func(json: string) -> value;\n}\n\n/// The three ambient facts a component cannot compute for itself: what time it\n/// is, an unpredictable number, and a fresh name. Each one is a CAPABILITY the\n/// manifest requests and the host grants (`capability-req`); an ungranted call\n/// traps rather than returning a plausible lie.\n///\n/// Deliberately NOT `wasi:clocks` + `wasi:random`. Three reasons, in order:\n/// the world imports no WASI and adding it drags preview2 shims into the\n/// browser; a real monotonic clock is the primitive a timing side channel is\n/// built from, and the coarsened one below is not; and an ambient clock makes\n/// a dispatch unreplayable, which contradicts \"the host is the framework\".\ninterface env {\n  /// Milliseconds since the Unix epoch, coarsened by the host and FROZEN for\n  /// the duration of one dispatch: every call inside one `handle-event`\n  /// returns the same instant. That is what lets a session replay, and what\n  /// denies a guest the fine-grained timer a side channel needs. Requires\n  /// `cap-clock`.\n  now-ms: func() -> u64;\n\n  /// Minutes to add to UTC for the user's local time, and the host's locale.\n  /// The host-context a widget would otherwise read off the DOM, handed over\n  /// as data. Requires `cap-clock`.\n  tz-offset-min: func() -> s32;\n  locale: func() -> string;\n\n  /// From a PRNG the HOST seeds per instance and records, so a session\n  /// replays. NOT cryptographic: a guest that needs unpredictability an\n  /// attacker cannot reproduce asks the host through `control.request`.\n  /// Requires `cap-random`.\n  random-u64: func() -> u64;\n\n  /// A fresh identifier, unique within this bundle for this session.\n  /// Monotonic, not a UUID — it is for keying a list, not for naming a thing\n  /// outside the page. Requires `cap-random`.\n  new-id: func() -> string;\n}\n\n/// Framework services available to a running handler. Calls are buffered by\n/// the host and applied through the dispatching handler's context when\n/// `handle-event` returns (tutuca ctx.bubble / ctx.send / ctx.request).\n/// `log` is immediate and always legal.\ninterface control {\n  use values.{value};\n\n  enum log-level { debug, info, warn, error }\n\n  log: func(level: log-level, msg: string);\n\n  /// One hop of a path RELATIVE to the dispatching instance — the guest's\n  /// half of `ctx.at`. Absolute paths are deliberately absent: a component\n  /// addresses its own subtree, never the tree it happens to be mounted in.\n  record item-step { field: string, key: string }\n  record index-step { field: string, index: u32 }\n  variant path-step {\n    /// `.name`\n    field(string),\n    /// `.name[key]` — a keyed element of a map / ordered-map field\n    item(item-step),\n    /// `.name[i]` — an element of a list field\n    at(index-step),\n  }\n\n  /// Response routing for a request (host `RequestOpts`). All three names are\n  /// optional: with none of them the response arrives as\n  /// handle-event(response, <request name>, [result, error]); with `on-ok` /\n  /// `on-error` it arrives at those names carrying just the value; `on-res`\n  /// renames the combined form.\n  record request-opts {\n    on-ok: option<string>,\n    on-error: option<string>,\n    on-res: option<string>,\n    /// Resolve the responding component by its path as it is WHEN THE RESPONSE\n    /// ARRIVES rather than pinning the keys at request time (host `live_path`).\n    live-path: bool,\n  }\n\n  /// Bubble a message to the parent component in the host tree.\n  emit: func(name: string, args: list<value>);\n\n  /// Send a message to self: arrives as a later handle-event(receive, name, ...).\n  send: func(name: string, args: list<value>);\n\n  /// Send to a component in this one's own subtree (`ctx.send-at-path`): the\n  /// message arrives as handle-event(receive, ...) at `path`, e.g.\n  /// `[field(\"left\")]` for the child a `left` field holds.\n  send-at: func(path: list<path-step>, name: string, args: list<value>);\n\n  /// Raise a bubble AT a descendant, which then travels up through it — the\n  /// targeted twin of `emit`.\n  bubble-at: func(path: list<path-step>, name: string, args: list<value>);\n\n  /// Stop the message being handled from travelling any further up the tree\n  /// (host `ctx.stop-propagation`). Only meaningful while handling a bubble.\n  stop-propagation: func();\n\n  /// Fire a request handler — one this bundle serves (see\n  /// `component-def.requests`) or, failing that, one the HOST registered. The\n  /// response arrives as a later handle-event(response, ...), routed by `opts`.\n  ///\n  /// A bundle's OWN handlers run inside the guest, so they inherit the guest's\n  /// (absent) authority and need no policy. Reaching a HOST handler is the one\n  /// place a guest asks for something it cannot do itself, so the host decides\n  /// — by the requester's path, at the moment of the call, not by anything the\n  /// manifest claimed