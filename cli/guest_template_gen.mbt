  (
    "manifest.json", "{\n  \"manifestVersion\": 1,\n  \"apiVersion\": 8,\n  \"moduleName\": \"{{name}}\",\n  \"doc\": \"A tutuca:component bundle.\",\n  \"version\": \"0.1.0\",\n  \"homepage\": \"\",\n  \"authors\": [],\n  \"capabilities\": [],\n  \"stringEncoding\": \"utf16\",\n  \"components\": [\n    {\n      \"name\": \"{{Name}}\",\n      \"doc\": \"A number with a label, and buttons that raise and lower it.\",\n      \"keywords\": [\"counter\", \"number\", \"{{name}}\"],\n      \"category\": \"input\",\n      \"messageDocs\": [\n        { \"name\": \"inc\", \"doc\": \"Add one.\" },\n        { \"name\": \"dec\", \"doc\": \"Subtract one.\" },\n        { \"name\": \"set\", \"doc\": \"Set the count outright.\" },\n        { \"name\": \"announce\", \"doc\": \"Tell the parent what the count is now.\" },\n        { \"name\": \"caption\", \"doc\": \"The label and count as one sentence.\" }\n      ],\n      \"views\": [{ \"name\": \"main\", \"src\": \"views/{{Name}}.main.html\" }],\n      \"types\": [\n        { \"kind\": \"ty-float\", \"elem\": null, \"items\": [], \"name\": \"\", \"members\": [] },\n        { \"kind\": \"ty-text\", \"elem\": null, \"items\": [], \"name\": \"\", \"members\": [] }\n      ],\n      \"fields\": [\n        { \"name\": \"count\", \"ty\": 0, \"doc\": \"How many.\", \"required\": false, \"constraint\": null },\n        { \"name\": \"label\", \"ty\": 1, \"doc\": \"What to call it.\", \"required\": false, \"constraint\": null }\n      ],\n      \"receives\": [\"set\"],\n      \"intents\": [\"counted\"],\n      \"methods\": [\"caption\"],\n      \"whens\": [],\n      \"serves\": [],\n      \"inits\": [],\n      \"style\": \"\"\n    }\n  ]\n}\n",
  ),
  ("moon.mod", "name = \"tutuca/component\"\n\npreferred_target = \"wasm\"\n"),
  (
    "pack.mjs", "#!/usr/bin/env node\n// Pack this guest's core wasm plus static declaration into a SINGLE\n// self-contained `.tutuca.tar.gz` — a gzipped ustar tar a universal host\n// unpacks in the browser with the native DecompressionStream and a tiny tar\n// reader. That is the whole distribution format: one file, dropped on a page.\n//\n// It contains no executable JavaScript: `tutuca.json`, one core wasm, and the\n// HTML views are enough because the host owns the canonical ABI.\n//\n// No dependency: Node's zlib gzips a tar built by hand here, because Node has\n// no tar writer. Regular files only, stored by basename.\n//\n//   node pack.mjs                     # dist/js -> <name>.tutuca.tar.gz\n//   node pack.mjs <srcDir> <outFile>\nimport { gzipSync } from \"node:zlib\";\nimport { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, resolve } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst name = JSON.parse(readFileSync(join(here, \"package.json\"), \"utf8\")).name;\nconst srcDir = resolve(here, process.argv[2] ?? \"dist/js\");\nconst outFile = resolve(here, process.argv[3] ?? `${name}.tutuca.tar.gz`);\n\n// A 512-byte ustar header for a regular file. Octal numeric fields, checksum\n// computed with the checksum field spaced out (POSIX rule). mtime pinned to 0\n// so the archive is byte-for-byte reproducible.\nfunction tarHeader(name, size) {\n  const h = Buffer.alloc(512);\n  h.write(name, 0, 100, \"utf8\");\n  const octal = (n, len) => n.toString(8).padStart(len - 1, \"0\") + \"\\0\";\n  h.write(octal(0o644, 8), 100); // mode\n  h.write(octal(0, 8), 108); // uid\n  h.write(octal(0, 8), 116); // gid\n  h.write(size.toString(8).padStart(11, \"0\") + \"\\0\", 124); // size\n  h.write(octal(0, 12), 136); // mtime\n  h.write(\"        \", 148); // checksum placeholder = 8 spaces\n  h.write(\"0\", 156); // typeflag: regular file\n  h.write(\"ustar\\0\", 257);\n  h.write(\"00\", 263); // version\n  let sum = 0;\n  for (const b of h) sum += b;\n  h.write(sum.toString(8).padStart(6, \"0\") + \"\\0 \", 148); // real checksum\n  return h;\n}\n\nfunction buildTar(files) {\n  const chunks = [];\n  for (const { name, data } of files) {\n    chunks.push(tarHeader(name, data.length));\n    chunks.push(data);\n    const pad = (512 - (data.length % 512)) % 512;\n    if (pad) chunks.push(Buffer.alloc(pad));\n  }\n  chunks.push(Buffer.alloc(1024)); // two zero blocks = end of archive\n  return Buffer.concat(chunks);\n}\n\nconst names = readdirSync(srcDir);\nconst core = names.find((n) => n.endsWith(\".component.core.wasm\"));\nif (!core) {\n  console.error(`pack: no *.component.core.wasm in ${srcDir} — run \\`node build.mjs\\` first`);\n  process.exit(1);\n}\nconst manifestPath = join(here, \"manifest.json\");\nif (!existsSync(manifestPath)) {\n  console.error(\"pack: manifest.json is missing\");\n  process.exit(1);\n}\nconst manifest = JSON.parse(readFileSync(manifestPath, \"utf8\"));\nconst descriptor = {\n  world: \"tutuca:component@0.9.0\",\n  encoding: manifest.stringEncoding ?? \"utf16\",\n  core,\n  manifest,\n};\nconst files = [\n  { name: \"tutuca.json\", data: Buffer.from(JSON.stringify(descriptor)) },\n  { name: core, data: readFileSync(join(srcDir, core)) },\n];\nfor (const component of manifest.components ?? []) {\n  for (const view of component.views ?? []) {\n    const name = basename(view.src ?? \"\");\n    const path = join(here, \"views\", name);\n    if (!name || !existsSync(path)) {\n      console.error(`pack: missing view ${view.src ?? \"<unnamed>\"}`);\n      process.exit(1);\n    }\n    if (!files.some((f) => f.name === name)) {\n      files.push({ name, data: readFileSync(path) });\n    }\n  }\n}\n\nmkdirSync(dirname(outFile), { recursive: true });\nwriteFileSync(outFile, gzipSync(buildTar(files), { level: 9 }));\nconsole.log(`packed ${files.length} files -> ${outFile}`);\nconsole.log(\"Drop it on a universal host page to load it.\");\n",
  ),
  (
    "package.json", "{\n  \"name\": \"{{name}}\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"description\": \"A tutuca:component guest — a WebAssembly component a running tutuca app can load.\",\n  \"scripts\": {\n    \"build\": \"node build.mjs\",\n    \"pack\": \"node pack.mjs\"\n  },\n  \"devDependencies\": {\n    \"@bytecodealliance/jco\": \"^1.26.1\"\n  }\n}\n",
  ),
  (
    "views/{{Name}}.main.html", "<div class=\"card bg-base-100 border border-base-300 shadow-sm\">\n  <div class=\"card-body gap-2 items-center p-4\">\n    <span class=\"text-sm opacity-70\" @text=\"$caption\"></span>\n    <div class=\"join\">\n      <button class=\"btn btn-sm join-item\" @on.click=\"dec\">−</button>\n      <span class=\"btn btn-sm join-item no-animation pointer-events-none\" @text=\".count\"></span>\n      <button class=\"btn btn-sm join-item\" @on.click=\"inc\">+</button>\n    </div>\n    <button class=\"btn btn-xs btn-ghost\" @on.click=\"announce\">announce</button>\n  </div>\n</div>\n",
  ),
  (
    "wit/tutuca-component.wit", "/// tutuca:component — dynamic WebAssembly tutuca components.\n///\n/// A guest implementing the `dynamic-component` world is a *logic module*.\n/// The bundle declares views, schemas, message buckets and styles as static\n/// files; the wasm implements behavior over an opaque-state `instance`\n/// resource. The HOST is the framework: it\n/// compiles the views with anode (`Component::for_type`), renders them,\n/// delegates events at the root, and drives the whole lifecycle. Guest state\n/// never crosses the boundary — the host reads fields lazily (`get-field`)\n/// while rendering and swaps in the NEW instance a handler returns (self in,\n/// self out), which is exactly tutuca's COW model.\n///\n/// Opaque state and a static declared schema are not in tension: the schema says what\n/// fields exist and what they hold, the state itself stays inside the guest.\n/// That is the same split a host component has, and it is what lets everything\n/// generic over a schema — equality, the JSON projection, the inspector, the\n/// per-field mutators — work on a guest without the guest implementing any of\n/// it.\n///\n/// The world imports no WASI — only the interfaces below — and the browser\n/// host supplies them. That is not an accident of packaging: it is the sandbox. A guest\n/// has no filesystem, no network, no sockets, no environment, no subprocess,\n/// no clock and no entropy except what `env` grants it, and it never touches\n/// the DOM — its views are DATA the host compiles. See ../SECURITY.md for what\n/// that does and does not cover.\npackage tutuca:component@0.9.0;\n\n/// Dynamic values crossing the boundary. WIT has no recursive types, so\n/// scalars travel inline and compounds are u64 handles into a host-side\n/// arena, read/built through this interface. Handles are only valid for the\n/// duration of the current host->guest call: read handles go stale when the\n/// call returns, and freshly built handles must be handed back to the host\n/// (in a return value or an import argument) within the same call.\n/// `instance` payloads are guest-instance handles (see `guest.instance`),\n/// used for nested same-bundle child components.\ninterface values {\n  variant value {\n    nil,\n    boolean(bool),\n    number(f64),\n    text(string),\n    %list(u64),\n    %map(u64),\n    %instance(u64),\n  }\n\n  // reads (any handle)\n  list-len: func(h: u64) -> u32;\n  list-get: func(h: u64, index: u32) -> value;\n  map-len: func(h: u64) -> u32;\n  map-keys: func(h: u64) -> list<string>;\n  map-get: func(h: u64, key: string) -> option<value>;\n\n  // construction (fresh handles)\n  list-new: func() -> u64;\n  list-push: func(h: u64, v: value);\n  map-new: func() -> u64;\n  map-set: func(h: u64, key: string, v: value);\n\n  // escape hatch for JSON-native guests; `instance` values serialize as null\n  to-json: func(v: value) -> string;\n  from-json: func(json: string) -> value;\n}\n\n/// Tabular data as a set of typed COLUMNS of equal width. Columns rather than\n/// rows because every operation a table is actually asked for — sort, filter,\n/// aggregate, retype, add a column — touches one column across every row, and\n/// because a column is the only place a type can be stated once instead of\n/// once per cell.\n///\n/// This interface declares NO functions, which is the whole of its cost: it\n/// exists so every guest is generated the SAME table types rather than\n/// inventing its own. Values still travel as `values.value` trees; these types\n/// are what both ends encode to and decode from, and the host's JSON Schema\n/// projection of `ty-table` is what an agent generates against.\ninterface tables {\n  /// What a column holds — the four things JSON has, and no more. There is no\n  /// date, no decimal and no nested value, because each of those is a\n  /// representation argument this contract cannot settle on its callers'\n  /// behalf; each is a `str` with a documented spelling until it earns an arm.\n  ///\n  /// `i32` and not `i64`: a table is JSON at every hop between here and the\n  /// page — `values.value` carries `number(f64)`, and the host's own runtime\n  /// value has one number type — so past 2^53 an integer stops being itself.\n  /// A 64-bit id is a `str`.\n  enum col-type { i32, %f64, str, %bool }\n\n  /// A column's values, all of one type. The ARM is the type: a column cannot\n  /// claim `i32` and hold strings, so the invariant is unrepresentable rather\n  /// than merely checked. The JSON spelling splits the two back apart into\n  /// `\"type\"` beside `\"values\"`, because that is the form a generator writes\n  /// and a schema can discriminate on — this is the form that cannot be wrong.\n  variant col-values {\n    i32s(list<s32>),\n    f64s(list<f64>),\n    strs(list<string>),\n    bools(list<bool>),\n  }\n\n  record column {\n    /// Unique within the table and STABLE. Every command addresses a column by\n    /// id, never by position, so a reorder does not invalidate a command\n    /// already in flight.\n    id: string,\n    /// What a header shows. Free text, not unique, not an identifier.\n    label: string,\n    values: col-values,\n    /// The row indices whose value is MISSING — ascending, no duplicates.\n    /// Empty is the common case and costs nothing, which is why this is a\n    /// sparse index list rather than a validity mask: a mask would cost\n    /// row-count entries per column on every crossing even when nothing is\n    /// missing.\n    ///\n    /// The entry in `values` at a listed index is present but MEANINGLESS, so\n    /// a reader consults this list first. In JSON this is spelled inline as\n    /// `null` instead — what a generator writes without being told, and the\n    /// one asymmetry between the two encodings.\n    nulls: list<u32>,\n  }\n\n  /// Columns of EQUAL width — the invariant this record exists to carry.\n  record table {\n    columns: list<column>,\n    /// The width every column has. Redundant with the payload lengths and so\n    /// CHECKED rather than trusted: it is what distinguishes \"three columns,\n    /// no rows yet\" from a table whose columns disagree. Absent from the JSON\n    /// spelling, where it is derived — a generator would get it wrong, and a\n    /// count that disagrees with the data is worse than no count.\n    row-count: u32,\n  }\n\n  /// A column's identity WITHOUT its data — the header half of a row.\n  record field-ref { id: string, label: string, ty: col-type }\n\n  /// One value. `blank` is how a lone cell says what a column says with\n  /// `nulls`: there is no column here to carry a list.\n  variant cell { i32(s32), %f64(f64), str(string), %bool(bool), blank }\n\n  /// One row, self-describing: `fields` and `cells` are parallel and the same\n  /// length. `index` is the row's position in the table it came from.\n  record row { fields: list<field-ref>, cells: list<cell>, index: u32 }\n\n  /// Many rows sharing one header, for when repeating `fields` per row would\n  /// be the larger half of the payload.\n  record row-set { fields: list<field-ref>, rows: list<list<cell>>, offset: u32 }\n\n  // ── Commands: intents that CHANGE the table. A command answers with no\n  //    data, and that is the whole of the split — it is what lets a query be\n  //    served from a snapshot, and what makes a command replayable.\n\n  record set-cell { column: string, row: u32, value: cell }\n  record insert-rows { at: u32, rows: list<list<cell>> }\n  record add-column { at: u32, column: column }\n  record rename-column { column: string, label: string }\n  record move-column { column: string, to: u32 }\n  /// Values that do not convert become missing rather than wrong.\n  record retype-column { column: string, ty: col-type }\n  record sort-by { column: string, descending: bool }\n\n  variant command {\n    /// Replace the table wholesale.\n    load(table),\n    /// Every column kept, every row dropped: row-count becomes 0.\n    clear,\n    set-cell(set-cell),\n    /// Each inner list is one row in COLUMN ORDER, as long as `columns`.\n    append-rows(list<list<cell>>),\n    insert-rows(insert-rows),\n    /// Ascending, no duplicates, and as of BEFORE the command — so a caller\n    /// composing one does not have to re-derive indices as it goes.\n    delete-rows(list<u32>),\n    add-column(add-column),\n    drop-column(string),\n    rename-column(rename-column),\n    move-column(move-column),\n    retype-column(retype-column),\n    sort-by(sort-by),\n  }\n\n  // ── Queries: OBSERVATIONS. A query never changes the table.\n\n  record cell-ref { column: string, row: u32 }\n  /// `columns` empty means every column.\n  record page { offset: u32, limit: u32, columns: list<string> }\n  enum agg-op { count, sum, min, max, mean, distinct-count }\n  record aggregate { column: string, op: agg-op }\n\n  /// Dimensions and headers with no values — what a renderer needs before it\n  /// decides whether to ask for any data at all.\n  record shape { row-count: u32, fields: list<field-ref> }\n\n  variant query {\n    shape,\n    cell(cell-ref),\n    row(u32),\n    column(string),\n    page(page),\n    aggregate(aggregate),\n    distinct(string),\n  }\n\n  variant query-result {\n    shape(shape),\n    cell(cell),\n    row(row),\n    column(column),\n    page(row-set),\n    number(f64),\n    values(col-values),\n  }\n\n  // ── Failure. A variant rather than a `result`: an outcome this contract\n  //    NAMES is one both ends can match on, and one an agent can be told how\n  //    to correct.\n\n  record type-mismatch { column: string, expected: col-type, got: col-type }\n  record width-mismatch { expected: u32, got: u32 }\n\n  variant table-error {\n    no-such-column(string),\n    duplicate-column-id(string),\n    row-out-of-range(u32),\n    type-mismatch(type-mismatch),\n    width-mismatch(width-mismatch),\n    /// A sort or an aggregate asked of a column whose type has no order.\n    not-comparable(string),\n    /// The JSON did not decode. Carries what was wrong with it, because the\n    /// thing that wrote it may be able to write it again.\n    malformed(string),\n  }\n\n  variant command-result { ok(table), err(table-error) }\n}\n\n/// The three ambient facts a component cannot compute for itself: what time it\n/// is, an unpredictable number, and a fresh name. Each one is a CAPABILITY the\n/// static manifest requests and the host grants; an ungranted call\n/// traps rather than returning a plausible lie.\n///\n/// Deliberately NOT `wasi:clocks` + `wasi:random`. Three reasons, in order:\n/// the world imports no WASI and adding it drags preview2 shims into the\n/// browser; a real monotonic clock is the primitive a timing side channel is\n/// built from, and the coarsened one below is not; and an ambient clock makes\n/// a dispatch unreplayable, which contradicts \"the host is the framework\".\ninterface env {\n  /// Milliseconds since the Unix epoch, coarsened by the host and FROZEN for\n  /// the duration of one dispatch: every call inside one `handle-event`\n  /// returns the same instant. That is what lets a session replay, and what\n  /// denies a guest the fine-grained timer a side channel needs. Requires\n  /// `cap-clock`.\n  now-ms: func() -> u64;\n\n  /// Minutes to add to UTC for the user's local time, and the host's locale.\n  /// The host-context a widget would otherwise read off the DOM, handed over\n  /// as data. Requires `cap-clock`.\n  tz-offset-min: func() -> s32;\n  locale: func() -> string;\n\n  /// From a PRNG the HOST seeds per instance and records, so a session\n  /// replays. NOT cryptographic: a guest that needs unpredictability an\n  /// attacker cannot reproduce asks the host with an intent on the `lex` leg.\n  /// Requires `cap-random`.\n  random-u64: func() -> u64;\n\n  /// A fresh identifier, unique within this bundle for this session.\n  /// Monotonic, not a UUID — it is for keying a list, not for naming a thing\n  /// outside the page. Requires `cap-random`.\n  new-id: func() -> string;\n}\n\n/// What the HOST decided this bundle's variables are: the manifest's declared\n/// defaults with the host's bindings applied.\n///\n/// The answer to \"this component would work anywhere, if somebody told it\n/// where\". `guests/mastodon` is the worked example: the same six components\n/// read mastodon.social or hachyderm.io depending on two strings, and neither\n/// the wasm nor the views change between them.\n///\n/// NOT a capability, unlike everything in `env`. A capability is authority a\n/// guest would not otherwise have, and these values are the host's own,\n/// handed over deliberately — reading one gives a guest nothing it could not\n/// have been shipped as a constant. What the values reach is decided\n/// elsewhere: a view can name an `origin` variable and spend\n/// `cap-external-urls` on it, and that grant is the host's, made by binding it.\ninterface config {\n  /// The value bound for `name`.\n  ///\n  /// TRAPS for a name the manifest does not declare, for the reason an\n  /// ungranted `env` call traps: an empty string is a plausible value, and a\n  /// guest that got one back could not tell a variable it misspelled from a\n  /// variable somebody deliberately set to nothing.\n  get: func(name: string) -> string;\n}\n\n/// Framework services available to a running handler. Calls are buffered by\n/// the host and applied through the dispatching handler's context when\n/// `handle-event` returns (tutuca ctx.send / ctx.intent).\n/// `log` is immediate and always legal.\ninterface control {\n  use values.{value};\n\n  enum log-level { debug, info, warn, error }\n\n  log: func(level: log-level, msg: string);\n\n  /// One hop of a path RELATIVE to the dispatching instance — the guest's\n  /// half of `ctx.at`. Absolute paths are deliberately absent: a component\n  /// addresses its own subtree, never the tree it happens to be mounted in.\n  record item-step { field: string, key: string }\n  record index-step { field: string, index: u32 }\n  variant path-step {\n    /// `.name`\n    field(string),\n    /// `.name[key]` — a keyed element of a map / ordered-map field\n    item(item-step),\n    /// `.name[i]` — an element of a list field\n    at(index-step),\n  }\n\n  /// A leg of an intent's route.\n  ///\n  /// `dyn` walks the dynamic scope — the host tree, from the sender's PARENT\n  /// up to the root. `lex` walks the lexical one, the registration chain, whose\n  /// handlers are static functions with no state. A route is a list of these,\n  /// in the order written, and `[dyn, lex]` when nothing says otherwise.\n  enum leg { dyn, lex }\n\n  /// Answer routing for an intent (host `IntentOpts`).\n  ///\n  /// Three outcome names, because an intent has three outcomes: a handler\n  /// replied, a handler failed, or the route ended with nobody answering. Each\n  /// carries its own payload, so no arm has to discriminate a combined one.\n  ///\n  /// A sender expects an answer if and only if it names one of these. That is\n  /// what makes an intent a request rather than a notification, and nothing\n  /// declares it separately.\n  record intent-opts {\n    /// The legs to walk. Empty means the default, `[dyn, lex]` — which the\n    /// HOST supplies, so a guest that says nothing cannot disagree with it.\n    route: list<leg>,\n    on-ok: option<string>,\n    on-error: option<string>,\n    on-unhandled: option<string>,\n    /// Resolve the answering component by its path as it is WHEN THE ANSWER\n    /// ARRIVES rather than pinning the keys at dispatch time (host\n    /// `live_path`).\n    live-path: bool,\n  }\n\n  /// Dispatch an intent along `opts.route`, from this instance's position.\n  ///\n  /// The `dyn` leg starts at this component's PARENT, so a component never\n  /// re-enters its own handler and a cycle needs two of them. The answer, if\n  /// any, arrives as a later handle-event(receive, ...) — an answer is an\n  /// ordinary message and a handler cannot tell it from one a parent sent.\n  ///\n  /// One channel: the route says which scope answers, rather than the verb\n  /// saying it.\n  intent: func(name: string, args: list<value>, opts: intent-opts);\n\n  /// Dispatch an intent AT a descendant, which then walks from there — the\n  /// targeted twin of `intent`.\n  intent-at: func(path: list<path-step>, name: string, args: list<value>, opts: intent-opts);\n\n  /// Pass the message being handled on as an intent, or — while handling an\n  /// intent — continue its walk after this position.\n  ///\n  /// The answer target does not move: a handler further up answers whoever\n  /// dispatched, not whoever forwarded. That, and not having to rebuild the\n  /// arguments, is the whole of what makes this different from dispatching the\n  /// intent again. An empty `args` means \"the ones that arrived\"; an empty\n  /// `route` means \"the one the walk is already on\".\n  forward: func(args: list<value>, opts: intent-opts);\n\n  /// Answer the intent this handler received, and end the walk. The answer\n  /// arrives at the sender as `<name>Ok`.\n  reply: func(v: value);\n\n  /// Answer it with a failure, and end the walk: `<name>Error`.\n  fail: func(e: value);\n\n  /// Send a message to self: arrives as a later handle-event(receive, name, ...).\n  send: func(name: string, args: list<value>);\n\n  /// Send to a component in this one's own subtree (`ctx.send-at-path`): the\n  /// message arrives as handle-event(receive, ...) at `path`, e.g.\n  /// `[field(\"left\")]` for the child a `left` field holds.\n  send-at: func(path: list<path-step>, name: string, args: list<value>);\n\n  /// End the walk with no answer — \"served, and no answer\". The sender hears\n  /// nothing, even if it named an outcome, which is what separates this from\n  /// letting the route run out.\n  ///\n  /// (host `ctx.stop-propagation`; only meaningful while handling an intent.)\n  stop-propagation: func();\n\n  /// Ask the host to send `name` back to THIS instance after `delay-ms`, as a\n  /// later handle-event(receive, ...). Buffered like the rest; the host owns\n  /// the timer and may coalesce, delay or drop it. There is no cancel and no\n  /// handle: a guest cannot cancel what it does not own, and a component that\n  /// wants to stop a tick stops acting on it. Requires `cap-timer`.\n  after: func(delay-ms: u32, name: string, args: list<value>);\n\n  /// Create a same-bundle child instance and return its HOST-ASSIGNED token\n  /// (the only instance-token space; `value.instance` payloads use it).\n  /// Callable from constructors and handlers; the child becomes a field of\n  /// the parent (return it from get-field as instance(token), accept it in\n  /// with-field) and the host renders it with `<x render=\".field\">`.\n  make-instance: func(component: string, args: list<tuple<string, value>>) -> u64;\n\n  /// Release a child token that will no longer be returned from get-field.\n  drop-instance: func(token: u64);\n}\n\ninterface guest {\n  use values.{value};\n\n  /// The answer to an intent this bundle SERVES. Synchronous, because every\n  /// call across this boundary is: a guest that needs to wait dispatches an\n  /// intent of its own and lets the host do the waiting.\n  variant serve-result {\n    ok(value),\n    err(value),\n  }\n\n  /// Serve one of the `serves` the static manifest declares.\n  ///\n  /// These are the bundle's own handlers on the `lex` leg — its components\n  /// reach them before the host's, and a host component never sees them at\n  /// all, which is what makes a bundle's services its own. Module-scoped: a\n  /// service is something the BUNDLE provides, not state an instance holds.\n  ///\n  /// It cannot decline. A handler with nothing to say answers `err`, and the\n  /// walk ends here either way; declining is `IntentAnswer::Pass`, which only\n  /// a host-side handler can give.\n  serve-intent: func(name: string, args: list<value>) -> serve-result;\n\n  /// The dispatch buckets a handler can live in.\n  ///\n  /// Two, and the difference is who decides where a dispatch lands: `receive`\n  /// is an addressed message, which stops at the component it names, and\n  /// `intent` is a routed one, which walks until something answers. A case's\n  /// position is its wire number.\n  enum bucket { receive, intent }\n\n  /// Whether a dispatch name belonged to the guest, independently of whether\n  /// it changed state. `unhandled` lets the host fall back to the mutator a\n  /// declared field implies; `unchanged` is a real handler that only dispatched\n  /// an intent, sent a message, stopped propagation, or deliberately did\n  /// nothing.\n  variant event-result {\n    unhandled,\n    unchanged,\n    changed(instance),\n  }\n\n  /// One guest component instance with OPAQUE state. Instances are\n  /// immutable by convention: handlers return a NEW instance in `changed`\n  /// and the host swaps its wrapper — new instance, new\n  /// identity, which drives tutuca's change detection.\n  /// The host drops superseded handles once a transaction settles.\n  resource instance {\n    /// `component` is a component name from the static manifest; `args` are\n    /// construction fields (host mount arguments).\n    constructor(component: string, args: list<tuple<string, value>>);\n\n    /// Rebuild an instance from bytes THIS bundle's `persist` wrote.\n    ///\n    /// none means refuse — bytes from a version this guest no longer reads, or\n    /// a component that does not persist — and the host then falls back to\n    /// constructing from the declared fields, which it can do without the\n    /// guest. Refusing is therefore cheap and always available, which is why\n    /// there is no versioning scheme here: a guest that changed its format\n    /// says no to the old one and the state it could not read is the only\n    /// thing lost.\n    restore: static func(component: string, state: list<u8>) -> option<instance>;\n\n    /// Lazy field read use