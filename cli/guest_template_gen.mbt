    "gen/interface/tutuca/component/guest/top.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\n/// A named view in tutuca template syntax. The HOST parses it (anode):\n/// event bindings are attributes resolved at view parse time, so the handler\n/// names the markup references dispatch back into `instance.handle-event`.\n/// Every component needs a \"main\" view.\n///\n/// This is the widest channel a bundle has, because it is text the host\n/// compiles and renders into its own page. `@dangerouslysetinnerhtml` is\n/// REFUSED in a guest view: its content is a runtime expression, so no\n/// registration-time pass can see what it will hold, and the host will not\n/// render markup it never got to look at. (A sanitizer over the compiled\n/// tree is the next step, and is what would let it back in.)\npub(all) struct ViewDef {\n  name : String\n  html : String\n} derive(Debug, Eq)\n\n///|\n/// What a declared field HOLDS, as a flat table: WIT has no recursive types,\n/// so a compound points at its parts by index into `component-def.types`.\n/// The kinds are the host's `TyInfo` — a guest declares the same shapes a\n/// host component declares in `<script type=\"tutuca/state\">`.\npub(all) enum TyKind {\n  TY_BOOL\n  TY_INT\n  TY_FLOAT\n  TY_TEXT\n  TY_LIST\n  TY_TUPLE\n  TY_OPTION\n  TY_OMAP\n  TY_RECORD\n  TY_ENUM\n  TY_VARIANT\n  TY_FLAGS\n  TY_SET\n  TY_COMP\n  TY_ANY\n} derive(Debug, Eq)\n\n///|\npub fn TyKind::ordinal(self : TyKind) -> Int {\n  match self {\n    TY_BOOL => 0\n    TY_INT => 1\n    TY_FLOAT => 2\n    TY_TEXT => 3\n    TY_LIST => 4\n    TY_TUPLE => 5\n    TY_OPTION => 6\n    TY_OMAP => 7\n    TY_RECORD => 8\n    TY_ENUM => 9\n    TY_VARIANT => 10\n    TY_FLAGS => 11\n    TY_SET => 12\n    TY_COMP => 13\n    TY_ANY => 14\n  }\n}\n\n///|\npub fn TyKind::from(self : Int) -> TyKind {\n  match self {\n    0 => TY_BOOL\n    1 => TY_INT\n    2 => TY_FLOAT\n    3 => TY_TEXT\n    4 => TY_LIST\n    5 => TY_TUPLE\n    6 => TY_OPTION\n    7 => TY_OMAP\n    8 => TY_RECORD\n    9 => TY_ENUM\n    10 => TY_VARIANT\n    11 => TY_FLAGS\n    12 => TY_SET\n    13 => TY_COMP\n    14 => TY_ANY\n    _ => panic()\n  }\n}\n\n///|\npub(all) struct TyDef {\n  kind : TyKind\n  elem : UInt?\n  items : FixedArray[UInt]\n  name : String\n  members : Array[String]\n} derive(Debug, Eq)\n\n///|\n/// A sentence about a name the component already declares elsewhere —\n/// a handler, a receive, a bubble, a response, a method, a request. One flat\n/// table rather than a doc field on six lists, because the lists stay plain\n/// `list<string>` and the host merges by name.\npub(all) struct NamedDoc {\n  name : String\n  doc : String\n} derive(Debug, Eq)\n\n///|\n/// The part of a field a TYPE cannot say. `ty-def` says a field holds a\n/// string; this says it holds an email between 3 and 254 characters with a\n/// default of \"\". Both a generated form and a JSON Schema need the second\n/// half, and neither can infer it.\n///\n/// Every member is optional by having an empty spelling: \"\" for the strings,\n/// `none` for the options. `enum-json` and `default-json` are JSON text for\n/// the same reason `init-def.args-json` is — a manifest is DATA the host\n/// keeps, and an arena handle would be stale the moment `get-manifest`\n/// returned.\npub(all) struct Constraint {\n  min : Double?\n  max : Double?\n  min_len : UInt?\n  max_len : UInt?\n  pattern : String\n  format : String\n  enum_json : String\n  default_json : String\n} derive(Debug, Eq)\n\n///|\npub(all) struct FieldDef {\n  name : String\n  ty : UInt\n  doc : String\n  required : Bool\n  constraint : Constraint?\n} derive(Debug, Eq)\n\n///|\n/// A named initial state — the guest's `<script type=\"tutuca/init\">`. The\n/// args are JSON rather than `value`s because a manifest is DATA the host\n/// keeps: an arena handle would be stale the moment `get-manifest` returned.\npub(all) struct InitDef {\n  name : String\n  args_json : String\n  doc : String\n} derive(Debug, Eq)\n\n///|\npub(all) struct ComponentDef {\n  name : String\n  doc : String\n  keywords : Array[String]\n  category : String\n  message_docs : Array[NamedDoc]\n  views : Array[ViewDef]\n  types : Array[TyDef]\n  fields : Array[FieldDef]\n  handlers : Array[String]\n  receives : Array[String]\n  bubbles : Array[String]\n  responses : Array[String]\n  methods : Array[String]\n  whens : Array[String]\n  requests : Array[String]\n  inits : Array[InitDef]\n  style : String\n} derive(Debug, Eq)\n\n///|\n/// Something a component cannot do for itself and the host can. Requested\n/// here, granted (or not) by the host; there is no negotiation and no\n/// partial grant, because a capability that is present but lies is worse\n/// than one that is absent.\n///\n/// `control.request` is deliberately NOT in this list. Whether a guest may\n/// reach a HOST request handler is a decision about the caller, not about\n/// the bundle, so the host makes it per call from the requester's path\n/// rather than reading a claim out of the manifest.\npub(all) enum Capability {\n  CAP_CLOCK\n  CAP_RANDOM\n  CAP_TIMER\n} derive(Debug, Eq)\n\n///|\npub fn Capability::ordinal(self : Capability) -> Int {\n  match self {\n    CAP_CLOCK => 0\n    CAP_RANDOM => 1\n    CAP_TIMER => 2\n  }\n}\n\n///|\npub fn Capability::from(self : Int) -> Capability {\n  match self {\n    0 => CAP_CLOCK\n    1 => CAP_RANDOM\n    2 => CAP_TIMER\n    _ => panic()\n  }\n}\n\n///|\npub(all) struct CapabilityReq {\n  cap : Capability\n  reason : String\n} derive(Debug, Eq)\n\n///|\n/// What the views RAISE is not declared: the host compiles them, so it reads\n/// those names off the compiled tree (Component::view_handler_names) and puts\n/// them in the component's descriptor. `handlers` above is the other\n/// question — which of them the guest answers rather than the host.\npub(all) struct Manifest {\n  api_version : UInt\n  module_name : String\n  doc : String\n  version : String\n  homepage : String\n  authors : Array[String]\n  capabilities : Array[CapabilityReq]\n  components : Array[ComponentDef]\n} derive(Debug, Eq)\n\n///|\n/// The answer to a request this bundle serves. Synchronous, because every\n/// call across this boundary is: a guest that needs to wait asks the host\n/// instead (`control.request`).\npub(all) enum RequestResult {\n  Ok(@values.Value)\n  Err(@values.Value)\n} derive(Debug, Eq)\n\n///|\npub(all) enum Bucket {\n  INPUT\n  RECEIVE\n  RESPONSE\n  BUBBLE\n} derive(Debug, Eq)\n\n///|\npub fn Bucket::ordinal(self : Bucket) -> Int {\n  match self {\n    INPUT => 0\n    RECEIVE => 1\n    RESPONSE => 2\n    BUBBLE => 3\n  }\n}\n\n///|\npub fn Bucket::from(self : Int) -> Bucket {\n  match self {\n    0 => INPUT\n    1 => RECEIVE\n    2 => RESPONSE\n    3 => BUBBLE\n    _ => panic()\n  }\n}\n\n///|\n/// One guest component instance with OPAQUE state. Instances are\n/// immutable by convention: handlers return a NEW instance (or none for\n/// \"unchanged\") and the host swaps its wrapper — new instance, new\n/// identity, which drives tutuca's change detection.\n/// The host drops superseded handles once a transaction settles.\npub(all) struct Instance(Int) derive(Debug, Eq)\n\n///|\n/// Creates a new resource with the given `rep` as its representation and returning the handle to this resource.\npub fn Instance::new(rep : Int) -> Instance {\n  Instance::Instance(wasmExportResourceNewInstance(rep))\n}\n\n///|\nfn wasmExportResourceNewInstance(rep : Int) -> Int = \"[export]tutuca:component/guest@0.4.0\" \"[resource-new]instance\"\n\n///|\n/// Drops a resource handle.\npub fn Instance::drop(self : Self) -> Unit {\n  let Instance(resource) = self\n  wasmExportResourceDropInstance(resource)\n}\n\n///|\nfn wasmExportResourceDropInstance(resource : Int) = \"[export]tutuca:component/guest@0.4.0\" \"[resource-drop]instance\"\n\n///|\n/// Gets the `Int` representation of the resource pointed to the given handle.\npub fn Instance::rep(self : Self) -> Int {\n  let Instance(resource) = self\n  wasmExportResourceRepInstance(resource)\n}\n\n///|\nfn wasmExportResourceRepInstance(resource : Int) -> Int = \"[export]tutuca:component/guest@0.4.0\" \"[resource-rep]instance\"\n\n///|\n/// Destructor of the resource.\ndeclare pub fn Instance::dtor(_self : Instance) -> Unit\n\n///|\ndeclare pub fn get_manifest() -> Manifest\n\n///|\n/// Serve one of the `requests` a component-def declares. Module-scoped like\n/// the manifest: a request is a service the BUNDLE provides, not state an\n/// instance holds.\ndeclare pub fn handle_request(\n  name : String,\n  args : Array[@values.Value],\n) -> RequestResult\n\n///|\n/// `component` is a component-def name from the manifest; `args` are\n/// construction fields (host mount arguments).\ndeclare pub fn Instance::instance(\n  component : String,\n  args : Array[(String, @values.Value)],\n) -> Instance\n\n///|\n/// Rebuild an instance from bytes THIS bundle's `persist` wrote.\n///\n/// none means refuse — bytes from a version this guest no longer reads, or\n/// a component that does not persist — and the host then falls back to\n/// constructing from the declared fields, which it can do without the\n/// guest. Refusing is therefore cheap and always available, which is why\n/// there is no versioning scheme here: a guest that changed its format\n/// says no to the old one and the state it could not read is the only\n/// thing lost.\ndeclare pub fn Instance::restore(\n  component : String,\n  state : FixedArray[Byte],\n) -> Instance?\n\n///|\n/// Lazy field read used while the host renders this instance's views\n/// (and for path lookups). none = no such field.\ndeclare pub fn Instance::get_field(\n  self : Instance,\n  name : String,\n) -> @values.Value?\n\n///|\n/// Ordered entries so host `@each` can iterate the instance as a\n/// sequence; none = not a sequence.\ndeclare pub fn Instance::seq_entries(\n  self : Instance,\n) -> Array[(String, @values.Value)]?\n\n///|\n/// Self in, self out: return the successor instance, or none if the\n/// event caused no state change. The `bubble` bucket is how a guest\n/// component hears from a guest child of its own (`control.emit` one level\n/// down); the host walks it up exactly as it does between host components.\n///\n/// There is no event object: what a handler needs from the DOM event is\n/// named in the view (`@on.input=\"setName value\"`) and arrives evaluated\n/// in `args`, which is also how a host component receives it — `event`,\n/// `target` and `ctx` are not handler arguments in tutuca.\ndeclare pub fn Instance::handle_event(\n  self : Instance,\n  b : Bucket,\n  name : String,\n  args : Array[@values.Value],\n) -> Instance?\n\n///|\n/// Pure render-time method call (view expressions). Must not mutate.\ndeclare pub fn Instance::call_method(\n  self : Instance,\n  name : String,\n  args : Array[@values.Value],\n) -> @values.Value\n\n///|\n/// COW write-through: successor with one field replaced. It is what host\n/// paths write through to reach a nested child, AND what the generated\n/// mutators write through, so a component that declares fields wants it\n/// even with no children of its own.\ndeclare pub fn Instance::with_field(\n  self : Instance,\n  name : String,\n  v : @values.Value,\n) -> Instance?\n\n///|\n/// This instance's state as bytes only this guest interprets. The host\n/// STORES them and hands them back to `restore`; it never looks inside,\n/// which is what lets a guest persist state the declared fields do not\n/// name (a cursor, a cache, a parser's arena) without the contract\n/// growing a shape for it.\n///\n/// An empty list means \"I do not persist\". That is not a failure: the host\n/// can already project the declared fields to JSON and construct from\n/// them, so a guest that adds nothing beyond its fields should return\n/// empty and let the host do it.\ndeclare pub fn Instance::persist(self : Instance) -> FixedArray[Byte]\n",
