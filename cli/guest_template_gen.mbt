    "interface/tutuca/component/values/ffi.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\n#owned(str)\nextern \"wasm\" fn mbt_ffi_str2ptr(str : String) -> Int =\n  #|(func (param i32) (result i32) local.get 0)\n\n///|\nextern \"wasm\" fn mbt_ffi_free(position : Int) =\n  #|(func (param i32) local.get 0 call $moonbit.decref)\n\n///|\nextern \"wasm\" fn mbt_ffi_load32(offset : Int) -> Int =\n  #|(func (param i32) (result i32) local.get 0 i32.load)\n\n///|\nextern \"wasm\" fn mbt_ffi_load64(offset : Int) -> Int64 =\n  #|(func (param i32) (result i64) local.get 0 i64.load)\n\n///|\nextern \"wasm\" fn mbt_ffi_load8_u(offset : Int) -> Int =\n  #|(func (param i32) (result i32) local.get 0 i32.load8_u)\n\n///|\nextern \"wasm\" fn mbt_ffi_loadf64(offset : Int) -> Double =\n  #|(func (param i32) (result f64) local.get 0 f64.load)\n\n///|\nextern \"wasm\" fn mbt_ffi_malloc(size : Int) -> Int =\n  #|(func (param i32) (result i32) (local i32)\n  #| local.get 0 i32.const 4 i32.add call $moonbit.gc.malloc\n  #| local.tee 1 i32.const 0 call $moonbit.init_array8\n  #| local.get 1)\n\n///|\nextern \"wasm\" fn mbt_ffi_ptr2str(ptr : Int, len : Int) -> String =\n  #|(func (param i32) (param i32) (result i32)\n  #| local.get 0\n  #| local.get 1 call $moonbit.init_array16\n  #| local.get 0)\n\n///|\nfn wasmImportFromJson(p0 : Int, p1 : Int, p2 : Int) = \"tutuca:component/values@0.4.0\" \"from-json\"\n\n///|\nfn wasmImportListGet(p0 : Int64, p1 : Int, p2 : Int) = \"tutuca:component/values@0.4.0\" \"list-get\"\n\n///|\nfn wasmImportListLen(p0 : Int64) -> Int = \"tutuca:component/values@0.4.0\" \"list-len\"\n\n///|\nfn wasmImportListNew() -> Int64 = \"tutuca:component/values@0.4.0\" \"list-new\"\n\n///|\nfn wasmImportListPush(p0 : Int64, p1 : Int, p2 : Int64, p3 : Int) = \"tutuca:component/values@0.4.0\" \"list-push\"\n\n///|\nfn wasmImportMapGet(p0 : Int64, p1 : Int, p2 : Int, p3 : Int) = \"tutuca:component/values@0.4.0\" \"map-get\"\n\n///|\nfn wasmImportMapKeys(p0 : Int64, p1 : Int) = \"tutuca:component/values@0.4.0\" \"map-keys\"\n\n///|\nfn wasmImportMapLen(p0 : Int64) -> Int = \"tutuca:component/values@0.4.0\" \"map-len\"\n\n///|\nfn wasmImportMapNew() -> Int64 = \"tutuca:component/values@0.4.0\" \"map-new\"\n\n///|\nfn wasmImportMapSet(\n  p0 : Int64,\n  p1 : Int,\n  p2 : Int,\n  p3 : Int,\n  p4 : Int64,\n  p5 : Int,\n) = \"tutuca:component/values@0.4.0\" \"map-set\"\n\n///|\nfn wasmImportToJson(p0 : Int, p1 : Int64, p2 : Int, p3 : Int) = \"tutuca:component/values@0.4.0\" \"to-json\"\n",
