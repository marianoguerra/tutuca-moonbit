  (
    "interface/tutuca/component/control/README.md", "Framework services available to a running handler. Calls are buffered by\nthe host and applied through the dispatching handler's context when\n`handle-event` returns (tutuca ctx.bubble / ctx.send / ctx.request).\n`log` is immediate and always legal.",
  ),
  (
    "interface/tutuca/component/control/ffi.mbt", "// Generated by `wit-bindgen` 0.59.0. DO NOT EDIT!\n\n///|\n#owned(str)\nextern \"wasm\" fn mbt_ffi_str2ptr(str : String) -> Int =\n  #|(func (param i32) (result i32) local.get 0)\n\n///|\nextern \"wasm\" fn mbt_ffi_free(position : Int) =\n  #|(func (param i32) local.get 0 call $moonbit.decref)\n\n///|\nextern \"wasm\" fn mbt_ffi_malloc(size : Int) -> Int =\n  #|(func (param i32) (result i32) (local i32)\n  #| local.get 0 i32.const 4 i32.add call $moonbit.gc.malloc\n  #| local.tee 1 i32.const 0 call $moonbit.init_array8\n  #| local.get 1)\n\n///|\nextern \"wasm\" fn mbt_ffi_store32(offset : Int, value : Int) =\n  #|(func (param i32) (param i32) local.get 0 local.get 1 i32.store)\n\n///|\nextern \"wasm\" fn mbt_ffi_store64(offset : Int, value : Int64) =\n  #|(func (param i32) (param i64) local.get 0 local.get 1 i64.store)\n\n///|\nextern \"wasm\" fn mbt_ffi_store8(offset : Int, value : Int) =\n  #|(func (param i32) (param i32) local.get 0 local.get 1 i32.store8)\n\n///|\nextern \"wasm\" fn mbt_ffi_storef64(offset : Int, value : Double) =\n  #|(func (param i32) (param f64) local.get 0 local.get 1 f64.store)\n\n///|\nfn wasmImportAfter(p0 : Int, p1 : Int, p2 : Int, p3 : Int, p4 : Int) = \"tutuca:component/control@0.4.0\" \"after\"\n\n///|\nfn wasmImportBubbleAt(\n  p0 : Int,\n  p1 : Int,\n  p2 : Int,\n  p3 : Int,\n  p4 : Int,\n  p5 : Int,\n) = \"tutuca:component/control@0.4.0\" \"bubble-at\"\n\n///|\nfn wasmImportDropInstance(p0 : Int64) = \"tutuca:component/control@0.4.0\" \"drop-instance\"\n\n///|\nfn wasmImportEmit(p0 : Int, p1 : Int, p2 : Int, p3 : Int) = \"tutuca:component/control@0.4.0\" \"emit\"\n\n///|\nfn wasmImportLog(p0 : Int, p1 : Int, p2 : Int) = \"tutuca:component/control@0.4.0\" \"log\"\n\n///|\nfn wasmImportMakeInstance(p0 : Int, p1 : Int, p2 : Int, p3 : Int) -> Int64 = \"tutuca:component/control@0.4.0\" \"make-instance\"\n\n///|\nfn wasmImportRequest(\n  p0 : Int,\n  p1 : Int,\n  p2 : Int,\n  p3 : Int,\n  p4 : Int,\n  p5 : Int,\n  p6 : Int,\n  p7 : Int,\n  p8 : Int,\n  p9 : Int,\n  p10 : Int,\n  p11 : Int,\n  p12 : Int,\n  p13 : Int,\n) = \"tutuca:component/control@0.4.0\" \"request\"\n\n///|\nfn wasmImportSend(p0 : Int, p1 : Int, p2 : Int, p3 : Int) = \"tutuca:component/control@0.4.0\" \"send\"\n\n///|\nfn wasmImportSendAt(p0 : Int, p1 : Int, p2 : Int, p3 : Int, p4 : Int, p5 : Int) = \"tutuca:component/control@0.4.0\" \"send-at\"\n\n///|\nfn wasmImportStopPropagation() = \"tutuca:component/control@0.4.0\" \"stop-propagation\"\n",
