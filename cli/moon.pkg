// Pure CLI core: argv in -> Emit (stdout/stderr text + exit code) out. Never
// touches argv/fs/stdio itself so it stays target-agnostic and testable;
// cmd/tutuca is the native shell that does I/O.
//
// The dependency list is the honest statement of what this CLI does: it reads
// view source and writes MoonBit (anode/viewgen/lint), and that is all. No
// component, render or vdom import, because nothing here builds or renders a
// component — in an ahead-of-time port that is the compiler's job.
import {
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/lint",
  "marianoguerra/tutuca/statedef",
  "marianoguerra/tutuca/tscript/check",
  "marianoguerra/tutuca/viewgen",
  // `tutuca trace`: reading and shortening a recording, which needs nothing
  // but the file
  "marianoguerra/tutuca/trace",
  "marianoguerra/tutuca/viewfile",
  // The `.tutu` reader, and the renderer for the reports it answers with.
  // `outline` is the only command that reads one, and it is the only reason
  // this binary carries a shrubbery parser.
  "marianoguerra/tutuca/tutufile",
  "marianoguerra/tutuca/tutufile/lower",
  "marianoguerra/error-report" @report,
  "marianoguerra/error-report/render" @report_render,
  "moonbitlang/core/string",
}

// No storybook import, at runtime or in tests: `tutuca storybook` serves a
// pre-built bundle and needs no knowledge of the story registry. The
// view-corpus test that used to live here runs from storybook/examples, which
// is where the corpus is.
// Test-only: gen_views_ir_test proves the generated compiled-tree module
// renders identically to the runtime-parsed view, which means mounting one.
// That is an equivalence check on the GENERATOR, not the CLI reaching into a
// component at run time — no non-test code here imports these.
import {
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  // the fixture writes its own state <-> Value codec, like a generated module
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/render",
  "marianoguerra/tutuca/vdom",
  "marianoguerra/tutuca/vdom/memdom",
} for "test"
