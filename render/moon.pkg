import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/vdom",
  // the sanitizing filter, applied to each component subtree as it is BUILT
  // rather than to the finished tree — see `RenderCtx.filter`
  "marianoguerra/tutuca/vdom/filter",
  "moonbitlang/core/json",
  "moonbitlang/core/strconv",
}

import {
  "marianoguerra/tutuca/vdom",
  "marianoguerra/tutuca/vdom/memdom",
  // the one test that walks a directive all the way to the DOM needs the
  // filter that understands it; `render` itself knows only the trait
  "marianoguerra/tutuca/vdom/filter/markdown" @mdfilter,
  "moonbitlang/core/debug",
} for "wbtest"
