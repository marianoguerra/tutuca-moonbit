// `.tutu` read straight into the tree the renderer indexes.
//
// The way this replaced printed each section as the text an HTML front end
// read, and something re-parsed it. That detour is where the fidelity bugs
// live: a printer holds the tree and loses it in the text, and every escape it
// forgets is a construct that silently changes meaning. Shrubbery in,
// `@anode.ANode` out, no string in between.
//
// Three things follow from going direct, and each is a DECISION rather than a
// consequence:
//
//   - A MACRO IS A TREE. `@anode.Macro` holds source text and re-parses it per
//     expansion, with `^name` substituted by the value parser. Here a macro
//     body is the shrubbery block it was read from, and expansion is a
//     substitution over `Ex` before anything becomes an `Expr`.
//   - WHITESPACE IS WHAT THE TREE SAYS. The HTML path inherits the tokenizer's
//     whitespace and then condenses it with a block/inline table
//     (`anode/whitespace.mbt`). At-notation has no such convention to inherit,
//     so nothing is inferred: a text node exists where the file writes one.
//   - THE EXPRESSION LANGUAGE HAS ONE READER. `Ex` (in `tutufile/shrub`) is
//     it, and it answers `@tutuca.Expr` directly rather than source that
//     something parses back.
import {
  "marianoguerra/tutuca/tutufile",
  "marianoguerra/tutuca/tutufile/shrub" @sh,
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/tscript",
  "marianoguerra/shrubbery/ast",
  "marianoguerra/shrubbery-css/lower" @csslower,
  "marianoguerra/css/write" @csswrite,
  "marianoguerra/css/ast" @cssast,
  "marianoguerra/error-report" @report,
}

import {
  "marianoguerra/shrubbery" @shrub,
  "moonbitlang/core/debug",
  // The other implementation of the notation, for the conformance oracle:
  // the same source read by both, and the two markup trees compared.
  "marianoguerra/shrubbery-html" @shrubbery_html,
  "marianoguerra/html/ast" @htmlast,
} for "test"
