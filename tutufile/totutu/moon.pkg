// A parsed declaration, written back as the notation.
//
// This was the migration converter — `tutuca to-tutu`, an `.html` view file in
// and the `.tutu` that replaces it out — and the repo is across, so the
// entry point that read an `.html` is gone with the file format it read. What
// is left is the half that had another reader: the printers, from a
// `StateDef`, a `@tscript.Decl`, an `ANode` and a `Value` to shrubbery.
//
// One caller: `cmd/conformance`. `tscript`'s corpus SPECIFIES the block
// language — that is what a `@tscript.Decl` is a parse of — and the file `gen`
// compiles is a `.tutu` like every other view file in the repo, so the
// projection is printed rather than converted.
//
// **It refuses rather than guesses.** Every construct it cannot spell raises
// `NoSpelling`, and the caller does not write the file. A projection that
// silently dropped a case would be worse than none: the corpus would compile,
// run, and prove less than it claims.
import {
  "marianoguerra/tutuca/statedef",
  "marianoguerra/tutuca/scenedef",
  "marianoguerra/tutuca/tscript",
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/tutufile/names",
}

import {
// The two properties the reader promises, asserted over what this package
// PRODUCES rather than over sources written by hand beside the assertion.
} for "test"
