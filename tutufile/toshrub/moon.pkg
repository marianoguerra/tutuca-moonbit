// The `view:` section, printed in the ALIGNED notation.
//
// Migration scaffolding, and meant to be deleted: it exists to convert the
// corpus from the at-notation spelling to the one that follows Shrubbery
// HTML's three laws, and once no file is written the old way it has no
// subject. `tutufile/lower` and `tutufile/equiv` were the same shape in the
// previous migration and went the same way.
//
// It prints from the SHRUBBERY TREE rather than from `@anode.ANode`, which is
// what makes it small. A printer that went through the compiled tree would
// have to reconstruct every expression from `@tutuca.Expr` -- which is what
// `tutufile/totutu` does, and where its `NoSpelling` refusals come from. Here
// an expression is a subtree, and `Node::to_source()` hands back exactly what
// the author wrote, so no expression can fail to convert.
import {
  "marianoguerra/tutuca/tutufile",
  "marianoguerra/tutuca/tutufile/shrub" @sh,
  "marianoguerra/tutuca/tutufile/toanode",
  "marianoguerra/shrubbery/ast",
  "marianoguerra/error-report",
  "marianoguerra/shrubbery-css" @shrubcss,
  "marianoguerra/css/parse" @cssparse,
  "marianoguerra/css/write" @csswrite,
}

import {
  "marianoguerra/tutuca/tutufile/toanode",
  "marianoguerra/error-report" @report,
  "moonbitlang/core/debug",
} for "test"
