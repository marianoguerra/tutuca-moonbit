spec:
  /// A temperature, readable either way round.
  Temperature:
    /// Degrees Celsius.
    field c :: Double

    property f :: Double

    property both :: String

    /// Never below absolute zero.
    invariant physical: (it.c >= -273.15)

logic:
  Temperature:
    /// The same temperature in Fahrenheit.
    property f :: Double:
      get: ((it.c * 1.8) + 32)

    /// Warmer by one degree.
    receive warmer:
      it.c += 1

    /// Cooler by one degree.
    receive cooler:
      it.c -= 1

    /// Both scales, in one sentence.
    property both :: String:
      get: @str{@(it.c) °C is @(((it.c * 1.8) + 32)) °F}

view:
  Temperature:
    @div{@button(~on_click: cooler){cooler} @button(~on_click: warmer){warmer} @p{@(it.both)}}

