// The page-level registry of loaded cards.
//
// `tutucard/web/card.js` instantiates a `tgc` module against the shared runtime
// and installs the runtime and the module's exports on `globalThis.__tgcmod`;
// `tgc/host/browser` is the `&Inst` over those, and this is where a page keeps
// the ones it has. Nothing here names an instance by an integer, because
// nothing between here and the engine does any more.
//
// It exists as its own package because two consumers hold cards — the card
// playground, one at a time, and the composition demo, several at once — and a
// second copy of a registry is how they would come to disagree about which
// module made what.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/tgc/host",
  "marianoguerra/tutuca/tgc/host/browser",
  "marianoguerra/tutuca/tgc/policy",
  "mizchi/js/core",
}

supported_targets = "js"
