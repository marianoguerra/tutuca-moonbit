// Reading a number out of a string: the `num` and `int` builtins.
//
// An OPTIONAL half, concatenated only for a card whose script actually says
// `num` or `int`. Same argument as `lower_scalar.wax` / `lower_values.wax`,
// with a different currency: those two decide the import section, and this one
// decides ~950 bytes that every card would otherwise carry for two builtins
// most of them never write. Wax's emitter does no dead-code elimination, so
// "only some cards need it" has to be said by the generator or not at all.
//
// Concatenated AFTER `runtime.wax` and after whichever lowering half this build
// got, so everything it names is already defined.

// A strict decimal parse.
//
// The language reads a Str as a number, so a card
// writing `num .raw` expects "42" and "-3.5" to be numbers and "12px" to FAIL
// the transition. This is that, for the decimal spellings a card can actually
// produce: an optional sign, digits with an optional fraction, and an optional
// exponent. Trailing rubbish is a failure, which is what `from_str` does.
//
// It is NOT a correctly-rounded parser — the mantissa accumulates by
// multiplication and the exponent is applied by repeated multiply — so a long
// decimal can land an ulp away from what MoonBit reads. That is the same class
// of deviation `tc_num_text` already documents in the other direction, and the
// spellings a card writes by hand are exact.
//
// Answers `(ok, value)`. `ok == 0` is the language's "no answer".
fn tc_parse_f64(s: &utf8_string) -> (i32, f64) {
    let l = utf8_byte_length(s);
    if l == 0 { return (0, 0.0); }
    let i: i32 = 0;
    let neg: i32 = 0;
    let c0 = utf8_at_byte(s, 0);
    if c0 == 43 { i = 1; }
    if c0 == 45 { neg = 1; i = 1; }
    // The integer and fraction digits share one mantissa; `scale` counts how
    // many of them were on the right of the point, so the two halves need no
    // separate accumulator.
    let mant: f64 = 0.0;
    let seen: i32 = 0;
    let scale: i32 = 0;
    'ipart: do {
        while i <s l {
            let b = utf8_at_byte(s, i);
            if b <u 48 { br 'ipart; }
            if b >u 57 { br 'ipart; }
            mant = mant * 10.0 + ((b - 48) as f64_s);
            seen += 1;
            i += 1;
        }
    }
    if i <s l {
        if utf8_at_byte(s, i) == 46 {
            i += 1;
            'fpart: do {
                while i <s l {
                    let b = utf8_at_byte(s, i);
                    if b <u 48 { br 'fpart; }
                    if b >u 57 { br 'fpart; }
                    mant = mant * 10.0 + ((b - 48) as f64_s);
                    seen += 1;
                    scale += 1;
                    i += 1;
                }
            }
        }
    }
    // A sign and a point with no digit between them is not a number.
    if seen == 0 { return (0, 0.0); }
    let exp: i32 = 0;
    if i <s l {
        let e = utf8_at_byte(s, i);
        let is_e: i32 = 0;
        if e == 101 { is_e = 1; }
        if e == 69 { is_e = 1; }
        if is_e == 1 {
            i += 1;
            let eneg: i32 = 0;
            if i <s l {
                let sgn = utf8_at_byte(s, i);
                if sgn == 43 { i += 1; }
                if sgn == 45 { eneg = 1; i += 1; }
            }
            let edigits: i32 = 0;
            'epart: do {
                while i <s l {
                    let b = utf8_at_byte(s, i);
                    if b <u 48 { br 'epart; }
                    if b >u 57 { br 'epart; }
                    exp = exp * 10 + (b - 48);
                    edigits += 1;
                    i += 1;
                }
            }
            if edigits == 0 { return (0, 0.0); }
            if eneg == 1 { exp = 0 - exp; }
        }
    }
    if i != l { return (0, 0.0); }
    let p = exp - scale;
    while p >s 0 { mant = mant * 10.0; p -= 1; }
    while p <s 0 { mant = mant / 10.0; p += 1; }
    if neg == 1 { mant = 0.0 - mant; }
    (1, mant)
}

// `num` — a number is itself, a string parses, and anything else has NO
// ANSWER. The third is the case the old `tc_int` got wrong: the language has no
// answer for `num true`, and no answer abandons the transition where a null
// would quietly become a field's new value.
fn tc_num_cast(a: &jv_value) -> &jv_value {
    let k = jv_kind(a);
    if k == jv_kind_f64 { return a; }
    if k == jv_kind_string {
        let (ok, x) = tc_parse_f64(jv_require_string(a));
        if ok == 0 { tc_fail = 1; return jv_null(); }
        return jv_f64(x);
    }
    tc_fail = 1;
    jv_null()
}

// `int` is `num` and then a truncation, down to reading a string first.
fn tc_int(a: &jv_value) -> &jv_value {
    let v = tc_num_cast(a);
    if tc_fail != 0 { return v; }
    jv_f64(jv_require_f64(v).trunc())
}
