// The fixed card runtime: tutuca's value semantics over the Wax data stdlib.
//
// This is SOURCE, not a tree the generator builds. Everything here is the same
// in every card, so there is nothing for a generator to decide, and a hundred
// lines of readable Wax beat five hundred lines of MoonBit that assembles the
// same instructions out of `call(...)` and `if_(...)`. The per-card half — the
// schema, the handlers, the dispatch chains — is still built as an AST, where
// the decisions actually are.
//
// Concatenated AFTER `vendor/wax/` (which it calls into) and after the memory,
// the constant pool and `alloc` (which it also calls into), and BEFORE the
// generated card.
//
// `tc_` is the prefix. Every name in a Wax module is global and the stdlib has
// claimed `wax_ phm_ phmt_ phs_ phst_ pv_ pvt_ utf8_ jv_ jvt_ st_`; this is the
// one that is ours, and the generator prefixes card-derived names too.
//
// THE NUMERIC RULE. tutuca has exactly one number type — `Value::Num(Double)`,
// `core/spec.mbt` — and jv has four that never coerce, with `jv_equal` false
// across them. So this file builds `jv_f64` and NOTHING ELSE, and every read
// goes through `tc_num_of`. An `jv_i32` reaching a comparison would be a bug
// that reads as "the numbers are not equal".

// ---------------------------------------------------------------------------
// state that outlives a call

// Interned string constants, in the pool's order. Built by the generated
// `#[start]`, read by `tc_const`. A card's literals are built ONCE rather than
// re-validated and re-hashed at every evaluation.
let tc_consts: &?pv_vector = null;

// Every instance this module has handed out. The canonical ABI's `resource_new`
// takes an i32 rep, and a GC reference is not an i32, so the rep is an index
// into here.
//
// Nothing is ever removed. That is the same trade the bump allocator made
// before it — an instance is live for as long as one edit-and-mount — and it is
// why `cabi_post_*` is still a no-op.
let tc_insts: &?pv_vector = null;

// The card's state types, one per component the file declares, in the order the
// manifest lists them — built by the generated `#[start]` because a schema is
// the one thing here a card decides.
//
// A vector rather than a global, because a card is a BUNDLE: `viewfile` has
// always let one file declare several components, and the constructor is handed
// the name of the one it is to build. One entry for a card that declares one,
// which is what every card did before this.
let tc_types: &?pv_vector = null;

// Set when a body did something with no answer — a division by zero, an index
// past the end of a list. The language answers `None` for these and the
// `None` propagates until the transition is abandoned; a compiled body has no
// option type to propagate, so it raises this flag and `handle-event` reads it
// where the interpreter would have seen the None.
//
// "Failure is no change" is the contract, and this is what keeps it.
let tc_fail: i32 = 0;

// Effects a body has performed, NOT yet told to the host.
//
// The interpreter collects effects into an `Outcome` and drops them when the
// transition is abandoned, so a `send` before a failing statement never
// happens. A compiled body used to call the host import as it went, which the
// host cannot un-hear. Buffering here and flushing after the contracts hold is
// what makes the two backends agree about a `send` that should not have
// escaped.
let tc_effects: &?pv_vector = null;

// Spellings a value's text form needs and a card may not contain.
let tc_s_true: &?utf8_string = null;
let tc_s_false: &?utf8_string = null;
let tc_s_nan: &?utf8_string = null;
let tc_s_inf: &?utf8_string = null;
let tc_s_empty: &?utf8_string = null;
let tc_s_null: &?utf8_string = null;
let tc_s_comma: &?utf8_string = null;
let tc_s_object: &?utf8_string = null;

fn tc_init() {
    tc_consts = pv_empty();
    tc_types = pv_empty();
    tc_insts = pv_empty();
    tc_effects = pv_empty();
    tc_s_true = utf8_from_bytes("true");
    tc_s_false = utf8_from_bytes("false");
    tc_s_nan = utf8_from_bytes("NaN");
    tc_s_inf = utf8_from_bytes("Infinity");
    tc_s_empty = utf8_empty();
    tc_s_null = utf8_from_bytes("null");
    tc_s_comma = utf8_from_bytes(",");
    tc_s_object = utf8_from_bytes("[object]");
}

// ---------------------------------------------------------------------------
// strings across the ABI boundary
//
// The canonical ABI passes a string as (pointer, byte length) into linear
// memory; a `utf8_string` owns a GC byte array. There is no bulk move between
// the two, so both directions are a loop.

fn tc_str_in(p: i32, l: i32) -> &utf8_string {
    if l <=s 0 { return tc_s_empty!; }
    let bytes = [wax_hash_bytes| 0; l];
    let i: i32 = 0;
    while i <s l {
        bytes[i] = mem.load8(p + i) as i32_u;
        i += 1;
    }
    // The host said it was a string, so it is valid UTF-8 or the host is
    // broken. `try` rather than `from` so a broken host is an empty string
    // instead of a trap that takes the instance with it.
    let (valid, out) = utf8_try_from_bytes(bytes);
    if valid == 0 { return tc_s_empty!; }
    out!
}

// Copies into freshly allocated linear memory and answers the pointer. The
// length is `utf8_byte_length`, which the caller already has.
fn tc_str_out(s: &utf8_string) -> i32 {
    let l = utf8_byte_length(s);
    if l == 0 { return 0; }
    let p = alloc(l, 1);
    let i: i32 = 0;
    while i <s l {
        mem.store8(p + i, utf8_at_byte(s, i));
        i += 1;
    }
    p
}

// ---------------------------------------------------------------------------
// constructors

fn tc_null() -> &jv_value { jv_null() }

fn tc_bool(b: i32) -> &jv_value { jv_bool(b) }

fn tc_num(x: f64) -> &jv_value { jv_f64(x) }

fn tc_text(s: &utf8_string) -> &jv_value { jv_string(s) }

// Intern one pool constant. Called by the generated `#[start]`, once per
// string, IN POOL ORDER — the index a use site names is this one's position.
fn tc_intern_const(at: i32, len: i32) {
    tc_consts = pv_push(tc_consts!, jv_string(tc_str_in(at, len)));
}

// A pool constant, by index. See `tc_consts`.
fn tc_const(i: i32) -> &jv_value {
    let (found, v) = pv_get(tc_consts!, i);
    if found == 0 { return jv_null(); }
    v! as &jv_value
}

// The `&utf8_string` behind a pool constant, for the places that want text
// rather than a value.
fn tc_const_str(i: i32) -> &utf8_string {
    jv_require_string(tc_const(i))
}

// ---------------------------------------------------------------------------
// reading a value
//
// Every one of these is total. A card that reads a number out of a string gets
// 0 rather than a trap: the interpreter's accessors are partial and answer
// `None`, and the shape that loses the least here is the zero, which is what
// the old cell runtime did when it read a `nil` payload.

fn tc_num_of(v: &jv_value) -> f64 {
    let (found, x) = jv_get_f64(v);
    if found == 0 { return 0.0; }
    x
}

fn tc_is_text(v: &jv_value) -> i32 {
    if jv_kind(v) == jv_kind_string { 1 } else { 0 }
}

fn tc_is_null(v: &jv_value) -> i32 {
    if jv_kind(v) == jv_kind_null { 1 } else { 0 }
}

// JS truthiness, which is what `@show` and `if` ask for.
// `core/value_eval.mbt`'s `Value::is_truthy`: null and false and 0 and NaN and
// "" are false, and a list or a map is ALWAYS true however empty it is.
fn tc_truthy(v: &jv_value) -> i32 {
    let k = jv_kind(v);
    if k == jv_kind_null { return 0; }
    if k == jv_kind_bool { return jv_require_bool(v); }
    if k == jv_kind_f64 {
        let x = jv_require_f64(v);
        if x != x { return 0; }
        if x == 0.0 { return 0; }
        return 1;
    }
    if k == jv_kind_string {
        if utf8_is_empty(jv_require_string(v)) == 1 { return 0; }
        return 1;
    }
    1
}

// The OTHER truthiness: what a `pred` asks, where an empty collection is false.
// `core/value_eval.mbt`'s `pred_truthy`. The two differ and both are right;
// keeping them apart is what stops `@show=".items"` from always showing.
fn tc_pred_truthy(v: &jv_value) -> i32 {
    let k = jv_kind(v);
    if k == jv_kind_vector {
        if jv_vector_count(jv_require_vector(v)) == 0 { return 0; }
        return 1;
    }
    if k == jv_kind_ordered_map {
        if jv_ordered_map_count(jv_require_ordered_map(v)) == 0 { return 0; }
        return 1;
    }
    tc_truthy(v)
}

// ---------------------------------------------------------------------------
// equality and ordering

// `jv_equal` is structural and almost right. Two deviations from
// `core/value_eval.mbt`'s `impl Eq for Value`, both about f64:
//
//   - jv compares BIT PATTERNS, so `+0.0` and `-0.0` are unequal. tutuca says
//     they are equal, and so does JavaScript, and a card that counts down to
//     zero by subtraction can reach the negative one.
//   - bit patterns also make `NaN == NaN` true, which is what tutuca says too
//     (deliberately — see the note on that impl), so THAT one needs no help.
fn tc_eq(a: &jv_value, b: &jv_value) -> i32 {
    if jv_kind(a) == jv_kind_f64 {
        if jv_kind(b) == jv_kind_f64 {
            let x = jv_require_f64(a);
            let y = jv_require_f64(b);
            if x == 0.0 {
                if y == 0.0 { return 1; }
            }
            return jv_equal(a, b);
        }
    }
    jv_equal(a, b)
}

// -1, 0 or 1. Two strings compare as text and everything else as numbers,
// which is what the corpus pins.
fn tc_cmp(a: &jv_value, b: &jv_value) -> i32 {
    if tc_is_text(a) == 1 {
        if tc_is_text(b) == 1 {
            return utf8_compare(jv_require_string(a), jv_require_string(b));
        }
    }
    let x = tc_num_of(a);
    let y = tc_num_of(b);
    if x < y { return -1; }
    if x > y { return 1; }
    0
}

// ---------------------------------------------------------------------------
// text of a value

// A number as text. NOT a float formatter: the integer part exactly, then up to
// six fractional digits with the trailing zeros trimmed. That is what a
// counter, a total and a price need and it is not what `0.1 + 0.2` needs — see
// "Known deviations" in README.md. Ported unchanged from the cell runtime, so
// the deviation did not move when the representation did.
fn tc_num_text(x: f64) -> &utf8_string {
    if x != x { return tc_s_nan!; }
    let a = x;
    let neg: i32 = 0;
    if a < 0.0 {
        neg = 1;
        a = 0.0 - a;
    }
    if a > 1.0e15 { return tc_s_inf!; }

    // Digits of the integer part, least significant first.
    let tmp = [wax_hash_bytes| 0; 24];
    let k: i32 = 0;
    let ip = a.floor();
    let fr = a - ip;
    if ip < 1.0 {
        tmp[0] = 48;
        k = 1;
    } else {
        while ip >= 1.0 {
            let q = (ip / 10.0).floor();
            let d = (ip - q * 10.0) as i32_s;
            tmp[k] = d + 48;
            k += 1;
            ip = q;
        }
    }

    let out = [wax_hash_bytes| 0; 48];
    let n: i32 = 0;
    if neg == 1 {
        out[0] = 45;
        n = 1;
    }
    let j = k;
    while j >s 0 {
        out[n] = tmp[j - 1] as i32_u;
        n += 1;
        j -= 1;
    }
    if fr > 0.0 {
        out[n] = 46;
        n += 1;
        let last = n;
        let c: i32 = 0;
        while c <s 6 {
            fr = fr * 10.0;
            let d = fr.floor() as i32_s;
            out[n] = d + 48;
            n += 1;
            if d != 0 { last = n; }
            fr = fr - (d as f64_s);
            c += 1;
        }
        n = last;
    }
    utf8_from_bytes(utf8_copy_storage(out, 0, n))
}

// A value as text — `core/value_eval.mbt`'s `to_display_string`, which is
// JavaScript's `${v}`.
//
// The three that are easy to get wrong, and that the corpus caught:
//   - null is "null", not the empty string. The empty string is `tpl_piece`,
//     which is a DIFFERENT function and is the one a template uses.
//   - a list joins with "," and its elements go through `tpl_piece`, so a null
//     ELEMENT is "" even though a null VALUE is "null". That is JS
//     `Array.join`, faithfully.
//   - a map is "[object]", which is what `${{}}` gives you.
fn tc_display(v: &jv_value) -> &utf8_string {
    let k = jv_kind(v);
    if k == jv_kind_string { return jv_require_string(v); }
    if k == jv_kind_f64 { return tc_num_text(jv_require_f64(v)); }
    if k == jv_kind_bool {
        if jv_require_bool(v) == 1 { return tc_s_true!; }
        return tc_s_false!;
    }
    if k == jv_kind_null { return tc_s_null!; }
    if k == jv_kind_vector {
        let items = jv_require_vector(v);
        let n = jv_vector_count(items);
        let acc = tc_s_empty!;
        let i: i32 = 0;
        while i <s n {
            if i != 0 { acc = utf8_concat(acc, tc_s_comma!); }
            acc = utf8_concat(acc, tc_tpl(jv_vector_at(items, i)));
            i += 1;
        }
        return acc;
    }
    if k == jv_kind_ordered_map { return tc_s_object!; }
    if k == jv_kind_record { return tc_s_object!; }
    tc_s_empty!
}

// One piece of a `$'…'` template, and one element of a joined list. JS
// `Array.join` turns null into "" and String()-coerces the rest.
fn tc_tpl(v: &jv_value) -> &utf8_string {
    if jv_kind(v) == jv_kind_null { return tc_s_empty!; }
    tc_display(v)
}

fn tc_str(v: &jv_value) -> &jv_value { jv_string(tc_display(v)) }

fn tc_concat(a: &jv_value, b: &jv_value) -> &jv_value {
    jv_string(utf8_concat(tc_display(a), tc_display(b)))
}

// The fold a `$'…'` template compiles to. `tpl_piece` rather than
// `to_display_string`, so an interpolated null vanishes instead of spelling
// itself out.
fn tc_tpl_concat(a: &jv_value, b: &jv_value) -> &jv_value {
    jv_string(utf8_concat(tc_tpl(a), tc_tpl(b)))
}

// ---------------------------------------------------------------------------
// arithmetic

// `+` is two operators. It joins two strings and adds two numbers, and which
// one it is depends on the VALUES rather than on anything the generator knew.
//
// A MIXED pair fails, which is what the corpus says: it takes the
// two-strings case first and then requires both to be numbers. An earlier
// version of this joined a mixed pair instead, on the theory that an opaque
// event argument is better joined than refused — the corpus disagrees, and the
// corpus is the language.
fn tc_both_num(a: &jv_value, b: &jv_value) -> i32 {
    if jv_kind(a) != jv_kind_f64 { return 0; }
    if jv_kind(b) != jv_kind_f64 { return 0; }
    1
}

fn tc_add(a: &jv_value, b: &jv_value) -> &jv_value {
    if tc_is_text(a) == 1 {
        if tc_is_text(b) == 1 { return tc_concat(a, b); }
    }
    if tc_both_num(a, b) == 0 {
        tc_fail = 1;
        return jv_null();
    }
    jv_f64(jv_require_f64(a) + jv_require_f64(b))
}

fn tc_sub(a: &jv_value, b: &jv_value) -> &jv_value {
    if tc_both_num(a, b) == 0 {
        tc_fail = 1;
        return jv_null();
    }
    jv_f64(jv_require_f64(a) - jv_require_f64(b))
}

fn tc_mul(a: &jv_value, b: &jv_value) -> &jv_value {
    if tc_both_num(a, b) == 0 {
        tc_fail = 1;
        return jv_null();
    }
    jv_f64(jv_require_f64(a) * jv_require_f64(b))
}

// Division by zero has no answer, so the transition does not happen. Not an
// infinity, and not a zero: `arith` answers `None` and the None is the point.
fn tc_div(a: &jv_value, b: &jv_value) -> &jv_value {
    if tc_both_num(a, b) == 0 {
        tc_fail = 1;
        return jv_null();
    }
    let y = jv_require_f64(b);
    if y == 0.0 {
        tc_fail = 1;
        return jv_null();
    }
    jv_f64(jv_require_f64(a) / y)
}

// `mod` is the INTEGER remainder — `arith` truncates both sides to int and
// takes `%`, so `7.5 mod 2` is `1` and not `1.5`.
fn tc_mod(a: &jv_value, b: &jv_value) -> &jv_value {
    if tc_both_num(a, b) == 0 {
        tc_fail = 1;
        return jv_null();
    }
    let y = jv_require_f64(b);
    if y == 0.0 {
        tc_fail = 1;
        return jv_null();
    }
    let xi = jv_require_f64(a) as i32_s;
    let yi = y as i32_s;
    jv_f64((xi %s yi) as f64_s)
}

fn tc_neg(a: &jv_value) -> &jv_value { jv_f64(0.0 - tc_num_of(a)) }

fn tc_not(a: &jv_value) -> &jv_value {
    if tc_truthy(a) == 0 { jv_bool(1) } else { jv_bool(0) }
}

// `empty?` — null is empty, "" is empty, and an empty collection is empty.
fn tc_empty(a: &jv_value) -> &jv_value {
    let k = jv_kind(a);
    if k == jv_kind_null { return jv_bool(1); }
    if k == jv_kind_string {
        return jv_bool(utf8_is_empty(jv_require_string(a)));
    }
    if k == jv_kind_vector {
        if jv_vector_count(jv_require_vector(a)) == 0 { return jv_bool(1); }
        return jv_bool(0);
    }
    if k == jv_kind_ordered_map {
        if jv_ordered_map_count(jv_require_ordered_map(a)) == 0 { return jv_bool(1); }
        return jv_bool(0);
    }
    jv_bool(0)
}

// --- the six that used to be refused ---------------------------------------
//
// None of them needed anything the stdlib does not have, and none of them
// needs Unicode: the language defines `lower`/`upper` as an ASCII
// A-Z/a-z shift and `trim` over exactly " \t\n\r", so byte-level work here
// agrees with the interpreter by construction rather than by luck.

// THE RULE THESE SEVEN SHARE.
//
// The language answers `None` for an argument of the wrong
// shape — `lower 3`, `contains 3 'a'`, `min 'a' 'b'`, `len 3` — and a None
// abandons the transition. Every one of these used to answer something
// PLAUSIBLE instead: the value unchanged, or `false`, or zero, or a comparison
// that read two strings as numbers.
//
// The corpus found the first of them (`lower` of a number, inside a `pred`
// called with the wrong argument) the first time this backend was held to the
// value table, and the rest are the same mistake in the same family. A
// plausible answer is worse than no answer here, because "the transition did
// not happen" is a thing a card author can see and `false` is not.

// `len` — codepoints for a string, items for a collection. `size_of` in
// `core/value_eval.mbt`, which has no answer for anything else.
fn tc_len(v: &jv_value) -> &jv_value {
    let k = jv_kind(v);
    if k == jv_kind_string {
        return jv_f64(utf8_codepoint_length(jv_require_string(v)) as f64_s);
    }
    if k == jv_kind_vector {
        return jv_f64(jv_vector_count(jv_require_vector(v)) as f64_s);
    }
    if k == jv_kind_ordered_map {
        return jv_f64(jv_ordered_map_count(jv_require_ordered_map(v)) as f64_s);
    }
    tc_fail = 1;
    jv_null()
}

// `has` — a key in a map, or a value in a list. Both, because the interpreter
// does both, and the map case keys on the DISPLAY string, which is the same
// key the generated `hasIn<X>` mutator uses.
fn tc_has(hay: &jv_value, needle: &jv_value) -> &jv_value {
    let k = jv_kind(hay);
    if k == jv_kind_ordered_map {
        return jv_bool(jv_ordered_map_contains(jv_require_ordered_map(hay), tc_display(needle)));
    }
    if k == jv_kind_vector {
        let items = jv_require_vector(hay);
        let n = jv_vector_count(items);
        let i: i32 = 0;
        while i <s n {
            if tc_eq(jv_vector_at(items, i), needle) == 1 { return jv_bool(1); }
            i += 1;
        }
        return jv_bool(0);
    }
    // Neither a map nor a list has no membership to ask about, which is not
    // the same as answering no.
    tc_fail = 1;
    jv_null()
}

// `contains` — substring, and text only, which is what the corpus says.
fn tc_contains(hay: &jv_value, needle: &jv_value) -> &jv_value {
    if tc_is_text(hay) == 0 { tc_fail = 1; return jv_null(); }
    if tc_is_text(needle) == 0 { tc_fail = 1; return jv_null(); }
    let h = jv_require_string(hay);
    let n = jv_require_string(needle);
    let hl = utf8_byte_length(h);
    let nl = utf8_byte_length(n);
    if nl == 0 { return jv_bool(1); }
    if nl >s hl { return jv_bool(0); }
    let at: i32 = 0;
    while at <=s hl - nl {
        let j: i32 = 0;
        'mismatch: do {
            while j <s nl {
                if utf8_at_byte(h, at + j) != utf8_at_byte(n, j) { br 'mismatch; }
                j += 1;
            }
            return jv_bool(1);
        }
        at += 1;
    }
    jv_bool(0)
}

// ASCII case, byte for byte. A multi-byte codepoint's bytes are all >= 0x80 and
// so are left alone, which is exactly what the interpreter's char loop does.
fn tc_case(v: &jv_value, down: i32) -> &jv_value {
    if tc_is_text(v) == 0 { tc_fail = 1; return jv_null(); }
    let s = jv_require_string(v);
    let l = utf8_byte_length(s);
    let out = [wax_hash_bytes| 0; l];
    let i: i32 = 0;
    while i <s l {
        let b = utf8_at_byte(s, i);
        if down == 1 {
            if b >=u 65 { if b <=u 90 { b += 32; } }
        } else {
            if b >=u 97 { if b <=u 122 { b -= 32; } }
        }
        out[i] = b;
        i += 1;
    }
    jv_string(utf8_from_bytes(out))
}

fn tc_lower_case(v: &jv_value) -> &jv_value { tc_case(v, 1) }

fn tc_upper_case(v: &jv_value) -> &jv_value { tc_case(v, 0) }

fn tc_space(b: i32) -> i32 {
    if b == 32 { return 1; }
    if b == 9 { return 1; }
    if b == 10 { return 1; }
    if b == 13 { return 1; }
    0
}

// `trim` — exactly " \t\n\r", which is the `chars=` the interpreter passes.
// All four are single-byte, so trimming bytes cannot land mid-codepoint.
fn tc_trim(v: &jv_value) -> &jv_value {
    if tc_is_text(v) == 0 { tc_fail = 1; return jv_null(); }
    let s = jv_require_string(v);
    let l = utf8_byte_length(s);
    let start: i32 = 0;
    'lead: do {
        while start <s l {
            if tc_space(utf8_at_byte(s, start)) == 0 { br 'lead; }
            start += 1;
        }
    }
    if start == l { return jv_string(tc_s_empty!); }
    let stop = l;
    'trail: do {
        while stop >s start {
            if tc_space(utf8_at_byte(s, stop - 1)) == 0 { br 'trail; }
            stop -= 1;
        }
    }
    jv_string(utf8_slice_bytes(s, start, stop - start))
}

// Both NUMBERS, which `tc_cmp` does not require: it reads two strings as text
// and everything else as numbers, so `min 'a' 'b'` used to answer `'a'` where
// the interpreter has no answer at all.
fn tc_min(a: &jv_value, b: &jv_value) -> &jv_value {
    if tc_both_num(a, b) == 0 { tc_fail = 1; return jv_null(); }
    if tc_cmp(a, b) <=s 0 { a } else { b }
}

fn tc_max(a: &jv_value, b: &jv_value) -> &jv_value {
    if tc_both_num(a, b) == 0 { tc_fail = 1; return jv_null(); }
    if tc_cmp(a, b) >=s 0 { a } else { b }
}

// `clamp lo hi` answers `lo` when `hi <s lo`, which is the language's
// choice: a range with no answer that is not a guess picks the low end.
fn tc_clamp(v: &jv_value, lo: &jv_value, hi: &jv_value) -> &jv_value {
    if tc_both_num(v, lo) == 0 { tc_fail = 1; return jv_null(); }
    if jv_kind(hi) != jv_kind_f64 { tc_fail = 1; return jv_null(); }
    if tc_cmp(v, lo) <s 0 { return lo; }
    if tc_cmp(v, hi) >s 0 { return hi; }
    v
}

// ---------------------------------------------------------------------------
// `new`'s target
//
// `new Label` builds the zero of a declared type and binds it to `@cur`, the
// one binding a compiled handler owns. Reading `@cur` before a `new` has made
// one is a FAILURE and not a null — `read_place` says so, and the reason is
// that the target comes from a `new` in this very body, so its absence is a
// mistake where a missing ordinary binding is a normal answer.
//
// The local is `&?jv_value`, so "not made yet" is the null it starts at and
// there is no second flag to keep in step.
fn tc_target(v: &?jv_value) -> &jv_value {
    match v {
        made: &jv_value => { return made; }
        _ => {
            tc_fail = 1;
            return jv_null();
        }
    }
    unreachable;
}

// ---------------------------------------------------------------------------
// mutating a collection
//
// The collection methods, one for one. The language answers `None` for
// a pair it does not implement — `.items.push` on a number, and the four names
// `collection_method` parses but the interpreter never handled (`clear`,
// `delete`, `set`, `removeAt`) — and the transition then does not happen.
// Here the same cases answer the value UNCHANGED, which the dispatch layer
// reports as `unchanged` for the same reason: a transition that does not hold
// is a transition that does not happen.
//
// A set is a Map keyed by the member's DISPLAY string, holding `true`. That is
// tutuca's representation, not a choice made here, and it is why `add`,
// `remove` and `toggle` are map operations.

const tc_m_push: i32 = 1;
const tc_m_insert_at: i32 = 2;
const tc_m_set_at: i32 = 3;
const tc_m_delete_at: i32 = 4;
const tc_m_add: i32 = 5;
const tc_m_remove: i32 = 6;
const tc_m_toggle: i32 = 7;

// An integral index, or -1. `Value::as_key`'s numeric arm: a non-integral
// number is not a key at all.
fn tc_index_of(v: &jv_value) -> i32 {
    if jv_kind(v) != jv_kind_f64 { return -1; }
    let x = jv_require_f64(v);
    let i = x as i32_s;
    if (i as f64_s) != x { return -1; }
    i
}

// Rebuild a vector with one item inserted before `at`. Past the end appends,
// which is the bounds rule `insertInXAt` follows.
fn tc_vec_insert(items: &jv_vector_value, at: i32, v: &jv_value) -> &jv_value {
    let n = jv_vector_count(items);
    let k = if at <s 0 { n } else { if at >s n { n } else { at } };
    let out = jv_vector_empty();
    let i: i32 = 0;
    while i <s k {
        out = jv_vector_push(out, jv_vector_at(items, i));
        i += 1;
    }
    out = jv_vector_push(out, v);
    while i <s n {
        out = jv_vector_push(out, jv_vector_at(items, i));
        i += 1;
    }
    out
}

fn tc_vec_delete(items: &jv_vector_value, at: i32) -> &jv_value {
    let n = jv_vector_count(items);
    if at <s 0 { return items; }
    if at >=s n { return items; }
    let out = jv_vector_empty();
    let i: i32 = 0;
    while i <s n {
        if i != at { out = jv_vector_push(out, jv_vector_at(items, i)); }
        i += 1;
    }
    out
}

fn tc_method(old: &jv_value, which: i32, a: &jv_value, b: &jv_value) -> &jv_value {
    let k = jv_kind(old);
    if k == jv_kind_vector {
        let items = jv_require_vector(old);
        if which == tc_m_push { return jv_vector_push(items, a); }
        if which == tc_m_insert_at {
            return tc_vec_insert(items, tc_index_of(a), b);
        }
        if which == tc_m_set_at {
            let at = tc_index_of(a);
            if at <s 0 { return old; }
            if at >s jv_vector_count(items) { return old; }
            return jv_vector_assoc(items, at, b);
        }
        if which == tc_m_delete_at {
            return tc_vec_delete(items, tc_index_of(a));
        }
        return old;
    }
    if k == jv_kind_ordered_map {
        let entries = jv_require_ordered_map(old);
        if which == tc_m_set_at {
            return jv_ordered_map_assoc(entries, tc_display(a), b);
        }
        if which == tc_m_delete_at {
            let key = tc_display(a);
            if jv_ordered_map_contains(entries, key) == 0 { return old; }
            return jv_ordered_map_dissoc(entries, key);
        }
        if which == tc_m_add {
            return jv_ordered_map_assoc(entries, tc_display(a), jv_bool(1));
        }
        if which == tc_m_remove {
            return jv_ordered_map_dissoc(entries, tc_display(a));
        }
        if which == tc_m_toggle {
            let key = tc_display(a);
            if jv_ordered_map_contains(entries, key) == 1 {
                return jv_ordered_map_dissoc(entries, key);
            }
            return jv_ordered_map_assoc(entries, key, jv_bool(1));
        }
        return old;
    }
    old
}

// ---------------------------------------------------------------------------
// paths
//
// `.a[k].b` — one step down, and one level of the spine rebuilt on the way
// back up. `core/path_step.mbt`'s `step_get` and `step_put`, less the frame-only
// steps a compiled handler never sees.

// A `.field` step. A field the value does not carry reads NULL — the checker
// names an undeclared one, and a schema-less card may grow a field the map has
// not seen yet.
fn tc_step_field(v: &jv_value, name: &utf8_string) -> &jv_value {
    let k = jv_kind(v);
    if k == jv_kind_ordered_map {
        let (found, out) = jv_ordered_map_get(jv_require_ordered_map(v), name);
        if found == 0 { return jv_null(); }
        return out!;
    }
    if k == jv_kind_record { return tc_get(jv_require_record(v), name); }
    jv_null()
}

// A `[key]` step. A key that is not there is a FAILURE, not a null: reading
// past the end of a list is the case "failure is no change" exists for, and a
// handler that quietly worked on null would write it back.
//
// So would a key that is not a key at all — `Value::as_key` answers None for a
// non-integral number and for anything that is neither text nor number.
fn tc_step_index(v: &jv_value, key: &jv_value) -> &jv_value {
    let k = jv_kind(v);
    if k == jv_kind_vector {
        let at = tc_index_of(key);
        if at <s 0 {
            tc_fail = 1;
            return jv_null();
        }
        let (found, out) = jv_vector_get(jv_require_vector(v), at);
        if found == 0 {
            tc_fail = 1;
            return jv_null();
        }
        return out!;
    }
    if jv_kind(key) != jv_kind_string {
        if jv_kind(key) != jv_kind_f64 {
            tc_fail = 1;
            return jv_null();
        }
        if tc_index_of(key) <s 0 {
            tc_fail = 1;
            return jv_null();
        }
    }
    if k == jv_kind_ordered_map {
        let (found, out) = jv_ordered_map_get(jv_require_ordered_map(v), tc_display(key));
        if found == 0 {
            tc_fail = 1;
            return jv_null();
        }
        return out!;
    }
    if k == jv_kind_record {
        let target = jv_require_record(v);
        let name = tc_display(key);
        if jv_record_has_field(target, name) == 0 {
            tc_fail = 1;
            return jv_null();
        }
        return tc_get(target, name);
    }
    tc_fail = 1;
    jv_null()
}

// `v` with the slot at a `.field` replaced — `Value::with_field_opt`.
//
// A map and a record take one. Anything else does not, and answering the value
// unchanged would make `.name.x = 1` on a string look like it worked, so it
// fails the write the way the interpreter's `None` does.
fn tc_step_put_field(
    v: &jv_value,
    name: &utf8_string,
    child: &jv_value,
) -> &jv_value {
    let k = jv_kind(v);
    if k == jv_kind_ordered_map { return jv_ordered_map_assoc(jv_require_ordered_map(v), name, child); }
    if k == jv_kind_record {
        return tc_set(jv_require_record(v), name, child);
    }
    tc_fail = 1;
    v
}

// `v` with the slot at a `[key]` replaced.
//
// A key that is not there REFUSES THE WHOLE WRITE. Growing a collection by
// assigning past its end is what `push` and `insertAt` are for, and a write
// that silently created a slot would make a typo into data.
fn tc_step_put_index(
    v: &jv_value,
    key: &jv_value,
    child: &jv_value,
) -> &jv_value {
    let k = jv_kind(v);
    if k == jv_kind_vector {
        let at = tc_index_of(key);
        let items = jv_require_vector(v);
        if at <s 0 {
            tc_fail = 1;
            return v;
        }
        if at >=s jv_vector_count(items) {
            tc_fail = 1;
            return v;
        }
        return jv_vector_assoc(items, at, child);
    }
    if k == jv_kind_ordered_map {
        let entries = jv_require_ordered_map(v);
        let name = tc_display(key);
        if jv_ordered_map_contains(entries, name) == 0 {
            tc_fail = 1;
            return v;
        }
        return jv_ordered_map_assoc(entries, name, child);
    }
    if k == jv_kind_record {
        let target = jv_require_record(v);
        let name = tc_display(key);
        if jv_record_has_field(target, name) == 0 {
            tc_fail = 1;
            return v;
        }
        return tc_set(target, name, child);
    }
    tc_fail = 1;
    v
}

// ---------------------------------------------------------------------------
// the state record

fn tc_get(s: &jv_record_value, name: &utf8_string) -> &jv_value {
    let (found, v) = jv_record_get(s, name);
    if found == 0 { return jv_null(); }
    v!
}

// A successor. `jv_record_try_set` validates against the schema and answers a
// status; a rejected write leaves the record alone, which is the same thing the
// old runtime did when `field_index` missed.
//
// Identity is preserved when the value is equal (`record.wax`), and that is
// what `handle-event` reads to tell `changed` from `unchanged` — a reference
// comparison where the cell runtime compared every byte of the instance.
fn tc_set(
    s: &jv_record_value,
    name: &utf8_string,
    v: &jv_value,
) -> &jv_record_value {
    let (status, out) = jv_record_try_set(s, name, v);
    if status != jv_record_ok { return s; }
    out!
}

// ---------------------------------------------------------------------------
// an enricher's bindings
//
// `Env.binds` in the interpreter is a plain map, and so is this. No schema, no
// declared types, no truncation: a binding is whatever was bound, and a name
// nobody bound reads null. An ORDERED map, like every other map this compiler
// builds, so the order a card binds names in is the order a reader sees them.

// `&jv_value` and not `&jv_ordered_map_value` throughout, so the local an
// enricher accumulates in has ONE type from its first assignment to its last —
// a `let` takes the type of what it is initialized with, and a body that starts
// from the narrow one cannot then be assigned the wide one.
fn tc_binds_empty() -> &jv_value { jv_ordered_map_empty() }

// The bindings an in-loop `enrich` was handed. Anything that is not a map — a
// caller that passed nothing, or a host that passed something else — starts the
// enricher from empty rather than trapping.
fn tc_binds_in(v: &jv_value) -> &jv_value {
    if jv_kind(v) != jv_kind_ordered_map { return tc_binds_empty(); }
    v
}

fn tc_bind_put(binds: &jv_value, name: &utf8_string, v: &jv_value) -> &jv_value {
    jv_ordered_map_assoc(jv_require_ordered_map(tc_binds_in(binds)), name, v)
}

// An Int field truncates on the way in, which the corpus pins. The
// schema cannot do this: tutuca's Int and Double are one jv kind, so the
// generator emits this call at the assignment sites of the fields it declared
// as integers, and nowhere else.
fn tc_trunc(v: &jv_value) -> &jv_value {
    if jv_kind(v) != jv_kind_f64 { return v; }
    jv_f64(jv_require_f64(v).trunc())
}

// ---------------------------------------------------------------------------
// instances

fn tc_intern(s: &jv_record_value) -> i32 {
    let h = pv_count(tc_insts!);
    tc_insts = pv_push(tc_insts!, s);
    h
}

fn tc_deref(h: i32) -> &jv_record_value {
    let (found, v) = pv_get(tc_insts!, h);
    if found == 0 { unreachable; }
    v! as &jv_record_value
}

// ---------------------------------------------------------------------------
// buffered effects
//
// Kinds, which the generated flush switches on. Only the flush knows how to
// reach the host: `control` is imported conditionally, so a card that performs
// no effect has no import to call and nothing here mentions one.

// Kind 1 and 3 are the two an addressed effect needs; 5 carries a path as
// well. The numbers are not contiguous because two of them named effects that
// no longer exist, and renumbering would silently change what an already-built
// card means to a host that reads the same table.
const tc_e_send: i32 = 1;
const tc_e_stop: i32 = 3;

const tc_e_send_at: i32 = 5;

// The routed four. `intent` and `forward` carry a ROUTE, which is one small
// integer because the set of routes is closed (see `@abi.route_*`). `reply` and
// `fail` carry one value and no name — the walk addresses them — so their
// argument list has exactly one entry and their name is the empty string.
const tc_e_intent: i32 = 6;
const tc_e_forward: i32 = 7;
const tc_e_reply: i32 = 8;
const tc_e_fail: i32 = 9;

// `steps` is null for every effect but a `sendAt`, which is the only one that
// addresses somewhere other than here. It is a list of `tc_pstep`, built by
// `send_at.wax` — the field is here rather than there because the buffer is,
// and one nullable word per effect is cheaper than a second buffer.
// `route` is 0 for every effect but an `intent` and a `forward`, which are the
// two the design gives a route. One i32 per effect, for the same reason `steps`
// is one nullable word: the buffer is here, and a second buffer for a field two
// kinds use would cost more than the field does.
type tc_effect = {
    kind: i32,
    name: &utf8_string,
    args: &?pv_vector,
    steps: &?pv_vector,
    route: i32,
};

fn tc_effect_new(
    kind: i32,
    name: &utf8_string,
    args: &?pv_vector,
    steps: &?pv_vector,
    route: i32,
) -> &tc_effect {
    { kind, name, args, steps, route }
}

fn tc_effect_reset() { tc_effects = pv_empty(); }

// The empty string, for a `stop` — which carries no name and no arguments but
// still takes a slot in the buffer so that the ORDER of the effects survives.
fn tc_empty_str() -> &utf8_string { tc_s_empty! }

fn tc_effect_push(kind: i32, name: &utf8_string, args: &?pv_vector) {
    tc_effects = pv_push(tc_effects!, tc_effect_new(kind, name, args, null, 0));
}

// The same, for the two effects that carry a route.
fn tc_effect_push_routed(
    kind: i32,
    name: &utf8_string,
    args: &?pv_vector,
    route: i32,
) {
    tc_effects = pv_push(tc_effects!, tc_effect_new(kind, name, args, null, route));
}

// The same, for the one effect that carries a path.
fn tc_effect_push_at(
    kind: i32,
    name: &utf8_string,
    args: &?pv_vector,
    steps: &?pv_vector,
) {
    tc_effects = pv_push(tc_effects!, tc_effect_new(kind, name, args, steps, 0));
}

fn tc_effect_count() -> i32 { pv_count(tc_effects!) }

fn tc_effect_at(i: i32) -> &tc_effect {
    pv_at(tc_effects!, i)! as &tc_effect
}

fn tc_effect_kind(i: i32) -> i32 { tc_effect_at(i).kind }

fn tc_effect_route(i: i32) -> i32 { tc_effect_at(i).route }

// The name and the arguments in the shape `control` takes them: a (pointer,
// length) pair into linear memory, and a `list<value>`.
fn tc_effect_name_ptr(i: i32) -> i32 { tc_str_out(tc_effect_at(i).name) }

fn tc_effect_name_len(i: i32) -> i32 {
    utf8_byte_length(tc_effect_at(i).name)
}

fn tc_effect_args_ptr(i: i32) -> i32 { tc_args_out(tc_effect_at(i).args) }

fn tc_effect_args_len(i: i32) -> i32 { tc_args_len(tc_effect_at(i).args) }

// ---------------------------------------------------------------------------
// argument lists
//
// One shape for both sources: the list the ABI handed in, and the list an
// expression built to call a `compute` with. `&?pv_vector` rather than
// `&pv_vector` so "no arguments" needs no allocation.

fn tc_arg_at(args: &?pv_vector, i: i32) -> &jv_value {
    match args {
        v: &pv_vector => {
            let (found, out) = pv_get(v, i);
            if found == 0 { return jv_null(); }
            return out! as &jv_value;
        }
        _ => { return jv_null(); }
    }
    unreachable;
}

fn tc_args_len(args: &?pv_vector) -> i32 {
    match args {
        v: &pv_vector => { return pv_count(v); }
        _ => { return 0; }
    }
    unreachable;
}

// The same list, lowered into linear memory as `list<value>` — cells end to
// end, which is what `control.send` and `control.emit` take.
fn tc_args_out(args: &?pv_vector) -> i32 {
    let n = tc_args_len(args);
    if n == 0 { return 0; }
    let p = alloc(n * 16, 8);
    let i: i32 = 0;
    while i <s n {
        tc_lower(tc_arg_at(args, i), p + i * 16);
        i += 1;
    }
    p
}

fn tc_args1(a: &jv_value) -> &?pv_vector { pv_push(pv_empty(), a) }

fn tc_args2(a: &jv_value, b: &jv_value) -> &?pv_vector {
    pv_push(pv_push(pv_empty(), a), b)
}

fn tc_args3(a: &jv_value, b: &jv_value, c: &jv_value) -> &?pv_vector {
    pv_push(pv_push(pv_push(pv_empty(), a), b), c)
}

fn tc_args4(
    a: &jv_value,
    b: &jv_value,
    c: &jv_value,
    d: &jv_value,
) -> &?pv_vector {
    pv_push(pv_push(pv_push(pv_push(pv_empty(), a), b), c), d)
}

// ---------------------------------------------------------------------------
// lifting and lowering `values.value`
//
// The wire shape is fixed by `dyncomp/host/wasm/abi.mjs`: 16 bytes, a
// discriminant at +0 and an 8-byte payload at +8, a `text` payload being a
// (pointer, length) pair inside those 8.
//
// The four scalar tags are here. `%list`, `%map` and `%instance` are u64
// handles into a host-side arena, which needs the `values` import — see
// `runtime/values.wax`, concatenated only for a card that can produce one.

const tc_tag_nil: i32 = 0;
const tc_tag_bool: i32 = 1;
const tc_tag_num: i32 = 2;
const tc_tag_text: i32 = 3;
// `values.value`'s seventh case: a same-bundle CHILD instance, as the
// host-assigned token `guest.instance` hands out.
//
// Carried as `jv_i64`, which is free: this runtime builds `jv_f64` and nothing
// else — tutuca has exactly one number — so an i64 in a card's value tree can
// only ever be a child token, and needs no tag of its own inside the guest to
// stay distinguishable from a count.
//
// Here rather than beside `tc_tag_list` in `lower_values.wax` because a child
// is a SCALAR on the wire: it is a token, not a handle into the value arena, so
// a card that holds children and no collections still imports no arena.
const tc_tag_instance: i32 = 6;

fn tc_lift_flat(kind: i32, p64: i64, p32: i32) -> &jv_value {
    if kind == tc_tag_bool {
        if (p64 & 0xff) as i32 != 0 { return jv_bool(1); }
        return jv_bool(0);
    }
    if kind == tc_tag_num {
        return jv_f64(p64.from_bits());
    }
    if kind == tc_tag_text {
        return jv_string(tc_str_in((p64 & 0xffffffff) as i32, p32));
    }
    if kind == tc_tag_instance { return jv_i64(p64); }
    jv_null()
}

// The four scalar tags of a wire cell. `tc_lift_cell`, which also knows the
// compound ones, is defined by whichever lowering half this build got — so a
// scalar-only card carries no code that mentions an arena it cannot reach.
fn tc_lift_scalar_cell(p: i32) -> &jv_value {
    let kind = mem.load8(p) as i32_u;
    if kind == tc_tag_bool {
        if mem.load8(p + 8) as i32_u != 0 { return jv_bool(1); }
        return jv_bool(0);
    }
    if kind == tc_tag_num {
        return jv_f64(mem.loadf64(p + 8));
    }
    if kind == tc_tag_text {
        return jv_string(tc_str_in(mem.load32(p + 8), mem.load32(p + 12)));
    }
    if kind == tc_tag_instance { return jv_i64(mem.load64(p + 8)); }
    jv_null()
}

fn tc_args_lift(ap: i32, al: i32) -> &?pv_vector {
    if al <=s 0 { return null; }
    let out = pv_empty();
    let i: i32 = 0;
    while i <s al {
        out = pv_push(out, tc_lift_cell(ap + i * 16));
        i += 1;
    }
    out
}

// ---------------------------------------------------------------------------
// the exports, less their names
//
// Everything below is the body of a `tutuca:component` export with the
// card-specific part taken out. The generated module still declares and exports
// the functions — the names carry an interface version and a resource method,
// and those are the generator's to spell — but the work is here, once, where it
// can be read.

// The zero instance. Every field at the default its declared type gives it,
// which is `jv_record_default` reading the schema the generated `#[start]`
// built.
fn tc_type_add(t: &jv_record_type) { tc_types = pv_push(tc_types!, t); }

fn tc_type_at(i: i32) -> &jv_record_type {
    let (found, v) = pv_get(tc_types!, i);
    if found == 0 { unreachable; }
    v! as &jv_record_type
}

fn tc_zero_of(i: i32) -> &jv_record_value { jv_record_default(tc_type_at(i)) }

// Which component an instance IS, as the index every arm is numbered by.
//
// The record carries the answer already: `definition` is a field on the value's
// own struct, every successor keeps it (`jv_record_try_set`), and each
// `jv_record_type_create` allocates a fresh one — so identity is a pointer
// compare, over a list that is as long as the card has components. No hidden
// field, and no side table that three separate places would have to agree to
// keep up to date.
fn tc_comp_of(s: &jv_record_value) -> i32 {
    let d = jv_record_definition(s);
    let n = pv_count(tc_types!);
    let i: i32 = 0;
    while i <s n {
        if tc_type_at(i) == d { return i; }
        i = i + 1;
    }
    -1
}

// The constructor's `args`: a `list<tuple<string, value>>`, stride 24, the name
// at +0 as (pointer, length) and the value cell at +8.
//
// A name the schema does not carry is IGNORED, which is what the cell runtime
// did when `field_index` missed. `tc_set` is the one that decides, and it
// declines a value of the wrong type as well as a name that does not exist.
fn tc_apply_args(s: &jv_record_value, ap: i32, al: i32) -> &jv_record_value {
    let out = s;
    let i: i32 = 0;
    while i <s al {
        let base = ap + i * 24;
        let name = tc_str_in(mem.load32(base), mem.load32(base + 4));
        out = tc_set(out, name, tc_lift_cell(base + 8));
        i += 1;
    }
    out
}

// `get-field` — writes the whole `option<value>`: a discriminant at +0 and the
// value at +8.
//
// A field the schema does not carry answers `none`, where the cell runtime
// answered `some(nil)` for a field it had refused but still allocated a cell
// for. A refused field is now simply absent, and `none` is the truthful answer.
fn tc_get_field(s: &jv_record_value, np: i32, nl: i32, area: i32) {
    let (found, v) = jv_record_get(s, tc_str_in(np, nl));
    if found == 0 {
        mem.store32(area, 0);
        return;
    }
    mem.store32(area, 1);
    tc_lower(v!, area + 8);
}

// `with-field` — the successor's handle, or -1 for `none`.
//
// The schema validates: an unknown name and a value of the wrong type both
// answer -1, where the cell runtime checked only the name and then wrote
// whatever joined payload it was handed into the cell. That is a real
// tightening, and it is free — `jv_record_try_set` was always going to run.
fn tc_with_field(
    s: &jv_record_value,
    np: i32,
    nl: i32,
    kind: i32,
    p64: i64,
    p32: i32,
) -> i32 {
    let name = tc_str_in(np, nl);
    let (status, out) = jv_record_try_set(s, name, tc_lift_flat(kind, p64, p32));
    if status != jv_record_ok { return -1; }
    tc_intern(out!)
}

// Did the handler change anything?
//
// Reference equality, because `jv_record_try_set` answers the SAME record when
// the value it was given is equal to the one already there. The cell runtime
// compared every byte of the instance to learn this; a successor that shares
// structure with its predecessor knows it already.
fn tc_same(a: &jv_record_value, b: &jv_record_value) -> i32 {
    if a == b { 1 } else { 0 }
}

// One arm of a dispatch chain: is the name this call arrived with the constant
// at `idx`? The name is lifted ONCE by the caller, so a card with twelve
// handlers does not build twelve copies of it.
fn tc_is(name: &utf8_string, idx: i32) -> i32 {
    utf8_equal(name, tc_const_str(idx))
}

// Writes the 16-byte cell. Answers 1 when it wrote one, 0 when the value is
// compound and this build has no arena to put it in.
fn tc_lower_scalar(v: &jv_value, dest: i32) -> i32 {
    let k = jv_kind(v);
    if k == jv_kind_null {
        mem.store32(dest, tc_tag_nil);
        mem.store64(dest + 8, 0);
        return 1;
    }
    if k == jv_kind_bool {
        mem.store32(dest, tc_tag_bool);
        mem.store64(dest + 8, 0);
        mem.store32(dest + 8, jv_require_bool(v));
        return 1;
    }
    if k == jv_kind_f64 {
        mem.store32(dest, tc_tag_num);
        mem.storef64(dest + 8, jv_require_f64(v));
        return 1;
    }
    if k == jv_kind_string {
        let s = jv_require_string(v);
        mem.store32(dest, tc_tag_text);
        mem.store32(dest + 8, tc_str_out(s));
        mem.store32(dest + 12, utf8_byte_length(s));
        return 1;
    }
    if k == jv_kind_i64 {
        mem.store32(dest, tc_tag_instance);
        mem.store64(dest + 8, jv_require_i64(v));
        return 1;
    }
    0
}
