) {\n    match node {\n        b: &phm_bitmap_node => {\n            let i: i32 = 0;\n            while i <s b.slots.length() {\n                let key = b.slots[i];\n                if key == null { phm_node_each(b.slots[i + 1] as &phm_node, context, visit); }\n                else { visit(context, key, b.slots[i + 1]); }\n                i += 2;\n            }\n            return;\n        }\n        a: &phm_array_node => {\n            let i: i32 = 0;\n            while i <s (32 as i32) {\n                if a.children[i] != null { phm_node_each(a.children[i]!, context, visit); }\n                i += 1;\n            }\n            return;\n        }\n        c: &phm_collision_node => {\n            let i: i32 = 0;\n            let count: i32 = c.count;\n            while i <s count {\n                visit(context, c.slots[i * 2], c.slots[i * 2 + 1]);\n                i += 1;\n            }\n            return;\n        }\n        _ => { unreachable; }\n    }\n    unreachable;\n}\n\nfn phm_empty(hash: &phm_hash, equal: &phm_equal) -> &phm_map {\n    { count: 0, root: null, has_null: 0, null_value: null, hash, equal }\n}\n\nfn phm_count(map: &phm_map) -> i32 { map.count }\n\nfn phm_get(map: &phm_map, key: &?eq) -> (i32, &?eq) {\n    if key == null { return (map.has_null, map.null_value); }\n    if map.root == null { return (0, null); }\n    return phm_node_get(map.root!, 0, map.hash(key!), key!, map.equal);\n}\n\nfn phm_contains(map: &phm_map, key: &?eq) -> i32 {\n    let (found, _) = phm_get(map, key);\n    found\n}\n\nfn phm_assoc(map: &phm_map, key: &?eq, value: &?eq) -> &phm_map {\n    if key == null {\n        if map.has_null != 0 {\n            if map.null_value == value { return map; }\n        }\n        return {\n            count: map.count + (if map.has_null == 0 { 1 } else { 0 }),\n            root: map.root,\n            has_null: 1,\n            null_value: value,\n            hash: map.hash,\n            equal: map.equal,\n        };\n    }\n    if map.count == 0x7fffffff { unreachable; }\n    let (root, added) = phm_node_assoc(map.root, 0, map.hash(key!), key!, value, map.hash, map.equal);\n    if root == map.root { return map; }\n    {\n        count: map.count + added,\n        root,\n        has_null: map.has_null,\n        null_value: map.null_value,\n        hash: map.hash,\n        equal: map.equal,\n    }\n}\n\nfn phm_dissoc(map: &phm_map, key: &?eq) -> &phm_map {\n    if key == null {\n        if map.has_null == 0 { return map; }\n        return {\n            count: map.count - 1,\n            root: map.root,\n            has_null: 0,\n            null_value: null,\n            hash: map.hash,\n            equal: map.equal,\n        };\n    }\n    if map.root == null { return map; }\n    let (root, removed) = phm_node_dissoc(map.root!, 0, map.hash(key!), key!, map.equal);\n    if removed == 0 { return map; }\n    {\n        count: map.count - 1,\n        root,\n        has_null: map.has_null,\n        null_value: map.null_value,\n        hash: map.hash,\n        equal: map.equal,\n    }\n}\n\nfn phm_each(map: &phm_map, context: &?eq, visit: &phm_visit) {\n    if map.has_null != 0 { visit(context, null, map.null_value); }\n    if map.root != null { phm_node_each(map.root!, context, visit); }\n}\n\nfn phm_as_transient(map: &phm_map) -> &phmt_map {\n    let edit: &phm_edit = { active: 1 };\n    {\n        edit,\n        count: map.count,\n        root: map.root,\n        has_null: map.has_null,\n        null_value: map.null_value,\n        hash: map.hash,\n        equal: map.equal,\n    }\n}\n\nfn phmt_require_active(map: &phmt_map) {\n    if map.edit.active == 0 { unreachable; }\n}\n\nfn phmt_count(map: &phmt_map) -> i32 { phmt_require_active(map); map.count }\n\nfn phmt_get(map: &phmt_map, key: &?eq) -> (i32, &?eq) {\n    phmt_require_active(map);\n    if key == null { return (map.has_null, map.null_value); }\n    if map.root == null { return (0, null); }\n    return phm_node_get(map.root!, 0, map.hash(key!), key!, map.equal);\n}\n\nfn phmt_contains(map: &phmt_map, key: &?eq) -> i32 {\n    let (found, _) = phmt_get(map, key);\n    found\n}\n\nfn phmt_ensure_node(node: &phm_node, edit: &phm_edit) -> &phm_node {\n    match node {\n        b: &phm_bitmap_node => {\n            if b.edit == edit { return b; }\n            return phm_bitmap(edit, b.bitmap, phm_copy_slots(b.slots, b.slots.length()));\n        }\n        a: &phm_array_node => {\n            if a.edit == edit { return a; }\n            let children = [phm_node_slots| null; 32];\n            children.copy(0, a.children, 0, 32);\n            return phm_array(edit, a.count, children);\n        }\n        c: &phm_collision_node => {\n            if c.edit == edit { return c; }\n            return phm_collision(edit, c.hash, c.count, phm_copy_slots(c.slots, c.slots.length()));\n        }\n        _ => { unreachable; }\n    }\n    unreachable;\n}\n\nfn phmt_node_assoc(\n    node: &?phm_node,\n    shift: i32,\n    hash: i32,\n    key: &eq,\n    value: &?eq,\n    hash_fn: &phm_hash,\n    equal: &phm_equal,\n    edit: &phm_edit,\n) -> (&phm_node, i32) {\n    if node == null {\n        let out = phm_singleton_at(shift, hash, key, value);\n        out.edit = edit;\n        return (out, 1);\n    }\n    let owned = phmt_ensure_node(node!, edit);\n    match owned {\n        b: &phm_bitmap_node => {\n            let bit = phm_bitpos(hash, shift);\n            let at = phm_bitmap_index(b.bitmap, bit) * 2;\n            if (b.bitmap & bit) == 0 {\n                if b.bitmap.popcnt() >=s (16 as i32) {\n                    let promoted = phm_promote(b, shift, hash, key, value, hash_fn, equal);\n                    promoted.edit = edit;\n                    return (promoted, 1);\n                }\n                b.bitmap = b.bitmap | bit;\n                b.slots = phm_insert_pair(b.slots, at, key, value);\n                return (b, 1);\n            }\n            let old_key = b.slots[at];\n            if old_key == null {\n                let (child, added) = phmt_node_assoc(\n                    b.slots[at + 1] as &phm_node,\n                    shift + 5,\n                    hash,\n                    key,\n                    value,\n                    hash_fn,\n                    equal,\n                    edit,\n                );\n                b.slots[at + 1] = child;\n                return (b, added);\n            }\n            if equal(old_key!, key) != 0 {\n                b.slots[at + 1] = value;\n                return (b, 0);\n            }\n            let child = phm_merge_two(\n                shift + 5,\n                hash_fn(old_key!),\n                old_key!,\n                b.slots[at + 1],\n                hash,\n                key,\n                value,\n            );\n            b.slots[at] = null;\n            b.slots[at + 1] = child;\n            return (b, 1);\n        }\n        a: &phm_array_node => {\n            let index = (hash >>u shift) & 31;\n            let (child, added) = phmt_node_assoc(\n                a.children[index],\n                shift + 5,\n                hash,\n                key,\n                value,\n                hash_fn,\n                equal,\n                edit,\n            );\n            if a.children[index] == null { a.count = a.count + 1; }\n            a.children[index] = child;\n            return (a, added);\n        }\n        c: &phm_collision_node => {\n            if c.hash != hash {\n                let (out, added) = phm_node_assoc(c, shift, hash, key, value, hash_fn, equal);\n                out.edit = edit;\n                return (out, added);\n            }\n            let i: i32 = 0;\n            let count: i32 = c.count;\n            while i <s count {\n                let at = i * 2;\n                if equal(c.slots[at]!, key) != 0 {\n                    c.slots[at + 1] = value;\n                    return (c, 0);\n                }\n                i += 1;\n            }\n            c.slots = phm_insert_pair(c.slots, c.slots.length(), key, value);\n            c.count = c.count + 1;\n            return (c, 1);\n        }\n        _ => { unreachable; }\n    }\n    unreachable;\n}\n\nfn phmt_node_dissoc(\n    node: &phm_node,\n    shift: i32,\n    hash: i32,\n    key: &eq,\n    equal: &phm_equal,\n    edit: &phm_edit,\n) -> (&?phm_node, i32) {\n    let owned = phmt_ensure_node(node, edit);\n    match owned {\n        b: &phm_bitmap_node => {\n            let bit = phm_bitpos(hash, shift);\n            if (b.bitmap & bit) == 0 { return (b, 0); }\n            let at = phm_bitmap_index(b.bitmap, bit) * 2;\n            let old_key = b.slots[at];\n            if old_key == null {\n                let (child, removed) = phmt_node_dissoc(\n                    b.slots[at + 1] as &phm_node,\n                    shift + 5,\n                    hash,\n                    key,\n                    equal,\n                    edit,\n                );\n                if removed == 0 { return (b, 0); }\n                if child == null {\n                    if b.bitmap == bit { return (null, 1); }\n                    b.bitmap = b.bitmap ^ bit;\n                    b.slots = phm_remove_pair(b.slots, at);\n                } else {\n                    b.slots[at + 1] = child;\n                }\n                return (b, 1);\n            }\n            if equal(old_key!, key) == 0 { return (b, 0); }\n            if b.bitmap == bit { return (null, 1); }\n            b.bitmap = b.bitmap ^ bit;\n            b.slots = phm_remove_pair(b.slots, at);\n            return (b, 1);\n        }\n        a: &phm_array_node => {\n            let index = (hash >>u shift) & 31;\n            let old = a.children[index];\n            if old == null { return (a, 0); }\n            let (child, removed) = phmt_node_dissoc(old!, shift + 5, hash, key, equal, edit);\n            if removed == 0 { return (a, 0); }\n            if child == null {\n                if a.count <=s (9 as i32) {\n                    let packed = phm_pack_array(a, index);\n                    if packed != null { packed!.edit = edit; }\n                    return (packed, 1);\n                }\n                a.count = a.count - 1;\n            }\n            a.children[index] = child;\n            return (a, 1);\n        }\n        c: &phm_collision_node => {\n            if c.hash != hash { return (c, 0); }\n            let i: i32 = 0;\n            let count: i32 = c.count;\n            while i <s count {\n                let at = i * 2;\n                if equal(c.slots[at]!, key) != 0 {\n                    if c.count == 1 { return (null, 1); }\n                    if c.count == 2 {\n                        let keep = if at == 0 { 2 } else { 0 };\n                        let out = phm_singleton_at(shift, hash, c.slots[keep]!, c.slots[keep + 1]);\n                        out.edit = edit;\n                        return (out, 1);\n                    }\n                    c.slots = phm_remove_pair(c.slots, at);\n                    c.count = c.count - 1;\n                    return (c, 1);\n                }\n                i += 1;\n            }\n            return (c, 0);\n        }\n        _ => { unreachable; }\n    }\n    unreachable;\n}\n\nfn phmt_assoc(map: &phmt_map, key: &?eq, value: &?eq) {\n    phmt_require_active(map);\n    if key == null {\n        if map.has_null == 0 { map.count = map.count + 1; }\n        map.has_null = 1;\n        map.null_value = value;\n        return;\n    }\n    if map.count == 0x7fffffff { unreachable; }\n    let (root, added) = phmt_node_assoc(\n        map.root,\n        0,\n        map.hash(key!),\n        key!,\n        value,\n        map.hash,\n        map.equal,\n        map.edit,\n    );\n    map.root = root;\n    map.count = map.count + added;\n}\n\nfn phmt_dissoc(map: &phmt_map, key: &?eq) {\n    phmt_require_active(map);\n    if key == null {\n        if map.has_null != 0 {\n            map.has_null = 0;\n            map.null_value = null;\n            map.count = map.count - 1;\n        }\n        return;\n    }\n    if map.root == null { return; }\n    let (root, removed) = phmt_node_dissoc(\n        map.root!,\n        0,\n        map.hash(key!),\n        key!,\n        map.equal,\n        map.edit,\n    );\n    map.root = root;\n    map.count = map.count - removed;\n}\n\nfn phmt_persistent(map: &phmt_map) -> &phm_map {\n    phmt_require_active(map);\n    map.edit.active = 0;\n    {\n        count: map.count,\n        root: map.root,\n        has_null: map.has_null,\n        null_value: map.null_value,\n        hash: map.hash,\n        equal: map.equal,\n    }\n}\n"),
  ("persistent_hash_set.wax", "// Wax persistent hash set.\n//\n// Concatenate persistent_hash_map.wax before this file. The set reuses the\n// HAMT's hash/equality policy, structural sharing, null-key support, and\n// transient edit ownership. Values in the backing map are an internal marker.\n\ntype phs_visit = fn(&?eq, &?eq);\n\ntype phs_set = { map: &phm_map };\ntype phst_set = { map: &phmt_map };\n\ntype phs_each_context = {\n    context: &?eq,\n    visit: &phs_visit,\n};\n\nfn phs_each_entry(context: &?eq, key: &?eq, _value: &?eq) {\n    let state = context! as &phs_each_context;\n    state.visit(state.context, key);\n}\n\nfn phs_empty(hash: &phm_hash, equal: &phm_equal) -> &phs_set {\n    { map: phm_empty(hash, equal) }\n}\n\nfn phs_count(set: &phs_set) -> i32 { phm_count(set.map) }\n\nfn phs_contains(set: &phs_set, value: &?eq) -> i32 {\n    phm_contains(set.map, value)\n}\n\nfn phs_add(set: &phs_set, value: &?eq) -> &phs_set {\n    let map = phm_assoc(set.map, value, 0 as &i31);\n    if map == set.map { return set; }\n    { map }\n}\n\nfn phs_remove(set: &phs_set, value: &?eq) -> &phs_set {\n    let map = phm_dissoc(set.map, value);\n    if map == set.map { return set; }\n    { map }\n}\n\nfn phs_each(set: &phs_set, context: &?eq, visit: &phs_visit) {\n    let state: &phs_each_context = { context, visit };\n    phm_each(set.map, state, phs_each_entry);\n}\n\ntype phs_union_context = { out: mut &phs_set };\n\nfn phs_union_add(context: &?eq, value: &?eq) {\n    let state = context! as &phs_union_context;\n    state.out = phs_add(state.out, value);\n}\n\nfn phs_union(left: &phs_set, right: &phs_set) -> &phs_set {\n    let state: &phs_union_context = { out: left };\n    phs_each(right, state, phs_union_add);\n    state.out\n}\n\ntype phs_filter_context = {\n    other: &phs_set,\n    out: mut &phs_set,\n    keep_present: i32,\n};\n\nfn phs_filter_add(context: &?eq, value: &?eq) {\n    let state = context! as &phs_filter_context;\n    let present = phs_contains(state.other, value);\n    if present == state.keep_present {\n        state.out = phs_add(state.out, value);\n    }\n}\n\nfn phs_intersection(left: &phs_set, right: &phs_set) -> &phs_set {\n    let state: &phs_filter_context = {\n        other: right,\n        out: phs_empty(left.map.hash, left.map.equal),\n        keep_present: 1,\n    };\n    phs_each(left, state, phs_filter_add);\n    state.out\n}\n\nfn phs_difference(left: &phs_set, right: &phs_set) -> &phs_set {\n    let state: &phs_filter_context = {\n        other: right,\n        out: phs_empty(left.map.hash, left.map.equal),\n        keep_present: 0,\n    };\n    phs_each(left, state, phs_filter_add);\n    state.out\n}\n\nfn phs_as_transient(set: &phs_set) -> &phst_set {\n    { map: phm_as_transient(set.map) }\n}\n\nfn phst_count(set: &phst_set) -> i32 { phmt_count(set.map) }\n\nfn phst_contains(set: &phst_set, value: &?eq) -> i32 {\n    phmt_contains(set.map, value)\n}\n\nfn phst_add(set: &phst_set, value: &?eq) {\n    phmt_assoc(set.map, value, 0 as &i31);\n}\n\nfn phst_remove(set: &phst_set, value: &?eq) {\n    phmt_dissoc(set.map, value);\n}\n\nfn phst_persistent(set: &phst_set) -> &phs_set {\n    { map: phmt_persistent(set.map) }\n}\n"),
  ("persistent_vector.wax", "// Wax persistent vector.\n//\n// Standalone, vendorable source. All names use pv_/pvt_ prefixes because Wax\n// has no source namespaces. Values are nullable references in the eq hierarchy.\n\ntype pv_visit = fn(&?eq, i32, &?eq);\ntype pv_edit = { active: mut i32 };\ntype pv_slots = [mut &?eq];\n\nrec {\n    type pv_node = { edit: mut &?pv_edit, slots: mut &pv_slots };\n}\n\ntype pv_vector = {\n    count: i32,\n    shift: i32,\n    root: &pv_node,\n    tail: &pv_slots,\n};\n\ntype pvt_vector = {\n    edit: &pv_edit,\n    count: mut i32,\n    shift: mut i32,\n    root: mut &pv_node,\n    tail: mut &pv_slots,\n    tail_count: mut i32,\n};\n\nfn pv_node_new(edit: &?pv_edit) -> &pv_node {\n    { edit, slots: [pv_slots| null; 32] }\n}\n\nfn pv_copy_slots(src: &pv_slots, length: i32) -> &pv_slots {\n    let dst = [pv_slots| null; length];\n    let n = if src.length() <u length { src.length() } else { length };\n    if n != 0 { dst.copy(0, src, 0, n); }\n    dst\n}\n\nfn pv_node_copy(node: &pv_node) -> &pv_node {\n    { edit: null, slots: pv_copy_slots(node.slots, 32) }\n}\n\nfn pv_tail_offset(count: i32) -> i32 {\n    if count <s (32 as i32) { return 0; }\n    ((count - 1) >>u 5) << 5\n}\n\nfn pv_new_path(level: i32, node: &pv_node) -> &pv_node {\n    if level == 0 { return node; }\n    let parent = pv_node_new(null);\n    parent.slots[0] = pv_new_path(level - 5, node);\n    parent\n}\n\nfn pv_push_tail(level: i32, parent: &pv_node, tail_node: &pv_node, index: i32) -> &pv_node {\n    let out = pv_node_copy(parent);\n    let subidx = (index >>u level) & 31;\n    if level == 5 {\n        out.slots[subidx] = tail_node;\n        return out;\n    }\n    let child = parent.slots[subidx];\n    if child == null {\n        out.slots[subidx] = pv_new_path(level - 5, tail_node);\n    } else {\n        out.slots[subidx] = pv_push_tail(level - 5, child as &pv_node, tail_node, index);\n    }\n    out\n}\n\nfn pv_do_assoc(level: i32, node: &pv_node, index: i32, value: &?eq) -> &pv_node {\n    let out = pv_node_copy(node);\n    if level == 0 {\n        out.slots[index & 31] = value;\n        return out;\n    }\n    let subidx = (index >>u level) & 31;\n    out.slots[subidx] = pv_do_assoc(level - 5, node.slots[subidx] as &pv_node, index, value);\n    out\n}\n\nfn pv_array_for(vector: &pv_vector, index: i32) -> &pv_slots {\n    if index <s (0 as i32) { unreachable; }\n    if index >=s vector.count { unreachable; }\n    if index >=s pv_tail_offset(vector.count) { return vector.tail; }\n    let node = vector.root;\n    let level = vector.shift;\n    while level >s (0 as i32) {\n        node = node.slots[(index >>u level) & 31] as &pv_node;\n        level -= 5;\n    }\n    node.slots\n}\n\nfn pv_pop_tail(level: i32, node: &pv_node, index: i32) -> &?pv_node {\n    let subidx = (index >>u level) & 31;\n    if level >s (5 as i32) {\n        let child = pv_pop_tail(level - 5, node.slots[subidx] as &pv_node, index);\n        if child == null {\n            if subidx == 0 { return null; }\n        }\n        let out = pv_node_copy(node);\n        out.slots[subidx] = child;\n        return out;\n    }\n    if subidx == 0 { return null; }\n    let out = pv_node_copy(node);\n    out.slots[subidx] = null;\n    out\n}\n\nfn pv_empty() -> &pv_vector {\n    { count: 0, shift: 5, root: pv_node_new(null), tail: [pv_slots| null; 0] }\n}\n\nfn pv_count(vector: &pv_vector) -> i32 { vector.count }\n\nfn pv_get(vector: &pv_vector, index: i32) -> (i32, &?eq) {\n    if index <s (0 as i32) { return (0, null); }\n    if index >=s vector.count { return (0, null); }\n    let slots = pv_array_for(vector, index);\n    return (1, slots[index & 31]);\n}\n\nfn pv_at(vector: &pv_vector, index: i32) -> &?eq {\n    let (found, value) = pv_get(vector, index);\n    if found == 0 { unreachable; }\n    value\n}\n\nfn pv_push(vector: &pv_vector, value: &?eq) -> &pv_vector {\n    if vector.count == 0x7fffffff { unreachable; }\n    if vector.tail.length() <u (32 as i32) {\n        let tail = pv_copy_slots(vector.tail, vector.tail.length() + 1);\n        tail[vector.tail.length()] = value;\n        return {\n            count: vector.count + 1,\n            shift: vector.shift,\n            root: vector.root,\n            tail,\n        };\n    }\n    let tail_node: &pv_node = { edit: null, slots: vector.tail };\n    let shift = vector.shift;\n    let root: &pv_node = if (vector.count >>u 5) >s ((1 as i32) << shift) {\n        let grown = pv_node_new(null);\n        grown.slots[0] = vector.root;\n        grown.slots[1] = pv_new_path(shift, tail_node);\n        shift += 5;\n        grown\n    } else {\n        pv_push_tail(shift, vector.root, tail_node, vector.count - 1)\n    };\n    {\n        count: vector.count + 1,\n        shift,\n        root,\n        tail: [pv_slots| value],\n    }\n}\n\nfn pv_assoc(vector: &pv_vector, index: i32, value: &?eq) -> &pv_vector {\n    if index == vector.count { return pv_push(vector, value); }\n    if index <s (0 as i32) { unreachable; }\n    if index >=s vector.count { unreachable; }\n    let tail_offset = pv_tail_offset(vector.count);\n    if index >=s tail_offset {\n        if vector.tail[index & 31] == value { return vector; }\n        let tail = pv_copy_slots(vector.tail, vector.tail.length());\n        tail[index & 31] = value;\n        return {\n            count: vector.count,\n            shift: vector.shift,\n            root: vector.root,\n            tail,\n        };\n    }\n    {\n        count: vector.count,\n        shift: vector.shift,\n        root: pv_do_assoc(vector.shift, vector.root, index, value),\n        tail: vector.tail,\n    }\n}\n\nfn pv_peek(vector: &pv_vector) -> (i32, &?eq) {\n    if vector.count == 0 { return (0, null); }\n    return (1, vector.tail[vector.tail.length() - 1]);\n}\n\nfn pv_pop(vector: &pv_vector) -> &pv_vector {\n    if vector.count == 0 { unreachable; }\n    if vector.count == 1 { return pv_empty(); }\n    if vector.tail.length() >s (1 as i32) {\n        return {\n            count: vector.count - 1,\n            shift: vector.shift,\n            root: vector.root,\n            tail: pv_copy_slots(vector.tail, vector.tail.length() - 1),\n        };\n    }\n    let new_tail = pv_array_for(vector, vector.count - 2);\n    let root0 = pv_pop_tail(vector.shift, vector.root, vector.count - 2);\n    let root: &pv_node = if root0 == null { pv_node_new(null) } else { root0! };\n    let shift = vector.shift;\n    if shift >s (5 as i32) {\n        if root.slots[1] == null {\n            root = root.slots[0] as &pv_node;\n            shift -= 5;\n        }\n    }\n    {\n        count: vector.count - 1,\n        shift,\n        root,\n        tail: new_tail,\n    }\n}\n\nfn pv_each(vector: &pv_vector, context: &?eq, visit: &pv_visit) {\n    let i: i32 = 0;\n    while i <s vector.count {\n        visit(context, i, pv_at(vector, i));\n        i += 1;\n    }\n}\n\nfn pv_as_transient(vector: &pv_vector) -> &pvt_vector {\n    let edit: &pv_edit = { active: 1 };\n    {\n        edit,\n        count: vector.count,\n        shift: vector.shift,\n        root: pvt_ensure_node(vector.root, edit),\n        tail: pv_copy_slots(vector.tail, 32),\n        tail_count: vector.tail.length(),\n    }\n}\n\nfn pvt_ensure_node(node: &pv_node, edit: &pv_edit) -> &pv_node {\n    if node.edit == edit { return node; }\n    { edit, slots: pv_copy_slots(node.slots, 32) }\n}\n\nfn pvt_new_path(level: i32, node: &pv_node, edit: &pv_edit) -> &pv_node {\n    if level == 0 { return node; }\n    let parent = pv_node_new(edit);\n    parent.slots[0] = pvt_new_path(level - 5, node, edit);\n    parent\n}\n\nfn pvt_push_tail(\n    level: i32,\n    parent: &pv_node,\n    tail_node: &pv_node,\n    index: i32,\n    edit: &pv_edit,\n) -> &pv_node {\n    let out = pvt_ensure_node(parent, edit);\n    let subidx = (index >>u level) & 31;\n    if level == 5 {\n        out.slots[subidx] = tail_node;\n        return out;\n    }\n    let child = out.slots[subidx];\n    if child == null {\n        out.slots[subidx] = pvt_new_path(level - 5, tail_node, edit);\n    } else {\n        out.slots[subidx] = pvt_push_tail(level - 5, child as &pv_node, tail_node, index, edit);\n    }\n    out\n}\n\nfn pvt_do_assoc(\n    level: i32,\n    node: &pv_node,\n    index: i32,\n    value: &?eq,\n    edit: &pv_edit,\n) -> &pv_node {\n    let out = pvt_ensure_node(node, edit);\n    if level == 0 {\n        out.slots[index & 31] = value;\n        return out;\n    }\n    let subidx = (index >>u level) & 31;\n    out.slots[subidx] = pvt_do_assoc(\n        level - 5,\n        out.slots[subidx] as &pv_node,\n        index,\n        value,\n        edit,\n    );\n    out\n}\n\nfn pvt_pop_tail(\n    level: i32,\n    node: &pv_node,\n    index: i32,\n    edit: &pv_edit,\n) -> &?pv_node {\n    let out = pvt_ensure_node(node, edit);\n    let subidx = (index >>u level) & 31;\n    if level >s (5 as i32) {\n        let child = pvt_pop_tail(level - 5, out.slots[subidx] as &pv_node, index, edit);\n        if child == null {\n            if subidx == 0 { return null; }\n        }\n        out.slots[subidx] = child;\n        return out;\n    }\n    if subidx == 0 { return null; }\n    out.slots[subidx] = null;\n    out\n}\n\nfn pvt_require_active(vector: &pvt_vector) {\n    if vector.edit.active == 0 { unreachable; }\n}\n\nfn pvt_snapshot(vector: &pvt_vector) -> &pv_vector {\n    {\n        count: vector.count,\n        shift: vector.shift,\n        root: vector.root,\n        tail: pv_copy_slots(vector.tail, vector.tail_count),\n    }\n}\n\nfn pvt_count(vector: &pvt_vector) -> i32 { pvt_require_active(vector); vector.count }\n\nfn pvt_get(vector: &pvt_vector, index: i32) -> (i32, &?eq) {\n    pvt_require_active(vector);\n    if index <s (0 as i32) { return (0, null); }\n    if index >=s vector.count { return (0, null); }\n    if index >=s pv_tail_offset(vector.count) {\n        return (1, vector.tail[index & 31]);\n    }\n    let node = vector.root;\n    let level = vector.shift;\n    while level >s (0 as i32) {\n        node = node.slots[(index >>u level) & 31] as &pv_node;\n        level -= 5;\n    }\n    (1, node.slots[index & 31])\n}\n\nfn pvt_at(vector: &pvt_vector, index: i32) -> &?eq {\n    pvt_require_active(vector);\n    let (found, value) = pvt_get(vector, index);\n    if found == 0 { unreachable; }\n    value\n}\n\nfn pvt_push(vector: &pvt_vector, value: &?eq) {\n    pvt_require_active(vector);\n    if vector.count == 0x7fffffff { unreachable; }\n    if vector.tail_count <s (32 as i32) {\n        vector.tail[vector.tail_count] = value;\n        vector.tail_count = vector.tail_count + 1;\n        vector.count = vector.count + 1;\n        return;\n    }\n    let tail_node: &pv_node = { edit: vector.edit, slots: vector.tail };\n    if (vector.count >>u 5) >s ((1 as i32) << vector.shift) {\n        let grown = pv_node_new(vector.edit);\n        grown.slots[0] = vector.root;\n        grown.slots[1] = pvt_new_path(vector.shift, tail_node, vector.edit);\n        vector.root = grown;\n        vector.shift = vector.shift + 5;\n    } else {\n        vector.root = pvt_push_tail(\n            vector.shift,\n            vector.root,\n            tail_node,\n            vector.count - 1,\n            vector.edit,\n        );\n    }\n    vector.tail = [pv_slots| null; 32];\n    vector.tail[0] = value;\n    vector.tail_count = 1;\n    vector.count = vector.count + 1;\n}\n\nfn pvt_assoc(vector: &pvt_vector, index: i32, value: &?eq) {\n    pvt_require_active(vector);\n    if index == vector.count {\n        pvt_push(vector, value);\n        return;\n    }\n    if index <s (0 as i32) { unreachable; }\n    if index >=s vector.count { unreachable; }\n    if index >=s pv_tail_offset(vector.count) {\n        vector.tail[index & 31] = value;\n        return;\n    }\n    vector.root = pvt_do_assoc(vector.shift, vector.root, index, value, vector.edit);\n}\n\nfn pvt_pop(vector: &pvt_vector) {\n    pvt_require_active(vector);\n    if vector.count == 0 { unreachable; }\n    if vector.count == 1 {\n        vector.count = 0;\n        vector.tail[0] = null;\n        vector.tail_count = 0;\n        return;\n    }\n    if vector.tail_count >s (1 as i32) {\n        vector.tail_count = vector.tail_count - 1;\n        vector.tail[vector.tail_count] = null;\n        vector.count = vector.count - 1;\n        return;\n    }\n    let leaf = vector.root;\n    let level = vector.shift;\n    let index = vector.count - 2;\n    while level >s (0 as i32) {\n        leaf = leaf.slots[(index >>u level) & 31] as &pv_node;\n        level -= 5;\n    }\n    vector.tail = pv_copy_slots(leaf.slots, 32);\n    vector.tail_count = 32;\n    let root0 = pvt_pop_tail(vector.shift, vector.root, vector.count - 2, vector.edit);\n    vector.root = if root0 == null { pv_node_new(vector.edit) } else { root0! };\n    if vector.shift >s (5 as i32) {\n        if vector.root.slots[1] == null {\n            vector.root = vector.root.slots[0] as &pv_node;\n            vector.shift = vector.shift - 5;\n        }\n    }\n    vector.count = vector.count - 1;\n}\n\nfn pvt_persistent(vector: &pvt_vector) -> &pv_vector {\n    pvt_require_active(vector);\n    vector.edit.active = 0;\n    pvt_snapshot(vector)\n}\n"),
  ("utf8.wax", "// Owned UTF-8 strings for Wax.\n//\n// Concatenate collections/hashing.wax before this file. Wax GC arrays cannot\n// be filled dynamically after being declared immutable, so this type owns a\n// mutable byte array but never exposes it through the API. Treat utf8_string\n// and its storage field as opaque after vendoring this source.\n\ntype utf8_visit = fn(&?eq, i32, i32, i32);\n\ntype utf8_string = {\n    storage_internal: &wax_hash_bytes,\n    byte_length: i32,\n    codepoint_length: i32,\n    hash: i32,\n};\n\nfn utf8_continuation(byte: i32) -> i32 {\n    if byte <u (0x80 as i32) { return 0; }\n    if byte >u (0xbf as i32) { return 0; }\n    1\n}\n\nfn utf8_validate(bytes: &wax_hash_bytes) -> (i32, i32) {\n    let i: i32 = 0;\n    let count: i32 = 0;\n    let length = bytes.length();\n    while i <s length {\n        let first = bytes[i] as i32_u;\n        'unit: do {\n            if first <=u (0x7f as i32) { i += 1; br 'unit; }\n            if first <=u (0xc1 as i32) { return (0, 0); }\n            if first <=u (0xdf as i32) {\n                if i + 1 >=s length { return (0, 0); }\n                if utf8_continuation(bytes[i + 1] as i32_u) == 0 { return (0, 0); }\n                i += 2;\n                br 'unit;\n            }\n            if first <=u (0xef as i32) {\n                if i + 2 >=s length { return (0, 0); }\n                let second = bytes[i + 1] as i32_u;\n                if utf8_continuation(second) == 0 { return (0, 0); }\n                if utf8_continuation(bytes[i + 2] as i32_u) == 0 { return (0, 0); }\n                if first == 0xe0 {\n                    if second <u (0xa0 as i32) { return (0, 0); }\n                }\n                if first == 0xed {\n                    if second >u (0x9f as i32) { return (0, 0); }\n                }\n                i += 3;\n                br 'unit;\n            }\n            if first <=u (0xf4 as i32) {\n                if i + 3 >=s length { return (0, 0); }\n                let second = bytes[i + 1] as i32_u;\n                if utf8_continuation(second) == 0 { return (0, 0); }\n                if utf8_continuation(bytes[i + 2] as i32_u) == 0 { return (0, 0); }\n                if utf8_continuation(bytes[i + 3] as i32_u) == 0 { return (0, 0); }\n                if first == 0xf0 {\n                    if second <u (0x90 as i32) { return (0, 0); }\n                }\n                if first == 0xf4 {\n                    if second >u (0x8f as i32) { return (0, 0); }\n                }\n                i += 4;\n                br 'unit;\n            }\n            return (0, 0);\n        }\n        count += 1;\n    }\n    (1, count)\n}\n\nfn utf8_copy_storage(bytes: &wax_hash_bytes, start: i32, length: i32) -> &wax_hash_bytes {\n    let out = [wax_hash_bytes| 0; length];\n    if length != 0 { out.copy(0, bytes, start, length); }\n    out\n}\n\nfn utf8_new_valid(bytes: &wax_hash_bytes, codepoints: i32) -> &utf8_string {\n    let storage_internal = utf8_copy_storage(bytes, 0, bytes.length());\n    {\n        storage_internal,\n        byte_length: storage_internal.length(),\n        codepoint_length: codepoints,\n        hash: wax_hash_bytes_value(storage_internal),\n    }\n}\n\nfn utf8_try_from_bytes(bytes: &wax_hash_bytes) -> (i32, &?utf8_string) {\n    let (valid, codepoints) = utf8_validate(bytes);\n    if valid == 0 { return (0, null); }\n    (1, utf8_new_valid(bytes, codepoints))\n}\n\nfn utf8_from_bytes(bytes: &wax_hash_bytes) -> &utf8_string {\n    let (valid, value) = utf8_try_from_bytes(bytes);\n    if valid == 0 { unreachable; }\n    value!\n}\n\nfn utf8_empty() -> &utf8_string {\n    utf8_new_valid([wax_hash_bytes|], 0)\n}\n\nfn utf8_copy_bytes(value: &utf8_string) -> &wax_hash_bytes {\n    utf8_copy_storage(value.storage_internal, 0, value.byte_length)\n}\n\nfn utf8_byte_length(value: &utf8_string) -> i32 { value.byte_length }\n\nfn utf8_codepoint_length(value: &utf8_string) -> i32 {\n    value.codepoint_length\n}\n\nfn utf8_is_empty(value: &utf8_string) -> i32 {\n    if value.byte_length == 0 { 1 } else { 0 }\n}\n\nfn utf8_get_byte(value: &utf8_string, index: i32) -> (i32, i32) {\n    if index <s (0 as i32) { return (0, 0); }\n    if index >=s value.byte_length { return (0, 0); }\n    (1, value.storage_internal[index] as i32_u)\n}\n\nfn utf8_at_byte(value: &utf8_string, index: i32) -> i32 {\n    let (found, byte) = utf8_get_byte(value, index);\n    if found == 0 { unreachable; }\n    byte\n}\n\nfn utf8_equal(left: &utf8_string, right: &utf8_string) -> i32 {\n    if left == right { return 1; }\n    if left.hash != right.hash { return 0; }\n    if left.byte_length != right.byte_length { return 0; }\n    let i: i32 = 0;\n    while i <s left.byte_length {\n        if left.storage_internal[i] as i32_u != right.storage_internal[i] as i32_u {\n            return 0;\n        }\n        i += 1;\n    }\n    1\n}\n\nfn utf8_compare(left: &utf8_string, right: &utf8_string) -> i32 {\n    let length = if left.byte_length <u right.byte_length {\n        left.byte_length\n    } else {\n        right.byte_length\n    };\n    let i: i32 = 0;\n    while i <s length {\n        let a = left.storage_internal[i] as i32_u;\n        let b = right.storage_internal[i] as i32_u;\n        if a <u b { return -1; }\n        if a >u b { return 1; }\n        i += 1;\n    }\n    if left.byte_length <u right.byte_length { return -1; }\n    if left.byte_length >u right.byte_length { return 1; }\n    0\n}\n\nfn utf8_hash(value: &utf8_string) -> i32 { value.hash }\n\nfn utf8_hash_key(key: &eq) -> i32 {\n    utf8_hash(key as &utf8_string)\n}\n\nfn utf8_equal_key(left: &eq, right: &eq) -> i32 {\n    utf8_equal(left as &utf8_string, right as &utf8_string)\n}\n\nfn utf8_concat(left: &utf8_string, right: &utf8_string) -> &utf8_string {\n    if left.byte_length == 0 { return right; }\n    if right.byte_length == 0 { return left; }\n    if left.byte_length >s 0x7fffffff - right.byte_length { unreachable; }\n    let length = left.byte_length + right.byte_length;\n    let storage = [wax_hash_bytes| 0; length];\n    storage.copy(0, left.storage_internal, 0, left.byte_length);\n    storage.copy(left.byte_length, right.storage_internal, 0, right.byte_length);\n    {\n        storage_internal: storage,\n        byte_length: length,\n        codepoint_length: left.codepoint_length + right.codepoint_length,\n        hash: wax_hash_bytes_value(storage),\n    }\n}\n\nfn utf8_is_boundary(value: &utf8_string, offset: i32) -> i32 {\n    if offset <s (0 as i32) { return 0; }\n    if offset >s value.byte_length { return 0; }\n    if offset == 0 { return 1; }\n    if offset == value.byte_length { return 1; }\n    if utf8_continuation(value.storage_internal[offset] as i32_u) == 0 { 1 } else { 0 }\n}\n\nfn utf8_try_slice_bytes(\n    value: &utf8_string,\n    start: i32,\n    length: i32,\n) -> (i32, &?utf8_string) {\n    if start <s (0 as i32) { return (0, null); }\n    if length <s (0 as i32) { return (0, null); }\n    if start >s value.byte_length { return (0, null); }\n    if length >s value.byte_length - start { return (0, null); }\n    let end = start + length;\n    if utf8_is_boundary(value, start) == 0 { return (0, null); }\n    if utf8_is_boundary(value, end) == 0 { return (0, null); }\n    if start == 0 {\n        if length == value.byte_length { return (1, value); }\n    }\n    let storage = utf8_copy_storage(value.storage_internal, start, length);\n    let (_, codepoints) = utf8_validate(storage);\n    (1, utf8_new_valid(storage, codepoints))\n}\n\nfn utf8_slice_bytes(value: &utf8_string, start: i32, length: i32) -> &utf8_string {\n    let (valid, slice) = utf8_try_slice_bytes(value, start, length);\n    if valid == 0 { unreachable; }\n    slice!\n}\n\nfn utf8_each_codepoint(value: &utf8_string, context: &?eq, visit: &utf8_visit) {\n    let offset: i32 = 0;\n    let index: i32 = 0;\n    while offset <s value.byte_length {\n        let first = value.storage_internal[offset] as i32_u;\n        let scalar: i32;\n        let width: i32;\n        'decoded: do {\n            if first <=u (0x7f as i32) {\n                scalar = first;\n                width = 1;\n                br 'decoded;\n            }\n            if first <=u (0xdf as i32) {\n                scalar = (first & 0x1f) << 6 | (value.storage_internal[offset + 1] as i32_u & 0x3f);\n                width = 2;\n                br 'decoded;\n            }\n            if first <=u (0xef as i32) {\n                scalar =\n                    (first & 0x0f) << 12\n                    | (value.storage_internal[offset + 1] as i32_u & 0x3f) << 6\n                    | (value.storage_internal[offset + 2] as i32_u & 0x3f);\n                width = 3;\n                br 'decoded;\n            }\n            scalar =\n                (first & 0x07) << 18\n                | (value.storage_internal[offset + 1] as i32_u & 0x3f) << 12\n                | (value.storage_internal[offset + 2] as i32_u & 0x3f) << 6\n                | (value.storage_internal[offset + 3] as i32_u & 0x3f);\n            width = 4;\n        }\n        visit(context, index, offset, scalar);\n        offset += width;\n        index += 1;\n    }\n}\n"),
  ("immutable_value.wax", "// Immutable JSON-like values for Wax.\n//\n// Concatenate hashing.wax, persistent_hash_map.wax,\n// persistent_hash_set.wax, persistent_vector.wax, and text/utf8.wax before\n// this file, then concatenate data/record.wax. Values constructed through this\n// API are non-null and acyclic.\n\nconst jv_kind_null = 0;\nconst jv_kind_bool = 1;\nconst jv_kind_string = 2;\nconst jv_kind_i32 = 3;\nconst jv_kind_i64 = 4;\nconst jv_kind_f32 = 5;\nconst jv_kind_f64 = 6;\nconst jv_kind_vector = 7;\nconst jv_kind_map = 8;\nconst jv_kind_any = 9;\nconst jv_kind_set = 10;\nconst jv_kind_record = 11;\nconst jv_kind_ordered_map = 12;\nconst jv_kind_ordered_set = 13;\n\ntype jvo_entry = { key: &eq, value: &?eq };\ntype jvo_store = { index: &phm_map, entries: &pv_vector };\ntype jvot_store = { index: &phmt_map, entries: &pvt_vector };\n\nrec {\n    type jv_value = open { kind: i32 };\n    type jv_null_value : jv_value = { .. };\n    type jv_bool_value : jv_value = { .., value: i32 };\n    type jv_string_value : jv_value = { .., value: &utf8_string };\n    type jv_i32_value : jv_value = { .., value: i32 };\n    type jv_i64_value : jv_value = { .., value: i64 };\n    type jv_f32_value : jv_value = { .., value: f32 };\n    type jv_f64_value : jv_value = { .., value: f64 };\n    type jv_vector_value : jv_value = { .., value: &pv_vector };\n    type jv_map_value : jv_value = { .., value: &phm_map };\n    type jv_any_value : jv_value = { .., value: &?any };\n    type jv_set_value : jv_value = { .., value: &phs_set };\n    type jv_ordered_map_value : jv_value = { .., value: &jvo_store };\n    type jv_ordered_set_value : jv_value = { .., value: &jvo_store };\n    type jv_record_value : jv_value = {\n        ..,\n        definition: &jv_record_type,\n        values: &phm_map,\n    };\n    type jv_type = open { kind: i32 };\n    type jv_type_scalar : jv_type = { .. };\n    type jv_type_vector_value : jv_type = { .., element: &jv_type };\n    type jv_type_map_value : jv_type = { .., value: &jv_type };\n    type jv_type_set_value : jv_type = { .., element: &jv_type };\n    type jv_type_ordered_map_value : jv_type = { .., value: &jv_type };\n    type jv_type_ordered_set_value : jv_type = { .., element: &jv_type };\n    type jv_type_record_value : jv_type = {\n        ..,\n        definition: &jv_record_type,\n    };\n    type jv_type_or_value : jv_type = {\n        ..,\n        left: &jv_type,\n        right: &jv_type,\n    };\n    type jv_record_field = {\n        value_type: &jv_type,\n        default_value: &jv_value,\n        validator_context: &?eq,\n        validator: &func,\n    };\n    type jv_record_schema = {\n        fields: &phm_map,\n        defaults: &phm_map,\n    };\n    type jv_record_type = {\n        name: &utf8_string,\n        schema: &jv_record_schema,\n        validator_context: &?eq,\n        validator: &func,\n    };\n}\n\ntype jv_field_validator = fn(&?eq, &jv_value) -> i32;\ntype jv_record_validator = fn(&?eq, &jv_record_value) -> i32;\n\ntype jv_vector_visit = fn(&?eq, i32, &jv_value);\ntype jv_map_visit = fn(&?eq, &utf8_string, &jv_value);\ntype jv_set_visit = fn(&?eq, &jv_value);\n\ntype jvt_vector = { value: &pvt_vector };\ntype jvt_map = { value: &phmt_map };\ntype jvt_set = { value: &phst_set };\ntype jvt_ordered_map = { value: &jvot_store };\ntype jvt_ordered_set = { value: &jvot_store };\n\nfn jv_null() -> &jv_value {\n    let out: &jv_null_value = { kind: jv_kind_null };\n    out\n}\n\nfn jv_bool(value: i32) -> &jv_value {\n    let normalized = if value == 0 { 0 } else { 1 };\n    let out: &jv_bool_value = { kind: jv_kind_bool, value: normalized };\n    out\n}\n\nfn jv_string(value: &utf8_string) -> &jv_value {\n    let out: &jv_string_value = { kind: jv_kind_string, value };\n    out\n}\n\nfn jv_i32(value: i32) -> &jv_value {\n    let out: &jv_i32_value = { kind: jv_kind_i32, value };\n    out\n}\n\nfn jv_i64(value: i64) -> &jv_value {\n    let out: &jv_i64_value = { kind: jv_kind_i64, value };\n    out\n}\n\nfn jv_f32(value: f32) -> &jv_value {\n    let out: &jv_f32_value = { kind: jv_kind_f32, value };\n    out\n}\n\nfn jv_f64(value: f64) -> &jv_value {\n    let out: &jv_f64_value = { kind: jv_kind_f64, value };\n    out\n}\n\nfn jv_any(value: &?any) -> &jv_value {\n    let out: &jv_any_value = { kind: jv_kind_any, value };\n    out\n}\n\nfn jv_kind(value: &jv_value) -> i32 { value.kind }\n\nfn jv_get_bool(value: &jv_value) -> (i32, i32) {\n    match value {\n        found: &jv_bool_value => { return (1, found.value); }\n        _ => { return (0, 0); }\n    }\n    unreachable;\n}\n\nfn jv_require_bool(value: &jv_value) -> i32 {\n    let (found, out) = jv_get_bool(value);\n    if found == 0 { unreachable; }\n    out\n}\n\nfn jv_get_string(value: &jv_value) -> (i32, &?utf8_string) {\n    match value {\n        found: &jv_string_value => { return (1, found.value); }\n        _ => { return (0, null); }\n    }\n    unreachable;\n}\n\nfn jv_require_string(value: &jv_value) -> &utf8_string {\n    let (found, out) = jv_get_string(value);\n    if found == 0 { unreachable; }\n    out!\n}\n\nfn jv_get_i32(value: &jv_value) -> (i32, i32) {\n    match value {\n        found: &jv_i32_value => { return (1, found.value); }\n        _ => { return (0, 0); }\n    }\n    unreachable;\n}\n\nfn jv_require_i32(value: &jv_value) -> i32 {\n    let (found, out) = jv_get_i32(value);\n    if found == 0 { unreachable; }\n    out\n}\n\nfn jv_get_i64(value: &jv_value) -> (i32, i64) {\n    match value {\n        found: &jv_i64_value => { return (1, found.value); }\n        _ => { return (0, 0); }\n    }\n    unreachable;\n}\n\nfn jv_require_i64(value: &jv_value) -> i64 {\n    let (found, out) = jv_get_i64(value);\n    if found == 0 { unreachable; }\n    out\n}\n\nfn jv_get_f32(value: &jv_value) -> (i32, f32) {\n    match value {\n        found: &jv_f32_value => { return (1, found.value); }\n        _ => { return (0, 0); }\n    }\n    unreachable;\n}\n\nfn jv_require_f32(value: &jv_value) -> f32 {\n    let (found, out) = jv_get_f32(value);\n    if found == 0 { unreachable; }\n    out\n}\n\nfn jv_get_f64(value: &jv_value) -> (i32, f64) {\n    match value {\n        found: &jv_f64_value => { return (1, found.value); }\n        _ => { return (0, 0); }\n    }\n    unreachable;\n}\n\nfn jv_require_f64(value: &jv_value) -> f64 {\n    let (found, out) = jv_get_f64(value);\n    if found == 0 { unreachable; }\n    out\n}\n\nfn jv_get_any(value: &jv_value) -> (i32, &?any) {\n    match value {\n        found: &jv_any_value => { return (1, found.value); }\n        _ => { return (0, null); }\n    }\n    unreachable;\n}\n\nfn jv_require_any(value: &jv_value) -> &?any {\n    let (found, out) = jv_get_any(value);\n    if found == 0 { unreachable; }\n    out\n}\n\nfn jv_any_equal(left: &?any, right: &?any) -> i32 {\n    match left {\n        null => {\n            match right {\n                null => { return 1; }\n                _ => { return 0; }\n            }\n        }\n        value: &eq => {\n            match right {\n                other: &eq => { return if value == other { 1 } else { 0 }; }\n                _ => { return 0; }\n            }\n        }\n        _ => { return 0; }\n    }\n    unreachable;\n}\n\n// Shared insertion-order storage. The HAMT maps each key to its vector index;\n// removed entries become null tombstones until trimming or compaction.\nfn jvo_empty(hash: &phm_hash, equal: &phm_equal) -> &jvo_store {\n    { index: phm_empty(hash, equal), entries: pv_empty() }\n}\n\nfn jvo_count(store: &jvo_store) -> i32 { phm_count(store.index) }\n\nfn jvo_slot(store: &jvo_store, key: &eq) -> (i32, i32) {\n    let (found, value) = phm_get(store.index, key);\n    if found == 0 { return (0, 0); }\n    (1, value! as i32_s)\n}\n\nfn jvo_get(store: &jvo_store, key: &eq) -> (i32, &?eq) {\n    let (found, slot) = jvo_slot(store, key);\n    if found == 0 { return (0, null); }\n    let entry = pv_at(store.entries, slot)! as &jvo_entry;\n    (1, entry.value)\n}\n\nfn jvo_contains(store: &jvo_store, key: &eq) -> i32 {\n    phm_contains(store.index, key)\n}\n\nfn jvo_next(store: &jvo_store, start: i32) -> (i32, &?jvo_entry) {\n    let i = start;\n    while i <s pv_count(store.entries) {\n        let raw = pv_at(store.entries, i);\n        i += 1;\n        if raw != null { return (i, raw! as &jvo_entry); }\n    }\n    (i, null)\n}\n\nfn jvo_compact(store: &jvo_store) -> &jvo_store {\n    let slots = pv_count(store.entries);\n    let count = jvo_count(store);\n    if slots <s (32 as i32) { return store; }\n    if slots <s count * 2 { return store; }\n    let index = phm_empty(store.index.hash, store.index.equal);\n    let entries = pv_empty();\n    let cursor: i32 = 0;\n    while cursor <s slots {\n        let raw = pv_at(store.entries, cursor);\n        if raw != null {\n            let entry = raw! as &jvo_entry;\n            index = phm_assoc(index, entry.key, pv_count(entries) as &i31);\n            entries = pv_push(entries, entry);\n        }\n        cursor += 1;\n    }\n    { index, entries }\n}\n\nfn jvo_assoc(store: &jvo_store, key: &eq, value: &?eq) -> &jvo_store {\n    let (found, slot) = jvo_slot(store, key);\n    if found != 0 {\n        let old = pv_at(store.entries, slot)! as &jvo_entry;\n        if old.value == value { return store; }\n        let entry: &jvo_entry = { key: old.key, value };\n        return { index: store.index, entries: pv_assoc(store.entries, slot, entry) };\n    }\n    let slot = pv_count(store.entries);\n    let entry: &jvo_entry = { key, value };\n    {\n        index: phm_assoc(store.index, key, slot as &i31),\n        entries: pv_push(store.entries, entry),\n    }\n}\n\nfn jvo_has_trailing_tombstone(entries: &pv_vector) -> i32 {\n    if pv_count(entries) == 0 { return 0; }\n    if pv_at(entries, pv_count(entries) - 1) == null { return 1; }\n    0\n}\n\nfn jvo_dissoc(store: &jvo_store, key: &eq) -> &jvo_store {\n    let (found, slot) = jvo_slot(store, key);\n    if found == 0 { return store; }\n    let index = phm_dissoc(store.index, key);\n    let entries = pv_assoc(store.entries, slot, null);\n    while jvo_has_trailing_tombstone(entries) != 0 {\n        entries = pv_pop(entries);\n    }\n    jvo_compact({ index, entries })\n}\n\nfn jvo_as_transient(store: &jvo_store) -> &jvot_store {\n    {\n        index: phm_as_transient(store.index),\n        entries: pv_as_transient(store.entries),\n    }\n}\n\nfn jvot_count(store: &jvot_store) -> i32 { phmt_count(store.index) }\n\nfn jvot_slot(store: &jvot_store, key: &eq) -> (i32, i32) {\n    let (found, value) = phmt_get(store.index, key);\n    if found == 0 { return (0, 0); }\n    (1, value! as i32_s)\n}\n\nfn jvot_get(store: &jvot_store, key: &eq) -> (i32, &?eq) {\n    let (found, slot) = jvot_slot(store, key);\n    if found == 0 { return (0, null); }\n    let entry = pvt_at(store.entries, slot)! as &jvo_entry;\n    (1, entry.value)\n}\n\nfn jvot_contains(store: &jvot_store, key: &eq) -> i32 {\n    phmt_contains(store.index, key)\n}\n\nfn jvot_assoc(store: &jvot_store, key: &eq, value: &?eq) {\n    let (found, slot) = jvot_slot(store, key);\n    if found != 0 {\n        let old = pvt_at(store.entries, slot)! as &jvo_entry;\n        if old.value == value { return; }\n        let entry: &jvo_entry = { key: old.key, value };\n        pvt_assoc(store.entries, slot, entry);\n        return;\n    }\n    let slot = pvt_count(store.entries);\n    let entry: &jvo_entry = { key, value };\n    phmt_assoc(store.index, key, slot as &i31);\n    pvt_push(store.entries, entry);\n}\n\nfn jvot_has_trailing_tombstone(entries: &pvt_vector) -> i32 {\n    if pvt_count(entries) == 0 { return 0; }\n    if pvt_at(entries, pvt_count(entries) - 1) == null { return 1; }\n    0\n}\n\nfn jvot_dissoc(store: &jvot_store, key: &eq) {\n    let (found, slot) = jvot_slot(store, key);\n    if found == 0 { return; }\n    phmt_dissoc(store.index, key);\n    pvt_assoc(store.entries, slot, null);\n    while jvot_has_trailing_tombstone(store.entries) != 0 {\n        pvt_pop(store.entries);\n    }\n}\n\nfn jvot_persistent(store: &jvot_store) -> &jvo_store {\n    let index = phmt_persistent(store.index);\n    let entries = pvt_persistent(store.entries);\n    jvo_compact({ index, entries })\n}\n\nfn jv_vector_empty() -> &jv_vector_value {\n    { kind: jv_kind_vector, value: pv_empty() }\n}\n\nfn jv_get_vector(value: &jv_value) -> (i32, &?jv_vector_value) {\n    match value {\n        found: &jv_vector_value => { return (1, found); }\n        _ => { return (0, null); }\n    }\n    unreachable;\n}\n\nfn jv_require_vector(value: &jv_value) -> &jv_vector_value {\n    let (found, out) = jv_get_vector(value);\n    if found == 0 { unreachable; }\n    out!\n}\n\nfn jv_vector_count(vector: &jv_vector_value) -> i32 {\n    pv_count(vector.value)\n}\n\nfn jv_vector_get(vector: &jv_vector_value, index: i32) -> (i32, &?jv_value) {\n    let (found, value) = pv_get(vector.value, index);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jv_vector_at(vector: &jv_vector_value, index: i32) -> &jv_value {\n    let (found, value) = jv_vector_get(vector, index);\n    if found == 0 { unreachable; }\n    value!\n}\n\nfn jv_vector_push(vector: &jv_vector_value, value: &jv_value) -> &jv_vector_value {\n    let raw = pv_push(vector.value, value);\n    { kind: jv_kind_vector, value: raw }\n}\n\nfn jv_vector_assoc(\n    vector: &jv_vector_value,\n    index: i32,\n    value: &jv_value,\n) -> &jv_vector_value {\n    let raw = pv_assoc(vector.value, index, value);\n    if raw == vector.value { return vector; }\n    { kind: jv_kind_vector, value: raw }\n}\n\nfn jv_vector_peek(vector: &jv_vector_value) -> (i32, &?jv_value) {\n    let (found, value) = pv_peek(vector.value);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jv_vector_pop(vector: &jv_vector_value) -> &jv_vector_value {\n    { kind: jv_kind_vector, value: pv_pop(vector.value) }\n}\n\ntype jv_vector_each_context = {\n    context: &?eq,\n    visit: &jv_vector_visit,\n};\n\nfn jv_vector_each_adapter(context: &?eq, index: i32, value: &?eq) {\n    let state = context! as &jv_vector_each_context;\n    state.visit(state.context, index, value! as &jv_value);\n}\n\nfn jv_vector_each(\n    vector: &jv_vector_value,\n    context: &?eq,\n    visit: &jv_vector_visit,\n) {\n    let state: &jv_vector_each_context = { context, visit };\n    pv_each(vector.value, state, jv_vector_each_adapter);\n}\n\nfn jv_vector_as_transient(vector: &jv_vector_value) -> &jvt_vector {\n    { value: pv_as_transient(vector.value) }\n}\n\nfn jvt_vector_count(vector: &jvt_vector) -> i32 { pvt_count(vector.value) }\n\nfn jvt_vector_get(vector: &jvt_vector, index: i32) -> (i32, &?jv_value) {\n    let (found, value) = pvt_get(vector.value, index);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jvt_vector_push(vector: &jvt_vector, value: &jv_value) {\n    pvt_push(vector.value, value);\n}\n\nfn jvt_vector_assoc(vector: &jvt_vector, index: i32, value: &jv_value) {\n    pvt_assoc(vector.value, index, value);\n}\n\nfn jvt_vector_pop(vector: &jvt_vector) { pvt_pop(vector.value); }\n\nfn jvt_vector_persistent(vector: &jvt_vector) -> &jv_vector_value {\n    { kind: jv_kind_vector, value: pvt_persistent(vector.value) }\n}\n\nfn jv_map_empty() -> &jv_map_value {\n    { kind: jv_kind_map, value: phm_empty(utf8_hash_key, utf8_equal_key) }\n}\n\nfn jv_get_map(value: &jv_value) -> (i32, &?jv_map_value) {\n    match value {\n        found: &jv_map_value => { return (1, found); }\n        _ => { return (0, null); }\n    }\n    unreachable;\n}\n\nfn jv_require_map(value: &jv_value) -> &jv_map_value {\n    let (found, out) = jv_get_map(value);\n    if found == 0 { unreachable; }\n    out!\n}\n\nfn jv_map_count(map: &jv_map_value) -> i32 { phm_count(map.value) }\n\nfn jv_map_get(map: &jv_map_value, key: &utf8_string) -> (i32, &?jv_value) {\n    let (found, value) = phm_get(map.value, key);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jv_map_contains(map: &jv_map_value, key: &utf8_string) -> i32 {\n    phm_contains(map.value, key)\n}\n\nfn jv_map_assoc(\n    map: &jv_map_value,\n    key: &utf8_string,\n    value: &jv_value,\n) -> &jv_map_value {\n    let raw = phm_assoc(map.value, key, value);\n    if raw == map.value { return map; }\n    { kind: jv_kind_map, value: raw }\n}\n\nfn jv_map_dissoc(map: &jv_map_value, key: &utf8_string) -> &jv_map_value {\n    let raw = phm_dissoc(map.value, key);\n    if raw == map.value { return map; }\n    { kind: jv_kind_map, value: raw }\n}\n\ntype jv_map_each_context = {\n    context: &?eq,\n    visit: &jv_map_visit,\n};\n\nfn jv_map_each_adapter(context: &?eq, key: &?eq, value: &?eq) {\n    let state = context! as &jv_map_each_context;\n    state.visit(state.context, key! as &utf8_string, value! as &jv_value);\n}\n\nfn jv_map_each(map: &jv_map_value, context: &?eq, visit: &jv_map_visit) {\n    let state: &jv_map_each_context = { context, visit };\n    phm_each(map.value, state, jv_map_each_adapter);\n}\n\nfn jv_map_as_transient(map: &jv_map_value) -> &jvt_map {\n    { value: phm_as_transient(map.value) }\n}\n\nfn jvt_map_count(map: &jvt_map) -> i32 { phmt_count(map.value) }\n\nfn jvt_map_get(map: &jvt_map, key: &utf8_string) -> (i32, &?jv_value) {\n    let (found, value) = phmt_get(map.value, key);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jvt_map_contains(map: &jvt_map, key: &utf8_string) -> i32 {\n    phmt_contains(map.value, key)\n}\n\nfn jvt_map_assoc(map: &jvt_map, key: &utf8_string, value: &jv_value) {\n    phmt_assoc(map.value, key, value);\n}\n\nfn jvt_map_dissoc(map: &jvt_map, key: &utf8_string) {\n    phmt_dissoc(map.value, key);\n}\n\nfn jvt_map_persistent(map: &jvt_map) -> &jv_map_value {\n    { kind: jv_kind_map, value: phmt_persistent(map.value) }\n}\n\nfn jv_hash_key(value: &eq) -> i32 { jv_hash(value as &jv_value) }\n\nfn jv_equal_key(left: &eq, right: &eq) -> i32 {\n    jv_equal(left as &jv_value, right as &jv_value)\n}\n\nfn jv_set_empty() -> &jv_set_value {\n    { kind: jv_kind_set, value: phs_empty(jv_hash_key, jv_equal_key) }\n}\n\nfn jv_get_set(value: &jv_value) -> (i32, &?jv_set_value) {\n    match value {\n        found: &jv_set_value => { return (1, found); }\n        _ => { return (0, null); }\n    }\n    unreachable;\n}\n\nfn jv_require_set(value: &jv_value) -> &jv_set_value {\n    let (found, out) = jv_get_set(value);\n    if found == 0 { unreachable; }\n    out!\n}\n\nfn jv_set_count(set: &jv_set_value) -> i32 { phs_count(set.value) }\n\nfn jv_set_contains(set: &jv_set_value, value: &jv_value) -> i32 {\n    phs_contains(set.value, value)\n}\n\nfn jv_set_add(set: &jv_set_value, value: &jv_value) -> &jv_set_value {\n    let raw = phs_add(set.value, value);\n    if raw == set.value { return set; }\n    { kind: jv_kind_set, value: raw }\n}\n\nfn jv_set_remove(set: &jv_set_value, value: &jv_value) -> &jv_set_value {\n    let raw = phs_remove(set.value, value);\n    if raw == set.value { return set; }\n    { kind: jv_kind_set, value: raw }\n}\n\ntype jv_set_each_context = {\n    context: &?eq,\n    visit: &jv_set_visit,\n};\n\nfn jv_set_each_adapter(context: &?eq, value: &?eq) {\n    let state = context! as &jv_set_each_context;\n    state.visit(state.context, value! as &jv_value);\n}\n\nfn jv_set_each(set: &jv_set_value, context: &?eq, visit: &jv_set_visit) {\n    let state: &jv_set_each_context = { context, visit };\n    phs_each(set.value, state, jv_set_each_adapter);\n}\n\nfn jv_set_union(left: &jv_set_value, right: &jv_set_value) -> &jv_set_value {\n    { kind: jv_kind_set, value: phs_union(left.value, right.value) }\n}\n\nfn jv_set_intersection(left: &jv_set_value, right: &jv_set_value) -> &jv_set_value {\n    { kind: jv_kind_set, value: phs_intersection(left.value, right.value) }\n}\n\nfn jv_set_difference(left: &jv_set_value, right: &jv_set_value) -> &jv_set_value {\n    { kind: jv_kind_set, value: phs_difference(left.value, right.value) }\n}\n\nfn jv_set_as_transient(set: &jv_set_value) -> &jvt_set {\n    { value: phs_as_transient(set.value) }\n}\n\nfn jvt_set_count(set: &jvt_set) -> i32 { phst_count(set.value) }\n\nfn jvt_set_contains(set: &jvt_set, value: &jv_value) -> i32 {\n    phst_contains(set.value, value)\n}\n\nfn jvt_set_add(set: &jvt_set, value: &jv_value) {\n    phst_add(set.value, value);\n}\n\nfn jvt_set_remove(set: &jvt_set, value: &jv_value) {\n    phst_remove(set.value, value);\n}\n\nfn jvt_set_persistent(set: &jvt_set) -> &jv_set_value {\n    { kind: jv_kind_set, value: phst_persistent(set.value) }\n}\n\nfn jv_ordered_map_empty() -> &jv_ordered_map_value {\n    {\n        kind: jv_kind_ordered_map,\n        value: jvo_empty(utf8_hash_key, utf8_equal_key),\n    }\n}\n\nfn jv_get_ordered_map(value: &jv_value) -> (i32, &?jv_ordered_map_value) {\n    match value {\n        found: &jv_ordered_map_value => { return (1, found); }\n        _ => { return (0, null); }\n    }\n    unreachable;\n}\n\nfn jv_require_ordered_map(value: &jv_value) -> &jv_ordered_map_value {\n    let (found, out) = jv_get_ordered_map(value);\n    if found == 0 { unreachable; }\n    out!\n}\n\nfn jv_ordered_map_count(map: &jv_ordered_map_value) -> i32 {\n    jvo_count(map.value)\n}\n\nfn jv_ordered_map_get(\n    map: &jv_ordered_map_value,\n    key: &utf8_string,\n) -> (i32, &?jv_value) {\n    let (found, value) = jvo_get(map.value, key);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jv_ordered_map_contains(map: &jv_ordered_map_value, key: &utf8_string) -> i32 {\n    jvo_contains(map.value, key)\n}\n\nfn jv_ordered_map_assoc(\n    map: &jv_ordered_map_value,\n    key: &utf8_string,\n    value: &jv_value,\n) -> &jv_ordered_map_value {\n    let raw = jvo_assoc(map.value, key, value);\n    if raw == map.value { return map; }\n    { kind: jv_kind_ordered_map, value: raw }\n}\n\nfn jv_ordered_map_dissoc(\n    map: &jv_ordered_map_value,\n    key: &utf8_string,\n) -> &jv_ordered_map_value {\n    let raw = jvo_dissoc(map.value, key);\n    if raw == map.value { return map; }\n    { kind: jv_kind_ordered_map, value: raw }\n}\n\nfn jv_ordered_map_each(\n    map: &jv_ordered_map_value,\n    context: &?eq,\n    visit: &jv_map_visit,\n) {\n    let cursor: i32 = 0;\n    while cursor <s pv_count(map.value.entries) {\n        let (next, entry) = jvo_next(map.value, cursor);\n        cursor = next;\n        if entry != null {\n            visit(\n                context,\n                entry!.key as &utf8_string,\n                entry!.value! as &jv_value,\n            );\n        }\n    }\n}\n\nfn jv_ordered_map_as_transient(map: &jv_ordered_map_value) -> &jvt_ordered_map {\n    { value: jvo_as_transient(map.value) }\n}\n\nfn jvt_ordered_map_count(map: &jvt_ordered_map) -> i32 {\n    jvot_count(map.value)\n}\n\nfn jvt_ordered_map_get(\n    map: &jvt_ordered_map,\n    key: &utf8_string,\n) -> (i32, &?jv_value) {\n    let (found, value) = jvot_get(map.value, key);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jvt_ordered_map_contains(map: &jvt_ordered_map, key: &utf8_string) -> i32 {\n    jvot_contains(map.value, key)\n}\n\nfn jvt_ordered_map_assoc(\n    map: &jvt_ordered_map,\n    key: &utf8_string,\n    value: &jv_value,\n) {\n    jvot_assoc(map.value, key, value);\n}\n\nfn jvt_ordered_map_dissoc(map: &jvt_ordered_map, key: &utf8_string) {\n    jvot_dissoc(map.value, key);\n}\n\nfn jvt_ordered_map_persistent(map: &jvt_ordered_map) -> &jv_ordered_map_value {\n    { kind: jv_kind_ordered_map, value: jvot_persistent(map.value) }\n}\n\nfn jv_ordered_set_empty() -> &jv_ordered_set_value {\n    {\n        kind: jv_kind_ordered_set,\n        value: jvo_empty(jv_hash_key, jv_equal_key),\n    }\n}\n\nfn jv_get_ordered_set(value: &jv_value) -> (i32, &?jv_ordered_set_value) {\n    match value {\n        found: &jv_ordered_set_value => { return (1, found); }\n        _ => { return (0, null); }\n    }\n    unreachable;\n}\n\nfn jv_require_ordered_set(value: &jv_value) -> &jv_ordered_set_value {\n    let (found, out) = jv_get_ordered_set(value);\n    if found == 0 { unreachable; }\n    out!\n}\n\nfn jv_ordered_set_count(set: &jv_ordered_set_value) -> i32 {\n    jvo_count(set.value)\n}\n\nfn jv_ordered_set_contains(set: &jv_ordered_set_value, value: &jv_value) -> i32 {\n    jvo_contains(set.value, value)\n}\n\nfn jv_ordered_set_add(\n    set: &jv_ordered_set_value,\n    value: &jv_value,\n) -> &jv_ordered_set_value {\n    let raw = jvo_assoc(set.value, value, 0 as &i31);\n    if raw == set.value { return set; }\n    { kind: jv_kind_ordered_set, value: raw }\n}\n\nfn jv_ordered_set_remove(\n    set: &jv_ordered_set_value,\n    value: &jv_value,\n) -> &jv_ordered_set_value {\n    let raw = jvo_dissoc(set.value, value);\n    if raw == set.value { return set; }\n    { kind: jv_kind_ordered_set, value: raw }\n}\n\nfn jv_ordered_set_each(\n    set: &jv_ordered_set_value,\n    context: &?eq,\n    visit: &jv_set_visit,\n) {\n    let cursor: i32 = 0;\n    while cursor <s pv_count(set.value.entries) {\n        let (next, entry) = jvo_next(set.value, cursor);\n        cursor = next;\n        if entry != null { visit(context, entry!.key as &jv_value); }\n    }\n}\n\ntype jv_ordered_set_union_context = { out: mut &jv_ordered_set_value };\n\nfn jv_ordered_set_union_add(context: &?eq, value: &jv_value) {\n    let state = context! as &jv_ordered_set_union_context;\n    state.out = jv_ordered_set_add(state.out, value);\n}\n\nfn jv_ordered_set_union(\n    left: &jv_ordered_set_value,\n    right: &jv_ordered_set_value,\n) -> &jv_ordered_set_value {\n    let state: &jv_ordered_set_union_context = { out: left };\n    jv_ordered_set_each(right, state, jv_ordered_set_union_add);\n    state.out\n}\n\ntype jv_ordered_set_filter_context = {\n    other: &jv_ordered_set_value,\n    out: mut &jv_ordered_set_value,\n    keep_present: i32,\n};\n\nfn jv_ordered_set_filter_add(context: &?eq, value: &jv_value) {\n    let state = context! as &jv_ordered_set_filter_context;\n    let present = jv_ordered_set_contains(state.other, value);\n    if present == state.keep_present {\n        state.out = jv_ordered_set_add(state.out, value);\n    }\n}\n\nfn jv_ordered_set_intersection(\n    left: &jv_ordered_set_value,\n    right: &jv_ordered_set_value,\n) -> &jv_ordered_set_value {\n    let state: &jv_ordered_set_filter_context = {\n        other: right,\n        out: jv_ordered_set_empty(),\n        keep_present: 1,\n    };\n    jv_ordered_set_each(left, state, jv_ordered_set_filter_add);\n    state.out\n}\n\nfn jv_ordered_set_difference(\n    left: &jv_ordered_set_value,\n    right: &jv_ordered_set_value,\n) -> &jv_ordered_set_value {\n    let state: &jv_ordered_set_filter_context = {\n        other: right,\n        out: jv_ordered_set_empty(),\n        keep_present: 0,\n    };\n    jv_ordered_set_each(left, state, jv_ordered_set_filter_add);\n    state.out\n}\n\nfn jv_ordered_set_as_transient(set: &jv_ordered_set_value) -> &jvt_ordered_set {\n    { value: jvo_as_transient(set.value) }\n}\n\nfn jvt_ordered_set_count(set: &jvt_ordered_set) -> i32 {\n    jvot_count(set.value)\n}\n\nfn jvt_ordered_set_contains(set: &jvt_ordered_set, value: &jv_value) -> i32 {\n    jvot_contains(set.value, value)\n}\n\nfn jvt_ordered_set_add(set: &jvt_ordered_set, value: &jv_value) {\n    jvot_assoc(set.value, value, 0 as &i31);\n}\n\nfn jvt_ordered_set_remove(set: &jvt_ordered_set, value: &jv_value) {\n    jvot_dissoc(set.value, value);\n}\n\nfn jvt_ordered_set_persistent(set: &jvt_ordered_set) -> &jv_ordered_set_value {\n    { kind: jv_kind_ordered_set, value: jvot_persistent(set.value) }\n}\n\ntype jv_map_equal_context = {\n    right: &jv_map_value,\n    equal: mut i32,\n};\n\nfn jv_map_equal_entry(context: &?eq, key: &utf8_string, value: &jv_value) {\n    let state = context! as &jv_map_equal_context;\n    if state.equal == 0 { return; }\n    let (found, other) = jv_map_get(state.right, key);\n    if found == 0 { state.equal = 0; return; }\n    if jv_equal(value, other!) == 0 { state.equal = 0; }\n}\n\ntype jv_set_equal_context = {\n    right: &jv_set_value,\n    equal: mut i32,\n};\n\nfn jv_set_equal_entry(context: &?eq, value: &jv_value) {\n    let state = context! as &jv_set_equal_context;\n    if state.equal == 0 { return; }\n    if jv_set_contains(state.right, value) == 0 { state.equal = 0; }\n}\n\nfn jv_ordered_map_equal(\n    left: &jv_ordered_map_value,\n    right: &jv_ordered_map_value,\n) -> i32 {\n    if jv_ordered_map_count(left) != jv_ordered_map_count(right) { return 0; }\n    let left_cursor: i32 = 0;\n    let right_cursor: i32 = 0;\n    let matched: i32 = 0;\n    while matched <s jv_ordered_map_count(left) {\n        let (left_next, left_entry) = jvo_next(left.value, left_cursor);\n        let (right_next, right_entry) = jvo_next(right.value, right_cursor);\n        left_cursor = left_next;\n        right_cursor = right_next;\n        if left_entry == null { return 0; }\n        if right_entry == null { return 0; }\n        if utf8_equal(\n            left_entry!.key as &utf8_string,\n            right_entry!.key as &utf8_string,\n        ) == 0 {\n            return 0;\n        }\n        if jv_equal(\n            left_entry!.value! as &jv_value,\n            right_entry!.value! as &jv_value,\n        ) == 0 {\n            return 0;\n        }\n        matched += 1;\n    }\n    1\n}\n\nfn jv_ordered_set_equal(\n    left: &jv_ordered_set_value,\n    right: &jv_ordered_set_value,\n) -> i32 {\n    if jv_ordered_set_count(left) != jv_ordered_set_count(right) { return 0; }\n    let left_cursor: i32 = 0;\n    let right_cursor: i32 = 0;\n    let matched: i32 = 0;\n    while matched <s jv_ordered_set_count(left) {\n        let (left_next, left_entry) = jvo_next(left.value, left_cursor);\n        let (right_next, right_entry) = jvo_next(right.value, right_cursor);\n        left_cursor = left_next;\n        right_cursor = right_next;\n        if left_entry == null { return 0; }\n        if right_entry == null { return 0; }\n        if jv_equal(\n            left_entry!.key as &jv_value,\n            right_entry!.key as &jv_value,\n        ) == 0 {\n            return 0;\n        }\n        matched += 1;\n    }\n    1\n}\n\nfn jv_equal(left: &jv_value, right: &jv_value) -> i32 {\n    if left == right { return 1; }\n    if left.kind != right.kind { return 0; }\n    match left {\n        found: &jv_null_value => { _ = found; return 1; }\n        a: &jv_bool_value => {\n            return if a.value == (right as &jv_bool_value).value { 1 } else { 0 };\n        }\n        a: &jv_string_value => {\n            return utf8_equal(a.value, (right as &jv_string_value).value);\n        }\n        a: &jv_i32_value => {\n            return if a.value == (right as &jv_i32_value).value { 1 } else { 0 };\n        }\n        a: &jv_i64_value => {\n            return if a.value == (right as &jv_i64_value).value { 1 } else { 0 };\n        }\n        a: &jv_f32_value => {\n            return if a.value.to_bits() == (right as &jv_f32_value).value.to_bits() { 1 } else { 0 };\n        }\n        a: &jv_f64_value => {\n            return if a.value.to_bits() == (right as &jv_f64_value).value.to_bits() { 1 } else { 0 };\n        }\n        a: &jv_vector_value => {\n            let b = right as &jv_vector_value;\n            if jv_vector_count(a) != jv_vector_count(b) { return 0; }\n            let i: i32 = 0;\n            while i <s jv_vector_count(a) {\n                if jv_equal(jv_vector_at(a, i), jv_vector_at(b, i)) == 0 { return 0; }\n                i += 1;\n            }\n            return 1;\n        }\n        a: &jv_map_value => {\n            let b = right as &jv_map_value;\n            if jv_map_count(a) != jv_map_count(b) { return 0; }\n            let state: &jv_map_equal_context = { right: b, equal: 1 };\n            jv_map_each(a, state, jv_map_equal_entry);\n            return state.equal;\n        }\n        a: &jv_any_value => {\n            return jv_any_equal(a.value, (right as &jv_any_value).value);\n        }\n        a: &jv_set_value => {\n            let b = right as &jv_set_value;\n            if jv_set_count(a) != jv_set_count(b) { return 0; }\n            let state: &jv_set_equal_context = { right: b, equal: 1 };\n            jv_set_each(a, state, jv_set_equal_entry);\n            return state.equal;\n        }\n        a: &jv_ordered_map_value => {\n            return jv_ordered_map_equal(a, right as &jv_ordered_map_value);\n        }\n        a: &jv_ordered_set_value => {\n            return jv_ordered_set_equal(a, right as &jv_ordered_set_value);\n        }\n        a: &jv_record_value => {\n            return jv_record_equal(a, right as &jv_record_value);\n        }\n        _ => { unreachable; }\n    }\n    unreachable;\n}\n\nfn jv_hash_tag(kind: i32) -> i32 {\n    wax_hash_i32_seeded(kind, 0x4a56414c)\n}\n\ntype jv_hash_unordered_context = {\n    sum: mut i32,\n    xor: mut i32,\n};\n\nfn jv_hash_unordered_add(state: &jv_hash_unordered_context, hash: i32) {\n    state.sum = state.sum + hash * 0x9e3779b1;\n    state.xor = state.xor ^ hash.rotl(hash & 31);\n}\n\nfn jv_hash_map_entry(context: &?eq, key: &utf8_string, value: &jv_value) {\n    let state = context! as &jv_hash_unordered_context;\n    let entry = wax_hash_add_i32(utf8_hash(key), jv_hash(value));\n    jv_hash_unordered_add(state, wax_hash_finalize(entry, 8));\n}\n\nfn jv_hash_set_entry(context: &?eq, value: &jv_value) {\n    jv_hash_unordered_add(context! as &jv_hash_unordered_context, jv_hash(value));\n}\n\nfn jv_hash_ordered_map(value: &jv_ordered_map_value) -> i32 {\n    let state = jv_hash_tag(jv_kind_ordered_map);\n    let cursor: i32 = 0;\n    while cursor <s pv_count(value.value.entries) {\n        let (next, entry) = jvo_next(value.value, cursor);\n        cursor = next;\n        if entry != null {\n            state = wax_hash_add_i32(state, utf8_hash(entry!.key as &utf8_string));\n            state = wax_hash_add_i32(state, jv_hash(entry!.value! as &jv_value));\n        }\n    }\n    wax_hash_finalize(state, jv_ordered_map_count(value) * 8)\n}\n\nfn jv_hash_ordered_set(value: &jv_ordered_set_value) -> i32 {\n    let state = jv_hash_tag(jv_kind_ordered_set);\n    let cursor: i32 = 0;\n    while cursor <s pv_count(value.value.entries) {\n        let (next, entry) = jvo_next(value.value, cursor);\n        cursor = next;\n        if entry != null {\n            state = wax_hash_add_i32(state, jv_hash(entry!.key as &jv_value));\n        }\n    }\n    wax_hash_finalize(state, jv_ordered_set_count(value) * 4)\n}\n\nfn jv_hash(value: &jv_value) -> i32 {\n    match value {\n        found: &jv_null_value => { _ = found; return jv_hash_tag(jv_kind_null); }\n        found: &jv_bool_value => {\n            return wax_hash_i32_seeded(found.value, jv_hash_tag(jv_kind_bool));\n        }\n        found: &jv_string_value => {\n            return wax_hash_i32_seeded(utf8_hash(found.value), jv_hash_tag(jv_kind_string));\n        }\n        found: &jv_i32_value => {\n            return wax_hash_i32_seeded(found.value, jv_hash_tag(jv_kind_i32));\n        }\n        found: &jv_i64_value => {\n            let bits = found.value;\n            let state = wax_hash_add_i32(jv_hash_tag(jv_kind_i64), bits as i32);\n            return wax_hash_finalize(wax_hash_add_i32(state, (bits >>u 32) as i32), 8);\n        }\n        found: &jv_f32_value => {\n            return wax_hash_i32_seeded(found.value.to_bits(), jv_hash_tag(jv_kind_f32));\n        }\n        found: &jv_f64_value => {\n            let bits = found.value.to_bits();\n            let state = wax_hash_add_i32(jv_hash_tag(jv_kind_f64), bits as i32);\n            return wax_hash_finalize(wax_hash_add_i32(state, (bits >>u 32) as i32), 8);\n        }\n        found: &jv_vector_value => {\n            let state = jv_hash_tag(jv_kind_vector);\n            let i: i32 = 0;\n            while i <s jv_vector_count(found) {\n                state = wax_hash_add_i32(state, jv_hash(jv_vector_at(found, i)));\n                i += 1;\n            }\n            return wax_hash_finalize(state, jv_vector_count(found) * 4);\n        }\n        found: &jv_map_value => {\n            let state: &jv_hash_unordered_context = { sum: 0, xor: 0 };\n            jv_map_each(found, state, jv_hash_map_entry);\n            let hash = wax_hash_add_i32(jv_hash_tag(jv_kind_map), state.sum);\n            return wax_hash_finalize(wax_hash_add_i32(hash, state.xor), jv_map_count(found) * 8);\n        }\n        found: &jv_any_value => {\n            _ = found;\n            // WebAssembly exposes reference equality but no stable identity hash.\n            // A constant preserves equal => same hash; many opaque values collide.\n            return jv_hash_tag(jv_kind_any);\n        }\n        found: &jv_set_value => {\n            let state: &jv_hash_unordered_context = { sum: 0, xor: 0 };\n            jv_set_each(found, state, jv_hash_set_entry);\n            let hash = wax_hash_add_i32(jv_hash_tag(jv_kind_set), state.sum);\n            return wax_hash_finalize(wax_hash_add_i32(hash, state.xor), jv_set_count(found) * 4);\n        }\n        found: &jv_ordered_map_value => { return jv_hash_ordered_map(found); }\n        found: &jv_ordered_set_value => { return jv_hash_ordered_set(found); }\n        found: &jv_record_value => { return jv_record_hash(found); }\n        _ => { unreachable; }\n    }\n    unreachable;\n}\n"),
  ("record.wax", "// Runtime-defined immutable records for jv_value.\n//\n// Concatenate this file after immutable_value.wax. Record definitions, schemas,\n// and values are immutable. Validator callbacks must be pure and deterministic.\n\nconst jv_record_ok = 0;\nconst jv_record_unknown_field = 1;\nconst jv_record_duplicate_field = 2;\nconst jv_record_type_mismatch = 3;\nconst jv_record_field_invalid = 4;\nconst jv_record_value_invalid = 5;\n\nconst jv_type_kind_null = 0;\nconst jv_type_kind_bool = 1;\nconst jv_type_kind_string = 2;\nconst jv_type_kind_i32 = 3;\nconst jv_type_kind_i64 = 4;\nconst jv_type_kind_f32 = 5;\nconst jv_type_kind_f64 = 6;\nconst jv_type_kind_vector = 7;\nconst jv_type_kind_map = 8;\nconst jv_type_kind_opaque = 9;\nconst jv_type_kind_set = 10;\nconst jv_type_kind_record = 11;\nconst jv_type_kind_any = 12;\nconst jv_type_kind_or = 13;\nconst jv_type_kind_ordered_map = 14;\nconst jv_type_kind_ordered_set = 15;\n\ntype jv_record_schema_visit = fn(&?eq, &utf8_string, &jv_type, &jv_value);\ntype jv_record_visit = fn(&?eq, &utf8_string, &jv_value);\n\ntype jvt_record = {\n    definition: &jv_record_type,\n    values: &phmt_map,\n};\n\nfn jv_type_scalar(kind: i32) -> &jv_type {\n    let out: &jv_type_scalar = { kind };\n    out\n}\n\nfn jv_type_null() -> &jv_type { jv_type_scalar(jv_type_kind_null) }\nfn jv_type_bool() -> &jv_type { jv_type_scalar(jv_type_kind_bool) }\nfn jv_type_string() -> &jv_type { jv_type_scalar(jv_type_kind_string) }\nfn jv_type_i32() -> &jv_type { jv_type_scalar(jv_type_kind_i32) }\nfn jv_type_i64() -> &jv_type { jv_type_scalar(jv_type_kind_i64) }\nfn jv_type_f32() -> &jv_type { jv_type_scalar(jv_type_kind_f32) }\nfn jv_type_f64() -> &jv_type { jv_type_scalar(jv_type_kind_f64) }\nfn jv_type_opaque() -> &jv_type { jv_type_scalar(jv_type_kind_opaque) }\nfn jv_type_any() -> &jv_type { jv_type_scalar(jv_type_kind_any) }\n\nfn jv_type_vector(element: &jv_type) -> &jv_type {\n    let out: &jv_type_vector_value = { kind: jv_type_kind_vector, element };\n    out\n}\n\nfn jv_type_map(value: &jv_type) -> &jv_type {\n    let out: &jv_type_map_value = { kind: jv_type_kind_map, value };\n    out\n}\n\nfn jv_type_set(element: &jv_type) -> &jv_type {\n    let out: &jv_type_set_value = { kind: jv_type_kind_set, element };\n    out\n}\n\nfn jv_type_ordered_map(value: &jv_type) -> &jv_type {\n    let out: &jv_type_ordered_map_value = {\n        kind: jv_type_kind_ordered_map,\n        value,\n    };\n    out\n}\n\nfn jv_type_ordered_set(element: &jv_type) -> &jv_type {\n    let out: &jv_type_ordered_set_value = {\n        kind: jv_type_kind_ordered_set,\n        element,\n    };\n    out\n}\n\nfn jv_type_record(definition: &jv_record_type) -> &jv_type {\n    let out: &jv_type_record_value = { kind: jv_type_kind_record, definition };\n    out\n}\n\nfn jv_type_or(left: &jv_type, right: &jv_type) -> &jv_type {\n    let out: &jv_type_or_value = { kind: jv_type_kind_or, left, right };\n    out\n}\n\nfn jv_type_optional(value: &jv_type) -> &jv_type {\n    jv_type_or(jv_type_null(), value)\n}\n\nfn jv_type_kind(value_type: &jv_type) -> i32 { value_type.kind }\n\ntype jv_type_validate_context = {\n    value_type: &jv_type,\n    valid: mut i32,\n};\n\nfn jv_type_validate_vector_entry(context: &?eq, _index: i32, value: &jv_value) {\n    let state = context! as &jv_type_validate_context;\n    if state.valid != 0 {\n        if jv_type_accepts(state.value_type, value) == 0 { state.valid = 0; }\n    }\n}\n\nfn jv_type_validate_map_entry(context: &?eq, _key: &utf8_string, value: &jv_value) {\n    let state = context! as &jv_type_validate_context;\n    if state.valid != 0 {\n        if jv_type_accepts(state.value_type, value) == 0 { state.valid = 0; }\n    }\n}\n\nfn jv_type_validate_set_entry(context: &?eq, value: &jv_value) {\n    let state = context! as &jv_type_validate_context;\n    if state.valid != 0 {\n        if jv_type_accepts(state.value_type, value) == 0 { state.valid = 0; }\n    }\n}\n\nfn jv_type_accepts(value_type: &jv_type, value: &jv_value) -> i32 {\n    match value_type {\n        found: &jv_type_vector_value => {\n            let (is_vector, vector) = jv_get_vector(value);\n            if is_vector == 0 { return 0; }\n            let state: &jv_type_validate_context = { value_type: found.element, valid: 1 };\n            jv_vector_each(vector!, state, jv_type_validate_vector_entry);\n            return state.valid;\n        }\n        found: &jv_type_map_value => {\n            let (is_map, map) = jv_get_map(value);\n            if is_map == 0 { return 0; }\n            let state: &jv_type_validate_context = { value_type: found.value, valid: 1 };\n            jv_map_each(map!, state, jv_type_validate_map_entry);\n            return state.valid;\n        }\n        found: &jv_type_set_value => {\n            let (is_set, set) = jv_get_set(value);\n            if is_set == 0 { return 0; }\n            let state: &jv_type_validate_context = { value_type: found.element, valid: 1 };\n            jv_set_each(set!, state, jv_type_validate_set_entry);\n            return state.valid;\n        }\n        found: &jv_type_ordered_map_value => {\n            let (is_map, map) = jv_get_ordered_map(value);\n            if is_map == 0 { return 0; }\n            let state: &jv_type_validate_context = {\n                value_type: found.value,\n                valid: 1,\n            };\n            jv_ordered_map_each(map!, state, jv_type_validate_map_entry);\n            return state.valid;\n        }\n        found: &jv_type_ordered_set_value => {\n            let (is_set, set) = jv_get_ordered_set(value);\n            if is_set == 0 { return 0; }\n            let state: &jv_type_validate_context = {\n                value_type: found.element,\n                valid: 1,\n            };\n            jv_ordered_set_each(set!, state, jv_type_validate_set_entry);\n            return state.valid;\n        }\n        found: &jv_type_record_value => {\n            match value {\n                record: &jv_record_value => {\n                    return if record.definition == found.definition { 1 } else { 0 };\n                }\n                _ => { return 0; }\n            }\n        }\n        found: &jv_type_or_value => {\n            if jv_type_accepts(found.left, value) != 0 { return 1; }\n            return jv_type_accepts(found.right, value);\n        }\n        found: &jv_type_scalar => {\n            if found.kind == jv_type_kind_any { return 1; }\n            let expected = if found.kind == jv_type_kind_opaque {\n                jv_kind_any\n            } else {\n                found.kind\n            };\n            return if jv_kind(value) == expected { 1 } else { 0 };\n        }\n        _ => { unreachable; }\n    }\n    unreachable;\n}\n\nfn jv_record_schema_empty() -> &jv_record_schema {\n    {\n        fields: phm_empty(utf8_hash_key, utf8_equal_key),\n        defaults: phm_empty(utf8_hash_key, utf8_equal_key),\n    }\n}\n\nfn jv_record_schema_count(schema: &jv_record_schema) -> i32 {\n    phm_count(schema.fields)\n}\n\nfn jv_record_schema_has(schema: &jv_record_schema, field: &utf8_string) -> i32 {\n    phm_contains(schema.fields, field)\n}\n\nfn jv_record_schema_get_field(\n    schema: &jv_record_schema,\n    field: &utf8_string,\n) -> (i32, &?jv_record_field) {\n    let (found, value) = phm_get(schema.fields, field);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_record_field)\n}\n\nfn jv_record_field_type(field: &jv_record_field) -> &jv_type { field.value_type }\nfn jv_record_field_default(field: &jv_record_field) -> &jv_value { field.default_value }\n\nfn jv_record_accept_field(_context: &?eq, _value: &jv_value) -> i32 { 1 }\nfn jv_record_accept_value(_context: &?eq, _record: &jv_record_value) -> i32 { 1 }\n\nfn jv_record_validate_field(field: &jv_record_field, value: &jv_value) -> i32 {\n    if jv_type_accepts(field.value_type, value) == 0 { return jv_record_type_mismatch; }\n    if (field.validator as &jv_field_validator)(field.validator_context, value) == 0 {\n        return jv_record_field_invalid;\n    }\n    jv_record_ok\n}\n\nfn jv_record_schema_try_add_validated(\n    schema: &jv_record_schema,\n    field: &utf8_string,\n    value_type: &jv_type,\n    default_value: &jv_value,\n    validator_context: &?eq,\n    validator: &jv_field_validator,\n) -> (i32, &?jv_record_schema) {\n    if jv_record_schema_has(schema, field) != 0 {\n        return (jv_record_duplicate_field, null);\n    }\n    let spec: &jv_record_field = {\n        value_type,\n        default_value,\n        validator_context,\n        validator,\n    };\n    let status = jv_record_validate_field(spec, default_value);\n    if status != jv_record_ok { return (status, null); }\n    let out: &jv_record_schema = {\n        fields: phm_assoc(schema.fields, field, spec),\n        defaults: phm_assoc(schema.defaults, field, default_value),\n    };\n    (jv_record_ok, out)\n}\n\nfn jv_record_schema_add_validated(\n    schema: &jv_record_schema,\n    field: &utf8_string,\n    value_type: &jv_type,\n    default_value: &jv_value,\n    validator_context: &?eq,\n    validator: &jv_field_validator,\n) -> &jv_record_schema {\n    let (status, out) = jv_record_schema_try_add_validated(\n        schema,\n        field,\n        value_type,\n        default_value,\n        validator_context,\n        validator,\n    );\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_schema_try_add(\n    schema: &jv_record_schema,\n    field: &utf8_string,\n    value_type: &jv_type,\n    default_value: &jv_value,\n) -> (i32, &?jv_record_schema) {\n    jv_record_schema_try_add_validated(\n        schema,\n        field,\n        value_type,\n        default_value,\n        null,\n        jv_record_accept_field,\n    )\n}\n\nfn jv_record_schema_add(\n    schema: &jv_record_schema,\n    field: &utf8_string,\n    value_type: &jv_type,\n    default_value: &jv_value,\n) -> &jv_record_schema {\n    jv_record_schema_add_validated(\n        schema,\n        field,\n        value_type,\n        default_value,\n        null,\n        jv_record_accept_field,\n    )\n}\n\ntype jv_record_schema_each_context = {\n    context: &?eq,\n    visit: &jv_record_schema_visit,\n};\n\nfn jv_record_schema_each_adapter(context: &?eq, key: &?eq, value: &?eq) {\n    let state = context! as &jv_record_schema_each_context;\n    let spec = value! as &jv_record_field;\n    state.visit(state.context, key! as &utf8_string, spec.value_type, spec.default_value);\n}\n\nfn jv_record_schema_each(\n    schema: &jv_record_schema,\n    context: &?eq,\n    visit: &jv_record_schema_visit,\n) {\n    let state: &jv_record_schema_each_context = { context, visit };\n    phm_each(schema.fields, state, jv_record_schema_each_adapter);\n}\n\nfn jv_record_candidate(definition: &jv_record_type, values: &phm_map) -> &jv_record_value {\n    { kind: jv_kind_record, definition, values }\n}\n\nfn jv_record_validate_candidate(record: &jv_record_value) -> i32 {\n    if (record.definition.validator as &jv_record_validator)(\n        record.definition.validator_context,\n        record,\n    ) == 0 {\n        return jv_record_value_invalid;\n    }\n    jv_record_ok\n}\n\nfn jv_record_type_try_create_validated(\n    name: &utf8_string,\n    schema: &jv_record_schema,\n    validator_context: &?eq,\n    validator: &jv_record_validator,\n) -> (i32, &?jv_record_type) {\n    let definition: &jv_record_type = {\n        name,\n        schema,\n        validator_context,\n        validator,\n    };\n    let candidate = jv_record_candidate(definition, schema.defaults);\n    let status = jv_record_validate_candidate(candidate);\n    if status != jv_record_ok { return (status, null); }\n    (jv_record_ok, definition)\n}\n\nfn jv_record_type_create_validated(\n    name: &utf8_string,\n    schema: &jv_record_schema,\n    validator_context: &?eq,\n    validator: &jv_record_validator,\n) -> &jv_record_type {\n    let (status, out) = jv_record_type_try_create_validated(\n        name,\n        schema,\n        validator_context,\n        validator,\n    );\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_type_create(\n    name: &utf8_string,\n    schema: &jv_record_schema,\n) -> &jv_record_type {\n    jv_record_type_create_validated(name, schema, null, jv_record_accept_value)\n}\n\nfn jv_record_type_name(definition: &jv_record_type) -> &utf8_string { definition.name }\nfn jv_record_type_schema(definition: &jv_record_type) -> &jv_record_schema { definition.schema }\n\nfn jv_record_default(definition: &jv_record_type) -> &jv_record_value {\n    jv_record_candidate(definition, definition.schema.defaults)\n}\n\nfn jv_get_record(value: &jv_value) -> (i32, &?jv_record_value) {\n    match value {\n        found: &jv_record_value => { return (1, found); }\n        _ => { return (0, null); }\n    }\n    unreachable;\n}\n\nfn jv_require_record(value: &jv_value) -> &jv_record_value {\n    let (found, out) = jv_get_record(value);\n    if found == 0 { unreachable; }\n    out!\n}\n\nfn jv_record_definition(record: &jv_record_value) -> &jv_record_type {\n    record.definition\n}\n\nfn jv_record_count(record: &jv_record_value) -> i32 {\n    jv_record_schema_count(record.definition.schema)\n}\n\nfn jv_record_has_field(record: &jv_record_value, field: &utf8_string) -> i32 {\n    jv_record_schema_has(record.definition.schema, field)\n}\n\nfn jv_record_get(\n    record: &jv_record_value,\n    field: &utf8_string,\n) -> (i32, &?jv_value) {\n    let (found, value) = phm_get(record.values, field);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jv_record_at(record: &jv_record_value, field: &utf8_string) -> &jv_value {\n    let (found, value) = jv_record_get(record, field);\n    if found == 0 { unreachable; }\n    value!\n}\n\nfn jv_record_try_set(\n    record: &jv_record_value,\n    field: &utf8_string,\n    value: &jv_value,\n) -> (i32, &?jv_record_value) {\n    let (found, spec) = jv_record_schema_get_field(record.definition.schema, field);\n    if found == 0 { return (jv_record_unknown_field, null); }\n    let status = jv_record_validate_field(spec!, value);\n    if status != jv_record_ok { return (status, null); }\n    let (_, old) = jv_record_get(record, field);\n    if jv_equal(old!, value) != 0 { return (jv_record_ok, record); }\n    let candidate = jv_record_candidate(\n        record.definition,\n        phm_assoc(record.values, field, value),\n    );\n    let candidate_status = jv_record_validate_candidate(candidate);\n    if candidate_status != jv_record_ok { return (candidate_status, null); }\n    (jv_record_ok, candidate)\n}\n\nfn jv_record_set(\n    record: &jv_record_value,\n    field: &utf8_string,\n    value: &jv_value,\n) -> &jv_record_value {\n    let (status, out) = jv_record_try_set(record, field, value);\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_try_reset(\n    record: &jv_record_value,\n    field: &utf8_string,\n) -> (i32, &?jv_record_value) {\n    let (found, spec) = jv_record_schema_get_field(record.definition.schema, field);\n    if found == 0 { return (jv_record_unknown_field, null); }\n    jv_record_try_set(record, field, spec!.default_value)\n}\n\nfn jv_record_reset(record: &jv_record_value, field: &utf8_string) -> &jv_record_value {\n    let (status, out) = jv_record_try_reset(record, field);\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_clear(record: &jv_record_value) -> &jv_record_value {\n    if record.values == record.definition.schema.defaults { return record; }\n    jv_record_default(record.definition)\n}\n\ntype jv_record_build_context = {\n    definition: &jv_record_type,\n    values: &phmt_map,\n    strict: i32,\n    status: mut i32,\n    failed_field: mut &?utf8_string,\n    changed: mut i32,\n};\n\nfn jv_record_build_entry(context: &?eq, key: &utf8_string, value: &jv_value) {\n    let state = context! as &jv_record_build_context;\n    if state.status != jv_record_ok { return; }\n    let (found, spec) = jv_record_schema_get_field(state.definition.schema, key);\n    if found == 0 {\n        if state.strict != 0 {\n            state.status = jv_record_unknown_field;\n            state.failed_field = key;\n        }\n        return;\n    }\n    let status = jv_record_validate_field(spec!, value);\n    if status != jv_record_ok {\n        state.status = status;\n        state.failed_field = key;\n        return;\n    }\n    let (old_found, old) = phmt_get(state.values, key);\n    if old_found != 0 {\n        if jv_equal(old! as &jv_value, value) != 0 { return; }\n    }\n    phmt_assoc(state.values, key, value);\n    state.changed = 1;\n}\n\nfn jv_record_try_apply_map(\n    definition: &jv_record_type,\n    initial: &phm_map,\n    overrides: &jv_map_value,\n    strict: i32,\n) -> (i32, &?utf8_string, &?jv_record_value) {\n    let values = phm_as_transient(initial);\n    let state: &jv_record_build_context = {\n        definition,\n        values,\n        strict,\n        status: jv_record_ok,\n        failed_field: null,\n        changed: 0,\n    };\n    jv_map_each(overrides, state, jv_record_build_entry);\n    let persistent = phmt_persistent(values);\n    if state.status != jv_record_ok {\n        return (state.status, state.failed_field, null);\n    }\n    let candidate = jv_record_candidate(\n        definition,\n        if state.changed == 0 { initial } else { persistent },\n    );\n    let status = jv_record_validate_candidate(candidate);\n    if status != jv_record_ok { return (status, null, null); }\n    (jv_record_ok, null, candidate)\n}\n\nfn jv_record_try_from_map(\n    definition: &jv_record_type,\n    overrides: &jv_map_value,\n) -> (i32, &?utf8_string, &?jv_record_value) {\n    jv_record_try_apply_map(definition, definition.schema.defaults, overrides, 1)\n}\n\nfn jv_record_from_map(\n    definition: &jv_record_type,\n    overrides: &jv_map_value,\n) -> &jv_record_value {\n    let (status, _, out) = jv_record_try_from_map(definition, overrides);\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_try_from_map_lenient(\n    definition: &jv_record_type,\n    overrides: &jv_map_value,\n) -> (i32, &?utf8_string, &?jv_record_value) {\n    jv_record_try_apply_map(definition, definition.schema.defaults, overrides, 0)\n}\n\nfn jv_record_from_map_lenient(\n    definition: &jv_record_type,\n    overrides: &jv_map_value,\n) -> &jv_record_value {\n    let (status, _, out) = jv_record_try_from_map_lenient(definition, overrides);\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_try_merge(\n    record: &jv_record_value,\n    overrides: &jv_map_value,\n) -> (i32, &?utf8_string, &?jv_record_value) {\n    let (status, field, out) = jv_record_try_apply_map(\n        record.definition,\n        record.values,\n        overrides,\n        1,\n    );\n    if status == jv_record_ok {\n        if out!.values == record.values { return (status, field, record); }\n    }\n    (status, field, out)\n}\n\nfn jv_record_merge(\n    record: &jv_record_value,\n    overrides: &jv_map_value,\n) -> &jv_record_value {\n    let (status, _, out) = jv_record_try_merge(record, overrides);\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_try_merge_lenient(\n    record: &jv_record_value,\n    overrides: &jv_map_value,\n) -> (i32, &?utf8_string, &?jv_record_value) {\n    let (status, field, out) = jv_record_try_apply_map(\n        record.definition,\n        record.values,\n        overrides,\n        0,\n    );\n    if status == jv_record_ok {\n        if out!.values == record.values { return (status, field, record); }\n    }\n    (status, field, out)\n}\n\nfn jv_record_merge_lenient(\n    record: &jv_record_value,\n    overrides: &jv_map_value,\n) -> &jv_record_value {\n    let (status, _, out) = jv_record_try_merge_lenient(record, overrides);\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_to_map(record: &jv_record_value) -> &jv_map_value {\n    { kind: jv_kind_map, value: record.values }\n}\n\ntype jv_record_each_context = {\n    context: &?eq,\n    visit: &jv_record_visit,\n};\n\nfn jv_record_each_adapter(context: &?eq, key: &?eq, value: &?eq) {\n    let state = context! as &jv_record_each_context;\n    state.visit(state.context, key! as &utf8_string, value! as &jv_value);\n}\n\nfn jv_record_each(\n    record: &jv_record_value,\n    context: &?eq,\n    visit: &jv_record_visit,\n) {\n    let state: &jv_record_each_context = { context, visit };\n    phm_each(record.values, state, jv_record_each_adapter);\n}\n\nfn jv_record_as_transient(record: &jv_record_value) -> &jvt_record {\n    { definition: record.definition, values: phm_as_transient(record.values) }\n}\n\nfn jvt_record_count(record: &jvt_record) -> i32 { phmt_count(record.values) }\n\nfn jvt_record_get(\n    record: &jvt_record,\n    field: &utf8_string,\n) -> (i32, &?jv_value) {\n    let (found, value) = phmt_get(record.values, field);\n    if found == 0 { return (0, null); }\n    (1, value! as &jv_value)\n}\n\nfn jvt_record_try_set(\n    record: &jvt_record,\n    field: &utf8_string,\n    value: &jv_value,\n) -> i32 {\n    let (found, spec) = jv_record_schema_get_field(record.definition.schema, field);\n    if found == 0 { return jv_record_unknown_field; }\n    let status = jv_record_validate_field(spec!, value);\n    if status != jv_record_ok { return status; }\n    let (old_found, old) = phmt_get(record.values, field);\n    if old_found != 0 {\n        if jv_equal(old! as &jv_value, value) != 0 { return jv_record_ok; }\n    }\n    phmt_assoc(record.values, field, value);\n    jv_record_ok\n}\n\nfn jvt_record_set(record: &jvt_record, field: &utf8_string, value: &jv_value) {\n    if jvt_record_try_set(record, field, value) != jv_record_ok { unreachable; }\n}\n\nfn jvt_record_try_reset(record: &jvt_record, field: &utf8_string) -> i32 {\n    let (found, spec) = jv_record_schema_get_field(record.definition.schema, field);\n    if found == 0 { return jv_record_unknown_field; }\n    jvt_record_try_set(record, field, spec!.default_value)\n}\n\nfn jvt_record_reset(record: &jvt_record, field: &utf8_string) {\n    if jvt_record_try_reset(record, field) != jv_record_ok { unreachable; }\n}\n\nfn jvt_record_try_persistent(record: &jvt_record) -> (i32, &?jv_record_value) {\n    let candidate = jv_record_candidate(record.definition, phmt_persistent(record.values));\n    let status = jv_record_validate_candidate(candidate);\n    if status != jv_record_ok { return (status, null); }\n    (jv_record_ok, candidate)\n}\n\nfn jvt_record_persistent(record: &jvt_record) -> &jv_record_value {\n    let (status, out) = jvt_record_try_persistent(record);\n    if status != jv_record_ok { unreachable; }\n    out!\n}\n\nfn jv_record_equal(left: &jv_record_value, right: &jv_record_value) -> i32 {\n    if left.definition != right.definition { return 0; }\n    return jv_equal(jv_record_to_map(left), jv_record_to_map(right));\n}\n\nfn jv_record_hash(record: &jv_record_value) -> i32 {\n    let state = wax_hash_add_i32(jv_hash_tag(jv_kind_record), utf8_hash(record.definition.name));\n    return wax_hash_add_i32(state, jv_hash(jv_record_to_map(record)));\n}\n"),
]

///|
/// The same thing concatenated, which is the form the parser wants.
///
/// Wax has no import system: the stdlib IS its concatenation, compiled as one
/// module ahead of whatever uses it. The order is fixed upstream and mirrored
/// in `build/vendor-embed.mjs`.
pub let stdlib_src : String = {
  let sb = StringBuilder::new()
  for f in stdlib_files {
    sb.write_string(f.1)
    sb.write_string("\n")
  }
  sb.to_string()
}

///|
/// cardwasm's own fixed runtime, from `runtime/`. Hand-written, not vendored.
pub let runtime_files : Array[(String, String)] = [
  ("runtime.wax", "// The fixed card runtime: tutuca's value semantics over the Wax data stdlib.\n//\n// This is SOURCE, not a tree the generator builds. Everything here is the same\n// in every card, so there is nothing for a generator to decide, and a hundred\n// lines of readable Wax beat five hundred lines of MoonBit that assembles the\n// same instructions out of `call(...)` and `if_(...)`. The per-card half — the\n// schema, the handlers, the dispatch chains — is still built as an AST, where\n// the decisions actually are.\n//\n// Concatenated AFTER `vendor/wax/` (which it calls into) and after the memory,\n// the constant pool and `alloc` (which it also calls into), and BEFORE the\n// generated card.\n//\n// `tc_` is the prefix. Every name in a Wax module is global and the stdlib has\n// claimed `wax_ phm_ phmt_ phs_ phst_ pv_ pvt_ utf8_ jv_ jvt_ st_`; this is the\n// one that is ours, and the generator prefixes card-derived names too.\n//\n// THE NUMERIC RULE. tutuca has exactly one number type — `Value::Num(Double)`,\n// `core/spec.mbt` — and jv has four that never coerce, with `jv_equal` false\n// across them. So this file builds `jv_f64` and NOTHING ELSE, and every read\n// goes through `tc_num_of`. An `jv_i32` reaching a comparison would be a bug\n// that reads as \"the numbers are not equal\".\n\n// ---------------------------------------------------------------------------\n// state that outlives a call\n\n// Interned string constants, in the pool's order. Built by the generated\n// `#[start]`, read by `tc_const`. A card's literals are built ONCE rather than\n// re-validated and re-hashed at every evaluation.\nlet tc_consts: &?pv_vector = null;\n\n// Every instance this module has handed out. The canonical ABI's `resource_new`\n// takes an i32 rep, and a GC reference is not an i32, so the rep is an index\n// into here.\n//\n// Nothing is ever removed. That is the same trade the bump allocator made\n// before it — an instance is live for as long as one edit-and-mount — and it is\n// why `cabi_post_*` is still a no-op.\nlet tc_insts: &?pv_vector = null;\n\n// The card's state type, built by the generated `#[start]` because its schema\n// is the one thing here a card decides.\nlet tc_state_type: &?jv_record_type = null;\n\n// Set when a body did something with no answer — a division by zero, an index\n// past the end of a list. `interp/eval.mbt` returns `None` for these and the\n// `None` propagates until the transition is abandoned; a compiled body has no\n// option type to propagate, so it raises this flag and `handle-event` reads it\n// where the interpreter would have seen the None.\n//\n// \"Failure is no change\" is the contract, and this is what keeps it.\nlet tc_fail: i32 = 0;\n\n// Effects a body has performed, NOT yet told to the host.\n//\n// The interpreter collects effects into an `Outcome` and drops them when the\n// transition is abandoned, so a `send` before a failing statement never\n// happens. A compiled body used to call the host import as it went, which the\n// host cannot un-hear. Buffering here and flushing after the contracts hold is\n// what makes the two backends agree about a `send` that should not have\n// escaped.\nlet tc_effects: &?pv_vector = null;\n\n// Spellings a value's text form needs and a card may not contain.\nlet tc_s_true: &?utf8_string = null;\nlet tc_s_false: &?utf8_string = null;\nlet tc_s_nan: &?utf8_string = null;\nlet tc_s_inf: &?utf8_string = null;\nlet tc_s_empty: &?utf8_string = null;\nlet tc_s_null: &?utf8_string = null;\nlet tc_s_comma: &?utf8_string = null;\nlet tc_s_object: &?utf8_string = null;\n\nfn tc_init() {\n    tc_consts = pv_empty();\n    tc_insts = pv_empty();\n    tc_effects = pv_empty();\n    tc_s_true = utf8_from_bytes(\"true\");\n    tc_s_false = utf8_from_bytes(\"false\");\n    tc_s_nan = utf8_from_bytes(\"NaN\");\n    tc_s_inf = utf8_from_bytes(\"Infinity\");\n    tc_s_empty = utf8_empty();\n    tc_s_null = utf8_from_bytes(\"null\");\n    tc_s_comma = utf8_from_bytes(\",\");\n    tc_s_object = utf8_from_bytes(\"[object]\");\n}\n\n// ---------------------------------------------------------------------------\n// strings across the ABI boundary\n//\n// The canonical ABI passes a string as (pointer, byte length) into linear\n// memory; a `utf8_string` owns a GC byte array. There is no bulk move between\n// the two, so both directions are a loop.\n\nfn tc_str_in(p: i32, l: i32) -> &utf8_string {\n    if l <=s 0 { return tc_s_empty!; }\n    let bytes = [wax_hash_bytes| 0; l];\n    let i: i32 = 0;\n    while i <s l {\n        bytes[i] = mem.load8(p + i) as i32_u;\n        i += 1;\n    }\n    // The host said it was a string, so it is valid UTF-8 or the host is\n    // broken. `try` rather than `from` so a broken host is an empty string\n    // instead of a trap that takes the instance with it.\n    let (valid, out) = utf8_try_from_bytes(bytes);\n    if valid == 0 { return tc_s_empty!; }\n    out!\n}\n\n// Copies into freshly allocated linear memory and answers the pointer. The\n// length is `utf8_byte_length`, which the caller already has.\nfn tc_str_out(s: &utf8_string) -> i32 {\n    let l = utf8_byte_length(s);\n    if l == 0 { return 0; }\n    let p = alloc(l, 1);\n    let i: i32 = 0;\n    while i <s l {\n        mem.store8(p + i, utf8_at_byte(s, i));\n        i += 1;\n    }\n    p\n}\n\n// ---------------------------------------------------------------------------\n// constructors\n\nfn tc_null() -> &jv_value { jv_null() }\n\nfn tc_bool(b: i32) -> &jv_value { jv_bool(b) }\n\nfn tc_num(x: f64) -> &jv_value { jv_f64(x) }\n\nfn tc_text(s: &utf8_string) -> &jv_value { jv_string(s) }\n\n// Intern one pool constant. Called by the generated `#[start]`, once per\n// string, IN POOL ORDER — the index a use site names is this one's position.\nfn tc_intern_const(at: i32, len: i32) {\n    tc_consts = pv_push(tc_consts!, jv_string(tc_str_in(at, len)));\n}\n\n// A pool constant, by index. See `tc_consts`.\nfn tc_const(i: i32) -> &jv_value {\n    let (found, v) = pv_get(tc_consts!, i);\n    if found == 0 { return jv_null(); }\n    v! as &jv_value\n}\n\n// The `&utf8_string` behind a pool constant, for the places that want text\n// rather than a value.\nfn tc_const_str(i: i32) -> &utf8_string {\n    jv_require_string(tc_const(i))\n}\n\n// ---------------------------------------------------------------------------\n// reading a value\n//\n// Every one of these is total. A card that reads a number out of a string gets\n// 0 rather than a trap: the interpreter's accessors are partial and answer\n// `None`, and the shape that loses the least here is the zero, which is what\n// the old cell runtime did when it read a `nil` payload.\n\nfn tc_num_of(v: &jv_value) -> f64 {\n    let (found, x) = jv_get_f64(v);\n    if found == 0 { return 0.0; }\n    x\n}\n\nfn tc_is_text(v: &jv_value) -> i32 {\n    if jv_kind(v) == jv_kind_string { 1 } else { 0 }\n}\n\nfn tc_is_null(v: &jv_value) -> i32 {\n    if jv_kind(v) == jv_kind_null { 1 } else { 0 }\n}\n\n// JS truthiness, which is what `@show` and `if` ask for.\n// `core/value_eval.mbt`'s `Value::is_truthy`: null and false and 0 and NaN and\n// \"\" are false, and a list or a map is ALWAYS true however empty it is.\nfn tc_truthy(v: &jv_value) -> i32 {\n    let k = jv_kind(v);\n    if k == jv_kind_null { return 0; }\n    if k == jv_kind_bool { return jv_require_bool(v); }\n    if k == jv_kind_f64 {\n        let x = jv_require_f64(v);\n        if x != x { return 0; }\n        if x == 0.0 { return 0; }\n        return 1;\n    }\n    if k == jv_kind_string {\n        if utf8_is_empty(jv_require_string(v)) == 1 { return 0; }\n        return 1;\n    }\n    1\n}\n\n// The OTHER truthiness: what a `pred` asks, where an empty collection is false.\n// `core/value_eval.mbt`'s `pred_truthy`. The two differ and both are right;\n// keeping them apart is what stops `@show=\".items\"` from always showing.\nfn tc_pred_truthy(v: &jv_value) -> i32 {\n    let k = jv_kind(v);\n    if k == jv_kind_vector {\n        if jv_vector_count(jv_require_vector(v)) == 0 { return 0; }\n        return 1;\n    }\n    if k == jv_kind_ordered_map {\n        if jv_ordered_map_count(jv_require_ordered_map(v)) == 0 { return 0; }\n        return 1;\n    }\n    tc_truthy(v)\n}\n\n// ---------------------------------------------------------------------------\n// equality and ordering\n\n// `jv_equal` is structural and almost right. Two deviations from\n// `core/value_eval.mbt`'s `impl Eq for Value`, both about f64:\n//\n//   - jv compares BIT PATTERNS, so `+0.0` and `-0.0` are unequal. tutuca says\n//     they are equal, and so does JavaScript, and a card that counts down to\n//     zero by subtraction can reach the negative one.\n//   - bit patterns also make `NaN == NaN` true, which is what tutuca says too\n//     (deliberately — see the note on that impl), so THAT one needs no help.\nfn tc_eq(a: &jv_value, b: &jv_value) -> i32 {\n    if jv_kind(a) == jv_kind_f64 {\n        if jv_kind(b) == jv_kind_f64 {\n            let x = jv_require_f64(a);\n            let y = jv_require_f64(b);\n            if x == 0.0 {\n                if y == 0.0 { return 1; }\n            }\n            return jv_equal(a, b);\n        }\n    }\n    jv_equal(a, b)\n}\n\n// -1, 0 or 1. Two strings compare as text and everything else as numbers,\n// which is `interp/eval.mbt`'s `compare_op`.\nfn tc_cmp(a: &jv_value, b: &jv_value) -> i32 {\n    if tc_is_text(a) == 1 {\n        if tc_is_text(b) == 1 {\n            return utf8_compare(jv_require_string(a), jv_require_string(b));\n        }\n    }\n    let x = tc_num_of(a);\n    let y = tc_num_of(b);\n    if x < y { return -1; }\n    if x > y { return 1; }\n    0\n}\n\n// ---------------------------------------------------------------------------\n// text of a value\n\n// A number as text. NOT a float formatter: the integer part exactly, then up to\n// six fractional digits with the trailing zeros trimmed. That is what a\n// counter, a total and a price need and it is not what `0.1 + 0.2` needs — see\n// \"Known deviations\" in README.md. Ported unchanged from the cell runtime, so\n// the deviation did not move when the representation did.\nfn tc_num_text(x: f64) -> &utf8_string {\n    if x != x { return tc_s_nan!; }\n    let a = x;\n    let neg: i32 = 0;\n    if a < 0.0 {\n        neg = 1;\n        a = 0.0 - a;\n    }\n    if a > 1.0e15 { return tc_s_inf!; }\n\n    // Digits of the integer part, least significant first.\n    let tmp = [wax_hash_bytes| 0; 24];\n    let k: i32 = 0;\n    let ip = a.floor();\n    let fr = a - ip;\n    if ip < 1.0 {\n        tmp[0] = 48;\n        k = 1;\n    } else {\n        while ip >= 1.0 {\n            let q = (ip / 10.0).floor();\n            let d = (ip - q * 10.0) as i32_s;\n            tmp[k] = d + 48;\n            k += 1;\n            ip = q;\n        }\n    }\n\n    let out = [wax_hash_bytes| 0; 48];\n    let n: i32 = 0;\n    if neg == 1 {\n        out[0] = 45;\n        n = 1;\n    }\n    let j = k;\n    while j >s 0 {\n        out[n] = tmp[j - 1] as i32_u;\n        n += 1;\n        j -= 1;\n    }\n    if fr > 0.0 {\n        out[n] = 46;\n        n += 1;\n        let last = n;\n        let c: i32 = 0;\n        while c <s 6 {\n            fr = fr * 10.0;\n            let d = fr.floor() as i32_s;\n            out[n] = d + 48;\n            n += 1;\n            if d != 0 { last = n; }\n            fr = fr - (d as f64_s);\n            c += 1;\n        }\n        n = last;\n    }\n    utf8_from_bytes(utf8_copy_storage(out, 0, n))\n}\n\n// A value as text — `core/value_eval.mbt`'s `to_display_string`, which is\n// JavaScript's `${v}`.\n//\n// The three that are easy to get wrong, and that the corpus caught:\n//   - null is \"null\", not the empty string. The empty string is `tpl_piece`,\n//     which is a DIFFERENT function and is the one a template uses.\n//   - a list joins with \",\" and its elements go through `tpl_piece`, so a null\n//     ELEMENT is \"\" even though a null VALUE is \"null\". That is JS\n//     `Array.join`, faithfully.\n//   - a map is \"[object]\", which is what `${{}}` gives you.\nfn tc_display(v: &jv_value) -> &utf8_string {\n    let k = jv_kind(v);\n    if k == jv_kind_string { return jv_require_string(v); }\n    if k == jv_kind_f64 { return tc_num_text(jv_require_f64(v)); }\n    if k == jv_kind_bool {\n        if jv_require_bool(v) == 1 { return tc_s_true!; }\n        return tc_s_false!;\n    }\n    if k == jv_kind_null { return tc_s_null!; }\n    if k == jv_kind_vector {\n        let items = jv_require_vector(v);\n        let n = jv_vector_count(items);\n        let acc = tc_s_empty!;\n        let i: i32 = 0;\n        while i <s n {\n            if i != 0 { acc = utf8_concat(acc, tc_s_comma!); }\n            acc = utf8_concat(acc, tc_tpl(jv_vector_at(items, i)));\n            i += 1;\n        }\n        return acc;\n    }\n    if k == jv_kind_ordered_map { return tc_s_object!; }\n    if k == jv_kind_record { return tc_s_object!; }\n    tc_s_empty!\n}\n\n// One piece of a `$'…'` template, and one element of a joined list. JS\n// `Array.join` turns null into \"\" and String()-coerces the rest.\nfn tc_tpl(v: &jv_value) -> &utf8_string {\n    if jv_kind(v) == jv_kind_null { return tc_s_empty!; }\n    tc_display(v)\n}\n\nfn tc_str(v: &jv_value) -> &jv_value { jv_string(tc_display(v)) }\n\nfn tc_concat(a: &jv_value, b: &jv_value) -> &jv_value {\n    jv_string(utf8_concat(tc_display(a), tc_display(b)))\n}\n\n// The fold a `$'…'` template compiles to. `tpl_piece` rather than\n// `to_display_string`, so an interpolated null vanishes instead of spelling\n// itself out.\nfn tc_tpl_concat(a: &jv_value, b: &jv_value) -> &jv_value {\n    jv_string(utf8_concat(tc_tpl(a), tc_tpl(b)))\n}\n\n// ---------------------------------------------------------------------------\n// arithmetic\n\n// `+` is two operators. It joins two strings and adds two numbers, and which\n// one it is depends on the VALUES rather than on anything the generator knew.\n//\n// A MIXED pair fails, which is `interp/eval.mbt`'s `arith`: it takes the\n// two-strings case first and then requires both to be numbers. An earlier\n// version of this joined a mixed pair instead, on the theory that an opaque\n// event argument is better joined than refused — the corpus disagrees, and the\n// corpus is the language.\nfn tc_both_num(a: &jv_value, b: &jv_value) -> i32 {\n    if jv_kind(a) != jv_kind_f64 { return 0; }\n    if jv_kind(b) != jv_kind_f64 { return 0; }\n    1\n}\n\nfn tc_add(a: &jv_value, b: &jv_value) -> &jv_value {\n    if tc_is_text(a) == 1 {\n        if tc_is_text(b) == 1 { return tc_concat(a, b); }\n    }\n    if tc_both_num(a, b) == 0 {\n        tc_fail = 1;\n        return jv_null();\n    }\n    jv_f64(jv_require_f64(a) + jv_require_f64(b))\n}\n\nfn tc_sub(a: &jv_value, b: &jv_value) -> &jv_value {\n    if tc_both_num(a, b) == 0 {\n        tc_fail = 1;\n        return jv_null();\n    }\n    jv_f64(jv_require_f64(a) - jv_require_f64(b))\n}\n\nfn tc_mul(a: &jv_value, b: &jv_value) -> &jv_value {\n    if tc_both_num(a, b) == 0 {\n        tc_fail = 1;\n        return jv_null();\n    }\n    jv_f64(jv_require_f64(a) * jv_require_f64(b))\n}\n\n// Division by zero has no answer, so the transition does not happen. Not an\n// infinity, and not a zero: `arith` answers `None` and the None is the point.\nfn tc_div(a: &jv_value, b: &jv_value) -> &jv_value {\n    if tc_both_num(a, b) == 0 {\n        tc_fail = 1;\n        return jv_null();\n    }\n    let y = jv_require_f64(b);\n    if y == 0.0 {\n        tc_fail = 1;\n        return jv_null();\n    }\n    jv_f64(jv_require_f64(a) / y)\n}\n\n// `mod` is the INTEGER remainder — `arith` truncates both sides to int and\n// takes `%`, so `7.5 mod 2` is `1` and not `1.5`.\nfn tc_mod(a: &jv_value, b: &jv_value) -> &jv_value {\n    if tc_both_num(a, b) == 0 {\n        tc_fail = 1;\n        return jv_null();\n    }\n    let y = jv_require_f64(b);\n    if y == 0.0 {\n        tc_fail = 1;\n        return jv_null();\n    }\n    let xi = jv_require_f64(a) as i32_s;\n    let yi = y as i32_s;\n    jv_f64((xi %s yi) as f64_s)\n}\n\nfn tc_neg(a: &jv_value) -> &jv_value { jv_f64(0.0 - tc_num_of(a)) }\n\nfn tc_not(a: &jv_value) -> &jv_value {\n    if tc_truthy(a) == 0 { jv_bool(1) } else { jv_bool(0) }\n}\n\nfn tc_int(a: &jv_value) -> &jv_value {\n    if jv_kind(a) != jv_kind_f64 { return jv_null(); }\n    jv_f64(jv_require_f64(a).trunc())\n}\n\n// `empty?` — null is empty, \"\" is empty, and an empty collection is empty.\nfn tc_empty(a: &jv_value) -> &jv_value {\n    let k = jv_kind(a);\n    if k == jv_kind_null { return jv_bool(1); }\n    if k == jv_kind_string {\n        return jv_bool(utf8_is_empty(jv_require_string(a)));\n    }\n    if k == jv_kind_vector {\n        if jv_vector_count(jv_require_vector(a)) == 0 { return jv_bool(1); }\n        return jv_bool(0);\n    }\n    if k == jv_kind_ordered_map {\n        if jv_ordered_map_count(jv_require_ordered_map(a)) == 0 { return jv_bool(1); }\n        return jv_bool(0);\n    }\n    jv_bool(0)\n}\n\n// --- the six that used to be refused ---------------------------------------\n//\n// None of them needed anything the stdlib does not have, and none of them\n// needs Unicode: `interp/eval.mbt` implements `lower`/`upper` as an ASCII\n// A-Z/a-z shift and `trim` over exactly \" \\t\\n\\r\", so byte-level work here\n// agrees with the interpreter by construction rather than by luck.\n\n// `len` — codepoints for a string, items for a collection. `size_of` in\n// `core/value_eval.mbt`; a value with no size answers null there and 0 here,\n// which is what `len` of a number has always meant to a card.\nfn tc_len(v: &jv_value) -> &jv_value {\n    let k = jv_kind(v);\n    if k == jv_kind_string {\n        return jv_f64(utf8_codepoint_length(jv_require_string(v)) as f64_s);\n    }\n    if k == jv_kind_vector {\n        return jv_f64(jv_vector_count(jv_require_vector(v)) as f64_s);\n    }\n    if k == jv_kind_ordered_map {\n        return jv_f64(jv_ordered_map_count(jv_require_ordered_map(v)) as f64_s);\n    }\n    jv_f64(0.0)\n}\n\n// `has` — a key in a map, or a value in a list. Both, because the interpreter\n// does both, and the map case keys on the DISPLAY string, which is the same\n// key the generated `hasIn<X>` mutator uses.\nfn tc_has(hay: &jv_value, needle: &jv_value) -> &jv_value {\n    let k = jv_kind(hay);\n    if k == jv_kind_ordered_map {\n        return jv_bool(jv_ordered_map_contains(jv_require_ordered_map(hay), tc_display(needle)));\n    }\n    if k == jv_kind_vector {\n        let items = jv_require_vector(hay);\n        let n = jv_vector_count(items);\n        let i: i32 = 0;\n        while i <s n {\n            if tc_eq(jv_vector_at(items, i), needle) == 1 { return jv_bool(1); }\n            i += 1;\n        }\n        return jv_bool(0);\n    }\n    jv_bool(0)\n}\n\n// `contains` — substring, and text only, which is what `interp/eval.mbt` says.\nfn tc_contains(hay: &jv_value, needle: &jv_value) -> &jv_value {\n    if tc_is_text(hay) == 0 { return jv_bool(0); }\n    if tc_is_text(needle) == 0 { return jv_bool(0); }\n    let h = jv_require_string(hay);\n    let n = jv_require_string(needle);\n    let hl = utf8_byte_length(h);\n    let nl = utf8_byte_length(n);\n    if nl == 0 { return jv_bool(1); }\n    if nl >s hl { return jv_bool(0); }\n    let at: i32 = 0;\n    while at <=s hl - nl {\n        let j: i32 = 0;\n        'mismatch: do {\n            while j <s nl {\n                if utf8_at_byte(h, at + j) != utf8_at_byte(n, j) { br 'mismatch; }\n                j += 1;\n            }\n            return jv_bool(1);\n        }\n        at += 1;\n    }\n    jv_bool(0)\n}\n\n// ASCII case, byte for byte. A multi-byte codepoint's bytes are all >= 0x80 and\n// so are left alone, which is exactly what the interpreter's char loop does.\nfn tc_case(v: &jv_value, down: i32) -> &jv_value {\n    if tc_is_text(v) == 0 { return v; }\n    let s = jv_require_string(v);\n    let l = utf8_byte_length(s);\n    let out = [wax_hash_bytes| 0; l];\n    let i: i32 = 0;\n    while i <s l {\n        let b = utf8_at_byte(s, i);\n        if down == 1 {\n            if b >=u 65 { if b <=u 90 { b += 32; } }\n        } else {\n            if b >=u 97 { if b <=u 122 { b -= 32; } }\n        }\n        out[i] = b;\n        i += 1;\n    }\n    jv_string(utf8_from_bytes(out))\n}\n\nfn tc_lower_case(v: &jv_value) -> &jv_value { tc_case(v, 1) }\n\nfn tc_upper_case(v: &jv_value) -> &jv_value { tc_case(v, 0) }\n\nfn tc_space(b: i32) -> i32 {\n    if b == 32 { return 1; }\n    if b == 9 { return 1; }\n    if b == 10 { return 1; }\n    if b == 13 { return 1; }\n    0\n}\n\n// `trim` — exactly \" \\t\\n\\r\", which is the `chars=` the interpreter passes.\n// All four are single-byte, so trimming bytes cannot land mid-codepoint.\nfn tc_trim(v: &jv_value) -> &jv_value {\n    if tc_is_text(v) == 0 { return v; }\n    let s = jv_require_string(v);\n    let l = utf8_byte_length(s);\n    let start: i32 = 0;\n    'lead: do {\n        while start <s l {\n            if tc_space(utf8_at_byte(s, start)) == 0 { br 'lead; }\n            start += 1;\n        }\n    }\n    if start == l { return jv_string(tc_s_empty!); }\n    let stop = l;\n    'trail: do {\n        while stop >s start {\n            if tc_space(utf8_at_byte(s, stop - 1)) == 0 { br 'trail; }\n            stop -= 1;\n        }\n    }\n    jv_string(utf8_slice_bytes(s, start, stop - start))\n}\n\nfn tc_min(a: &jv_value, b: &jv_value) -> &jv_value {\n    if tc_cmp(a, b) <=s 0 { a } else { b }\n}\n\nfn tc_max(a: &jv_value, b: &jv_value) -> &jv_value {\n    if tc_cmp(a, b) >=s 0 { a } else { b }\n}\n\n// `clamp lo hi` answers `lo` when `hi <s lo`, which is `interp/eval.mbt`'s\n// choice: a range with no answer that is not a guess picks the low end.\nfn tc_clamp(v: &jv_value, lo: &jv_value, hi: &jv_value) -> &jv_value {\n    if tc_cmp(v, lo) <s 0 { return lo; }\n    if tc_cmp(v, hi) >s 0 { return hi; }\n    v\n}\n\n// ---------------------------------------------------------------------------\n// `new`'s target\n//\n// `new Label` builds the zero of a declared type and binds it to `@cur`, the\n// one binding a compiled handler owns. Reading `@cur` before a `new` has made\n// one is a FAILURE and not a null — `read_place` says so, and the reason is\n// that the target comes from a `new` in this very body, so its absence is a\n// mistake where a missing ordinary binding is a normal answer.\n//\n// The local is `&?jv_value`, so \"not made yet\" is the null it starts at and\n// there is no second flag to keep in step.\nfn tc_target(v: &?jv_value) -> &jv_value {\n    match v {\n        made: &jv_value => { return made; }\n        _ => {\n            tc_fail = 1;\n            return jv_null();\n        }\n    }\n    unreachable;\n}\n\n// ---------------------------------------------------------------------------\n// mutating a collection\n//\n// `interp/run.mbt`'s `collection_op`, method for method. It answers `None` for\n// a pair it does not implement — `.items.push` on a number, and the four names\n// `collection_method` parses but the interpreter never handled (`clear`,\n// `delete`, `set`, `removeAt`) — and the transition then does not happen.\n// Here the same cases answer the value UNCHANGED, which the dispatch layer\n// reports as `unchanged` for the same reason: a transition that does not hold\n// is a transition that does not happen.\n//\n// A set is a Map keyed by the member's DISPLAY string, holding `true`. That is\n// tutuca's representation, not a choice made here, and it is why `add`,\n// `remove` and `toggle` are map operations.\n\nconst tc_m_push: i32 = 1;\nconst tc_m_insert_at: i32 = 2;\nconst tc_m_set_at: i32 = 3;\nconst tc_m_delete_at: i32 = 4;\nconst tc_m_add: i32 = 5;\nconst tc_m_remove: i32 = 6;\nconst tc_m_toggle: i32 = 7;\n\n// An integral index, or -1. `Value::as_key`'s numeric arm: a non-integral\n// number is not a key at all.\nfn tc_index_of(v: &jv_value) -> i32 {\n    if jv_kind(v) != jv_kind_f64 { return -1; }\n    let x = jv_require_f64(v);\n    let i = x as i32_s;\n    if (i as f64_s) != x { return -1; }\n    i\n}\n\n// Rebuild a vector with one item inserted before `at`. Past the end appends,\n// which is the bounds rule `insertInXAt` follows.\nfn tc_vec_insert(items: &jv_vector_value, at: i32, v: &jv_value) -> &jv_value {\n    let n = jv_vector_count(items);\n    let k = if at <s 0 { n } else { if at >s n { n } else { at } };\n    let out = jv_vector_empty();\n    let i: i32 = 0;\n    while i <s k {\n        out = jv_vector_push(out, jv_vector_at(items, i));\n        i += 1;\n    }\n    out = jv_vector_push(out, v);\n    while i <s n {\n        out = jv_vector_push(out, jv_vector_at(items, i));\n        i += 1;\n    }\n    out\n}\n\nfn tc_vec_delete(items: &jv_vector_value, at: i32) -> &jv_value {\n    let n = jv_vector_count(items);\n    if at <s 0 { return items; }\n    if at >=s n { return items; }\n    let out = jv_vector_empty();\n    let i: i32 = 0;\n    while i <s n {\n        if i != at { out = jv_vector_push(out, jv_vector_at(items, i)); }\n        i += 1;\n    }\n    out\n}\n\nfn tc_method(old: &jv_value, which: i32, a: &jv_value, b: &jv_value) -> &jv_value {\n    let k = jv_kind(old);\n    if k == jv_kind_vector {\n        let items = jv_require_vector(old);\n        if which == tc_m_push { return jv_vector_push(items, a); }\n        if which == tc_m_insert_at {\n            return tc_vec_insert(items, tc_index_of(a), b);\n        }\n        if which == tc_m_set_at {\n            let at = tc_index_of(a);\n            if at <s 0 { return old; }\n            if at >s jv_vector_count(items) { return old; }\n            return jv_vector_assoc(items, at, b);\n        }\n        if which == tc_m_delete_at {\n            return tc_vec_delete(items, tc_index_of(a));\n        }\n        return old;\n    }\n    if k == jv_kind_ordered_map {\n        let entries = jv_require_ordered_map(old);\n        if which == tc_m_set_at {\n            return jv_ordered_map_assoc(entries, tc_display(a), b);\n        }\n        if which == tc_m_delete_at {\n            let key = tc_display(a);\n            if jv_ordered_map_contains(entries, key) == 0 { return old; }\n            return jv_ordered_map_dissoc(entries, key);\n        }\n        if which == tc_m_add {\n            return jv_ordered_map_assoc(entries, tc_display(a), jv_bool(1));\n        }\n        if which == tc_m_remove {\n            return jv_ordered_map_dissoc(entries, tc_display(a));\n        }\n        if which == tc_m_toggle {\n            let key = tc_display(a);\n            if jv_ordered_map_contains(entries, key) == 1 {\n                return jv_ordered_map_dissoc(entries, key);\n            }\n            return jv_ordered_map_assoc(entries, key, jv_bool(1));\n        }\n        return old;\n    }\n    old\n}\n\n// ---------------------------------------------------------------------------\n// paths\n//\n// `.a[k].b` — one step down, and one level of the spine rebuilt on the way\n// back up. `core/path_step.mbt`'s `step_get` and `step_put`, less the frame-only\n// steps a compiled handler never sees.\n\n// A `.field` step. A field the value does not carry reads NULL — the checker\n// names an undeclared one, and a schema-less card may grow a field the map has\n// not seen yet.\nfn tc_step_field(v: &jv_value, name: &utf8_string) -> &jv_value {\n    let k = jv_kind(v);\n    if k == jv_kind_ordered_map {\n        let (found, out) = jv_ordered_map_get(jv_require_ordered_map(v), name);\n        if found == 0 { return jv_null(); }\n        return out!;\n    }\n    if k == jv_kind_record { return tc_get(jv_require_record(v), name); }\n    jv_null()\n}\n\n// A `[key]` step. A key that is not there is a FAILURE, not a null: reading\n// past the end of a list is the case \"failure is no change\" exists for, and a\n// handler that quietly worked on null would write it back.\n//\n// So would a key that is not a key at all — `Value::as_key` answers None for a\n// non-integral number and for anything that is neither text nor number.\nfn tc_step_index(v: &jv_value, key: &jv_value) -> &jv_value {\n    let k = jv_kind(v);\n    if k == jv_kind_vector {\n        let at = tc_index_of(key);\n        if at <s 0 {\n            tc_fail = 1;\n            return jv_null();\n        }\n        let (found, out) = jv_vector_get(jv_require_vector(v), at);\n        if found == 0 {\n            tc_fail = 1;\n            return jv_null();\n        }\n        return out!;\n    }\n    if jv_kind(key) != jv_kind_string {\n        if jv_kind(key) != jv_kind_f64 {\n            tc_fail = 1;\n            return jv_null();\n        }\n        if tc_index_of(key) <s 0 {\n            tc_fail = 1;\n            return jv_null();\n        }\n    }\n    if k == jv_kind_ordered_map {\n        let (found, out) = jv_ordered_map_get(jv_require_ordered_map(v), tc_display(key));\n        if found == 0 {\n            tc_fail = 1;\n            return jv_null();\n        }\n        return out!;\n    }\n    if k == jv_kind_record {\n        let target = jv_require_record(v);\n        let name = tc_display(key);\n        if jv_record_has_field(target, name) == 0 {\n            tc_fail = 1;\n            return jv_null();\n        }\n        return tc_get(target, name);\n    }\n    tc_fail = 1;\n    jv_null()\n}\n\n// `v` with the slot at a `.field` replaced — `Value::with_field_opt`.\n//\n// A map and a record take one. Anything else does not, and answering the value\n// unchanged would make `.name.x = 1` on a string look like it worked, so it\n// fails the write the way the interpreter's `None` does.\nfn tc_step_put_field(\n    v: &jv_value,\n    name: &utf8_string,\n    child: &jv_value,\n) -> &jv_value {\n    let k = jv_kind(v);\n    if k == jv_kind_ordered_map { return jv_ordered_map_assoc(jv_require_ordered_map(v), name, child); }\n    if k == jv_kind_record {\n        return tc_set(jv_require_record(v), name, child);\n    }\n    tc_fail = 1;\n    v\n}\n\n// `v` with the slot at a `[key]` replaced.\n//\n// A key that is not there REFUSES THE WHOLE WRITE. Growing a collection by\n// assigning past its end is what `push` and `insertAt` are for, and a write\n// that silently created a slot would make a typo into data.\nfn tc_step_put_index(\n    v: &jv_value,\n    key: &jv_value,\n    child: &jv_value,\n) -> &jv_value {\n    let k = jv_kind(v);\n    if k == jv_kind_vector {\n        let at = tc_index_of(key);\n        let items = jv_require_vector(v);\n        if at <s 0 {\n            tc_fail = 1;\n            return v;\n        }\n        if at >=s jv_vector_count(items) {\n            tc_fail = 1;\n            return v;\n        }\n        return jv_vector_assoc(items, at, child);\n    }\n    if k == jv_kind_ordered_map {\n        let entries = jv_require_ordered_map(v);\n        let name = tc_display(key);\n        if jv_ordered_map_contains(entries, name) == 0 {\n            tc_fail = 1;\n            return v;\n        }\n        return jv_ordered_map_assoc(entries, name, child);\n    }\n    if k == jv_kind_record {\n        let target = jv_require_record(v);\n        let name = tc_display(key);\n        if jv_record_has_field(target, name) == 0 {\n            tc_fail = 1;\n            return v;\n        }\n        return tc_set(target, name, child);\n    }\n    tc_fail = 1;\n    v\n}\n\n// ---------------------------------------------------------------------------\n// the state record\n\nfn tc_get(s: &jv_record_value, name: &utf8_string) -> &jv_value {\n    let (found, v) = jv_record_get(s, name);\n    if found == 0 { return jv_null(); }\n    v!\n}\n\n// A successor. `jv_record_try_set` validates against the schema and answers a\n// status; a rejected write leaves the record alone, which is the same thing the\n// old runtime did when `field_index` missed.\n//\n// Identity is preserved when the value is equal (`record.wax`), and that is\n// what `handle-event` reads to tell `changed` from `unchanged` — a reference\n// comparison where the cell runtime compared every byte of the instance.\nfn tc_set(\n    s: &jv_record_value,\n    name: &utf8_string,\n    v: &jv_value,\n) -> &jv_record_value {\n    let (status, out) = jv_record_try_set(s, name, v);\n    if status != jv_record_ok { return s; }\n    out!\n}\n\n// An Int field truncates on the way in — `coerce_root`, `interp/run.mbt`. The\n// schema cannot do this: tutuca's Int and Double are one jv kind, so the\n// generator emits this call at the assignment sites of the fields it declared\n// as integers, and nowhere else.\nfn tc_trunc(v: &jv_value) -> &jv_value {\n    if jv_kind(v) != jv_kind_f64 { return v; }\n    jv_f64(jv_require_f64(v).trunc())\n}\n\n// ---------------------------------------------------------------------------\n// instances\n\nfn tc_intern(s: &jv_record_value) -> i32 {\n    let h = pv_count(tc_insts!);\n    tc_insts = pv_push(tc_insts!, s);\n    h\n}\n\nfn tc_deref(h: i32) -> &jv_record_value {\n    let (found, v) = pv_get(tc_insts!, h);\n    if found == 0 { unreachable; }\n    v! as &jv_record_value\n}\n\n// ---------------------------------------------------------------------------\n// buffered effects\n//\n// Kinds, which the generated flush switches on. Only the flush knows how to\n// reach the host: `control` is imported conditionally, so a card that performs\n// no effect has no import to call and nothing here mentions one.\n\nconst tc_e_send: i32 = 1;\nconst tc_e_bubble: i32 = 2;\nconst tc_e_stop: i32 = 3;\n\ntype tc_effect = { kind: i32, name: &utf8_string, args: &?pv_vector };\n\nfn tc_effect_new(\n    kind: i32,\n    name: &utf8_string,\n    args: &?pv_vector,\n) -> &tc_effect {\n    { kind, name, args }\n}\n\nfn tc_effect_reset() { tc_effects = pv_empty(); }\n\n// The empty string, for a `stop` — which carries no name and no arguments but\n// still takes a slot in the buffer so that the ORDER of the effects survives.\nfn tc_empty_str() -> &utf8_string { tc_s_empty! }\n\nfn tc_effect_push(kind: i32, name: &utf8_string, args: &?pv_vector) {\n    tc_effects = pv_push(tc_effects!, tc_effect_new(kind, name, args));\n}\n\nfn tc_effect_count() -> i32 { pv_count(tc_effects!) }\n\nfn tc_effect_at(i: i32) -> &tc_effect {\n    pv_at(tc_effects!, i)! as &tc_effect\n}\n\nfn tc_effect_kind(i: i32) -> i32 { tc_effect_at(i).kind }\n\n// The name and the arguments in the shape `control` takes them: a (pointer,\n// length) pair into linear memory, and a `list<value>`.\nfn tc_effect_name_ptr(i: i32) -> i32 { tc_str_out(tc_effect_at(i).name) }\n\nfn tc_effect_name_len(i: i32) -> i32 {\n    utf8_byte_length(tc_effect_at(i).name)\n}\n\nfn tc_effect_args_ptr(i: i32) -> i32 { tc_args_out(tc_effect_at(i).args) }\n\nfn tc_effect_args_len(i: i32) -> i32 { tc_args_len(tc_effect_at(i).args) }\n\n// ---------------------------------------------------------------------------\n// argument lists\n//\n// One shape for both sources: the list the ABI handed in, and the list an\n// expression built to call a `compute` with. `&?pv_vector` rather than\n// `&pv_vector` so \"no arguments\" needs no allocation.\n\nfn tc_arg_at(args: &?pv_vector, i: i32) -> &jv_value {\n    match args {\n        v: &pv_vector => {\n            let (found, out) = pv_get(v, i);\n            if found == 0 { return jv_null(); }\n            return out! as &jv_value;\n        }\n        _ => { return jv_null(); }\n    }\n    unreachable;\n}\n\nfn tc_args_len(args: &?pv_vector) -> i32 {\n    match args {\n        v: &pv_vector => { return pv_count(v); }\n        _ => { return 0; }\n    }\n    unreachable;\n}\n\n// The same list, lowered into linear memory as `list<value>` — cells end to\n// end, which is what `control.send` and `control.emit` take.\nfn tc_args_out(args: &?pv_vector) -> i32 {\n    let n = tc_args_len(args);\n    if n == 0 { return 0; }\n    let p = alloc(n * 16, 8);\n    let i: i32 = 0;\n    while i <s n {\n        tc_lower(tc_arg_at(args, i), p + i * 16);\n        i += 1;\n    }\n    p\n}\n\nfn tc_args1(a: &jv_value) -> &?pv_vector { pv_push(pv_empty(), a) }\n\nfn tc_args2(a: &jv_value, b: &jv_value) -> &?pv_vector {\n    pv_push(pv_push(pv_empty(), a), b)\n}\n\nfn tc_args3(a: &jv_value, b: &jv_value, c: &jv_value) -> &?pv_vector {\n    pv_push(pv_push(pv_push(pv_empty(), a), b), c)\n}\n\nfn tc_args4(\n    a: &jv_value,\n    b: &jv_value,\n    c: &jv_value,\n    d: &jv_value,\n) -> &?pv_vector {\n    pv_push(pv_push(pv_push(pv_push(pv_empty(), a), b), c), d)\n}\n\n// ---------------------------------------------------------------------------\n// lifting and lowering `values.value`\n//\n// The wire shape is fixed by `dyncomp/host/wasm/abi.mjs`: 16 bytes, a\n// discriminant at +0 and an 8-byte payload at +8, a `text` payload being a\n// (pointer, length) pair inside those 8.\n//\n// The four scalar tags are here. `%list`, `%map` and `%instance` are u64\n// handles into a host-side arena, which needs the `values` import — see\n// `runtime/values.wax`, concatenated only for a card that can produce one.\n\nconst tc_tag_nil: i32 = 0;\nconst tc_tag_bool: i32 = 1;\nconst tc_tag_num: i32 = 2;\nconst tc_tag_text: i32 = 3;\n\nfn tc_lift_flat(kind: i32, p64: i64, p32: i32) -> &jv_value {\n    if kind == tc_tag_bool {\n        if (p64 & 0xff) as i32 != 0 { return jv_bool(1); }\n        return jv_bool(0);\n    }\n    if kind == tc_tag_num {\n        return jv_f64(p64.from_bits());\n    }\n    if kind == tc_tag_text {\n        return jv_string(tc_str_in((p64 & 0xffffffff) as i32, p32));\n    }\n    jv_null()\n}\n\n// The four scalar tags of a wire cell. `tc_lift_cell`, which also knows the\n// compound ones, is defined by whichever lowering half this build got — so a\n// scalar-only card carries no code that mentions an arena it cannot reach.\nfn tc_lift_scalar_cell(p: i32) -> &jv_value {\n    let kind = mem.load8(p) as i32_u;\n    if kind == tc_tag_bool {\n        if mem.load8(p + 8) as i32_u != 0 { return jv_bool(1); }\n        return jv_bool(0);\n    }\n    if kind == tc_tag_num {\n        return jv_f64(mem.loadf64(p + 8));\n    }\n    if kind == tc_tag_text {\n        return jv_string(tc_str_in(mem.load32(p + 8), mem.load32(p + 12)));\n    }\n    jv_null()\n}\n\nfn tc_args_lift(ap: i32, al: i32) -> &?pv_vector {\n    if al <=s 0 { return null; }\n    let out = pv_empty();\n    let i: i32 = 0;\n    while i <s al {\n        out = pv_push(out, tc_lift_cell(ap + i * 16));\n        i += 1;\n    }\n    out\n}\n\n// ---------------------------------------------------------------------------\n// the exports, less their names\n//\n// Everything below is the body of a `tutuca:component` export with the\n// card-specific part taken out. The generated module still declares and exports\n// the functions — the names carry an interface version and a resource method,\n// and those are the generator's to spell — but the work is here, once, where it\n// can be read.\n\n// The zero instance. Every field at the default its declared type gives it,\n// which is `jv_record_default` reading the schema the generated `#[start]`\n// built.\nfn tc_zero() -> &jv_record_value { jv_record_default(tc_state_type!) }\n\n// The constructor's `args`: a `list<tuple<string, value>>`, stride 24, the name\n// at +0 as (pointer, length) and the value cell at +8.\n//\n// A name the schema does not carry is IGNORED, which is what the cell runtime\n// did when `field_index` missed. `tc_set` is the one that decides, and it\n// declines a value of the wrong type as well as a name that does not exist.\nfn tc_apply_args(s: &jv_record_value, ap: i32, al: i32) -> &jv_record_value {\n    let out = s;\n    let i: i32 = 0;\n    while i <s al {\n        let base = ap + i * 24;\n        let name = tc_str_in(mem.load32(base), mem.load32(base + 4));\n        out = tc_set(out, name, tc_lift_cell(base + 8));\n        i += 1;\n    }\n    out\n}\n\n// `get-field` — writes the whole `option<value>`: a discriminant at +0 and the\n// value at +8.\n//\n// A field the schema does not carry answers `none`, where the cell runtime\n// answered `some(nil)` for a field it had refused but still allocated a cell\n// for. A refused field is now simply absent, and `none` is the truthful answer.\nfn tc_get_field(s: &jv_record_value, np: i32, nl: i32, area: i32) {\n    let (found, v) = jv_record_get(s, tc_str_in(np, nl));\n    if found == 0 {\n        mem.store32(area, 0);\n        return;\n    }\n    mem.store32(area, 1);\n    tc_lower(v!, area + 8);\n}\n\n// `with-field` — the successor's handle, or -1 for `none`.\n//\n// The schema validates: an unknown name and a value of the wrong type both\n// answer -1, where the cell runtime checked only the name and then wrote\n// whatever joined payload it was handed into the cell. That is a real\n// tightening, and it is free — `jv_record_try_set` was always going to run.\nfn tc_with_field(\n    s: &jv_record_value,\n    np: i32,\n    nl: i32,\n    kind: i32,\n    p64: i64,\n    p32: i32,\n) -> i32 {\n    let name = tc_str_in(np, nl);\n    let (status, out) = jv_record_try_set(s, name, tc_lift_flat(kind, p64, p32));\n    if status != jv_record_ok { return -1; }\n    tc_intern(out!)\n}\n\n// Did the handler change anything?\n//\n// Reference equality, because `jv_record_try_set` answers the SAME record when\n// the value it was given is equal to the one already there. The cell runtime\n// compared every byte of the instance to learn this; a successor that shares\n// structure with its predecessor knows it already.\nfn tc_same(a: &jv_record_value, b: &jv_record_value) -> i32 {\n    if a == b { 1 } else { 0 }\n}\n\n// One arm of a dispatch chain: is the name this call arrived with the constant\n// at `idx`? The name is lifted ONCE by the caller, so a card with twelve\n// handlers does not build twelve copies of it.\nfn tc_is(name: &utf8_string, idx: i32) -> i32 {\n    utf8_equal(name, tc_const_str(idx))\n}\n\n// Writes the 16-byte cell. Answers 1 when it wrote one, 0 when the value is\n// compound and this build has no arena to put it in.\nfn tc_lower_scalar(v: &jv_value, dest: i32) -> i32 {\n    let k = jv_kind(v);\n    if k == jv_kind_null {\n        mem.store32(dest, tc_tag_nil);\n        mem.store64(dest + 8, 0);\n        return 1;\n    }\n    if k == jv_kind_bool {\n        mem.store32(dest, tc_tag_bool);\n        mem.store64(dest + 8, 0);\n        mem.store32(dest + 8, jv_require_bool(v));\n        return 1;\n    }\n    if k == jv_kind_f64 {\n        mem.store32(dest, tc_tag_num);\n        mem.storef64(dest + 8, jv_require_f64(v));\n        return 1;\n    }\n    if k == jv_kind_string {\n        let s = jv_require_string(v);\n        mem.store32(dest, tc_tag_text);\n        mem.store32(dest + 8, tc_str_out(s));\n        mem.store32(dest + 12, utf8_byte_length(s));\n        return 1;\n    }\n    0\n}\n"),
]

///|
pub let runtime_src : String = {
  let sb = StringBuilder::new()
  for f in runtime_files {
    sb.write_string(f.1)
    sb.write_string("\n")
  }
  sb.to_string()
}

///|
/// The two lowering halves, by name. Exactly ONE is ever concatenated: which
/// decides whether the module imports the `values` arena, and a host reads the
/// import section to know what a guest can do.
pub let lower_files : Array[(String, String)] = [
  ("lower_scalar.wax", "// Lowering a value to the wire, for a card that cannot produce a compound one.\n//\n// Exactly one of `lower_scalar.wax` and `lower_values.wax` is concatenated, and\n// which one decides what the module's IMPORT SECTION says. That is the point of\n// the split: a host inspects imports to know what a guest can do, so a card\n// with four scalar fields must not import the value arena merely because the\n// generator can emit code that would use it. A capability not imported cannot\n// be used, and asking for one is a promise rather than a grant.\n//\n// See `lower_values.wax` for the other half.\n\nfn tc_lower(v: &jv_value, dest: i32) {\n    if tc_lower_scalar(v, dest) == 1 { return; }\n    // Unreachable in this build: a card that can hold a list is compiled with\n    // `lower_values.wax` instead. Nil rather than a trap, because a wrong\n    // answer the host can render beats taking the instance down.\n    mem.store32(dest, tc_tag_nil);\n    mem.store64(dest + 8, 0);\n}\n\n// A host may still hand IN a `%list` or a `%map` — as an event argument, say,\n// from a view this card does not control. There is no arena import here to\n// read it through, so it arrives as null. That is the same answer this card\n// would give for any value it has no field to hold.\nfn tc_lift_cell(p: i32) -> &jv_value {\n    tc_lift_scalar_cell(p)\n}\n"),
  ("lower_values.wax", "// Lowering a value to the wire, for a card that CAN produce a compound one.\n//\n// WIT has no recursive types, so `values.value` carries `%list` and `%map` as\n// u64 handles into a host-side arena and this interface is how a guest reads\n// and builds one. Handles live for the duration of the current host->guest\n// call, which is exactly the lifetime a lowered return value needs.\n//\n// Concatenated INSTEAD of `lower_scalar.wax`, and only for a card whose state\n// declares a collection or whose script builds one. That conditionality is the\n// whole reason the two are separate files: the import section is what a host\n// inspects to know what a guest can do, and a four-scalar card that imported\n// the arena would be claiming a reach it does not have.\n//\n// `to-json` / `from-json` are on the interface too and would collapse this to\n// one call each way, but they need a JSON writer and reader inside the guest\n// and the stdlib has neither. Walking the arena needs no serializer at all.\n\nimport \"tutuca:component/values@0.7.0\" {\n    #[import = \"list-new\"]\n    fn tc_list_new() -> i64;\n    #[import = \"list-push\"]\n    fn tc_list_push(h: i64, kind: i32, p64: i64, p32: i32);\n    #[import = \"map-new\"]\n    fn tc_map_new() -> i64;\n    #[import = \"map-set\"]\n    fn tc_map_set(h: i64, kp: i32, kl: i32, kind: i32, p64: i64, p32: i32);\n    #[import = \"list-len\"]\n    fn tc_list_len(h: i64) -> i32;\n    #[import = \"list-get\"]\n    fn tc_list_get(h: i64, index: i32, dest: i32);\n    #[import = \"map-len\"]\n    fn tc_map_len(h: i64) -> i32;\n    #[import = \"map-keys\"]\n    fn tc_map_keys(h: i64, dest: i32);\n    #[import = \"map-get\"]\n    fn tc_map_get(h: i64, kp: i32, kl: i32, dest: i32);\n}\n\n// A scratch cell for flattening a value into the (kind, p64, p32) triple the\n// imports take. Above the static return areas, which end at 168.\nconst tc_flat: i32 = 192;\n\nfn tc_flatten(v: &jv_value) {\n    tc_lower(v, tc_flat);\n}\n\n// The three flat components of the value now at `tc_flat`.\nfn tc_flat_tag() -> i32 { mem.load8(tc_flat) as i32_u }\n\nfn tc_flat_p64() -> i64 { mem.load64(tc_flat + 8) }\n\nfn tc_flat_p32() -> i32 { mem.load32(tc_flat + 12) }\n\n// A vector as an arena list. Recursive through `tc_lower`, so a list of lists\n// builds bottom up and each inner handle is pushed as its parent's element.\nfn tc_lower_vector(items: &jv_vector_value) -> i64 {\n    let h = tc_list_new();\n    let n = jv_vector_count(items);\n    let i: i32 = 0;\n    while i <s n {\n        tc_flatten(jv_vector_at(items, i));\n        tc_list_push(h, tc_flat_tag(), tc_flat_p64(), tc_flat_p32());\n        i += 1;\n    }\n    h\n}\n\ntype tc_map_ctx = { handle: i64 };\n\nfn tc_lower_map_entry(context: &?eq, key: &utf8_string, value: &jv_value) {\n    let ctx = context! as &tc_map_ctx;\n    let kp = tc_str_out(key);\n    let kl = utf8_byte_length(key);\n    tc_flatten(value);\n    tc_map_set(ctx.handle, kp, kl, tc_flat_tag(), tc_flat_p64(), tc_flat_p32());\n}\n\nfn tc_lower_map(entries: &jv_ordered_map_value) -> i64 {\n    let h = tc_map_new();\n    let ctx: &tc_map_ctx = { handle: h };\n    jv_ordered_map_each(entries, ctx, tc_lower_map_entry);\n    h\n}\n\nconst tc_tag_list: i32 = 4;\nconst tc_tag_map: i32 = 5;\n\nfn tc_lower(v: &jv_value, dest: i32) {\n    if tc_lower_scalar(v, dest) == 1 { return; }\n    let k = jv_kind(v);\n    if k == jv_kind_vector {\n        let h = tc_lower_vector(jv_require_vector(v));\n        mem.store32(dest, tc_tag_list);\n        mem.store64(dest + 8, h);\n        return;\n    }\n    if k == jv_kind_ordered_map {\n        let h = tc_lower_map(jv_require_ordered_map(v));\n        mem.store32(dest, tc_tag_map);\n        mem.store64(dest + 8, h);\n        return;\n    }\n    mem.store32(dest, tc_tag_nil);\n    mem.store64(dest + 8, 0);\n}\n\n// The other direction: an arena handle back into a jv value. `list-get` and\n// `map-get` return a `value`, which the canonical ABI returns by writing into\n// an area the CALLER owns — `tc_in` here, distinct from `tc_flat` so a lift\n// nested inside a lower cannot tread on it.\nconst tc_in: i32 = 256;\n\nfn tc_lift_list(h: i64) -> &jv_value {\n    let out = jv_vector_empty();\n    let n = tc_list_len(h);\n    let i: i32 = 0;\n    while i <s n {\n        tc_list_get(h, i, tc_in);\n        out = jv_vector_push(out, tc_lift_cell(tc_in));\n        i += 1;\n    }\n    out\n}\n\nfn tc_lift_cell(p: i32) -> &jv_value {\n    let kind = mem.load8(p) as i32_u;\n    if kind == tc_tag_list { return tc_lift_list(mem.load64(p + 8)); }\n    if kind == tc_tag_map { return tc_lift_map(mem.load64(p + 8)); }\n    tc_lift_scalar_cell(p)\n}\n\nfn tc_lift_map(h: i64) -> &jv_value {\n    let out = jv_ordered_map_empty();\n    // `map-keys` answers a `list<string>`: a (pointer, length) pair, the\n    // pointer at the area and each element an 8-byte (pointer, length) pair.\n    tc_map_keys(h, tc_in);\n    let kp = mem.load32(tc_in);\n    let kn = mem.load32(tc_in + 4);\n    let i: i32 = 0;\n    while i <s kn {\n        let sp = mem.load32(kp + i * 8);\n        let sl = mem.load32(kp + i * 8 + 4);\n        let key = tc_str_in(sp, sl);\n        tc_map_get(h, sp, sl, tc_in + 32);\n        // `option<value>`: a discriminant, then the value at +8.\n        if mem.load8(tc_in + 32) as i32_u != 0 {\n            out = jv_ordered_map_assoc(out, key, tc_lift_cell(tc_in + 40));\n        }\n        i += 1;\n    }\n    out\n}\n"),
]

///|
/// The lowering half named, or the empty string if there is no such half.
pub fn lower_src(name : String) -> String {
  for f in lower_files {
    if f.0 == name {
      return f.1
    }
  }
  ""
}
