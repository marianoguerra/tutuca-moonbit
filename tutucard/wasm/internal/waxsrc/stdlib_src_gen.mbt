.slots[at + 1],\n                hash,\n                key,\n                value,\n            );\n            let slots = phm_copy_slots(b.slots, b.slots.length());\n            slots[at] = null;\n            slots[at + 1] = child;\n            return (phm_bitmap(null, b.bitmap, slots), 1);\n        }\n        a: &phm_array_node => {\n            let index = (hash >>u shift) & 31;\n            let old = a.children[index];\n            let (child, added) = phm_node_assoc(old, shift + 5, hash, key, value, hash_fn, equal);\n            if old == child { return (a, added); }\n            let children = [phm_node_slots| null; 32];\n            children.copy(0, a.children, 0, 32);\n            children[index] = child;\n            let child_delta = if old == null { 1 } else { 0 };\n            return (phm_array(null, a.count + child_delta, children), added);\n        }\n        c: &phm_collision_node => {\n            if c.hash != hash {\n                let bit1 = phm_bitpos(c.hash, shift);\n                let bit2 = phm_bitpos(hash, shift);\n                if bit1 == bit2 {\n                    let (child, _) = phm_node_assoc(c, shift + 5, hash, key, value, hash_fn, equal);\n                    return (phm_bitmap(null, bit1, [phm_slots| null, child]), 1);\n                }\n                if bit1 <u bit2 {\n                    return (phm_bitmap(null, bit1 | bit2, [phm_slots| null, c, key, value]), 1);\n                }\n                return (phm_bitmap(null, bit1 | bit2, [phm_slots| key, value, null, c]), 1);\n            }\n            let i: i32 = 0;\n            let count: i32 = c.count;\n            while i <s count {\n                let at = i * 2;\n                if equal(c.slots[at]!, key) != 0 {\n                    if c.slots[at + 1] == value { return (c, 0); }\n                    let slots = phm_copy_slots(c.slots, c.slots.length());\n                    slots[at + 1] = value;\n                    return (phm_collision(null, hash, c.count, slots