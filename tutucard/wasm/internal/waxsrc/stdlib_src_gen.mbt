  ("hashing.wax", "// Wax hashing utilities.\n//\n// This standalone source implements MurmurHash3 x86-32 for canonical Wax\n// byte arrays and i31 keys. It is non-cryptographic. Vendor it only when the\n// application wants these policies; PersistentHashMap accepts any compatible\n// hash/equality callbacks and does not depend on this file.\n\ntype wax_hash_bytes = [mut i8];\n\nfn wax_hash_mix_i32(value: i32) -> i32 {\n    let mixed = value * 0xcc9e2d51;\n    mixed = mixed.rotl(15);\n    mixed * 0x1b873593\n}\n\n// Add one 32-bit word to a MurmurHash3 x86-32 state. Composite-key hash\n// callbacks can begin with their seed, add each field, then finalize with the\n// total byte length.\nfn wax_hash_add_i32(state: i32, value: i32) -> i32 {\n    let out = state ^ wax_hash_mix_i32(value);\n    out.rotl(13) * 5 + 0xe6546b64\n}\n\nfn wax_hash_finalize(state: i32, byte_length: i32) -> i32 {\n    let out = state ^ byte_length;\n    out ^= out >>u 16;\n    out *= 0x85ebca6b;\n    out ^= out >>u 13;\n    out *= 0xc2b2ae35;\n    out ^ out >>u 16\n}\n\nfn wax_hash_i32_seeded(value: i32, seed: i32) -> i32 {\n    wax_hash_finalize(wax_hash_add_i32(seed, value), 4)\n}\n\nfn wax_hash_i32(value: i32) -> i32 { wax_hash_i32_seeded(value, 0) }\n\nfn wax_hash_bytes_seeded(bytes: &wax_hash_bytes, seed: i32) -> i32 {\n    let state = seed;\n    let length = bytes.length();\n    let offset: i32 = 0;\n    while offset + 4 <=s length {\n        let word =\n            bytes[offset] as i32_u\n            | bytes[offset + 1] as i32_u << 8\n            | bytes[offset + 2] as i32_u << 16\n            | bytes[offset + 3] as i32_u << 24;\n        state = wax_hash_add_i32(state, word);\n        offset += 4;\n    }\n    let remaining = length - offset;\n    if remaining != 0 {\n        let tail: i32 = bytes[offset] as i32_u;\n        if remaining >=s (2 as i32) { tail |= bytes[offset + 1] as i32_u << 8; }\n        if remaining == 3 { tail |= bytes[offset + 2] as i32_u << 16; }\n        state ^= wax_hash_mix_i32(tail);\n    }\n    wax_hash_finalize(state, length)\n}\n\nfn wax_hash_bytes_value(bytes: &wax_hash_bytes) -> i32 {\n    wax_hash_bytes_seeded(bytes, 0)\n}\n\nfn wax_hash_i31_key(key: &eq) -> i32 {\n    wax_hash_i32(key as i32_s)\n}\n\nfn wax_equal_i31_key(left: &eq, right: &eq) -> i32 {\n    if (left as i32_s) == (right as i32_s) { 1 } else { 0 }\n}\n\nfn wax_hash_bytes_key(key: &eq) -> i32 {\n    wax_hash_bytes_value(key as &wax_hash_bytes)\n}\n\nfn wax_equal_bytes_key(left: &eq, right: &eq) -> i32 {\n    if left == right { return 1; }\n    let a = left as &wax_hash_bytes;\n    let b = right as &wax_hash_bytes;\n    if a.length() != b.length() { return 0; }\n    let i: i32 = 0;\n    while i <s a.length() {\n        if a[i] as i32_u != b[i] as i32_u { return 0; }\n        i += 1;\n    }\n    1\n}\n"),
  ("persistent_hash_map.wax", "// Wax persistent hash map.\n//\n// This file is deliberately standalone and uses a phm_/phmt_ prefix because\n// Wax modules do not have source namespaces.  Vendor this file into a project\n// and concatenate it before the application's Wax source.\n//\n// Values are nullable WebAssembly GC references.  Full-width numbers and\n// references outside the eq hierarchy must be boxed by the caller.\n\ntype phm_hash = fn(&eq) -> i32;\ntype phm_equal = fn(&eq, &eq) -> i32;\ntype phm_visit = fn(&?eq, &?eq, &?eq);\n\ntype phm_edit = { active: mut i32 };\ntype phm_slots = [mut &?eq];\n\nrec {\n    type phm_node = open { edit: mut &?phm_edit };\n    type phm_bitmap_node : phm_node = {\n        ..,\n        bitmap: mut i32,\n        slots: mut &phm_slots,\n    };\n    type phm_node_slots = [mut &?phm_node];\n    type phm_array_node : phm_node = {\n        ..,\n        count: mut i32,\n        children: mut &phm_node_slots,\n    };\n    type phm_collision_node : phm_node = {\n        ..,\n        hash: i32,\n        count: mut i32,\n        slots: mut &phm_slots,\n    };\n}\n\ntype phm_map = {\n    count: i32,\n    root: &?phm_node,\n    has_null: i32,\n    null_value: &?eq,\n    hash: &phm_hash,\n    equal: &phm_equal,\n};\n\ntype phmt_map = {\n    edit: &phm_edit,\n    count: mut i32,\n    root: mut &?phm_node,\n    has_null: mut i32,\n    null_value: mut &?eq,\n    hash: &phm_hash,\n    equal: &phm_equal,\n};\n\nfn phm_bitpos(hash: i32, shift: i32) -> i32 {\n    1 << ((hash >>u shift) & 31)\n}\n\nfn phm_bitmap_index(bitmap: i32, bit: i32) -> i32 {\n    (bitmap & (bit - 1)).popcnt()\n}\n\nfn phm_copy_slots(src: &phm_slots, length: i32) -> &phm_slots {\n    let dst = [phm_slots| null; length];\n    let n = if src.length() <u length { src.length() } else { length };\n    if n != 0 { dst.copy(0, src, 0, n); }\n    dst\n}\n\nfn phm_insert_pair(src: &phm_slots, at: i32, key: &?eq, value: &?eq) -> &phm_slots {\n    let n = src.length();\n    let dst =