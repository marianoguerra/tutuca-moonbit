&phm_bitmap_node => {\n            let bit = phm_bitpos(hash, shift);\n            if (b.bitmap & bit) == 0 { return (0, null); }\n            let at = phm_bitmap_index(b.bitmap, bit) * 2;\n            let found_key = b.slots[at];\n            if found_key == null {\n                return phm_node_get(b.slots[at + 1] as &phm_node, shift + 5, hash, key, equal);\n            }\n            if equal(found_key!, key) != 0 { return (1, b.slots[at + 1]); }\n            return (0, null);\n        }\n        a: &phm_array_node => {\n            let child = a.children[(hash >>u shift) & 31];\n            if child == null { return (0, null); }\n            return phm_node_get(child!, shift + 5, hash, key, equal);\n        }\n        c: &phm_collision_node => {\n            if c.hash != hash { return (0, null); }\n            let i: i32 = 0;\n            let count: i32 = c.count;\n            while i <s count {\n                let at = i * 2;\n                if equal(c.slots[at]!, key) != 0 { return (1, c.slots[at + 1]); }\n                i += 1;\n            }\n            return (0, null);\n        }\n        _ => { unreachable; }\n    }\n    unreachable;\n}\n\nfn phm_promote(\n    node: &phm_bitmap_node,\n    shift: i32,\n    hash: i32,\n    key: &eq,\n    value: &?eq,\n    hash_fn: &phm_hash,\n    equal: &phm_equal,\n) -> &phm_node {\n    let children = [phm_node_slots| null; 32];\n    let slot: i32 = 0;\n    let branch: i32 = 0;\n    while branch <s (32 as i32) {\n        let bit = (1 as i32) << branch;\n        if (node.bitmap & bit) != 0 {\n            let old_key = node.slots[slot];\n            if old_key == null {\n                children[branch] = node.slots[slot + 1] as &phm_node;\n            } else {\n                let old_hash = hash_fn(old_key!);\n                children[branch] = phm_singleton_at(shift + 5, old_hash, old_key!, node.slots[slot + 1]);\n            }\n            slot += 2;\n        }\n        branch += 1;\n    }\n    let index = (hash >>