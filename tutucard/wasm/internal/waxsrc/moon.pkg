// The Wax sources every compiled card carries, parsed once.
//
// Two halves: the vendored standard library (`vendor/wax/`, copied verbatim
// from `marianoguerra/wax` — see its README) and the fixed card runtime
// (`runtime/`, hand-written here), which is tutuca's value semantics over it.
//
// Both are SOURCE, because Wax has no import system: a consumer concatenates
// the files and compiles the whole thing as one module. So this package holds
// the text, parses it, and hands back module fields — and it is the one place
// in the compiler that reaches Wax's front end.
import {
  "marianoguerra/wax" @waxfacade,
  "marianoguerra/wax/basic",
  "marianoguerra/tutuca/tutucard/wasm/internal/abi" @abi,
  "moonbitlang/core/ref",
}

// The two tests compile these sources on their own — a syntax error in a
// `.wax` file is a problem with THAT file, and finding it here rather than
// inside a `BadModule` from some card is most of fixing it. The library half
// only parses; checking and emitting is the caller's job, so these are the
// tests' imports and not the package's.
import {
  "marianoguerra/wax/compile" @compile,
  "marianoguerra/wax/message" @message,
} for "test"
