// tutucard: a component that is only a `.html` file.
//
// State in `<script type="tutuca/state">`, behaviour in
// `<script type="tutuca/script">`, views in `<template>`. No MoonBit, no
// generator, no compiler — the card is parsed and mounted at runtime, which is
// what makes it authorable in a browser and what makes a model able to write
// one and have it validated before it runs.
//
// **A card is `DynObj` with an interpreter where the wasm bridge would be**,
// and almost nothing here is new. The mutators come from
// `@component.schema_mutators` over the declared schema, exactly as a guest's
// do; the state holder is the same `FieldBox` three-closure adapter; the views
// are `@anode.View::new`, the runtime-parse path a guest bundle already takes;
// the component is `Component::for_type`. What this package adds is the part
// that used to be a wasm module: a `Handler` that runs a parsed body.
//
// The effect vocabulary lining up is the evidence that this is the right
// shape rather than a convenient one. `send` / `bubble` / `sendAt` / `request`
// / `stop` are `dyncomp`'s `ControlMsg` list, and a body answering "I changed
// nothing" is the same `None` a guest's `handled` distinguishes from "no arm
// claimed this".
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/viewfile",
  "marianoguerra/tutuca/statedef",
  "marianoguerra/tutuca/statedef/info",
  "marianoguerra/tutuca/tscript",
  "marianoguerra/tutuca/tscript/check",
  "marianoguerra/tutuca/tscript/interp",
}

import {
  "marianoguerra/tutuca/testing/harness",
} for "test"
