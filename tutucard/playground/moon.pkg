// The card playground's mount facade.
//
// The payload here is the whole story. The existing `playground/` ships a
// 5.5 MB `moonc` worker, a prebuilt `.mi`/`.core` bundle per target, and a
// toolchain pin asserted at assemble time — because it compiles the user's
// MoonBit in the browser. A card needs none of that: `tgc/emit` turns the
// source into a core wasm module, and that compiler is a MoonBit LIBRARY in
// this bundle rather than a payload fetched beside it.
//
// COMPILING used to be the second answer to a card and interpreting was the
// first: the page parsed a card, mounted it where it stood, and showed what the
// compiler would have made of the same source in a panel next door. There is no
// interpreter any more, so the panel's answer is the one on screen — the page
// compiles, instantiates and mounts, and what it shows you is what it is
// running.
//
// The edit loop is therefore check → compile → instantiate → mount, and the
// third step is the only one that is not a synchronous call: it lives in
// `web/card-tgc.js` as `mountTgcCard`, because `WebAssembly.compile` answers a
// promise. What is left on this side is `check(source)` — the diagnostics, as
// JSON, with real columns, which nothing in a view file could report until
// `tscript` carried spans — and `mountCompiled`, which takes a module the page
// has already instantiated.
import {
  "marianoguerra/tutuca/app",
  "marianoguerra/tutuca/transactor",
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/component",
  // The card compiler: core wasm plus GC, no component model, no archive.
  "marianoguerra/tutuca/tgc/emit" @tgc,
  // Driving a card rather than showing one: the same bundle, mounted on the
  // in-memory DOM. Backend-agnostic, so what it proves is provable with no
  // page — which is the whole point of it being reachable from here.
  "marianoguerra/tutuca/tutucard/drive",
  "marianoguerra/tutuca/scenedef",
  // The drive verbs, over the app this page just mounted. A fixture's `drive`
  // steps run on the REAL DOM through the same harness a scene uses on the
  // in-memory one, which is what keeps "click the third row" one thing.
  "marianoguerra/tutuca/testing/harness",
  "marianoguerra/tutuca/viewfile",
  // What the compiled card is mounted AS: an ordinary loaded module. The
  // `&Guest` over the instantiated module is `cardguest.mbt`, and `policy` is
  // what this page will accept from one.
  "marianoguerra/tutuca/tgc/host",
  "marianoguerra/tutuca/tgc/policy",
  "moonbitlang/core/encoding/base64",
  "marianoguerra/tutuca/app/browser" @glue,
  "marianoguerra/tutuca/vdom/browser" @bdom,
  "mizchi/js_browser/dom",
  "moonbitlang/core/json",
}

supported_targets = "js"

pkgtype(kind: "executable")
