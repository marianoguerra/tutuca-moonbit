///|
/// The generated module for the counter view, in full. This snapshot IS the
/// contract: read it, do not just refresh it.
test "the generated counter module" {
  inspect(
    @viewgen.generate(counter_html, name="Counter", source_file="counter.html"),
    content=(
      #|// GENERATED by `tutuca gen` from counter.html — DO NOT EDIT.
      #|// Regenerate with:
      #|//
      #|//   tutuca gen counter.html --name Counter --out <dir>
      #|//
      #|// The package this file lives in must import:
      #|//   "marianoguerra/tutuca/core" @tutuca, "marianoguerra/tutuca/component",
      #|//   "moonbitlang/core/debug"
      #|
      #|///|
      #|/// The file-level style — pass as `common_style~`.
      #|pub let counter_common_style : String = ""
      #|
      #|///|
      #|/// The `data-global` style — pass as `global_style~`.
      #|pub let counter_global_style : String = ""
      #|
      #|///|
      #|/// The Receive arm of @component.Dispatch, decoded.
      #|///
      #|/// Every addressed name: the `message` variant the state block declares,
      #|/// plus every bare `@on` handler the views write. One bucket holds them
      #|/// however they were sent, so one type covers it — where the two overlap
      #|/// the schema's declared payload wins, and a view whose call sites
      #|/// disagree with it is a build error.
      #|pub(all) enum CounterMsg {
      #|  Add(Double)
      #|  ResetCount
      #|  SetLabel(String)
      #|  /// A message the schema does not declare, or a declared name whose
      #|  /// runtime arguments did not match the declared types.
      #|  Unknown(String, Array[@tutuca.Value])
      #|}
      #|
      #|///|
      #|/// Decode a Receive dispatch. None for any other bucket.
      #|///
      #|/// A payload that does not match falls into `Unknown` rather than being
      #|/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,
      #|/// and silently truncating it would hide that.
      #|///
      #|/// It is also REPORTED. `Unknown` answers two different questions —
      #|/// nobody declares this name, and this name is declared here and was
      #|/// handed the wrong shape — and the second one is a bug in the sender
      #|/// that used to be indistinguishable from silence. Every arm below that
      #|/// can fail on a DECLARED name says so through `@tutuca.bad_payload`,
      #|/// which costs nothing unless a host is listening.
      #|pub fn CounterMsg::from_dispatch(d : @component.Dispatch) -> CounterMsg? {
      #|  guard d is Receive(name, args) else { return None }
      #|  Some(
      #|    match (name, args) {
      #|      ("add", [Num(a0)]) => Add(a0)
      #|      ("resetCount", []) => ResetCount
      #|      ("setLabel", [Str(a0)]) => SetLabel(a0)
      #|      _ => {
      #|        match name {
      #|          "add" =>
      #|            @tutuca.bad_payload(name, "Double", args)
      #|          "resetCount" =>
      #|            @tutuca.bad_payload(name, "", args)
      #|          "setLabel" =>
      #|            @tutuca.bad_payload(name, "String", args)
      #|          _ => ()
      #|        }
      #|        Unknown(name, args)
      #|      }
      #|    },
      #|  )
      #|}
      #|
      #|///|
      #|/// The dispatch name and arguments this message raises as.
      #|pub fn CounterMsg::to_dispatch(self : CounterMsg) -> (String, Array[@tutuca.Value]) {
      #|  match self {
      #|    Add(a0) => ("add", [Num(a0)])
      #|    ResetCount => ("resetCount", [])
      #|    SetLabel(a0) => ("setLabel", [Str(a0)])
      #|    Unknown(n, args) => (n, args)
      #|  }
      #|}
      #|
      #|///|
      #|/// Send this message to self; it arrives as a later Receive dispatch.
      #|///
      #|/// The name comes from the schema, so it cannot drift from the one
      #|/// `from_dispatch` decodes.
      #|pub fn CounterMsg::send(self : CounterMsg, ctx : &@tutuca.Ctx) -> Unit {
      #|  let (name, args) = self.to_dispatch()
      #|  ctx.send(name, args)
      #|}
      #|
      #|
    ),
  )
}

///|
/// The compiled-tree module for the same view, in full. This snapshot IS the
/// contract for what the builders let the emitter leave out: no ns, no
/// node_id where it is None, no event ids, no data-vid (View::from_ir stamps
/// it), no ConstAttrs/DynAttrs (h derives it from the items).
test "the generated counter tree" {
  inspect(
    @viewgen.emit_ir_module(
      "Counter",
      "counter.html",
      @viewgen.split_file(counter_html),
    ),
    content=(
      #|// GENERATED by `tutuca gen` from counter.html — DO NOT EDIT.
      #|//
      #|// The views of Counter, already compiled: the @anode.ANode tree each one
      #|// parses into, plus its event table, written with anode's builders.
      #|// Passing counter_views() as `views~` means the template parser
      #|// never runs at startup.
      #|//
      #|// A component that also declares a schema gets a `_component` wrapper
      #|// beside its views: component() with the name, the views, the styles,
      #|// the codec and the schema already filled in — pass it the handlers.
      #|//
      #|// The package this file lives in must import:
      #|//   "marianoguerra/tutuca/anode", and for the wrapper
      #|//   "marianoguerra/tutuca/core" @tutuca, "marianoguerra/tutuca/component"
      #|//
      #|// Every builder returns a FRESH tree: View::from_ir stamps and optimizes
      #|// it in place, and each component that adopts a view stamps its own
      #|// data-cid onto it.
      #|
      #|///|
      #|/// The compiled `main` view.
      #|fn counter_main_view_ir() -> @anode.View {
      #|  @anode.View::from_ir(
      #|    "main",
      #|    @anode.h("div", [@anode.attr("class", "counter")], [
      #|      @anode.h("h1", [], [
      #|        @anode.dyn_text(@tutuca.Expr::field("label"), id=0),
      #|        @anode.text(": "),
      #|        @anode.h("span", [@anode.attr("id", "count")], [
      #|          @anode.dyn_text(@tutuca.Expr::field("count"), id=1),
      #|        ]),
      #|      ]),
      #|      @anode.text(" "),
      #|      @anode.h("button", [@anode.attr("id", "inc"), @anode.eid(0)], [
      #|        @anode.text("+1"),
      #|      ]),
      #|      @anode.text(" "),
      #|      @anode.h("button", [@anode.attr("id", "dec"), @anode.eid(1)], [
      #|        @anode.text("-1"),
      #|      ]),
      #|      @anode.text(" "),
      #|      @anode.h("button", [@anode.attr("id", "reset"), @anode.eid(2)], [
      #|        @anode.text("reset"),
      #|      ]),
      #|      @anode.text(" "),
      #|      @anode.h("input", [@anode.attr("id", "label"), @anode.dyn_attr("value", @tutuca.Expr::field("label")), @anode.eid(3)], []),
      #|      @anode.text(" "),
      #|      @anode.h("ul", [@anode.attr("id", "history")], [
      #|        @anode.each(3, @tutuca.Expr::field("history"), @anode.h("li", [], [
      #|          @anode.dyn_text(@tutuca.Expr::bind("value"), id=2),
      #|        ])),
      #|      ]),
      #|    ]),
      #|    [
      #|      [@anode.on("click", @tutuca.Expr::name("add"), args=[@anode.const_num(1.0)])],
      #|      [@anode.on("click", @tutuca.Expr::name("add"), args=[@anode.const_num(-1.0)])],
      #|      [@anode.on("click", @tutuca.Expr::name("resetCount"))],
      #|      [@anode.on("input", @tutuca.Expr::name("setLabel"), args=[@tutuca.Expr::event_path(["value"])]), @anode.on("keydown", @tutuca.Expr::name("setLabel"), args=[@anode.const_str("sent!")], modifiers=["send"])],
      #|    ],
      #|  )
      #|}
      #|
      #|///|
      #|/// The component's views, already compiled — pass as `views~` to
      #|/// @component.component.
      #|pub fn counter_views() -> Map[String, @anode.View] {
      #|  {
      #|    "main": counter_main_view_ir(),
      #|  }
      #|}
      #|
      #|
    ),
  )
}

///|
test "a view with a $method, several views and styles" {
  inspect(
    @viewgen.generate(
      (
        #|<style>.todo { display: grid }</style>
        #|<template>
        #|  <ul><li @each=".items"><x render-it as="row"></x></li></ul>
        #|  <button @on.click="clearDone" :title="$doneLabel">clear</button>
        #|</template>
        #|<template id="row"><style>li { margin: 0 }</style><li><x text="@value"></x></li></template>
      ),
      name="TodoList",
      source_file="todo.html",
    ),
    content=(
      #|// GENERATED by `tutuca gen` from todo.html — DO NOT EDIT.
      #|// Regenerate with:
      #|//
      #|//   tutuca gen todo.html --name TodoList --out <dir>
      #|//
      #|// The package this file lives in must import:
      #|//   "marianoguerra/tutuca/core" @tutuca, "marianoguerra/tutuca/component",
      #|//   "moonbitlang/core/debug"
      #|
      #|///|
      #|/// The file-level style — pass as `common_style~`.
      #|pub let todo_list_common_style : String = ".todo { display: grid }"
      #|
      #|///|
      #|/// The `data-global` style — pass as `global_style~`.
      #|pub let todo_list_global_style : String = ""
      #|
      #|///|
      #|/// The Receive arm of @component.Dispatch, decoded.
      #|///
      #|/// Every addressed name: the `message` variant the state block declares,
      #|/// plus every bare `@on` handler the views write. One bucket holds them
      #|/// however they were sent, so one type covers it — where the two overlap
      #|/// the schema's declared payload wins, and a view whose call sites
      #|/// disagree with it is a build error.
      #|pub(all) enum TodoListMsg {
      #|  ClearDone
      #|  /// A message the schema does not declare, or a declared name whose
      #|  /// runtime arguments did not match the declared types.
      #|  Unknown(String, Array[@tutuca.Value])
      #|}
      #|
      #|///|
      #|/// Decode a Receive dispatch. None for any other bucket.
      #|///
      #|/// A payload that does not match falls into `Unknown` rather than being
      #|/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,
      #|/// and silently truncating it would hide that.
      #|///
      #|/// It is also REPORTED. `Unknown` answers two different questions —
      #|/// nobody declares this name, and this name is declared here and was
      #|/// handed the wrong shape — and the second one is a bug in the sender
      #|/// that used to be indistinguishable from silence. Every arm below that
      #|/// can fail on a DECLARED name says so through `@tutuca.bad_payload`,
      #|/// which costs nothing unless a host is listening.
      #|pub fn TodoListMsg::from_dispatch(d : @component.Dispatch) -> TodoListMsg? {
      #|  guard d is Receive(name, args) else { return None }
      #|  Some(
      #|    match (name, args) {
      #|      ("clearDone", []) => ClearDone
      #|      _ => {
      #|        match name {
      #|          "clearDone" =>
      #|            @tutuca.bad_payload(name, "", args)
      #|          _ => ()
      #|        }
      #|        Unknown(name, args)
      #|      }
      #|    },
      #|  )
      #|}
      #|
      #|///|
      #|/// The dispatch name and arguments this message raises as.
      #|pub fn TodoListMsg::to_dispatch(self : TodoListMsg) -> (String, Array[@tutuca.Value]) {
      #|  match self {
      #|    ClearDone => ("clearDone", [])
      #|    Unknown(n, args) => (n, args)
      #|  }
      #|}
      #|
      #|///|
      #|/// Send this message to self; it arrives as a later Receive dispatch.
      #|///
      #|/// The name comes from the schema, so it cannot drift from the one
      #|/// `from_dispatch` decodes.
      #|pub fn TodoListMsg::send(self : TodoListMsg, ctx : &@tutuca.Ctx) -> Unit {
      #|  let (name, args) = self.to_dispatch()
      #|  ctx.send(name, args)
      #|}
      #|
      #|///|
      #|/// Every `$name` the views call, plus the block's own `pred` / `compute` names — the bucket `compute~` keys.
      #|pub(all) enum TodoListCompute {
      #|  DoneLabel
      #|} derive(Eq, @debug.Debug)
      #|
      #|///|
      #|pub fn TodoListCompute::name(self : TodoListCompute) -> String {
      #|  match self {
      #|    DoneLabel => "doneLabel"
      #|  }
      #|}
      #|
      #|
    ),
  )
}

///|
/// The safe markup directives survive AOT codegen.
///
/// A snapshot of the whole module would be the wrong test here — what can break
/// is one arm of `attr_item_expr`, and it breaks SILENTLY: a missing arm means
/// the generated view drops the directive and the component renders an empty
/// element with no error anywhere. So assert on the builder calls themselves.
///
/// `emit_ir_module` rather than `generate`, because the builder calls live in
/// the IR module; `generate` emits the styles and the handler enums.
test "gen emits the safe markup directives" {
  let out = @viewgen.emit_ir_module(
    "Doc",
    "doc.html",
    @viewgen.split_file(
      (
        #|<view name="main">
        #|  <div>
        #|    <article @setinnerhtml=".body"></article>
        #|    <svg @setinnersvg=".chart"></svg>
        #|  </div>
        #|</view>
      ),
      name="Doc",
    ),
  )
  assert_true(out.contains("set_inner_html(val=@tutuca.Expr::field(\"body\"))"))
  assert_true(out.contains("set_inner_svg(val=@tutuca.Expr::field(\"chart\"))"))
}
