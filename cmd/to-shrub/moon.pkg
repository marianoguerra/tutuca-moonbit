// `to-shrub <file.tutu>...` — the corpus, converted to the aligned notation.
//
// Migration scaffolding, and meant to be deleted with `tutufile/toshrub` once
// no file is written the old way. The previous migration's `tutuca to-tutu`
// was the same thing and went the same way, which is why this is a `cmd/`
// binary rather than a `tutuca` subcommand: a throwaway does not belong in the
// command registry, the help text and the agent context.
//
// It writes nothing it has not checked. For each file, both spellings are read
// to `@anode.ANode` and compared WHITESPACE-EXACT -- a comparison that
// normalised whitespace would be blind to the one dimension this conversion
// changes, and four defects in this repo's migrations have been one step from
// what their check could see.
import {
  "marianoguerra/tutuca/tutufile",
  "marianoguerra/tutuca/tutufile/toshrub",
  "marianoguerra/tutuca/tutufile/toanode",
  "marianoguerra/tutuca/tutufile/shrub" @sh,
  "marianoguerra/error-report" @report,
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/debug",
}

supported_targets = "native"

pkgtype(kind: "executable")
