///|
/// Regenerate the margaui bundle + its embedded MoonBit module.
///
/// `-i <entry.css>`  the adapted margaui entry (default demo/assets/margaui.entry.css)
/// `--base <dir>`    margaui checkout the entry's @imports resolve against (default ../margaui)
/// `-o <bundle.json>` the raw path->content bundle (default demo/assets/margaui.bundle.json)
/// `--emit-mbt <p>`  the embedded module (default demo/margaui/bundle_gen.mbt)
///
/// The bundle step is exactly `tailwindcss bundle` — `@tw.collect_imports` walks
/// the `@import` graph and returns entry-relative keys usable with `base = ""`.
async fn main {
  let args = @sys.get_cli_args()
  let mut input = "demo/assets/margaui.entry.css"
  let mut base = "../margaui"
  let mut output = "demo/assets/margaui.bundle.json"
  let mut emit_mbt = "demo/margaui/bundle_gen.mbt"
  let mut index = 1
  while index < args.length() {
    let arg = args[index]
    fn next(name : String) -> String {
      index += 1
      guard index < args.length() else {
        println("error: \{name} requires a value")
        @sys.exit(2)
        ""
      }
      args[index]
    }

    match arg {
      "-i" | "--input" => input = next(arg)
      "--base" => base = next(arg)
      "-o" | "--output" => output = next(arg)
      "--emit-mbt" => emit_mbt = next(arg)
      "-h" | "--help" => {
        println(
          "usage: margaui-bundle [-i entry.css] [--base dir] [-o bundle.json] [--emit-mbt out.mbt]",
        )
        return
      }
      _ => {
        println("error: unknown argument: \{arg}")
        @sys.exit(2)
      }
    }
    index += 1
  }
  let entry = @fs.read_file_to_string(input) catch {
    _ => {
      println("error: cannot read entry: \{input}")
      @sys.exit(1)
      ""
    }
  }
  let loader = @twfs.FsStylesheetLoader::new()
  let imports = @tw.collect_imports(entry, loader, base~) catch {
    err => {
      println("error: \{err}")
      @sys.exit(1)
      Map([])
    }
  }
  @fs.write_string_to_file(output, imports_to_json(imports))
  @fs.write_string_to_file(emit_mbt, emit_module(entry, imports))
  println(
    "margaui-bundle: \{imports.length()} files -> \{output} (+ embedded \{emit_mbt})",
  )
}

///|
/// Serialize the collected import map to a stable, single-line JSON object with
/// keys sorted (Map iteration order is unspecified). Identical to the CLI's
/// `imports_to_json` so the artifact matches `tailwindcss bundle -o`.
fn imports_to_json(imports : Map[String, String]) -> String {
  let keys = imports.keys().collect()
  keys.sort()
  let parts = keys.map(fn(key) {
    let value = imports.get(key).unwrap()
    "\{Json::string(key).stringify()}:\{Json::string(value).stringify()}"
  })
  "{\{parts.join(",")}}"
}

///|
/// Emit the generated MoonBit module: the entry and every bundled stylesheet as
/// `#|` raw multi-line strings, so CSS (naturally multi-line) needs no escaping
/// and no source line runs long. `margaui_bundle` is directly the pairs
/// `MemoryStylesheetLoader` wants; keys are entry-relative (see collect_imports).
fn emit_module(entry : String, imports : Map[String, String]) -> String {
  let buf = StringBuilder::new()
  buf.write_string(
    (
      #|// GENERATED by `moon run --target native cmd/dev -- margaui-bundle` from
      #|// demo/assets/margaui.entry.css + a margaui checkout — DO NOT EDIT.
      #|// `margaui_entry` is the compile entry; `margaui_bundle` is the
      #|// path->content @import map (see marianoguerra/tailwindcss `bundle`).
      #|
      #|///|
      #|pub let margaui_entry : String =
      #|
    ),
  )
  write_raw_string(buf, entry, indent="  ")
  buf.write_string(
    (
      #|
      #|///|
      #|pub let margaui_bundle : Array[(String, String)] = [
      #|
    ),
  )
  let keys = imports.keys().collect()
  keys.sort()
  for key in keys {
    buf.write_string("  (\{Json::string(key).stringify()}, ")
    write_raw_string(buf, imports.get(key).unwrap(), indent="    ")
    buf.write_string("),\n")
  }
  buf.write_string("]\n")
  buf.to_string()
}

///|
/// Write `s` as a MoonBit `#|` raw string literal, one `#|` line per source line.
/// Wrapped in parens so it is a standalone expression (safe in a tuple/arg).
fn write_raw_string(buf : StringBuilder, s : String, indent~ : String) -> Unit {
  buf.write_string("(\n")
  for line in s.split("\n") {
    buf.write_string(indent)
    buf.write_string("#|")
    buf.write_string(line.to_owned())
    buf.write_string("\n")
  }
  buf.write_string(indent)
  buf.write_string(")")
}
