///|
/// Regenerate a CSS bundle + its embedded MoonBit module.
///
/// Run twice by the `css-bundle` task, once per entry: the stock Tailwind
/// stylesheets and the margaui component layers land in two generated modules
/// that the `css` package compiles from.
///
/// `-i <entry.css>`  the compile entry (default css/assets/margaui.entry.css)
/// `--base <dir>`    the checkout the entry's @imports resolve against
///                   (default _build/margaui — where scripts/fetch-margaui.mjs
///                   clones the pinned margaui ref; the Tailwind run passes
///                   _build/tailwind, filled by scripts/fetch-tailwind.mjs)
/// `-o <bundle.json>` the raw path->content bundle (default css/assets/margaui.bundle.json)
/// `--emit-mbt <p>`  the embedded module (default css/margaui_bundle_gen.mbt)
/// `--prefix <name>` name the emitted bindings `<name>_entry` / `<name>_bundle`
///                   (default margaui)
/// `--skip-prefix <p>` drop bundled keys starting with `p`. The margaui run
///                   passes `tw/`: margaui's entry imports ./tw/*, but those
///                   files come from the Tailwind bundle at compile time, so
///                   re-emitting margaui's hand-mirrored (and stale) copies here
///                   would both bloat the module and shadow the good ones.
///
/// The bundle step is exactly `tailwindcss bundle` — `@tw.collect_imports` walks
/// the `@import` graph and returns entry-relative keys usable with `base = ""`.
async fn main {
  let args = @sys.get_cli_args()
  let mut input = "css/assets/margaui.entry.css"
  let mut base = "_build/margaui"
  let mut output = "css/assets/margaui.bundle.json"
  let mut emit_mbt = "css/margaui_bundle_gen.mbt"
  let mut prefix = "margaui"
  let mut skip_prefix : String? = None
  let mut index = 1
  while index < args.length() {
    let arg = args[index]
    fn next(name : String) -> String {
      index += 1
      guard index < args.length() else {
        println("error: \{name} requires a value")
        @sys.exit(2)
        ""
      }
      args[index]
    }

    match arg {
      "-i" | "--input" => input = next(arg)
      "--base" => base = next(arg)
      "-o" | "--output" => output = next(arg)
      "--emit-mbt" => emit_mbt = next(arg)
      "--prefix" => prefix = next(arg)
      "--skip-prefix" => skip_prefix = Some(next(arg))
      "-h" | "--help" => {
        println(
          "usage: css-bundle [-i entry.css] [--base dir] [-o bundle.json] [--emit-mbt out.mbt] [--prefix name] [--skip-prefix p]",
        )
        return
      }
      _ => {
        println("error: unknown argument: \{arg}")
        @sys.exit(2)
      }
    }
    index += 1
  }
  let entry = @fs.read_file_to_string(input) catch {
    _ => {
      println("error: cannot read entry: \{input}")
      @sys.exit(1)
      ""
    }
  }
  let loader = @twfs.FsStylesheetLoader::new()
  let imports = @tw.collect_imports(entry, loader, base~) catch {
    err => {
      println("error: \{err}")
      @sys.exit(1)
      Map([])
    }
  }
  let kept = match skip_prefix {
    Some(p) => {
      let out : Map[String, String] = Map([])
      for key, value in imports {
        if !key.has_prefix(p) {
          out[key] = value
        }
      }
      out
    }
    None => imports
  }
  let skipped = imports.length() - kept.length()
  @fs.write_string_to_file(output, imports_to_json(kept))
  @fs.write_string_to_file(emit_mbt, emit_module(entry, kept, prefix))
  let note = if skipped > 0 { " (\{skipped} skipped)" } else { "" }
  println(
    "css-bundle: \{kept.length()} files\{note} -> \{output} (+ embedded \{emit_mbt})",
  )
}

///|
/// Serialize the collected import map to a stable, single-line JSON object with
/// keys sorted (Map iteration order is unspecified). Identical to the CLI's
/// `imports_to_json` so the artifact matches `tailwindcss bundle -o`.
fn imports_to_json(imports : Map[String, String]) -> String {
  let keys = imports.keys().collect()
  keys.sort()
  let parts = keys.map(fn(key) {
    let value = imports.get(key).unwrap()
    "\{Json::string(key).stringify()}:\{Json::string(value).stringify()}"
  })
  "{\{parts.join(",")}}"
}

///|
/// Emit the generated MoonBit module: the entry and every bundled stylesheet as
/// `#|` raw multi-line strings, so CSS (naturally multi-line) needs no escaping
/// and no source line runs long. `<prefix>_bundle` is directly the pairs
/// `MemoryStylesheetLoader` wants; keys are entry-relative (see collect_imports).
fn emit_module(
  entry : String,
  imports : Map[String, String],
  prefix : String,
) -> String {
  let buf = StringBuilder::new()
  buf.write_string(
    "// GENERATED by `moon run --target native cmd/dev -- css-bundle` from\n" +
    "// css/assets/\{prefix}.entry.css + a pinned upstream checkout — DO NOT EDIT.\n" +
    "// `\{prefix}_entry` is the compile entry; `\{prefix}_bundle` is the\n" +
    "// path->content @import map (see marianoguerra/tailwindcss `bundle`).\n" +
    "\n///|\npub let \{prefix}_entry : String =\n",
  )
  write_raw_string(buf, entry, indent="  ")
  buf.write_string(
    "\n///|\npub let \{prefix}_bundle : Array[(String, String)] = [\n",
  )
  let keys = imports.keys().collect()
  keys.sort()
  for key in keys {
    buf.write_string("  (\{Json::string(key).stringify()}, ")
    write_raw_string(buf, imports.get(key).unwrap(), indent="    ")
    buf.write_string("),\n")
  }
  buf.write_string("]\n")
  buf.to_string()
}

///|
/// Write `s` as a MoonBit `#|` raw string literal, one `#|` line per source line.
/// Wrapped in parens so it is a standalone expression (safe in a tuple/arg).
fn write_raw_string(buf : StringBuilder, s : String, indent~ : String) -> Unit {
  buf.write_string("(\n")
  for line in s.split("\n") {
    buf.write_string(indent)
    buf.write_string("#|")
    buf.write_string(line.to_owned())
    buf.write_string("\n")
  }
  buf.write_string(indent)
  buf.write_string(")")
}
