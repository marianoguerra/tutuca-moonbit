// Dev-only native tool: write the conformance corpus out as a view file, so
// the MoonBit backend is held to the same table the interpreter is.
//
// The corpus is DATA (`tscript/conformance`), and the interpreter reads it
// directly. The MoonBit backend cannot — its answers only exist once `moonc`
// has compiled them — so the corpus is projected into one `.html` that
// `gen` compiles like any other, and a whitebox test drives the emitted
// functions case by case.
//
// Run via: moon run --target native cmd/dev -- gen-conformance
// (which then runs `gen` over the file it writes).
import {
  // For `quote`: one owner for "this string, as a MoonBit literal". The copy
  // that used to live here wrapped in quotes and escaped nothing, which is a
  // handler name away from emitting a module that does not parse.
  "marianoguerra/tutuca/statedef",
  "marianoguerra/tutuca/tscript",
  "marianoguerra/tutuca/tscript/conformance" @corpus,
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")
