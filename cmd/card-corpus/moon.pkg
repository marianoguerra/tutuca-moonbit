// Dump `tscript/conformance` as JSON, for the wasm backend's adapter.
//
// The corpus is MoonBit data and a compiled card can only be RUN from node, so
// the table crosses as JSON and `tutucard/wasm/test/conformance.test.mjs` is
// the adapter over it.
//
// `tscript/interp` is NOT imported, and used to be: the corpus stored effects
// in a printed form, so the values had to be recovered by running a second
// implementation, and the compiled backend's conformance harness depended on
// the interpreter existing. The corpus stores the values now and this is a
// projection.
import {
  "marianoguerra/tutuca/tscript/conformance",
  "marianoguerra/tutuca/statedef",
  "marianoguerra/tutuca/core" @tutuca,
  "moonbitlang/x/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")
