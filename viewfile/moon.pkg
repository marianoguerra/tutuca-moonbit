// The shape of a read view file: its components' views, the declarations
// under them, its schema, its fixtures and its scenes.
//
// A SHAPE and no longer a reader. This package used to split: it ran the
// WHATWG tokenizer over an `.html` file to find element boundaries and sliced
// the source between them, so a view came back as raw text and every consumer
// parsed it again. `viewgen/read.mbt` reads a `.tutu` into this shape once,
// with `tutufile`'s readers, and nothing is parsed twice.
//
// It stays its own package for the reason it was split out of `viewgen/`: two
// very different consumers hold one of these and only one of them is a code
// generator. A card runtime that had to import an emitter to find out what a
// file declares would be carrying the whole `emit_*` layer for the sake of a
// struct.
import {
  "marianoguerra/tutuca/statedef",
  // A view READ from a `.tutu` arrives as a tree, and a `logic:` section as
  // declarations. Neither goes through text, so the shapes they arrive in are
  // part of what a file is.
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/tscript",
  "marianoguerra/tutuca/scenedef",
  "moonbitlang/core/debug",
}
