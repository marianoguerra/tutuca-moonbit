  // playground/site/examples/json.tutu
  SiteJsonJsonNull:
    span(class: "text-warning text-xs font-mono p-3 json-null"):
      "null"

  SiteJsonJsonBool:
    button(data_bool: "", class: if it.value | "btn btn-sm btn-soft btn-success font-mono true" | "btn btn-sm btn-soft btn-error font-mono false", ~on_click: it.value := !it.value):
      show(it.value):
        span():
          "true"
      " "
      hide(it.value):
        span():
          "false"

  SiteJsonJsonString:
    input(class: "input input-sm input-ghost text-green-500 font-mono json-string", value: it.value, ~on_input: it.value := e.value)

  SiteJsonJsonNumber:
    input(type: "number", class: "input input-sm input-ghost text-primary font-mono json-number", title: it.value, value: it.str_value, ~on_input: set_raw_value(e.value))

  SiteJsonJsonSelector:
    div(class: "join gap-3 font-mono json-selector"):
      button(class: "btn btn-sm btn-soft btn-warning to-null", ~on_click: set_to_null):
        "null"
      " "
      button(class: "btn btn-sm btn-soft btn-success to-bool", ~on_click: set_to_bool(e.isCtrl)):
        "bool"
      " "
      button(class: "btn btn-sm btn-soft btn-primary to-number", ~on_click: set_to_number):
        "0"
      " "
      button(class: "btn btn-sm btn-soft btn-accent to-string", ~on_click: set_to_string):
        "\"\""
      " "
      button(class: "btn btn-sm btn-soft btn-info to-array", ~on_click: set_to_array):
        "[]"
      " "
      button(class: "btn btn-sm btn-soft btn-info to-object", ~on_click: set_to_object):
        "{}"

  SiteJsonJsonArray:
    style(): @{[data-draggingover="json-list-item"] { border-top: 4rem solid transparent; transition: 0.15s border-top ease; }}
    section(class: "join join-vertical gap-3 pl-3 border-l-1 border-l-neutral-500 json-array"):
      button(class: "btn btn-sm btn-soft btn-primary add", ~on_click: add_item):
        "+"
      " "
      div(class: "join join-vertical gap-3"):
        each(value, key in it.items):
          div(class: "join gap-3 justify-between items-center group entry", draggable: "true", data_dragtype: "json-list-item", data_droptarget: "json-list-item", ~on_drop: on_drop_on_item(key, e.dragInfo)):
            render(value)
            " "
            button(class: "btn btn-sm btn-soft btn-circle btn-error font-mono opacity-20 group-hover:opacity-100 rm", ~on_click: it.items.delete_at(key)):
              "x"

  SiteJsonJsonObjectKeyVal:
    div(class: "join gap-3 items-center justify-center json-kv"):
      input(class: "input input-sm input-ghost text-green-500 font-mono json-key", value: it.key, ~on_input: it.key := e.value)
      " "
      span(class: "text-xs font-mono text-gray-500 colon"):
        ":"
      " "
      render(it.value)

  SiteJsonJsonObject:
    style(): @{[data-draggingover="json-kv-item"] { border-top: 4rem solid transparent; transition: 0.15s border-top ease; }}
    section(class: "join join-vertical gap-3 pl-3 border-l-1 border-l-neutral-500 json-object"):
      button(class: "btn btn-sm btn-soft font-mono btn-primary add", ~on_click: add_item):
        "+"
      " "
      div(class: "join join-vertical gap-3"):
        each(value, key in it.items):
          div(class: "join gap-3 justify-between items-center group entry", draggable: "true", data_dragtype: "json-kv-item", data_droptarget: "json-kv-item", ~on_drop: on_drop_on_item(key, e.dragInfo)):
            render(value)
            " "
            button(class: "btn btn-sm btn-soft btn-circle btn-error font-mono opacity-20 group-hover:opacity-100 rm", ~on_click: it.items.delete_at(key)):
              "x"
  // playground/site/examples/personal_site.tutu
  SitePersonalSiteAltUrl:
    a(class: "badge badge-ghost badge-sm cursor-pointer gap-1 no-underline hover:bg-base-200 alt-url", href: it.url, target: "_blank"):
      "🔗 "
      span():
        @(it.label)

  SitePersonalSitePSEntry:
    div(class: "card bg-base-200 shadow-sm p-2 sm:p-3 flex flex-col gap-2 ps-entry"):
      div(class: "flex gap-1 sm:gap-2 flex-wrap items-center"):
        show(it.featured):
          span(class: "star"):
            "⭐"
        " "
        show(is_spanish()):
          span(class: "flag"):
            @(lang_flag())
        " "
        show(it.start_year.is_truthy()):
          span(class: "badge badge-ghost badge-sm border-0 font-bold years"):
            @(year_display())
        " "
        show(it.role):
          span(class: "badge badge-neutral badge-sm border-0 font-bold role"):
            @(it.role)
      " "
      a(href: it.url, target: "_blank", class: "link link-hover"):
        h2(class: "font-bold title"):
          @(it.title)
      " "
      p(class: "text-sm opacity-70 desc"):
        @(it.description)
      div(class: "flex gap-1 sm:gap-2 flex-wrap cats"):
        each(value, key in it.categories, ~enrich_with: enrich_category_badge):
          span(class: badge_class):
            @(value)
      " "
      hide(it.alt_urls.is_empty()):
        div(class: "alts"):
          ul():
            each(value, key in it.alt_urls):
              li():
                render(value)

  SitePersonalSiteRoot:
    section(class: "ps-root flex flex-col gap-4"):
      div(class: "card bg-base-200 p-4 controls"):
        p(class: "text-sm mb-4"):
          "💡 Click tags to toggle. Solo / unsolo toggle with "
          kbd(class: "text-mono"):
            "alt/option + click"
          "."
        "\n"
        div(class: "grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-y-1 sm:gap-x-3 sm:gap-y-3 items-start"):
          span(class: "font-semibold text-sm pt-1"):
            "Categories"
          " "
          div(class: "cat-facets flex flex-wrap gap-2"):
            each(value, key in it.all_categories, ~enrich_with: enrich_category_bindings):
              button(class: btn_class, ~on_click: on_category_toggle(key, e.isAlt)):
                @(value)
          " "
          span(class: "font-semibold text-sm pt-1"):
            "Roles"
          " "
          div(class: "role-facets flex flex-wrap gap-2"):
            each(value, key in it.all_roles, ~enrich_with: enrich_role_bindings):
              button(class: btn_class, ~on_click: on_role_toggle(key, e.isAlt)):
                @(value)
          " "
          span(class: "font-semibold text-sm pt-1"):
            "Sort By"
          " "
          div(class: "flex flex-wrap items-center gap-2"):
            label(class: "swap btn btn-xs btn-outline btn-primary"):
              input(type: "checkbox", class: "sort-end", checked: it.sort_by_end, ~on_change: on_toggle_sort_by_end)
              " "
              span(class: "swap-on"):
                "End Year"
              " "
              span(class: "swap-off"):
                "Start Year"
            " "
            label(class: "swap btn btn-xs btn-outline btn-primary"):
              input(type: "checkbox", class: "sort-asc", checked: it.sort_asc, ~on_change: on_toggle_sort_asc)
              " "
              span(class: "swap-on"):
                "↑ Oldest first"
              " "
              span(class: "swap-off"):
                "↓ Newest first"
            " "
            label(class: "flex items-center gap-2 cursor-pointer"):
              input(type: "checkbox", class: "toggle toggle-sm feat-first", checked: it.featured_first, ~on_change: on_toggle_featured_first)
              " "
              span(class: "text-sm"):
                "Featured first"
        "\n"
        div(class: "flex flex-wrap items-center gap-4 mt-4"):
          show(has_active_filters()):
            button(class: "btn btn-outline btn-sm clear-filters", ~on_click: clear_filters):
              "Clear Filters"
      "\n"
      div(class: "entries flex flex-col gap-3"):
        each(value, key in it.all_entries, ~when: filter_entry):
          div(class: "entry-row"):
            render(value)
