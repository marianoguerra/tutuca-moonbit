logic:
  // demo/counterlib/counter.tutu
  DemoCounterCounter:
    /// Move the counter by `d`, remembering where it landed.
    ///
    /// `.count` reads the value the line above wrote: a statement rebinds the
    /// state, so the push records where the counter ENDED rather than where it
    /// started.
    receive add(d):
      it.count += d
      it.history.push(it.count)

    /// The same move, addressed by name rather than by a click.
    receive reset_to(n):
      it.count := n
      it.history.push(it.count)
  // storybook/examples/communication.tutu
  SbCommunicationStatus:
    /// Show a message, and remember how many have come through.
    receive flash(m):
      it.message := m
      it.count += 1

    /// Stop showing it. The count is a running total and does not reset.
    receive clear:
      it.message := ""

  SbCommunicationSendReceive:
    /// Empty the input. `submit` cannot join it here: addressing the sibling by
    /// path is what that handler is FOR, and a path is what this block does not
    /// spell.
    receive clear_draft:
      it.draft := ""
  // storybook/examples/conditionals.tutu
  SbConditionalsTrafficLight:
    /// Step to the next colour, wrapping at the end of the cycle.
    ///
    /// The three names are the `$light` method's business, not this one's: the
    /// handler only ever moves an index, so `mod 3` is all it needs to know.
    receive next_light:
      it.light_index := ((it.light_index + 1) mod 3)
  // storybook/examples/counter.tutu
  SbCounterCounter:
    /// One step up, one step down. Both are `@on` names the views write, and
    /// neither reads anything but the field it moves — which is the whole of
    /// what a counter is.
    receive inc:
      it.count += 1

    receive dec:
      it.count -= 1

    property magnitude :: Int:
      get: if (it.count < 0) | -it.count | it.count
      set:
        if (it.count < 0)
        | it.count := -value
        | it.count := value
  // storybook/examples/personal_site.tutu
  SbPersonalSiteRoot:
    /// Ask for the data. Nothing else moves — the entries arrive as an ordinary
    /// message, `loadDataOk`, which sorts them and collects the facets, and that
    /// is a MoonBit handler.
    ///
    /// `lex` is the leg: the answer comes from a handler registered in the
    /// SCOPE, which is where the module puts its fixture.
    receive init:
      ask("load_data", ~route: lex)
  // storybook/examples/render_child.tutu
  SbRenderChildEntry:
    /// Whether this entry matches a query, for a parent's `@when` filter.
    ///
    /// It used to be a `func` in the state block — the one thing that put
    /// behaviour in a block whose own header says it holds none. It is a
    /// callable, so it lives with the callables.
    ///
    /// No view of SbRenderChildEntry calls it: a parent's `@when` does, holding SbRenderChildEntry
    /// instances and knowing nothing of their fields. That is why the block says
    /// `for="SbRenderChildEntry"` — this file declares four components, and a `.title` here
    /// has to mean exactly one of them.
    pred contains_text(q): ((it.title.lower()).contains(q.lower()) || (it.description.lower()).contains(q.lower()))
  // storybook/examples/rendering.tutu
  SbRenderingPushView:
    /// Flip the pushed view name. The label under the button is `$getToggleLabel`
    /// and stays in MoonBit — a `compute` is answered while rendering, and this
    /// runs after.
    receive toggle_view:
      it.view := if (it.view == "main") | "edit" | "main"

  SbRenderingPagination:
    /// Step back, never past the first page.
    receive prev:
      it.page := math.max(0, (it.page - 1))

    /// Step forward, never past the last one.
    ///
    /// `((len .items) - 1) / .pageSize` is the last page's index with its
    /// fraction still on it — the field is an Int and takes the whole part, so
    /// the division needs no ceiling of its own.
    receive next:
      it.page := math.min((it.page + 1), ((it.items.length() - 1) / it.page_size))
  // storybook/examples/request.tutu
  SbRequestRequestExample:
    /// Flip the pushed view name.
    receive toggle_view:
      it.view := if (it.view == "main") | "edit" | "main"

    /// Dispatch the intent and say so. `intent` is an effect here, which means
    /// it goes out only if the whole body finished — a message sent beside a
    /// transition that did not happen is the one outcome nobody can reason
    /// about afterwards.
    ///
    /// `lex` is the leg: the answer comes from a handler REGISTERED IN THE
    /// SCOPE, not from a component up the tree. That is what v1 spelled
    /// `request`, and writing it as a route is the whole change — the verb no
    /// longer decides which scope answers.
    ///
    /// No opts here. The three answer arms are in the schema, so the generator
    /// already knows where the answer goes.
    receive init:
      ask("load_data", ~route: lex)
      it.is_loading := true
  // storybook/examples/state_and_updates.tutu
  SbStateAndUpdatesShowHide:
    /// The panel's own counter. `toggleIsOpen` is not here because it is not
    /// written anywhere: a Bool field generates its own toggle.
    receive inc_count:
      it.count += 1
  // playground/site/examples/composability.tutu
  SiteComposabilityCounter:
    /// Six components share this file, so a script block says which one it
    /// answers for — a `.count` here has to mean exactly one state.
    receive inc:
      it.count += 1

    receive dec:
      it.count -= 1
  // playground/site/examples/counter.tutu
  SiteCounterCounter:
    /// The behaviour, in the same file as the state and the view. `gen`
    /// compiles this block into MoonBit and the component composes it ahead of
    /// the `update~` you pass — so a counter needs no `update~` at all.
    receive inc:
      it.count += 1

    receive dec:
      it.count -= 1

