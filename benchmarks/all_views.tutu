      div(role: "tablist", class: "tabs tabs-border"):
        button(role: "tab", id: "tab-counter", class: if (it.active_section == "counter") | "tab tab-active" | "tab", ~on_click: it.active_section := "counter"):
          "SiteComposabilityCounter"
        " "
        button(role: "tab", id: "tab-todo", class: if (it.active_section == "todo") | "tab tab-active" | "tab", ~on_click: it.active_section := "todo"):
          "To-Do"
        " "
        button(role: "tab", id: "tab-tree", class: if (it.active_section == "tree") | "tab tab-active" | "tab", ~on_click: it.active_section := "tree"):
          "Tree"
      " "
      show((it.active_section == "counter")):
        div(class: "pane-counter"):
          render(it.counter)
      " "
      show((it.active_section == "todo")):
        div(class: "pane-todo"):
          render(it.todo)
      " "
      show((it.active_section == "tree")):
        div(class: "pane-tree"):
          render(it.tree)
