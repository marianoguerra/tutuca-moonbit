  #|<!-- storybook/examples/rendering.html (SbRendering) -->
  #|
  #|<script type="tutuca/script" for="PushView">
  #|  /// Flip the pushed view name. The label under the button is `$getToggleLabel`
  #|  /// and stays in MoonBit — a `compute` is answered while rendering, and this
  #|  /// runs after.
  #|  receive toggleView {
  #|    .view = if .view is 'main' { 'edit' } else { 'main' }
  #|  }
  #|</script>
  #|
  #|<script type="tutuca/script" for="Pagination">
  #|  /// Step back, never past the first page.
  #|  receive prev {
  #|    .page = max 0 (.page - 1)
  #|  }
  #|
  #|  /// Step forward, never past the last one.
  #|  /// 
  #|  /// `((len .items) - 1) / .pageSize` is the last page's index with its
  #|  /// fraction still on it — the field is an Int and takes the whole part, so
  #|  /// the division needs no ceiling of its own.
  #|  receive next {
  #|    .page = min (.page + 1) (((len .items) - 1) / .pageSize)
  #|  }
  #|</script>
  #|
  #|<template id="SbRenderingPushView">
  #|  <section class="flex flex-col gap-3">
  #|    <div class="flex justify-between">
  #|      <input type="search" class="input" :value=".query"
  #|        @on.input="setQuery e.value" @on.keydown+cancel="resetQuery"
  #|        placeholder="Filter entries">
  #|      <button class="btn bnt-sm btn-primary toggle-btn" @text="$getToggleLabel" @on.click="toggleView"></button>
  #|    </div>
  #|    <div class="flex flex-col gap-3 max-h-[40vh] overflow-y-auto pr-3 rows" @push-view=".view">
  #|      <x render-each=".items" @when="filterItem"></x>
  #|    </div>
  #|  </section>
  #|</template>
  #|<template id="SbRenderingSeqItemAccess">
