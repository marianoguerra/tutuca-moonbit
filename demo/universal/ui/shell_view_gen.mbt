  /// 
  /// A FIELD and not a literal, because `@push-view` takes a text expression
  /// with no literal fallback — and because the whole point is that it is
  /// toggled. "" is not a view name, so it falls through to `main`.
  editView : String
  library : Array[@tutuca.Value]
  /// The paste-and-compile box.
  source : String
  notes : Array[@tutuca.Value]
  /// The one-slot pump to the shell outside. `pending` is a verb and
  /// `argument` is its one argument; the encoder and the decoder are written
  /// in one file so they cannot disagree.
  pending : String
  argument : String
  status : String
}

///|
/// The zero state: every field at its type's empty value.
///
/// The state block declares no defaults — a default is a value, not a
/// type — so this
/// is type-directed, and `init` spreads it to name only what differs:
///
///   initial={ ..ShellState::zero(), label: "Counter" }
pub fn ShellState::zero() -> ShellState {
  {
    canvas: Null,
    picker: Null,
    editView: "",
    library: [],
    source: "",
    notes: [],
    pending: "",
    argument: "",
    status: "",
  }
}

///|
/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through. That is the case a JSON round trip could not do at all: an
/// `Obj` or an `Fn` does not survive one.
impl @component.Fields for ShellState with fn encode(s) {
  {
    "canvas": s.canvas,
    "picker": s.picker,
    "editView": Str(s.editView),
    "library": (List(s.library.map(x => x)) : @tutuca.Value),
    "source": Str(s.source),
    "notes": (List(s.notes.map(x => x)) : @tutuca.Value),
    "pending": Str(s.pending),
    "argument": Str(s.argument),
    "status": Str(s.status),
  }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
impl @component.Fields for ShellState with fn decode(f) {
  let v_canvas = f.get("canvas").unwrap_or(Null)
  let v_picker = f.get("picker").unwrap_or(Null)
  guard f.get("editView") is Some(Str(v_editView)) else { return None }
  guard f.get("library") is Some(t1_library) else { return None }
  guard t1_library is List(u1_library) else { return None }
  let v_library : Array[@tutuca.Value] = []
  for e1_library in u1_library {
    let x1_library = e1_library
    v_library.push(x1_library)
  }
  guard f.get("source") is Some(Str(v_source)) else { return None }
  guard f.get("notes") is Some(t1_notes) else { return None }
  guard t1_notes is List(u1_notes) else { return None }
  let v_notes : Array[@tutuca.Value] = []
  for e1_notes in u1_notes {
    let x1_notes = e1_notes
    v_notes.push(x1_notes)
  }
  guard f.get("pending") is Some(Str(v_pending)) else { return None }
  guard f.get("argument") is Some(Str(v_argument)) else { return None }
  guard f.get("status") is Some(Str(v_status)) else { return None }
  Some({
    canvas: v_canvas,
    picker: v_picker,
    editView: v_editView,
    library: v_library,
    source: v_source,
    notes: v_notes,
    pending: v_pending,
    argument: v_argument,
    status: v_status,
  })
}

///|
/// The Receive arm of @component.Dispatch, decoded.
///
/// Every addressed name: the `message` variant the state block declares,
/// plus every bare `@on` handler the views write. One bucket holds them
/// however they were sent, so one type covers it — where the two overlap
/// the schema's declared payload wins, and a view whose call sites
/// disagree with it is a build error.
///
/// The script block answers typeSource, toggleEdit, compileSource, loadAll, loadChosen, save, restore, clearCanvas, so an `update` arm for
/// one of those can never run — the wrapper consults `update` only for a
/// dispatch the block did not claim. They are still here because raising
/// one is what a parent does, and `to_dispatch` is how.
pub(all) enum ShellMsg {
  OpenPicker
  PickerHits(Array[@tutuca.Value], String)
  PlaceBuilt(@tutuca.Value, Bool)
  AddNote(String, String)
  SetLibrary(Array[@tutuca.Value])
  SetStatus(String)
  Pumped
  ClearCanvas
  CompileSource
  LoadAll
  LoadChosen
  Restore
  Save
  ToggleEdit
  TypeSource(String)
  /// A message the schema does not declare, or a declared name whose
  /// runtime arguments did not match the declared types.
  Unknown(String, Array[@tutuca.Value])
}

///|
/// `pickerHits`'s arguments, decoded at the declared types.
///
/// The same `dec_stmts` the state codec is written from, so a payload and
/// a field of the same declared type are read by one rule. `None` is a
/// mismatch anywhere in the shape, however deep.
fn shell_msg_picker_hits_of_args(args : Array[@tutuca.Value]) -> ShellMsg? {
  guard args.length() == 2 else { return None }
  guard args.get(0) is Some(t1_0) else { return None }
  guard t1_0 is List(u1_0) else { return None }
  let a0 : Array[@tutuca.Value] = []
  for e1_0 in u1_0 {
    let x1_0 = e1_0
    a0.push(x1_0)
  }
  guard args.get(1) is Some(Str(a1)) else { return None }
  Some(PickerHits(a0, a1))
}

///|
/// `setLibrary`'s arguments, decoded at the declared types.
///
/// The same `dec_stmts` the state codec is written from, so a payload and
/// a field of the same declared type are read by one rule. `None` is a
/// mismatch anywhere in the shape, however deep.
fn shell_msg_set_library_of_args(args : Array[@tutuca.Value]) -> ShellMsg? {
  guard args.length() == 1 else { return None }
  guard args.get(0) is Some(t1_0) else { return None }
  guard t1_0 is List(u1_0) else { return None }
  let a0 : Array[@tutuca.Value] = []
  for e1_0 in u1_0 {
    let x1_0 = e1_0
    a0.push(x1_0)
  }
  Some(SetLibrary(a0))
}

///|
/// Decode a Receive dispatch. None for any other bucket.
///
/// A payload that does not match falls into `Unknown` rather than being
/// coerced: an `s32` handler handed 2.5 has been sent the wrong thing,
/// and silently truncating it would hide that.
///
/// It is also REPORTED. `Unknown` answers two different questions —
/// nobody declares this name, and this name is declared here and was
/// handed the wrong shape — and the second one is a bug in the sender
/// that used to be indistinguishable from silence. Every arm below that
/// can fail on a DECLARED name says so through `@tutuca.bad_payload`,
/// which costs nothing unless a host is listening.
pub fn ShellMsg::from_dispatch(d : @component.Dispatch) -> ShellMsg? {
  guard d is Receive(name, args) else { return None }
  Some(
    match (name, args) {
      ("openPicker", []) => OpenPicker
      ("pickerHits", _) =>
        match shell_msg_picker_hits_of_args(args) {
          Some(v) => v
          None => {
            @tutuca.bad_payload(name, "Array[Any], String", args)
            Unknown(name, args)
          }
        }
      ("placeBuilt", [a0, Bool(a1)]) => PlaceBuilt(a0, a1)
      ("addNote", [Str(a0), Str(a1)]) => AddNote(a0, a1)
      ("setLibrary", _) =>
        match shell_msg_set_library_of_args(args) {
          Some(v) => v
          None => {
            @tutuca.bad_payload(name, "Array[Any]", args)
            Unknown(name, args)
          }
        }
      ("setStatus", [Str(a0)]) => SetStatus(a0)
      ("pumped", []) => Pumped
      ("clearCanvas", []) => ClearCanvas
      ("compileSource", []) => CompileSource
      ("loadAll", []) => LoadAll
      ("loadChosen", []) => LoadChosen
      ("restore", []) => Restore
      ("save", []) => Save
      ("toggleEdit", []) => ToggleEdit
      ("typeSource", [Str(a0)]) => TypeSource(a0)
      _ => {
        match name {
          "openPicker" => @tutuca.bad_payload(name, "", args)
          "pickerHits" => @tutuca.bad_payload(name, "Array[Any], String", args)
          "placeBuilt" => @tutuca.bad_payload(name, "Any, Bool", args)
          "addNote" => @tutuca.bad_payload(name, "String, String", args)
          "setLibrary" => @tutuca.bad_payload(name, "Array[Any]", args)
          "setStatus" => @tutuca.bad_payload(name, "String", args)
          "pumped" => @tutuca.bad_payload(name, "", args)
          "clearCanvas" => @tutuca.bad_payload(name, "", args)
          "compileSource" => @tutuca.bad_payload(name, "", args)
          "loadAll" => @tutuca.bad_payload(name, "", args)
          "loadChosen" => @tutuca.bad_payload(name, "", args)
          "restore" => @tutuca.bad_payload(name, "", args)
          "save" => @tutuca.bad_payload(name, "", args)
          "toggleEdit" => @tutuca.bad_payload(name, "", args)
          "typeSource" => @tutuca.bad_payload(name, "String", args)
          _ => ()
        }
        Unknown(name, args)
      }
    },
  )
}

///|
/// The dispatch name and arguments this message raises as.
pub fn ShellMsg::to_dispatch(self : ShellMsg) -> (String, Array[@tutuca.Value]) {
  match self {
    OpenPicker => ("openPicker", [])
    PickerHits(a0, a1) =>
      ("pickerHits", [(List(a0.map(x => x)) : @tutuca.Value), Str(a1)])
    PlaceBuilt(a0, a1) => ("placeBuilt", [a0, Bool(a1)])
    AddNote(a0, a1) => ("addNote", [Str(a0), Str(a1)])
    SetLibrary(a0) => ("setLibrary", [(List(a0.map(x => x)) : @tutuca.Value)])
    SetStatus(a0) => ("setStatus", [Str(a0)])
    Pumped => ("pumped", [])
    ClearCanvas => ("clearCanvas", [])
    CompileSource => ("compileSource", [])
    LoadAll => ("loadAll", [])
    LoadChosen => ("loadChosen", [])
    Restore => ("restore", [])
    Save => ("save", [])
    ToggleEdit => ("toggleEdit", [])
    TypeSource(a0) => ("typeSource", [Str(a0)])
    Unknown(n, args) => (n, args)
  }
}

///|
/// Send this message to self; it arrives as a later Receive dispatch.
///
/// The name comes from the schema, so it cannot drift from the one
/// `from_dispatch` decodes.
pub fn ShellMsg::send(self : ShellMsg, ctx : &@tutuca.Ctx) -> Unit {
  let (name, args) = self.to_dispatch()
  ctx.send(name, args)
}

///|
/// The file-level style — pass as `common_style~`.
pub let shell_common_style : String = ""

///|
/// The `data-global` style — pass as `global_style~`.
pub let shell_global_style : String = ""

///|
/// What this component's schema declares, for `schema~`.
///
/// This is the only thing consulted for a field's KIND — there is no
/// inference off the init value behind it — and it is what an instance
/// answers `schema()` with, so a holder of a bare `@tutuca.Value`
/// can name these fields without a component registry.
impl @component.Fields for ShellState with fn schema() {
  @component.SchemaInfo::new(
    name="Shell",
    fingerprint="ebdf15daade43244",
    fields=[
      @component.FieldInfo::new("canvas", TyComp(None)),
      @component.FieldInfo::new("picker", TyComp(Some("ComponentPicker"))),
      @component.FieldInfo::new("editView", TyText),
      @component.FieldInfo::new("library", TyList(TyComp(Some("CardRow")))),
      @component.FieldInfo::new("source", TyText),
      @component.FieldInfo::new("notes", TyList(TyComp(Some("Note")))),
      @component.FieldInfo::new("pending", TyText),
      @component.FieldInfo::new("argument", TyText),
      @component.FieldInfo::new("status", TyText),
    ],
    view_handlers=[
      "clearCanvas", "compileSource", "loadAll", "loadChosen", "restore", "save",
      "toggleEdit", "typeSource",
    ],
    receives=[
      "openPicker", "pickerHits", "placeBuilt", "addNote", "setLibrary", "setStatus",
      "pumped",
    ],
    methods=["editLabel", "editing"],
    view_names=["main"],
  )
}
