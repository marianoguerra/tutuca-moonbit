                @anode.attr("class", "act-restore btn btn-sm btn-ghost"),
                @anode.eid(2),
              ],
              [@anode.text("restore")],
            ),
            @anode.text(" "),
            @anode.h(
              "button",
              [
                @anode.attr("class", "act-clear btn btn-sm btn-ghost"),
                @anode.eid(3),
              ],
              [@anode.text("clear")],
            ),
          ],
        ),
        @anode.text(" "),
        @anode.push_view(
          @tutuca.Expr::field("edit_view"),
          @anode.h(
            "main",
            [
              @anode.attr(
                "class", "canvas grow rounded border border-base-300 p-2",
              ),
            ],
            [@anode.render(2, @tutuca.Expr::field("canvas"))],
          ),
        ),
        @anode.text(" "),
        @anode.h(
          "section",
          [@anode.attr("class", "library flex flex-col gap-1")],
          [
            @anode.h("div", [@anode.attr("class", "flex items-center gap-2")], [
              @anode.h(
                "h2",
                [@anode.attr("class", "text-sm font-medium grow")],
                [@anode.text("library")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "act-load-chosen btn btn-xs"),
                  @anode.eid(4),
                ],
                [@anode.text("load selected")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "act-load-all btn btn-xs btn-ghost"),
                  @anode.eid(5),
                ],
                [@anode.text("load all")],
              ),
            ]),
            @anode.h("ul", [@anode.attr("class", "flex flex-col gap-1")], [
              @anode.each(
                4,
                @tutuca.Expr::field("library"),
                @anode.render_it(3),
                from_render_each=true,
              ),
            ]),
          ],
        ),
        @anode.h(
          "section",
          [@anode.attr("class", "paste flex flex-col gap-1")],
          [
            @anode.h("h2", [@anode.attr("class", "text-sm font-medium")], [
              @anode.text("write a card"),
            ]),
            @anode.text(" "),
            @anode.h(
              "textarea",
              [
                @anode.attr(
                  "class", "src textarea textarea-bordered w-full font-mono text-xs",
                ),
                @anode.attr("rows", "6"),
                @anode.attr("placeholder", "paste a card here"),
                @anode.dyn_attr("value", @tutuca.Expr::field("source")),
                @anode.eid(6),
              ],
              [],
            ),
            @anode.text(" "),
            @anode.h("div", [], [
              @anode.h(
                "button",
                [@anode.attr("class", "act-compile btn btn-sm"), @anode.eid(7)],
                [@anode.text("compile and add")],
              ),
            ]),
          ],
        ),
        @anode.text(" "),
        @anode.hide(
          @tutuca.Expr::app("empty?", [@tutuca.Expr::field("notes")]),
          @anode.h("ul", [@anode.attr("class", "notes flex flex-col gap-1")], [
            @anode.each(
              6,
              @tutuca.Expr::field("notes"),
              @anode.render_it(5),
              from_render_each=true,
            ),
          ]),
        ),
        @anode.text(" "),
        @anode.render(7, @tutuca.Expr::field("picker")),
      ],
    ),
    [
      [@anode.on("click", @tutuca.Expr::name("toggle_edit"))],
      [@anode.on("click", @tutuca.Expr::name("save"))],
      [@anode.on("click", @tutuca.Expr::name("restore"))],
      [@anode.on("click", @tutuca.Expr::name("clear_canvas"))],
      [@anode.on("click", @tutuca.Expr::name("load_chosen"))],
      [@anode.on("click", @tutuca.Expr::name("load_all"))],
      [
        @anode.on("input", @tutuca.Expr::name("type_source"), args=[
          @tutuca.Expr::event_path(["value"]),
        ]),
      ],
      [@anode.on("click", @tutuca.Expr::name("compile_source"))],
    ],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn shell_views() -> Map[String, @anode.View] {
  { "main": shell_main_view_ir() }
}

///|
/// The dispatches the file's `logic:` section answers.
///
/// Composed AHEAD of the author's `update~`, which stays optional and is
/// consulted only for a name this does not answer. GENERATED — edit the
/// block, not this.
fn shell_inline_update(
  s : ShellState,
  msg : @component.Dispatch,
  ctx : &@tutuca.Ctx,
) -> @component.Update[ShellState] {
  match msg {
    Receive("set_status", args) => {
      guard args.get(0) is Some(Str(s_)) else { return Unchanged }
      let s = { ..s, status: s_, }
      Next(s)
    }
    Receive("type_source", args) => {
      guard args.get(0) is Some(Str(s_)) else { return Unchanged }
      let s = { ..s, source: s_, }
      Next(s)
    }
    Receive("pumped", _args) => {
      let s = { ..s, pending: "", }
      let s = { ..s, argument: "", }
      Next(s)
    }
    Receive("toggle_edit", _args) => {
      let s = if shell_compute_editing(s, [], @tutuca.CtxStack(ctx)).is_truthy() {
        let s = { ..s, edit_view: "", }
        s
      } else {
        let s = { ..s, edit_view: "tutuca.dev/universal/Editable@1::editor", }
        s
      }
      Next(s)
    }
    Receive("compile_source", _args) => {
      let s = { ..s, pending: "compile", }
      let s = { ..s, argument: s.source, }
      Next(s)
    }
    Receive("load_all", _args) => {
      let s = { ..s, pending: "loadAll", }
      let s = { ..s, argument: "", }
      Next(s)
    }
    Receive("load_chosen", _args) => {
      let s = { ..s, pending: "loadChosen", }
      let s = { ..s, argument: "", }
      Next(s)
    }
    Receive("save", _args) => {
      let s = { ..s, pending: "save", }
      let s = { ..s, argument: "", }
      Next(s)
    }
    Receive("restore", _args) => {
      let s = { ..s, pending: "restore", }
      let s = { ..s, argument: "", }
      Next(s)
    }
    Receive("clear_canvas", _args) => {
      let s = { ..s, pending: "clear", }
      let s = { ..s, argument: "", }
      Next(s)
    }
    _ => Unhandled
  }
}

///|
/// `compute editing` from the `logic:` section. GENERATED — edit
/// the file, not this.
fn shell_compute_editing(
  s : ShellState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(!((Str(s.edit_view) : @tutuca.Value) == (Str("") : @tutuca.Value))) :
    @tutuca.Value)
}

///|
/// `compute edit_label` from the `logic:` section. GENERATED — edit
/// the file, not this.
fn shell_compute_edit_label(
  s : ShellState,
  _args : Array[@tutuca.Value],
  stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Str(
      if shell_compute_editing(s, [], stack).is_truthy() {
        "done"
      } else {
        "edit"
      },
    ) : @tutuca.Value)
}

///|
/// The `compute` names the file's `logic:` section answers.
/// GENERATED — edit the `logic:` section, not this.
fn shell_inline_compute() -> Map[
  String,
  (ShellState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value,
] {
  { "editing": shell_compute_editing, "edit_label": shell_compute_edit_label }
}

///|
/// The Shell component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `ShellState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn shell_component(
  name? : String = "Shell",
  views? : Map[String, @anode.View] = shell_views(),
  initial? : ShellState = ShellState::zero(),
  common_style? : String = shell_common_style,
  global_style? : String = shell_global_style,
  update? : (ShellState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    ShellState,
  ],
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    initial~,
    common_style~,
    global_style~,
    update=(s, msg, ctx) => {
      match shell_inline_update(s, msg, ctx) {
        Unhandled =>
          match update {
            Some(u) => u(s, msg, ctx)
            None => Unhandled
          }
        answered => answered
      }
    },
    compute=shell_inline_compute(),
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=picker_row_spec_source,
  )
}
