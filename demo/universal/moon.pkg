// The universal composition demo, on the real document.
//
// This is the half that cannot be driven headlessly: it compiles cards in the
// browser, instantiates them as `tgc` modules, and holds the registry the
// palette is a projection of. Everything above it — the picker, the keyboard,
// the cell memory, the pump — is `demo/universal/ui` and is tested on the
// in-memory DOM.
//
// The canvas holds NO host components. The layout kit is a loaded card and so
// is everything a person puts in it, which is the claim the demo exists to
// make: the palette cannot tell them apart because there is nothing to tell.
import {
  "marianoguerra/tutuca/app",
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/css",
  "marianoguerra/tutuca/transactor",
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/demo/universal/ui",
  "marianoguerra/tutuca/demo/universal/std",
  "marianoguerra/tutuca/compose/catalog",
  "marianoguerra/tutuca/compose",
  // The card compiler, as a LIBRARY in this bundle rather than a payload
  // fetched beside it. A card pasted into the page compiles here.
  "marianoguerra/tutuca/tgc/emit",
  "marianoguerra/tutuca/tgc/host",
  "marianoguerra/tutuca/tgc/policy",
  "marianoguerra/tutuca/tutucard/guest",
  "marianoguerra/tutuca/app/browser" @glue,
  "marianoguerra/tutuca/vdom/browser" @bdom,
  "mizchi/js_browser/dom",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/base64",
}

supported_targets = "js"

pkgtype(kind: "executable")
