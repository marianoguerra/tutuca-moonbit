// wasm-gc "dyncomp storybook" page: a gallery of every component every loaded
// bundle declares, once per configuration it declares. Drop a single
// `.tutuca.tar.gz` on it, or load one by URL, and its stories appear — there is
// no story list anywhere, because a bundle's manifest already declares its
// components and their named `inits`.
//
// The import list is the point of this package: the host is
// `dyncomp/storybook/wasm`, which is published, and this is the short
// executable around it — which bundles to offer, whether to fetch them at
// mount, and the export list. A wasm-gc export list is per-package `link`
// configuration and cannot come from a dependency, which is the whole reason a
// page is a package rather than a call.
//
// Build + assemble: moon run --target native cmd/dev -- dyncomp-storybook
import {
  "marianoguerra/tutuca/dyncomp/storybook/wasm" @sbw,
  // `LoaderBarSample` — one bundle to offer as a button, and the sample
  // `double` service both pages offer their guests
  "marianoguerra/tutuca/dyncomp/shell",
  "mizchi/js/core",
}

supported_targets = "wasm-gc"

pkgtype(kind: "executable")

options(
  link: {
    "wasm-gc": {
      "exports": [
        "mount",
        "on_event",
        "dyncomp_on_loaded",
        "dyncomp_on_load_error",
        "refresh_margaui",
        "state_json",
      ],
      "use-js-builtin-string": true,
    },
  },
)
