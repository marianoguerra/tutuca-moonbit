// wasm-gc host for the storybook gallery: it mounts the whole grouped gallery
// (storybook/ui) over the entire example registry as a single live app. Lint text for each pane comes
// from the CLI's check_component, injected as the mount() lint callback.
// Build: moon build --target wasm-gc demo/storybook_wasm
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/app",
  "marianoguerra/tutuca/app/wasm" @wglue,
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/css",
  "marianoguerra/tutuca/storybook" @sb,
  "marianoguerra/tutuca/storybook/ui" @sbui,
  "marianoguerra/tutuca/vdom",
  "marianoguerra/tutuca/vdom/wasm" @wdom,
  "mizchi/js/core",
}

supported_targets = "wasm-gc"

pkgtype(kind: "executable")

options(
  link: {
    "wasm-gc": {
      "exports": [
        // No dyncomp_on_* here: the gallery used to carry a second, smaller
        // shell for runtime bundle loading and no longer does — the universal
        // demo is the one page that hosts them. Its loader.mjs links no `tcomp`
        // either, which is what the loader split made possible.
        "mount",
        "on_event",
        "on_popstate",
        // The Fuzz tab's animation frame. An export rather than a callback for
        // the reason `on_event` is one: closures cannot cross into JS on
        // wasm-gc.
        "on_fuzz_tick",
        "refresh_margaui",
      ],
      "use-js-builtin-string": true,
    },
  },
)
