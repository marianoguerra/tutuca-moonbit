// wasm-gc PAGE for the storybook gallery: this repo's example registry, mounted
// through `storybook/ui/wasm`. Nothing but the export list and the story set —
// a downstream page is the same shape (`tutuca new-storybook`).
// Build: moon build --target wasm-gc demo/storybook_wasm
import {
  "marianoguerra/tutuca/storybook" @sb,
  // this repo's own story set + its curated section order; a downstream host
  // brings its own (see storybook/project.mbt)
  "marianoguerra/tutuca/storybook/examples" @ex,
  // the browser host: URL/theme services, the event bridge, margaui
  "marianoguerra/tutuca/storybook/ui/wasm" @sbw,
  // the standard tabs (Instance/Trace/Fuzz/Spec/Raw) and the page effects they
  // need; naming it is what links them
  "marianoguerra/tutuca/storybook/ui/panels/wasm" @panelsw,
  // @core.Any: the DOM event the exported on_event receives from JS
  "mizchi/js/core",
}

supported_targets = "wasm-gc"

pkgtype(kind: "executable")

options(
  link: {
    "wasm-gc": {
      "exports": [
        "mount",
        "on_event",
        "on_popstate",
        // The Fuzz tab's animation frame. An export rather than a callback for
        // the reason `on_event` is one: closures cannot cross into JS on
        // wasm-gc.
        "on_fuzz_tick",
        // The Trace tab's file read. Same reason as `on_fuzz_tick`: the
        // browser answers a read asynchronously and cannot be handed a
        // closure, so it calls back through an export.
        "on_file_text",
        "refresh_margaui",
      ],
      "use-js-builtin-string": true,
    },
  },
)
