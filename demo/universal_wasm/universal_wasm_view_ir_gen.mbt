}

///|
/// The UniversalWasm component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `UniversalWasmState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn universal_wasm_component(
  name? : String = "UniversalWasm",
  views? : Map[String, @anode.View] = universal_wasm_views(),
  init? : UniversalWasmState = UniversalWasmState::zero(),
  common_style? : String = universal_wasm_common_style,
  global_style? : String = universal_wasm_global_style,
  update? : (UniversalWasmState, @component.Dispatch, &@tutuca.Ctx) -> UniversalWasmState?,
  swap? : (UniversalWasmInput) -> ((
    UniversalWasmState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([LoadDropped, LoadSample] : Array[UniversalWasmInput]),
          UniversalWasmInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
  )
}
