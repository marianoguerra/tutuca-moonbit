// wasm-gc "universal" host page: a drag-and-drop loader for dynamic wasm
// tutuca components (dyncomp/DESIGN.md). Drop a single `.tutuca.tar.gz` (a
// gzipped tar of a guest's jco-transpiled bundle); the loader (loader.mjs)
// unpacks it with the native DecompressionStream, instantiates the
// `tutuca:component` guest, and the host mounts every component its manifest
// declares.
//
// The import list is the point of this package: the host is
// `dyncomp/ui/wasm`, which is published, and this is the ~90-line executable
// around it — which bundles to offer, whether to remember a session, one
// service to lend, and the export list. A wasm-gc export list is per-package
// `link` configuration and cannot come from a dependency, which is the whole
// reason a page is a package rather than a call.
//
// Build: moon build --target wasm-gc demo/universal_wasm
import {
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/dyncomp/ui/wasm" @uiw,
  // `LoaderBarSample` — one bundle to offer as a button. The bar is shared
  // with the storybook page, so its record lives beside it.
  "marianoguerra/tutuca/dyncomp/shell",
  "mizchi/js/core",
}

supported_targets = "wasm-gc"

pkgtype(kind: "executable")

options(
  link: {
    "wasm-gc": {
      "exports": [
        "mount",
        "on_event",
        "dyncomp_on_loaded",
        "dyncomp_on_load_error",
        "refresh_margaui",
        "state_json",
      ],
      "use-js-builtin-string": true,
    },
  },
)
