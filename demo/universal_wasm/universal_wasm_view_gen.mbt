/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through. That is the case a JSON round trip could not do at all: an
/// `Obj` or an `Fn` does not survive one.
impl @component.Fields for ComponentEntryState with fn encode(s) {
  { "module": Str(s.module_), "name": Str(s.name), "label": Str(s.label) }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
impl @component.Fields for ComponentEntryState with fn decode(f) {
  guard f.get("module") is Some(Str(v_module_)) else { return None }
  guard f.get("name") is Some(Str(v_name)) else { return None }
  guard f.get("label") is Some(Str(v_label)) else { return None }
  Some(ComponentEntryState::{ module_: v_module_, name: v_name, label: v_label })
}

///|
/// The views declared in universal_wasm.html.
pub(all) enum ComponentEntryView {
  Main
} derive(Eq, @debug.Debug)

///|
pub fn ComponentEntryView::name(self : ComponentEntryView) -> String {
  match self {
    Main => "main"
  }
}

///|
/// The file-level style — pass as `common_style~`.
pub let component_entry_common_style : String = ""

///|
/// The `data-global` style — pass as `global_style~`.
pub let component_entry_global_style : String = ""

///|
/// Every bare `@on` handler name the views reference.
pub(all) enum ComponentEntryInput {
  OnSelect
} derive(Eq, @debug.Debug)

///|
pub fn ComponentEntryInput::name(self : ComponentEntryInput) -> String {
  match self {
    OnSelect => "onSelect"
  }
}

///|
pub fn ComponentEntryInput::parse(s : String) -> ComponentEntryInput? {
  match s {
    "onSelect" => Some(OnSelect)
    _ => None
  }
}

///|
/// The Input arm of @component.Dispatch, decoded. Payload types are
/// inferred from the argument shapes written at the call sites, so a
/// handler added to universal_wasm.html breaks every `match` over this type
/// until it is handled.
pub(all) enum ComponentEntryMsg {
  /// `@on.click="onSelect …"`
  OnSelect
  /// An Input dispatch the views do not declare, or a declared name
  /// whose runtime arguments did not match the inferred shape.
  Unknown(String, Array[@tutuca.Value])
}

///|
/// None for Receive / Bubble / Response — those names are raised by
/// component code, never written in a view, so the views cannot type them.
pub fn ComponentEntryMsg::from_dispatch(
  d : @component.Dispatch,
) -> ComponentEntryMsg? {
  guard d is Input(name, args) else { return None }
  Some(
    match (name, args) {
      ("onSelect", []) => OnSelect
      _ => Unknown(name, args)
    },
  )
}

///|
/// Build `swap~` from an exhaustive match over the `@on` names the views raise.
/// Return None for a name another bucket serves, or one of the mutators
/// generated from the state's fields.
pub fn[S] component_entry_swap(
  f : (ComponentEntryInput) -> ((S, Array[@tutuca.Value], &@tutuca.Ctx) -> @tutuca.Value?)?,
) -> Map[String, (S, Array[@tutuca.Value], &@tutuca.Ctx) -> @tutuca.Value?] {
  let out : Map[
    String,
    (S, Array[@tutuca.Value], &@tutuca.Ctx) -> @tutuca.Value?,
  ] = Map([])
  for m in ([OnSelect] : Array[ComponentEntryInput]) {
    match f(m) {
      Some(h) => out[m.name()] = h
      None => ()
    }
  }
  out
}

