  // see the note on `App::new`, and `set_filter` for the way out.
  "marianoguerra/tutuca/vdom/filter/markdown" @mdfilter,
}

import {
  "marianoguerra/tutuca/vdom/memdom",
  "moonbitlang/core/json",
} for "test"
