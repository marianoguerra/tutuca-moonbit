// Pure half of the `skill-embed` task: turn the skill/tutuca/ file tree into
// a generated MoonBit source (cli/skill_assets_gen.mbt) embedding every file
// as a string constant — the bundled-assets story that unblocks the native
// CLI's `install-skill` (a binary has no package dir to copy from).
// cmd/dev walks + reads the files and hands
// them here; this builds the source text.

///|
/// Escape a file's contents as a MoonBit double-quoted string literal.
/// Escaping `\` first also neutralizes `\{` interpolation.
fn escape_mbt_string(s : String) -> String {
  let buf = StringBuilder()
  for c in s {
    match c {
      '\\' => buf.write_string("\\\\")
      '"' => buf.write_string("\\\"")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      _ => buf.write_char(c)
    }
  }
  buf.to_string()
}

///|
/// A generated assets module: one `pub let <var> : Array[(String, String)]`
/// holding every (path, contents) pair, in walk order.
///
/// Three callers, one shape — `skill-embed` (the Claude-Code skill, written
/// out by `install-skill`) and `storybook-template-embed` (a gallery
/// project, written out by `new-storybook`). A binary has no package directory
/// to copy from, so anything the CLI hands a user has to be compiled into it.
pub fn assets_source(
  files : Array[(String, String)],
  var_~ : String,
  banner~ : String,
) -> String {
  let sb = StringBuilder()
  sb.write_string(banner)
  sb.write_string("\n///|\npub let \{var_} : Array[(String, String)] = [\n")
  for pair in files {
    let (path, contents) = pair
    sb.write_string("  (\"")
    sb.write_string(escape_mbt_string(path))
    sb.write_string("\", \"")
    sb.write_string(escape_mbt_string(contents))
    sb.write_string("\"),\n")
  }
  sb.write_string("]\n")
  sb.to_string()
}

///|
/// The generated cli/skill_assets_gen.mbt contents. `files` are
/// (path-relative-to-skill/tutuca, contents) pairs, in walk order.
pub fn skill_assets_source(files : Array[(String, String)]) -> String {
  assets_source(
    files,
    var_="skill_files",
    banner=(
      #|// GENERATED by `moon run --target native cmd/dev -- skill-embed` from
      #|// skill/tutuca/ — DO NOT EDIT. Embeds the tutuca Claude-Code skill in
      #|// the CLI so the native `install-skill` command can write it out.
    ),
  )
}

///|
/// The generated cli/storybook_template_gen.mbt contents. `files` are
/// (path-relative-to-the-new-project-directory, contents) pairs, in walk order,
/// still carrying their `{{name}}` / `{{tutuca_version}}` placeholders —
/// substitution is `new-storybook`'s job, so one embed serves every project.
pub fn storybook_template_source(files : Array[(String, String)]) -> String {
  assets_source(
    files,
    var_="storybook_template_files",
    banner=(
      #|// GENERATED by `moon run --target native cmd/dev -- storybook-template-embed`
      #|// — DO NOT EDIT. Embeds a whole gallery project in the CLI so
      #|// `tutuca new-storybook` can write one out.
      #|//
      #|// Assembled from storybook/template/, whose `page/counter.html` is in the
      #|// repo's `gen` sweep — so the generated view module the template
      #|// hands out cannot drift from the generator that would rewrite it.
    ),
  )
}
