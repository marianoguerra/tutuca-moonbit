  title : String
  /// "view" | "form"
  mode : String
  /// The live instance, when it renders its own config view. It is MOVED
  /// here rather than copied: an instance rendered in two places has one
  /// of them holding a dead handle after the first interaction.
  target : @tutuca.Value
  form : @tutuca.Value
}

