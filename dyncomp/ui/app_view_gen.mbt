    error: "",
    submitLabel: "",
  }
}

///|
/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through. That is the case a JSON round trip could not do at all: an
/// `Obj` or an `Fn` does not survive one.
impl @component.Fields for SchemaFormState with fn encode(s) {
  {
    "module": Str(s.module_),
    "name": Str(s.name),
    "title": Str(s.title),
    "doc": Str(s.doc),
    "fields": (List(s.fields.map(x => x)) : @tutuca.Value),
    "inits": (List(s.inits.map(x => x)) : @tutuca.Value),
    "error": Str(s.error),
    "submitLabel": Str(s.submitLabel),
  }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
impl @component.Fields for SchemaFormState with fn decode(f) {
  guard f.get("module") is Some(Str(v_module_)) else { return None }
  guard f.get("name") is Some(Str(v_name)) else { return None }
  guard f.get("title") is Some(Str(v_title)) else { return None }
  guard f.get("doc") is Some(Str(v_doc)) else { return None }
  guard f.get("fields") is Some(t1_fields) else { return None }
  guard t1_fields is List(u1_fields) else { return None }
  let v_fields : Array[@tutuca.Value] = []
  for e1_fields in u1_fields {
    let x1_fields = e1_fields
    v_fields.push(x1_fields)
  }
  guard f.get("inits") is Some(t1_inits) else { return None }
  guard t1_inits is List(u1_inits) else { return None }
  let v_inits : Array[@tutuca.Value] = []
  for e1_inits in u1_inits {
    let x1_inits = e1_inits
    v_inits.push(x1_inits)
  }
  guard f.get("error") is Some(Str(v_error)) else { return None }
  guard f.get("submitLabel") is Some(Str(v_submitLabel)) else { return None }
  Some({
    module_: v_module_,
    name: v_name,
    title: v_title,
    doc: v_doc,
    fields: v_fields,
    inits: v_inits,
    error: v_error,
    submitLabel: v_submitLabel,
  })
}

