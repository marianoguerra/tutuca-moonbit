                  @anode.eid(0),
                ],
                [@anode.dyn_text(BindMember(name="value", prop="label"))],
              ),
            ),
          ],
        ),
      ),
      @anode.text(" "),
      @anode.each(
        2,
        Field("fields"),
        @anode.render_it(1),
        from_render_each=true,
      ),
      @anode.text(" "),
      @anode.show(
        App(name="truthy?", args=[Field("error")]),
        @anode.h("p", [@anode.attr("class", "text-error text-xs form-error")], [
          @anode.dyn_text(Field("error")),
        ]),
