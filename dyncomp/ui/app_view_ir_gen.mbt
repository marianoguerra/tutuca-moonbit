    global_style~,
    update?,
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([Close] : Array[ConfigPanelInput]),
          ConfigPanelInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
  )
}

///|
/// The compiled `main` view.
fn universal_app_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "div",
      [
        @anode.attr(
          "class", "universal-app min-h-screen flex flex-col bg-base-200 text-base-content",
        ),
        @anode.attr("data-droptarget", "tutuca-host-drop"),
        @anode.eid(2),
      ],
      [
        @anode.h(
          "header",
          [
            @anode.attr(
              "class", "app-bar flex items-center gap-2 px-3 py-1 border-b border-base-300 bg-base-100",
            ),
          ],
          [
            @anode.h(
              "span",
              [
                @anode.attr(
                  "class", "config-pill badge badge-sm badge-outline cursor-grab select-none",
                ),
                @anode.attr("draggable", "true"),
                @anode.attr("data-dragtype", "config-pill"),
              ],
              [@anode.text("config")],
            ),
            @anode.text(" "),
            @anode.h(
              "button",
              [@anode.attr("class", "btn btn-xs open-command"), @anode.eid(0)],
              [@anode.text("+ add…")],
            ),
            @anode.text(" "),
            @anode.h(
              "button",
              [
                @anode.attr("class", "btn btn-xs btn-ghost toggle-mode"),
                @anode.eid(1),
              ],
              [@anode.dyn_text(Method("modeLabel"))],
            ),
            @anode.text(" "),
            @anode.render(0, Field("devTools")),
            @anode.text(" "),
            @anode.h(
              "span",
              [@anode.attr("class", "text-sm opacity-70 grow app-status")],
              [@anode.dyn_text(Field("status"))],
            ),
          ],
        ),
        @anode.h("div", [@anode.attr("class", "flex grow min-h-0")], [
          @anode.push_view(
            Field("mode"),
            @anode.h(
              "div",
              [@anode.attr("class", "grow app-canvas overflow-auto p-4")],
              [@anode.render(1, Field("root"))],
            ),
          ),
          @anode.text(" "),
          @anode.render(2, Field("configPanel")),
        ]),
        @anode.text(" "),
        @anode.render(3, Field("commandBar")),
      ],
    ),
    [
      [@anode.on("click", HandlerName(name="openCommand", ns=Input))],
      [@anode.on("click", HandlerName(name="toggleMode", ns=Input))],
      [
        @anode.on("drop", HandlerName(name="filesDropped", ns=Input), args=[
          Name("value"),
        ]),
      ],
    ],
  )
}

///|
/// The component's views, already compiled — pass as `views~` to
/// @component.component.
pub fn universal_app_views() -> Map[String, @anode.View] {
  { "main": universal_app_main_view_ir() }
}

///|
/// The UniversalApp component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `UniversalAppState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn universal_app_component(
  name? : String = "UniversalApp",
  views? : Map[String, @anode.View] = universal_app_views(),
  init? : UniversalAppState = UniversalAppState::zero(),
  common_style? : String = universal_app_common_style,
  global_style? : String = universal_app_global_style,
  update? : (UniversalAppState, @component.Dispatch, &@tutuca.Ctx) -> UniversalAppState?,
  compute? : (UniversalAppMethod) -> ((UniversalAppState, Array[@tutuca.Value]) -> @tutuca.Value)?,
  swap? : (UniversalAppInput) -> ((
    UniversalAppState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    compute=match compute {
      Some(f) =>
        @component.build_bucket(
          ([ModeLabel] : Array[UniversalAppMethod]),
          UniversalAppMethod::name,
          f,
        )
      None => Map([])
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([FilesDropped, OpenCommand, ToggleMode] : Array[UniversalAppInput]),
          UniversalAppInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
  )
}
