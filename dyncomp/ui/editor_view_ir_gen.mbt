///|
/// The compiled `main` view.
fn component_palette_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "div",
      [@anode.attr("class", "component-palette flex flex-col gap-2")],
      [
        @anode.h(
          "input",
          [
            @anode.attr("type", "search"),
            @anode.attr("class", "input input-sm input-bordered palette-search"),
            @anode.attr("placeholder", "search components…"),
            @anode.dyn_attr("value", Field("query")),
            @anode.eid(0),
          ],
          [],
        ),
        @anode.text(" "),
        @anode.h(
          "ul",
          [
            @anode.attr(
              "class", "flex flex-col gap-1 max-h-96 overflow-y-auto palette-hits",
            ),
          ],
          [
            @anode.each(
              1,
              Field("hits"),
              @anode.render_it(0),
              from_render_each=true,
            ),
          ],
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=IsEmpty, args=[Field("hits")]),
          @anode.h(
            "p",
            [@anode.attr("class", "text-xs opacity-50 italic palette-empty")],
            [@anode.dyn_text(Field("emptyMessage"))],
          ),
        ),
      ],
    ),
    [
      [
        @anode.on("input", HandlerName(name="setQuery", ns=Input), args=[
          Name("value"),
        ]),
      ],
    ],
  )
}

