}

///|
/// The compiled `main` view.
fn schema_field_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "label",
      [@anode.attr("class", "schema-field flex flex-col gap-0.5")],
      [
        @anode.h("span", [@anode.attr("class", "flex items-baseline gap-2")], [
          @anode.h(
            "span",
            [@anode.attr("class", "font-mono text-xs field-name")],
            [@anode.dyn_text(Field("name"))],
          ),
          @anode.text(" "),
          @anode.show(
            Field("required"),
            @anode.h(
              "span",
              [@anode.attr("class", "text-error text-xs field-required")],
              [@anode.text("*")],
            ),
          ),
          @anode.text(" "),
          @anode.h(
            "span",
            [@anode.attr("class", "text-[0.65rem] opacity-40 field-hint")],
            [@anode.dyn_text(Field("hint"))],
          ),
        ]),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=IsTruthy, args=[Field("doc")]),
          @anode.h(
            "span",
            [@anode.attr("class", "text-[0.65rem] opacity-60 field-doc")],
            [@anode.dyn_text(Field("doc"))],
          ),
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=Equals, args=[Field("kind"), @anode.const_str("bool")]),
          @anode.h(
            "input",
            [
              @anode.attr("type", "checkbox"),
              @anode.attr("class", "checkbox checkbox-xs field-bool"),
              @anode.dyn_attr("checked", Field("flag")),
              @anode.eid(0),
            ],
            [],
          ),
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=Equals, args=[
            Field("kind"),
            @anode.const_str("number"),
          ]),
          @anode.h(
            "input",
            [
              @anode.attr("type", "number"),
              @anode.attr("class", "input input-xs input-bordered field-number"),
              @anode.dyn_attr("value", Field("num")),
              @anode.eid(1),
            ],
            [],
          ),
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=Equals, args=[
            Field("kind"),
            @anode.const_str("string"),
          ]),
          @anode.h(
            "input",
            [
              @anode.attr("type", "text"),
              @anode.attr("class", "input input-xs input-bordered field-string"),
              @anode.dyn_attr("value", Field("text")),
              @anode.eid(2),
            ],
            [],
          ),
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=Equals, args=[Field("kind"), @anode.const_str("enum")]),
          @anode.h(
            "select",
            [
              @anode.attr(
                "class", "select select-xs select-bordered field-enum",
              ),
              @anode.eid(3),
            ],
            [
              @anode.each(
                0,
                Field("choices"),
                @anode.h("option", [@anode.dyn_attr("value", Bind("value"))], [
                  @anode.dyn_text(Bind("value")),
                ]),
              ),
            ],
          ),
        ),
        @anode.text(" "),
        @anode.comment(
          " A compound the vocabulary has no control for is edited as JSON. That\n       is honest rather than lazy: a list-of-records editor is a real feature\n       and drawing three text boxes would be pretending to be one. ",
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=Equals, args=[Field("kind"), @anode.const_str("json")]),
          @anode.h(
            "textarea",
            [
              @anode.attr(
                "class", "textarea textarea-xs textarea-bordered font-mono field-json",
              ),
              @anode.attr("rows", "2"),
              @anode.dyn_attr("value", Field("text")),
              @anode.eid(4),
            ],
            [],
          ),
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=IsTruthy, args=[Field("error")]),
          @anode.h(
            "span",
            [@anode.attr("class", "text-error text-[0.65rem] field-error")],
            [@anode.dyn_text(Field("error"))],
          ),
        ),
      ],
    ),
    [
      [
        @anode.on("input", HandlerName(name="edit", ns=Input), args=[
          Name("value"),
        ]),
      ],
      [
        @anode.on("input", HandlerName(name="edit", ns=Input), args=[
          Name("value"),
        ]),
      ],
      [
        @anode.on("input", HandlerName(name="edit", ns=Input), args=[
          Name("value"),
        ]),
      ],
      [
        @anode.on("input", HandlerName(name="edit", ns=Input), args=[
          Name("value"),
        ]),
      ],
      [
        @anode.on("input", HandlerName(name="edit", ns=Input), args=[
          Name("value"),
        ]),
      ],
    ],
  )
}

///|
