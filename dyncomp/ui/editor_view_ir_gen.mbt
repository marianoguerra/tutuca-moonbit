///|
/// The compiled `main` view.
fn surface_editor_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "div",
      [@anode.attr("class", "surface-editor flex gap-4 items-start")],
      [
        @anode.h(
          "div",
          [
            @anode.attr(
              "class", "flex flex-col gap-2 w-72 shrink-0 editor-side",
            ),
          ],
          [
            @anode.h(
              "div",
              [@anode.attr("class", "flex gap-1 flex-wrap editor-add")],
              [
                @anode.h(
                  "button",
                  [@anode.attr("class", "btn btn-xs add-stack"), @anode.eid(0)],
                  [@anode.text("+ stack")],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [@anode.attr("class", "btn btn-xs add-grid"), @anode.eid(1)],
                  [@anode.text("+ grid")],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [@anode.attr("class", "btn btn-xs add-box"), @anode.eid(2)],
                  [@anode.text("+ box")],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [@anode.attr("class", "btn btn-xs add-slot"), @anode.eid(3)],
                  [@anode.text("+ slot")],
                ),
                @anode.text(" "),
                @anode.h(
                  "button",
                  [
                    @anode.attr(
                      "class", "btn btn-xs btn-error btn-outline remove-node",
                    ),
                    @anode.eid(4),
                  ],
                  [@anode.text("remove")],
                ),
              ],
            ),
            @anode.text(" "),
            @anode.render(0, Field("settings")),
            @anode.text(" "),
            @anode.render(1, Field("palette")),
            @anode.text(" "),
            @anode.render(2, Field("form")),
            @anode.text(" "),
            @anode.h("div", [@anode.attr("class", "flex gap-1")], [
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-xs btn-ghost do-export"),
                  @anode.eid(5),
                ],
                [@anode.text("export")],
              ),
              @anode.text(" "),
              @anode.h(
                "button",
                [
                  @anode.attr("class", "btn btn-xs btn-ghost do-import"),
                  @anode.eid(6),
                ],
                [@anode.text("import")],
              ),
            ]),
            @anode.text(" "),
            @anode.comment(
              " Always visible: pasting a document to import should not require\n         exporting one first, and an empty box is its own invitation. ",
            ),
            @anode.text(" "),
            @anode.h(
              "textarea",
              [
                @anode.attr(
                  "class", "textarea textarea-xs textarea-bordered font-mono editor-transfer",
                ),
                @anode.attr("rows", "6"),
                @anode.attr(
                  "placeholder", "paste a surface document to import…",
                ),
                @anode.dyn_attr("value", Field("transfer")),
                @anode.eid(7),
              ],
              [],
            ),
            @anode.text(" "),
            @anode.h(
              "p",
              [@anode.attr("class", "text-xs opacity-70 editor-status")],
              [@anode.dyn_text(Field("status"))],
            ),
          ],
        ),
        @anode.h(
          "div",
          [
            @anode.attr(
              "class", "grow editor-canvas border border-dashed border-base-300 rounded p-4 min-h-48",
            ),
          ],
          [@anode.render(3, Field("tree"))],
        ),
      ],
    ),
    [
      [@anode.on("click", HandlerName(name="addStack", ns=Input))],
      [@anode.on("click", HandlerName(name="addGrid", ns=Input))],
      [@anode.on("click", HandlerName(name="addBox", ns=Input))],
      [@anode.on("click", HandlerName(name="addSlot", ns=Input))],
      [@anode.on("click", HandlerName(name="removeNode", ns=Input))],
      [@anode.on("click", HandlerName(name="exportDoc", ns=Input))],
      [@anode.on("click", HandlerName(name="importDoc", ns=Input))],
      [
        @anode.on("input", HandlerName(name="setTransfer", ns=Input), args=[
          Name("value"),
        ]),
      ],
    ],
  )
}

