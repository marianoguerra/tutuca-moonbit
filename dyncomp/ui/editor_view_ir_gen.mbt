///|
/// The SchemaField component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `SchemaFieldState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn schema_field_component(
  name? : String = "SchemaField",
  views? : Map[String, @anode.View] = schema_field_views(),
  init? : SchemaFieldState = SchemaFieldState::zero(),
  common_style? : String = schema_field_common_style,
  global_style? : String = schema_field_global_style,
  update? : (SchemaFieldState, @component.Dispatch, &@tutuca.Ctx) -> SchemaFieldState?,
  swap? : (SchemaFieldInput) -> ((
    SchemaFieldState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([Edit] : Array[SchemaFieldInput]),
          SchemaFieldInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
  )
}

///|
/// The compiled `main` view.
fn schema_form_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "div",
      [@anode.attr("class", "schema-form flex flex-col gap-2 p-2")],
      [
        @anode.h(
          "div",
          [@anode.attr("class", "font-mono text-sm font-semibold form-title")],
          [@anode.dyn_text(Field("title"))],
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=IsTruthy, args=[Field("doc")]),
          @anode.h("p", [@anode.attr("class", "text-xs opacity-70 form-doc")], [
            @anode.dyn_text(Field("doc")),
          ]),
        ),
        @anode.text(" "),
        @anode.comment(
          " A component's named fixtures, offered beside the bare constructor: the\n       guest said when to prefer each one, so the form says so too. ",
        ),
        @anode.text(" "),
        @anode.hide(
          Predicate(pred=IsEmpty, args=[Field("inits")]),
          @anode.h(
            "div",
            [@anode.attr("class", "flex gap-1 flex-wrap form-inits")],
            [
              @anode.each(
                0,
                Field("inits"),
                @anode.h(
                  "button",
                  [
                    @anode.attr("class", "btn btn-xs btn-outline form-init"),
                    @anode.eid(0),
                  ],
                  [@anode.dyn_text(BindMember(name="value", prop="label"))],
                ),
              ),
            ],
          ),
        ),
        @anode.text(" "),
        @anode.each(
          2,
          Field("fields"),
          @anode.render_it(1),
          from_render_each=true,
        ),
        @anode.text(" "),
        @anode.show(
          Predicate(pred=IsTruthy, args=[Field("error")]),
          @anode.h(
            "p",
            [@anode.attr("class", "text-error text-xs form-error")],
            [@anode.dyn_text(Field("error"))],
          ),
        ),
        @anode.text(" "),
        @anode.h("div", [@anode.attr("class", "flex gap-2")], [
          @anode.h(
            "button",
            [
              @anode.attr("class", "btn btn-sm btn-primary form-create"),
              @anode.eid(1),
            ],
            [@anode.text("Place")],
          ),
          @anode.text(" "),
          @anode.h(
            "button",
            [
              @anode.attr("class", "btn btn-sm btn-ghost form-cancel"),
              @anode.eid(2),
            ],
            [@anode.text("Cancel")],
          ),
        ]),
      ],
    ),
    [
      [
        @anode.on("click", HandlerName(name="useInit", ns=Input), args=[
          BindMember(name="value", prop="name"),
        ]),
      ],
      [@anode.on("click", HandlerName(name="create", ns=Input))],
      [@anode.on("click", HandlerName(name="cancel", ns=Input))],
    ],
  )
}

