// The standard components: what the universal UI can always place.
//
// Ordinary tutuca components, authored the normal way (`std.html` through
// `gen-views`), and that is the whole point. To a person searching the catalog
// and to a guest asking for a placeholder, a standard component and a loaded
// one are the same kind of thing — the catalog ranks them together, the same
// generated form configures them, and the same `<x render>` draws them.
//
// Only `Universal` MUST exist: it is the one component the app's root starts
// as, the one a container's children always are, and the one a guest asks for
// when it wants to offer a hole in its own layout. Everything else here is
// convenience, and a bundle that shipped a better stack would be no different
// in kind from this one.
//
// Deliberately BACKEND-AGNOSTIC and free of any dyncomp dependency: nothing
// here knows what a bundle is, so `moon test` drives the whole set on the
// in-memory DOM.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/anode",
  // the generated *_view_gen.mbt modules derive @debug.Debug on their
  // vocabulary enums
  "moonbitlang/core/debug",
}

import {
  "marianoguerra/tutuca/testing/harness",
  "marianoguerra/tutuca/render",
  "moonbitlang/core/test",
} for "test"
