pub fn tabs_component(
  name? : String = "Tabs",
  views? : Map[String, @anode.View] = tabs_views(),
  init? : TabsState = TabsState::zero(),
  common_style? : String = tabs_common_style,
  global_style? : String = tabs_global_style,
  update? : (TabsState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    TabsState,
  ],
  swap? : (TabsInput) -> ((TabsState, Array[@tutuca.Value], &@tutuca.Ctx) -> @tutuca.Value?)?,
  when? : (TabsWhen) -> ((
    TabsState,
    @tutuca.Value,
    @tutuca.Value,
    @tutuca.Value,
    &@tutuca.Stack,
  ) -> Bool)?,
  enrich? : (TabsEnrich) -> ((
    TabsState,
    Map[String, @tutuca.Value],
    @tutuca.Value,
    @tutuca.Value,
    @tutuca.Value,
    &@tutuca.Stack,
  ) -> Unit)?,
  slots? : Map[String, String] = Map([]),
