      Some(f) =>
        @component.build_bucket(
          ([Activate, AddTab, CloseActive] : Array[TabsInput]),
          TabsInput::name,
          f,
        )
      None => Map([])
    },
    when=match when {
      Some(f) =>
        @component.build_bucket(
          ([IsActivePage] : Array[TabsWhen]),
          TabsWhen::name,
          f,
        )
      None => Map([])
    },
    enrich=match enrich {
      Some(f) =>
        @component.build_bucket(
          ([MarkActive] : Array[TabsEnrich]),
          TabsEnrich::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=universal_spec_source,
