///|
/// A tab strip and one page at a time. `tabs` are TabPages.
///
/// Declared as `state` in the state block. Adding a field there adds it
/// here, so a view that reads it type-checks and one that reads a name
/// this struct lacks fails generation.
pub(all) struct TabsState {
  tabs : Array[@tutuca.Value]
  active : Int
  /// Whether the active tab's NAME is being edited, in place on the strip.
  /// 
  /// Only the active one can be: ctrl/cmd-clicking a tab both selects it
  /// and starts the edit, so "which tab is being renamed" is never a
  /// second answer to "which tab is open".
  renaming : Bool
  /// The name it had when the edit started, so Escape can put it back.
  /// Typing writes straight through to the tab, because a name you cannot
  /// see change while you type it is a name you have to guess at.
  original : String
}

///|
/// The zero state: every field at its type's empty value.
///
/// The state block declares no defaults — a default is a value, not a
/// type — so this
/// is type-directed, and `init` spreads it to name only what differs:
///
///   initial={ ..TabsState::zero(), label: "Counter" }
pub fn TabsState::zero() -> TabsState {
  { tabs: [], active: 0, renaming: false, original: "", }
}

///|
/// The state as the fields map the render and path layers read, built
/// field by field rather than through a `Json` round trip.
///
/// A field that already holds a `@tutuca.Value` is passed straight
/// through. That is the case a JSON round trip could not do at all: an
/// `Obj` or an `Fn` does not survive one.
impl @component.Fields for TabsState with fn encode(s) {
  {
    "tabs": (List(s.tabs.map(x => x)) : @tutuca.Value),
    "active": Num(s.active.to_double()),
    "renaming": Bool(s.renaming),
    "original": Str(s.original),
  }
}

///|
/// The fields map back into the state. None on a shape mismatch, which
/// callers treat as a no-op write — the same contract as the JSON path.
impl @component.Fields for TabsState with fn decode(f) {
  guard f.get("tabs") is Some(t1_tabs) else { return None }
  guard t1_tabs is List(u1_tabs) else { return None }
  let v_tabs : Array[@tutuca.Value] = []
  for e1_tabs in u1_tabs {
    let x1_tabs = e1_tabs
    v_tabs.push(x1_tabs)
  }
  guard f.get("active") is Some(Num(t1_active)) else { return None }
  let v_active = t1_active.to_int()
  guard f.get("renaming") is Some(Bool(v_renaming)) else { return None }
  guard f.get("original") is Some(Str(v_original)) else { return None }
  Some({
    tabs: v_tabs,
    active: v_active,
    renaming: v_renaming,
    original: v_original,
  })
}

