///|
/// The Input arm of @component.Dispatch, decoded. Payload types are
/// inferred from the argument shapes written at the call sites, so a
/// handler added to editor.html breaks every `match` over this type
/// until it is handled.
pub(all) enum SurfaceEditorMsg {
  /// `@on.click="addBox …"`
  AddBox
  /// `@on.click="addGrid …"`
  AddGrid
  /// `@on.click="addSlot …"`
  AddSlot
  /// `@on.click="addStack …"`
  AddStack
  /// `@on.click="exportDoc …"`
  ExportDoc
  /// `@on.click="importDoc …"`
  ImportDoc
  /// `@on.click="removeNode …"`
  RemoveNode
  /// `@on.input="setTransfer …"`
  SetTransfer(String)
  /// An Input dispatch the views do not declare, or a declared name
  /// whose runtime arguments did not match the inferred shape.
  Unknown(String, Array[@tutuca.Value])
}

///|
/// None for Receive / Bubble / Response — those names are raised by
/// component code, never written in a view, so the views cannot type them.
pub fn SurfaceEditorMsg::from_dispatch(
  d : @component.Dispatch,
) -> SurfaceEditorMsg? {
  guard d is Input(name, args) else { return None }
  Some(
    match (name, args) {
      ("addBox", []) => AddBox
      ("addGrid", []) => AddGrid
      ("addSlot", []) => AddSlot
      ("addStack", []) => AddStack
      ("exportDoc", []) => ExportDoc
      ("importDoc", []) => ImportDoc
      ("removeNode", []) => RemoveNode
      ("setTransfer", [Str(a0)]) => SetTransfer(a0)
      _ => Unknown(name, args)
    },
  )
}

///|
/// What this component's schema declares, for `schema~`.
///
/// This is the only thing consulted for a field's KIND — there is no
/// inference off the init value behind it — and it is what an instance
/// answers `obj_schema()` with, so a holder of a bare `@tutuca.Value`
/// can name these fields without a component registry.
impl @component.Fields for SurfaceEditorState with fn schema() {
  @component.SchemaInfo::new(
    name="SurfaceEditor",
    fingerprint="0b95774e12c3bb51",
    fields=[
      @component.FieldInfo::new("doc", TyAny),
      @component.FieldInfo::new("tree", TyComp(None)),
      @component.FieldInfo::new("selected", TyText),
      @component.FieldInfo::new("palette", TyComp(None)),
      @component.FieldInfo::new("settings", TyComp(None)),
      @component.FieldInfo::new("form", TyComp(None)),
      @component.FieldInfo::new("status", TyText),
      @component.FieldInfo::new("transfer", TyText),
      @component.FieldInfo::new("showTransfer", TyBool),
    ],
    inputs=[
      "addBox", "addGrid", "addSlot", "addStack", "exportDoc", "importDoc", "removeNode",
      "setTransfer",
    ],
    receives=["catalogChanged", "restoreSession"],
    view_names=["main"],
  )
}
