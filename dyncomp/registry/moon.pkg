// The catalog: every component every loaded bundle declares, and search over
// it.
//
// This is what v3 of the contract was for. Before it a component was a name
// with handlers hanging off it, so a palette could list names and nothing
// could RANK them — and a language model choosing between forty components it
// has never seen needs exactly the ranking a name cannot support.
//
// It sits above `dyncomp/host` (which owns loading and the live instances) and
// beside `dyncomp/jsonschema` (which owns the projection), and holds neither:
// a Descriptor is a description, and asking for one never touches a guest.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/dyncomp/host" @dyncomp,
  "marianoguerra/tutuca/dyncomp/jsonschema",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
}

import {
  "marianoguerra/tutuca/component",
  "moonbitlang/core/test",
} for "test"
