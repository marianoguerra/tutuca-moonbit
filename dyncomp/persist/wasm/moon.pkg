// The browser half of dyncomp/persist: a `Store` over localStorage.
//
// Separate package because it is the only part that cannot run anywhere else —
// `dyncomp/persist` is backend-agnostic and tested on a Map, and this is four
// FFI calls that make the same trait talk to a real browser. Check:
// moon check --target wasm-gc dyncomp/persist/wasm
import {
  "marianoguerra/tutuca/dyncomp/persist",
  "moonbitlang/core/json",
}

supported_targets = "wasm-gc"
