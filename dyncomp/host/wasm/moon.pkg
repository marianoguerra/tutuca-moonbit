// wasm-gc bridge for dyncomp/host: implements &Guest over the `tcomp` import
// namespace (served by the demo loader's createTcompImports) and provides the
// load/on_loaded lifecycle glue. Values cross the JS boundary as JSON strings
// (the bridge keeps a JS-side arena for the guest's `values` imports, so the
// host never sees arena handles). Check: moon check --target wasm-gc dyncomp/host/wasm
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/dyncomp/host" @dyncomp,
  // the catalog this glue keeps in sync as bundles load and hot-swap
  "marianoguerra/tutuca/dyncomp/registry",
  // snapshots of loaded instances, for a page that stores them
  "marianoguerra/tutuca/dyncomp/persist",
  // what this page will accept from a bundle; the page chooses it, and until
  // it does every bundle is registered as untrusted
  "marianoguerra/tutuca/dyncomp/policy",
  "marianoguerra/tutuca/app",
  "marianoguerra/tutuca/app/wasm" @wglue,
  "marianoguerra/tutuca/vdom/wasm" @wdom,
  // the render-time half of the sanitizer: an attribute's VALUE is a `Val` at
  // registration, so the URL rule cannot run where the policy does
  "marianoguerra/tutuca/vdom/filter",
  "mizchi/js/core",
  "moonbitlang/core/json",
  // a guest's persisted bytes cross this bridge as base64 text
  "moonbitlang/core/encoding/base64",
}

supported_targets = "wasm-gc"
