///|
/// The DyncompStorybook component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `DyncompStorybookState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn dyncomp_storybook_component(
  name? : String = "DyncompStorybook",
  views? : Map[String, @anode.View] = dyncomp_storybook_views(),
  init? : DyncompStorybookState = DyncompStorybookState::zero(),
  common_style? : String = dyncomp_storybook_common_style,
  global_style? : String = dyncomp_storybook_global_style,
  update? : (DyncompStorybookState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    DyncompStorybookState,
  ],
  compute? : (DyncompStorybookMethod) -> ((
    DyncompStorybookState,
    Array[@tutuca.Value],
  ) -> @tutuca.Value)?,
  swap? : (DyncompStorybookInput) -> ((
    DyncompStorybookState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  when? : (DyncompStorybookWhen) -> ((
    DyncompStorybookState,
    @tutuca.Value,
    @tutuca.Value,
    @tutuca.Value,
  ) -> Bool)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Map[String, @component.LookupSpec] = Map([]),
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    compute=match compute {
      Some(f) =>
        @component.build_bucket(
          ([DetailsLabel, IsEmpty, LayoutLabel] : Array[DyncompStorybookMethod]),
          DyncompStorybookMethod::name,
          f,
        )
      None => Map([])
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          (
            [
              ChooseTheme,
              FilesDropped,
              SetQuery,
              ShowAll,
              ToggleDetails,
              ToggleWide,
            ] : Array[DyncompStorybookInput]),
          DyncompStorybookInput::name,
          f,
        )
      None => Map([])
    },
    when=match when {
      Some(f) =>
        @component.build_bucket(
          ([Matches] : Array[DyncompStorybookWhen]),
          DyncompStorybookWhen::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
  )
}
