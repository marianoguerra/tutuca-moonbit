///|
/// `invariant aCardShowsSomething` from the `<script type="tutuca/spec">` block. GENERATED — edit
/// the block, not this.
fn story_card_compute_aCardShowsSomething(
  s : StoryCardState,
  _args : Array[@tutuca.Value],
  _stack : &@tutuca.Stack,
) -> @tutuca.Value {
  (
    Bool(
      !(match @tutuca.builtin("null?") {
        Some(b) => (b.apply)([s.target]).is_truthy()
        None => false
      }) ||
      s.error.length().to_double() > 0.0,
    ) : @tutuca.Value)
}

///|
/// The `compute` names the `<script type="tutuca/script">` block answers.
/// GENERATED — edit the block, not this.
fn story_card_inline_compute() -> Map[
  String,
  (StoryCardState, Array[@tutuca.Value], &@tutuca.Stack) -> @tutuca.Value,
] {
  { "aCardShowsSomething": story_card_compute_aCardShowsSomething }
}

///|
/// The StoryCard component: `component()` with everything the view file already
/// states filled in — its name, its compiled views and its styles. The
/// schema and the codec are not passed at all: `StoryCardState` states them
/// through `@component.Fields`, and `component()` reads them off the
/// bound. What is left is the code no generator can write.
///
/// `init` defaults to the zero state and `name` to the name the template
/// id declares — pass either when yours differs. The signature below is
/// the whole story: anything not a parameter here, the view file states.
pub fn story_card_component(
  name? : String = "StoryCard",
  views? : Map[String, @anode.View] = story_card_views(),
  init? : StoryCardState = StoryCardState::zero(),
  common_style? : String = story_card_common_style,
  global_style? : String = story_card_global_style,
  update? : (StoryCardState, @component.Dispatch, &@tutuca.Ctx) -> @component.Update[
    StoryCardState,
  ],
  compute? : (StoryCardMethod) -> ((
    StoryCardState,
    Array[@tutuca.Value],
    &@tutuca.Stack,
  ) -> @tutuca.Value)?,
  swap? : (StoryCardInput) -> ((
    StoryCardState,
    Array[@tutuca.Value],
    &@tutuca.Ctx,
  ) -> @tutuca.Value?)?,
  slots? : Map[String, String] = Map([]),
  slot_args? : Map[String, Map[String, @tutuca.Value]] = Map([]),
  provide? : Map[String, String] = Map([]),
  lookup? : Array[@component.LookupSpec] = [],
) -> @component.Component {
  @component.component(
    name~,
    views~,
    init~,
    common_style~,
    global_style~,
    update?,
    compute={
      let bucket = match compute {
        Some(f) =>
          @component.build_bucket(
            ([RefLabel] : Array[StoryCardMethod]),
            StoryCardMethod::name,
            f,
          )
        None => Map([])
      }
      for k, h in story_card_inline_compute() {
        bucket[k] = h
      }
      bucket
    },
    swap=match swap {
      Some(f) =>
        @component.build_bucket(
          ([Rebuild] : Array[StoryCardInput]),
          StoryCardInput::name,
          f,
        )
      None => Map([])
    },
    slots~,
    slot_args~,
    provide~,
    lookup~,
    spec=story_nav_spec_source,
  )
}

