///|
/// The compiled `main` view.
fn dyncomp_storybook_main_view_ir() -> @anode.View {
  @anode.View::from_ir(
    "main",
    @anode.h(
      "div",
      [
        @anode.attr(
          "class", "dyncomp-storybook min-h-screen flex flex-col bg-base-200 text-base-content",
        ),
        @anode.dyn_attr("data-theme", Field("theme")),
        @anode.attr("data-droptarget", "tutuca-host-drop"),
        @anode.eid(5),
      ],
      [
        @anode.h(
          "header",
          [
            @anode.attr(
              "class", "sb-bar flex items-center gap-2 flex-wrap px-3 py-1 border-b border-base-300 bg-base-100",
            ),
          ],
          [
            @anode.h("span", [@anode.attr("class", "font-semibold text-sm")], [
              @anode.text("dyncomp storybook"),
            ]),
            @anode.text(" "),
            @anode.h(
              "input",
              [
                @anode.attr("type", "search"),
                @anode.attr("class", "input input-xs input-bordered sb-search"),
                @anode.attr("placeholder", "filter stories…"),
                @anode.dyn_attr("value", Field("query")),
                @anode.eid(0),
              ],
              [],
            ),
            @anode.text(" "),
            @anode.h(
              "button",
              [
                @anode.attr("class", "btn btn-xs btn-ghost sb-all"),
                @anode.eid(1),
              ],
              [@anode.text("all")],
            ),
            @anode.text(" "),
            @anode.h(
              "label",
              [@anode.attr("class", "text-xs flex items-center gap-1")],
              [
                @anode.text("theme\n      "),
                @anode.h(
                  "select",
                  [
                    @anode.attr(
                      "class", "select select-xs select-bordered sb-theme",
                    ),
                    @anode.dyn_attr("value", Field("theme")),
                    @anode.eid(2),
                  ],
                  [
                    @anode.h("option", [@anode.attr("value", "light")], [
                      @anode.text("light"),
                    ]),
                    @anode.text(" "),
                    @anode.h("option", [@anode.attr("value", "dark")], [
                      @anode.text("dark"),
                    ]),
                    @anode.text(" "),
                    @anode.h("option", [@anode.attr("value", "corporate")], [
                      @anode.text("corporate"),
                    ]),
                    @anode.text(" "),
                    @anode.h("option", [@anode.attr("value", "dracula")], [
                      @anode.text("dracula"),
                    ]),
                    @anode.text(" "),
                    @anode.h("option", [@anode.attr("value", "nord")], [
                      @anode.text("nord"),
                    ]),
                    @anode.text(" "),
                    @anode.h("option", [@anode.attr("value", "retro")], [
                      @anode.text("retro"),
                    ]),
                    @anode.text(" "),
                    @anode.h("option", [@anode.attr("value", "winter")], [
                      @anode.text("winter"),
                    ]),
                  ],
                ),
              ],
            ),
            @anode.text(" "),
            @anode.h(
              "button",
              [
                @anode.attr("class", "btn btn-xs btn-ghost sb-layout"),
                @anode.eid(3),
              ],
              [@anode.dyn_text(Method("layoutLabel"))],
            ),
            @anode.text(" "),
            @anode.h(
              "button",
              [
                @anode.attr("class", "btn btn-xs btn-ghost sb-details"),
                @anode.eid(4),
              ],
              [@anode.dyn_text(Method("detailsLabel"))],
            ),
            @anode.text(" "),
            @anode.render(0, Field("devTools")),
            @anode.text(" "),
            @anode.h(
              "span",
              [@anode.attr("class", "text-xs opacity-70 grow sb-status")],
              [@anode.dyn_text(Field("status"))],
            ),
          ],
        ),
        @anode.h("div", [@anode.attr("class", "flex grow min-h-0")], [
          @anode.h(
            "aside",
            [
              @anode.attr(
                "class", "sb-nav w-64 shrink-0 border-r border-base-300 bg-base-100 overflow-y-auto p-2",
              ),
            ],
            [
              @anode.h("ul", [@anode.attr("class", "flex flex-col gap-0.5")], [
                @anode.each(
                  2,
                  Field("nav"),
                  @anode.render_it(1),
                  from_render_each=true,
                ),
              ]),
              @anode.text(" "),
              @anode.show(
                App(name="empty?", args=[Field("nav")]),
                @anode.h(
                  "p",
                  [
                    @anode.attr(
                      "class", "text-xs opacity-50 italic p-2 sb-nav-empty",
                    ),
                  ],
                  [
                    @anode.text(
                      "\n        Nothing loaded yet — drop a .tutuca.tar.gz on the page.\n      ",
                    ),
                  ],
                ),
              ),
            ],
          ),
          @anode.h(
            "main",
            [
              @anode.attr(
                "class", "sb-main grow overflow-auto p-4 flex flex-col gap-4",
              ),
            ],
            [
              @anode.push_view(
                Field("mode"),
                @anode.h(
                  "div",
                  [
                    @anode.if_attr(
                      "class",
                      Field("wide"),
                      then_val=@anode.const_str("sb-cards flex flex-col gap-4"),
                      else_val=@anode.const_str(
                        "sb-cards grid grid-cols-1 xl:grid-cols-2 gap-4 items-start",
                      ),
                    ),
                  ],
                  [
                    @anode.each(
                      4,
                      Field("cards"),
                      @anode.render_it(3),
                      when_val=HandlerName(name="matches", ns=Alter),
                      from_render_each=true,
                    ),
                  ],
                ),
              ),
              @anode.text(" "),
              @anode.show(
                Method("isEmpty"),
                @anode.h(
                  "p",
                  [@anode.attr("class", "text-sm opacity-60 italic sb-empty")],
                  [@anode.dyn_text(Field("emptyMessage"))],
                ),
              ),
            ],
          ),
        ]),
      ],
    ),
    [
      [
        @anode.on("input", HandlerName(name="setQuery", ns=Receive), args=[
          EventPath(["value"]),
        ]),
      ],
      [@anode.on("click", HandlerName(name="showAll", ns=Receive))],
      [
        @anode.on("input", HandlerName(name="chooseTheme", ns=Receive), args=[
          EventPath(["value"]),
        ]),
      ],
      [@anode.on("click", HandlerName(name="toggleWide", ns=Receive))],
      [@anode.on("click", HandlerName(name="toggleDetails", ns=Receive))],
      [
        @anode.on("drop", HandlerName(name="filesDropped", ns=Receive), args=[
          EventPath(["value"]),
        ]),
      ],
    ],
  )
}

