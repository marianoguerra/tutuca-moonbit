// A storybook for dynamic components: every component every loaded bundle
// declares, once per configuration it declares.
//
// The story set is not written anywhere. A `.tutuca.tar.gz` already carries a
// manifest that says what its components are, what each field holds, and what
// named `inits` it ships — and named initial states are exactly what a
// storybook shows. So this works on a bundle nobody wrote for it, including one
// dropped on the page while it is running.
//
// That is the difference from `storybook/`, which is the gallery of this
// repository's own compiled-in examples: those are known before the program
// runs and this one cannot be.
//
// BACKEND-AGNOSTIC on purpose, the same way `dyncomp/ui` is, and for the same
// payoff: `moon test` drives the whole gallery on the in-memory DOM with a fake
// guest. `dyncomp/storybook/wasm` is the wasm-gc shell that mounts it and
// supplies the one thing it cannot have — a bridge that fetches an archive and
// builds real guest instances.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/dyncomp/registry",
  "moonbitlang/core/json",
  // the generated *_view_gen.mbt modules derive @debug.Debug on their
  // vocabulary enums
  "moonbitlang/core/debug",
}

import {
  "marianoguerra/tutuca/testing/harness",
  "marianoguerra/tutuca/dyncomp/host" @dyncomp,
  "moonbitlang/core/test",
} for "test"
