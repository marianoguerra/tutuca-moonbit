///|
/// The Input arm of @component.Dispatch, decoded. Payload types are
/// inferred from the argument shapes written at the call sites, so a
/// handler added to storybook.html breaks every `match` over this type
/// until it is handled.
pub(all) enum DyncompStorybookMsg {
  /// `@on.input="chooseTheme …"`
  ChooseTheme(String)
  /// `@on.drop="filesDropped …"`
  FilesDropped(String)
  /// `@on.input="setQuery …"`
  SetQuery(String)
  /// `@on.click="showAll …"`
  ShowAll
  /// `@on.click="toggleDetails …"`
  ToggleDetails
  /// `@on.click="toggleWide …"`
  ToggleWide
  /// An Input dispatch the views do not declare, or a declared name
  /// whose runtime arguments did not match the inferred shape.
  Unknown(String, Array[@tutuca.Value])
}

///|
/// None for Receive / Bubble / Response — those names are raised by
/// component code, never written in a view, so the views cannot type them.
pub fn DyncompStorybookMsg::from_dispatch(
  d : @component.Dispatch,
) -> DyncompStorybookMsg? {
  guard d is Input(name, args) else { return None }
  Some(
    match (name, args) {
      ("chooseTheme", [Str(a0)]) => ChooseTheme(a0)
      ("filesDropped", [Str(a0)]) => FilesDropped(a0)
      ("setQuery", [Str(a0)]) => SetQuery(a0)
      ("showAll", []) => ShowAll
      ("toggleDetails", []) => ToggleDetails
      ("toggleWide", []) => ToggleWide
      _ => Unknown(name, args)
    },
  )
}

