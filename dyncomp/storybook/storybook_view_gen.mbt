      @component.FieldInfo::new("nav", TyList(TyAny)),
      @component.FieldInfo::new("query", TyText),
      @component.FieldInfo::new("module", TyText),
      @component.FieldInfo::new("name", TyText),
      @component.FieldInfo::new("theme", TyText),
      @component.FieldInfo::new("wide", TyBool),
      @component.FieldInfo::new("mode", TyText),
      @component.FieldInfo::new("status", TyText),
      @component.FieldInfo::new("emptyMessage", TyText),
      @component.FieldInfo::new("devTools", TyComp(None)),
    ],
    inputs=[
      "chooseTheme", "filesDropped", "setQuery", "showAll", "toggleDetails", "toggleWide",
    ],
    receives=["catalogChanged", "setStatus"],
    bubbles=["catalogChanged"],
    methods=["detailsLabel", "isEmpty", "layoutLabel"],
    view_names=["main"],
  )
}
