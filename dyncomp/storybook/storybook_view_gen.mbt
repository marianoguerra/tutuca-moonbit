    SetStatus(a0) => ("setStatus", [Str(a0)])
    ChooseTheme(a0) => ("chooseTheme", [Str(a0)])
    FilesDropped(a0) => ("filesDropped", [Str(a0)])
    SetQuery(a0) => ("setQuery", [Str(a0)])
    ShowAll => ("showAll", [])
    ToggleDetails => ("toggleDetails", [])
    ToggleWide => ("toggleWide", [])
    Unknown(n, args) => (n, args)
  }
