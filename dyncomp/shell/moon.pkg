// What every wasm-gc page that HOSTS bundles needs, whatever it does with
// them.
//
// There are two such pages in this repository and they are not variants of one
// thing — `dyncomp/ui/wasm` is an editor a person builds on, `dyncomp/storybook/wasm`
// is a gallery that shows everything a bundle declares. What they share is not a
// capability but a floor: turning a `ComponentRef` into a live guest instance,
// keeping the utility CSS in step with the views a bundle just brought, and the
// bar a bundle arrives through.
//
// That floor used to be copied into both, which is the kind of duplication that
// looks harmless until the two copies answer differently. So: one loader bar,
// one `make_instance`, one margaui refresh — and each host keeps its own
// `mount`, because what a page IS remains its own.
//
// It is deliberately NOT in `dyncomp/host/wasm`, which is the bridge: that
// package should not have to depend on a CSS compiler and a view parser to
// answer `get-field`.
import {
  "marianoguerra/tutuca/core" @tutuca,
  "marianoguerra/tutuca/app",
  "marianoguerra/tutuca/app/wasm" @wglue,
  "marianoguerra/tutuca/component",
  "marianoguerra/tutuca/anode",
  "marianoguerra/tutuca/css",
  "marianoguerra/tutuca/vdom/wasm" @wdom,
  "marianoguerra/tutuca/dyncomp/host/wasm" @dhw,
  "marianoguerra/tutuca/dyncomp/registry",
  // the generated *_view_gen.mbt modules derive @debug.Debug on their
  // vocabulary enums
  "moonbitlang/core/debug",
}

supported_targets = "wasm-gc"
