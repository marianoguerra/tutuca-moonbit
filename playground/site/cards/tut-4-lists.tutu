spec:
  Playlist:
    field draft :: String
    field songs :: List.of(String)

    property caption :: String

    pred any: !(it.songs.is_empty())

    message init

logic:
  Playlist:
    receive init:
      it.songs.push("Ramble On")
      it.songs.push("Pyramid Song")
      it.songs.push("Teardrop")

    /// The guard is the whole handler: appending and clearing the box
    /// are both mutators, and refusing an empty draft is the part that
    /// belongs to this component.
    receive add:
      if (it.draft.trim() != "")
      | 
          it.songs.push(it.draft.trim())
          it.draft := ""

    /// Moving a row is two writes at two positions, which is exactly
    /// the shape no single mutator has.
    receive up(i):
      if (i > 0)
      | 
          it.songs.insert_at((i - 1), it.songs[i])
          it.songs.delete_at((i + 1))

    property caption :: String:
      get: @str{@(it.songs.length()) song(s)}

view:
  Playlist:
    @div(~class: "card bg-base-200 max-w-md"){
      @div(~class: "card-body gap-3"){@h2(~class: "card-title"){Playlist}@div(~class: "flex gap-2 items-center"){@input(~class: "input input-sm w-full", ~placeholder: "add a song", ~value: it.draft, ~on_input: it.draft := e.value, ~on_keydown: add ~send) @button(~class: "btn btn-sm btn-primary", ~on_click: add){add}} @show(any()){
  @ul(~class: "flex flex-col gap-2"){
    @each(value, key in it.songs){
      @li(~class: "flex gap-2 items-center w-full"){@span(~class: "w-full"){@(value)} @button(~class: "btn btn-xs btn-ghost", ~title: "move up", ~on_click: up(key)){↑} @button(~class: "btn btn-xs btn-soft btn-error btn-circle", ~title: "remove", ~on_click: it.songs.delete_at(key)){×}}
    }
  }
} @hide(any()){
  @p(~class: "opacity-60 italic"){@" nothing queued — press Enter to add "}
} @span(~class: "badge badge-sm badge-neutral"){@(it.caption)}}
    }

