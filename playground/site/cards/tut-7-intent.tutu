spec:
  Quote:
    field text :: String
    field error :: String
    field busy :: Bool
    field tries :: Int

    pred failed: !(it.error.is_empty())

    message init

    message load_quote_ok(Any)

    message load_quote_error(Any)

    message load_quote_unhandled

logic:
  Quote:
    receive init:
      ask("load_quote", ~route: lex)
      it.busy := true

    receive retry:
      ask("load_quote", ~route: lex)
      it.busy := true
      it.error := ""
      it.tries += 1

    /// Each outcome is its own arm, and each gets only what it is about.
    ///
    /// v1 sent one payload carrying BOTH a result and an error, exactly one
    /// of which was Null, and every arm began by working out which. The
    /// branch is gone with the pair.
    receive load_quote_ok(res):
      it.busy := false
      it.text := res.to_string()

    receive load_quote_error(err):
      it.busy := false
      it.error := err.to_string()

    /// The third outcome, and the one this page is actually showing you.
    ///
    /// It registers NO handler for `loadQuote`, so the route runs out and
    /// NOBODY answered — which is not the same as a fetch that failed. v1
    /// could only say the second, so it invented an error and this arm was a
    /// lie about what happened. Now it says the true thing.
    receive load_quote_unhandled:
      it.busy := false
      it.error := "nothing on this page answers `loadQuote`"

view:
  Quote:
    div(class: "card bg-base-200 max-w-md"):
      div(class: "card-body gap-3"):
        show(it.busy):
          p(class: "opacity-60 italic"):
            "asking…"
        " "
        hide(failed()):
          p(class: "text-lg"):
            @(it.text)
        " "
        show(failed()):
          div(class: "alert alert-error"):
            span(class: "font-mono text-sm"):
              @(it.error)
        " "
        div(class: "card-actions items-center gap-2"):
          button(class: "btn btn-sm btn-primary", ~on_click: retry):
            " try again "
          " "
          span(class: "badge badge-sm badge-neutral"):
            " tries: "
            @(it.tries)
