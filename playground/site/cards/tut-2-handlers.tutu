spec:
  Steps:
    field count :: Int
    field step :: Int
    field trail :: List.of(Int)

    message init

logic:
  Steps:
    /// A card starts at the schema's zero, and an Int zeroes to 0 —
    /// which would make every press below move by nothing at all.
    receive init:
      it.step := 1

    /// Move one step in `dir`, remembering where it landed.
    ///
    /// `.count` on the second line reads what the first one wrote: a
    /// statement rebinds the state, so the trail records where the
    /// counter ENDED rather than where it started.
    receive step(dir):
      it.count += (dir * it.step)
      it.trail.push(it.count)

    /// `n` is whatever the call site wrote — `pickStep valueAsInt`
    /// below — so its type comes from there, not from an annotation.
    receive pick_step(n):
      it.step := math.clamp(n, 1, 10)

    /// The last entry is a place like any other: `.trail[expr]` reads
    /// it and `.trail.deleteAt` drops it.
    receive undo:
      if (it.trail.length() > 0)
      | 
          it.trail.delete_at((it.trail.length() - 1))
          it.count := 0
          if (it.trail.length() > 0)
          | it.count := it.trail[(it.trail.length() - 1)]

view:
  Steps:
    @div(~class: "card bg-base-200 max-w-md"){
      @div(~class: "card-body gap-3"){@p(~class: "text-4xl tabular-nums"){@(it.count)}@div(~class: "join"){@button(~class: "btn btn-sm join-item", ~on_click: step(1)){+} @button(~class: "btn btn-sm join-item", ~on_click: step(-1)){−} @button(~class: "btn btn-sm join-item btn-ghost", ~on_click: undo){undo}} @label(~class: "flex gap-2 items-center"){@span(~class: "opacity-70"){step} @input(~type: "range", ~class: "range range-sm", ~min: "1", ~max: "10", ~value: it.step, ~on_input: pick_step(e.valueAsInt)) @span(~class: "badge badge-sm badge-neutral"){@(it.step)}} @ul(~class: "flex gap-1 flex-wrap"){@each(value, key in it.trail){
  @li(~class: "badge badge-sm badge-ghost"){@(value)}
}}}
    }

