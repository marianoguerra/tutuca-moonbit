spec:
  Ledger:
    field total :: Int
    field here :: Int
    field there :: Int
    field moves :: Int

    /// PRECONDITIONS — what a handler asks before it moves anything.
    ///
    /// The `format` is what each one SAYS when it declines. Press a button with
    /// nothing left on that side and the console gets the sentence rather than
    /// silence.
    pred can_push:
      ~format: "nothing left here to push"
      (it.here > 0)

    pred can_pull:
      ~format: "nothing over there to pull back"
      (it.there > 0)

    /// A POSTCONDITION's rule. It is about what ONE handler was supposed to
    /// achieve, which is the half a reader can check by looking: `pushAll` is
    /// the handler that empties `here`, and this is that sentence written down.
    pred here_empty: (it.here == 0)

    /// THE INVARIANT — the component keeps this, so it is checked after every
    /// handler below and every handler added later, including the ones that
    /// never mention it, and including the generated `setHere` nobody wrote.
    /// That reach is why it belongs here rather than among the handlers: its
    /// attachment point is the COMPONENT, and this is the component.
    ///
    /// The `format` is what it SAYS when it does not hold, evaluated against the
    /// state that was rejected — so the numbers in the sentence are the ones that
    /// broke the rule. This comment says what the rule is; the format says what
    /// went wrong this time.
    invariant conserved:
      ~format: @str{@(it.here) + @(it.there) is not @(it.total) — a token came from nowhere}
      ((it.here + it.there) == it.total)

    /// A cross-field rule, in the shape `implies` is here for: exactly two
    /// operands, so there is no precedence to get wrong. Left as a plain `pred`
    /// — it is read by the badge below and by nothing else, which is what a
    /// rule looks like before you decide it is worth enforcing.
    pred empty_means_moved: ((it.here == 0) implies (it.moves > 0))

    message init

logic:
  Ledger:
    receive init:
      it.total := 8
      it.here := 8

    /// The guard has a NAME and sits in the header, so a reader knows when the
    /// handler applies without reading the body — and can read the rule itself in
    /// the spec block above. It still needs no rollback: a precondition is asked
    /// before anything has moved.
    receive push:
      ~requires: can_push
      it.here -= 1
      it.there += 1
      it.moves += 1

    receive pull:
      ~requires: can_pull
      it.there -= 1
      it.here += 1
      it.moves += 1

    /// A POSTCONDITION — asked after the body, against where it landed.
    ///
    /// One clause of each kind is the limit, and both on one header is the shape
    /// a transition takes when it has something to ask and something to promise.
    /// Both clauses are NAMES; the sentences they name are up in the spec block,
    /// which is what lets this header stay one line of intent.
    receive push_all:
      ~requires: can_push
      ~ensures: here_empty
      it.there += it.here
      it.here := 0
      it.moves += 1

    /// The button that tries to mint one out of nothing. It is refused — by a
    /// rule it does not mention, and does not need to, because the rule is the
    /// component's rather than this handler's — and the refusal is reported
    /// rather than silent. Open the console: `contract: cheat was abandoned — it
    /// broke the invariant conserved: 8 + 1 is not 8 — a token came from
    /// nowhere`. A host that wants the record rather than the line calls
    /// `on_runtime_notice`, and gets the rule, the path and the state that was
    /// rejected with it.
    receive cheat:
      it.there += 1

view:
  Ledger:
    @div(~class: "card bg-base-200 max-w-md"){
      @div(~class: "card-body gap-3"){
        @div(~class: "stats bg-base-100"){
          @div(~class: "stat"){
            @div(~class: "stat-title"){here}
            @div(~class: "stat-value text-2xl"){@(it.here)}
          }
          @div(~class: "stat"){
            @div(~class: "stat-title"){there}
            @div(~class: "stat-value text-2xl"){@(it.there)}
          }
          @div(~class: "stat"){
            @div(~class: "stat-title"){moves}
            @div(~class: "stat-value text-2xl"){@(it.moves)}
          }
        }
        @div(~class: "flex gap-2 items-center flex-wrap"){@div(~class: "join"){@button(~class: "btn btn-sm join-item", ~on_click: push){@" here → there "} @button(~class: "btn btn-sm join-item", ~on_click: pull){@" there → here "} @button(~class: "btn btn-sm join-item", ~on_click: push_all, ~title: "a postcondition: it has to land with here at 0"){@" all → "}} @button(~class: "btn btn-sm btn-soft btn-error", ~on_click: cheat, ~title: "refused by the invariant, and reported"){cheat}}
        @ul(~class: "flex flex-col gap-1 font-mono text-xs"){
          @li(~class: "flex gap-2 items-center"){@span(~class: if conserved() | "badge badge-sm badge-success" | "badge badge-sm badge-error"){@(conserved())}@" conserved: here + there is total "}
          @li(~class: "flex gap-2 items-center"){@span(~class: if empty_means_moved() | "badge badge-sm badge-success" | "badge badge-sm badge-error"){@(empty_means_moved())}@" emptyMeansMoved: here is 0 implies moves > 0 "}
        }
      }
    }

