spec:
  TreeItem:
    field type :: String
    field label :: String
    field is_open :: Bool
    field items :: List.of(Instance.of(TreeItem))

    /// The half a `where` cannot say: a leaf has no children. Two fields
    /// have to agree, and no relation over one of them states it.
    invariant files_are_leaves:
      ~format: @str{a file cannot hold @(it.items.length()) children}
      ((it.type == "file") implies (it.items.length() == 0))

    /// A filesystem node is one of exactly two things, and every view here
    /// branches on nothing else. A domain rather than a rule, because a
    /// generator can draw from a closed set and can only filter for a rule.
    where it.type is_one_of ["file", "dir"]

  TreeRoot:
    field log :: List.of(String)
    field root :: Instance.of(TreeItem)

view:
  TreeItem:
    style():
      user_select: none
      class(head):
        cursor: pointer
      class(head) element(before):
        content: "⏺️"
        margin_right: rem(0.25)
      class(head) class(type_file) element(before):
        content: "📄️"
      class(head) class(open) class(type_dir) element(before):
        content: "📂️"
      class(head) class(closed) class(type_dir) element(before):
        content: "📁️"
    section():
      p(class: "head", class: if it.is_open | @str{head open type-@(it.type)} | @str{head closed type-@(it.type)}, ~on_click: on_item_click):
        @(it.label)
      " "
      show(are_childs_visible()):
        div(class: "pl-3 pt-1 flex flex-col gap-2 kids"):
          each(value, key in it.items):
            render(value)

  TreeRoot:
    div(class: "flex flex-col gap-3"):
      render(it.root)
      " "
      ul(class: "flex flex-col gap-2 max-h-[40vh] overflow-y-auto log"):
        each(value, key in it.log):
          li():
            @(value)
