spec:
  Counter:
    field count :: Int

  Item:
    field completed :: Bool
    field text :: String

  Items:
    field items :: List.of(Instance.of(Item))

  TreeItem:
    field type :: String
    field label :: String
    field is_open :: Bool
    field items :: List.of(Instance.of(TreeItem))

    /// The half a `where` cannot say: a leaf has no children. Two fields
    /// have to agree, and no relation over one of them states it.
    invariant files_are_leaves:
      ~format: @str{a file cannot hold @(it.items.length()) children}
      ((it.type == "file") implies (it.items.length() == 0))

    /// A filesystem node is one of exactly two things, and every view here
    /// branches on nothing else. A domain rather than a rule, because a
    /// generator can draw from a closed set and can only filter for a rule.
    where it.type is_one_of ["file", "dir"]

  TreeRoot:
    field log :: List.of(String)
    field root :: Instance.of(TreeItem)

  Composability:
    field active_section :: String
    field counter :: Instance.of(Counter)
    field todo :: Instance.of(Items)
    field tree :: Instance.of(TreeRoot)

    /// Three tabs, three panes. `setActiveSection` is generated, so this is
    /// the only place the closed set can be stated — a fourth name renders a
    /// tab strip above nothing.
    where it.active_section is_one_of ["counter", "todo", "tree"]

logic:
  Counter:
    /// Six components share this file, so a script block says which one it
    /// answers for — a `.count` here has to mean exactly one state.
    receive inc:
      it.count += 1

    receive dec:
      it.count -= 1

view:
  Counter:
    @div(~style: "display:flex;gap:.5rem;align-items:center;font-size:1.5rem"){@button(~on_click: dec){-} @b{@(it.count)} @button(~on_click: inc){+}}

  Item:
    @div(~class: "flex gap-3 items-center"){@input(~type: "checkbox", ~class: "checkbox", ~checked: it.completed, ~on_input: it.completed := e.value) @input(~class: "input", ~value: it.text, ~on_input: it.text := e.value, ~disabled: it.completed)}

  Items:
    @div(~class: "flex flex-col gap-3"){@button(~class: "btn btn-soft btn-success add", ~on_click: on_add_item){Add Task} @div(~class: "flex flex-col gap-3 w-full"){@each(value, key in it.items){
  @div(~class: "flex gap-3 justify-center items-center w-full row"){@render(value) @button(~class: "btn btn-soft btn-sm btn-error btn-circle font-mono rm", ~on_click: it.items.delete_at(key)){x}}
}}}

  TreeItem:
    @style{user-select: none; .head { cursor: pointer; } .head:before { content: "⏺️"; margin-right: 0.25rem; } .head.type-file:before { content: "📄️"; } .head.open.type-dir:before { content: "📂️"; } .head.closed.type-dir:before { content: "📁️"; }}
    @section{@p(~class: "head", ~class: if it.is_open | @str{head open type-@(it.type)} | @str{head closed type-@(it.type)}, ~on_click: on_item_click){@(it.label)} @show(are_childs_visible()){
  @div(~class: "pl-3 pt-1 flex flex-col gap-2 kids"){
    @each(value, key in it.items){
      @render(value)
    }
  }
}}

  TreeRoot:
    @div(~class: "flex flex-col gap-3"){@render(it.root) @ul(~class: "flex flex-col gap-2 max-h-[40vh] overflow-y-auto log"){@each(value, key in it.log){
  @li{@(value)}
}}}

  Composability:
    @section(~class: "flex flex-col gap-4"){@div(~role: "tablist", ~class: "tabs tabs-border"){@button(~role: "tab", ~id: "tab-counter", ~class: if (it.active_section == "counter") | "tab tab-active" | "tab", ~on_click: it.active_section := "counter"){Counter} @button(~role: "tab", ~id: "tab-todo", ~class: if (it.active_section == "todo") | "tab tab-active" | "tab", ~on_click: it.active_section := "todo"){To-Do} @button(~role: "tab", ~id: "tab-tree", ~class: if (it.active_section == "tree") | "tab tab-active" | "tab", ~on_click: it.active_section := "tree"){Tree}} @show((it.active_section == "counter")){
  @div(~class: "pane-counter"){@render(it.counter)}
} @show((it.active_section == "todo")){
  @div(~class: "pane-todo"){@render(it.todo)}
} @show((it.active_section == "tree")){
  @div(~class: "pane-tree"){@render(it.tree)}
}}

