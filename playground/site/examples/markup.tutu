spec:
  MarkupPreview:
    field html :: String
    field svg :: String

view:
  MarkupPreview:
    div(style: "font-family:system-ui;display:flex;flex-direction:column;gap:1rem"):
      div(style: "display:flex;gap:1rem;align-items:stretch;min-height:22rem"):
        textarea(value: it.html, ~on_input: it.html := e.value, spellcheck: "false", style: "flex:1;min-width:0;font-family:ui-monospace,monospace;font-size:.8rem;line-height:1.5;padding:.75rem;border:1px solid #cbd5e1;border-radius:.375rem;resize:vertical")
        " "
        div(inner_html: it.html, style: "flex:1;min-width:0;overflow:auto;padding:.75rem;border:1px solid #cbd5e1;border-radius:.375rem;background:#fff")
      div(style: "display:flex;gap:1rem;align-items:stretch;min-height:14rem"):
        textarea(value: it.svg, ~on_input: it.svg := e.value, spellcheck: "false", style: "flex:1;min-width:0;font-family:ui-monospace,monospace;font-size:.8rem;line-height:1.5;padding:.75rem;border:1px solid #cbd5e1;border-radius:.375rem;resize:vertical")
        " "
        div(style: "flex:1;min-width:0;padding:.75rem;border:1px solid #cbd5e1;border-radius:.375rem;background:#fff"):
          svg(viewBox: "0 0 120 120", width: "220", height: "220", inner_svg: it.svg)
