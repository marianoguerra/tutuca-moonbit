spec:
  MdPreview:
    field source :: String

view:
  MdPreview:
    div(style: "font-family:system-ui;display:flex;gap:1rem;align-items:stretch;min-height:32rem"):
      textarea(value: it.source, ~on_input: it.source := e.value, spellcheck: "false", style: "flex:1;min-width:0;font-family:ui-monospace,monospace;font-size:.8rem;line-height:1.5;padding:.75rem;border:1px solid #cbd5e1;border-radius:.375rem;resize:vertical")
      " "
      div(inner_md: it.source, style: "flex:1;min-width:0;overflow:auto;padding:.75rem;border:1px solid #cbd5e1;border-radius:.375rem;background:#fff")
